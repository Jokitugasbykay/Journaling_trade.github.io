<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FNC Academy — Member Area</title>
  <link rel="icon" type="image/png"
    href="data:image/png;base64,">
  <link rel="apple-touch-icon"
    href="data:image/png;base64,">
  <meta name="theme-color" content="#1F2937">
  <meta name="description" content="Jurnal trading & dashboard performa untuk member private FNC Academy.">
  <style>
    :root {
      --orange: #F2701D;
      --orange-deep: #C2410C;
      --orange-light: #FB923C;
      --cream: #FFEDD5;
      --cream-bg: #FFFBF6;
      --slate: #1F2937;
      --slate-2: #374151;
      --gray: #6B7280;
      --line: #EAD9C7;
      --line-2: #F0E4D6;
      --white: #fff;
      --win: #16A34A;
      --loss: #DC2626;
      --kartu: #fff;
      /* latar kartu & kotak */
      --teks-isi: #374151;
      /* teks paragraf, dibuat lebih terang di mode gelap */
      --hal: #F3EFE9;
      /* latar halaman paling luar */
      --glow: none;
      /* efek cahaya teks, hanya aktif di mode gelap */
      --glow-kuat: none;
      --kursor: transparent;
      /* sorotan mengikuti kursor */
      /* ===== lapisan kaca =====
       Dipakai untuk panel yang mengambang di atas latar. Nilai blur sengaja
       sedang (14px) — cukup terasa, tapi tidak membebani HP kelas menengah. */
      --kaca: rgba(255, 255, 255, .72);
      --pop-kepala: #1F2937;
      --kaca-tepi: rgba(255, 255, 255, .85);
      --kaca-blur: 14px;
      --bayang-1: 0 1px 2px rgba(31, 41, 55, .05), 0 4px 14px rgba(31, 41, 55, .06);
      --bayang-2: 0 2px 6px rgba(31, 41, 55, .07), 0 12px 32px rgba(31, 41, 55, .10);
      --bayang-3: 0 8px 28px rgba(31, 41, 55, .14);
      --aksen-halus: rgba(242, 112, 29, .10);
      --sans: -apple-system, system-ui, 'Segoe UI', Inter, Roboto, sans-serif;
      --mono: ui-monospace, 'SF Mono', 'Cascadia Code', 'Roboto Mono', monospace;
    }

    /* ===== MODE GELAP =====
     Semua warna diturunkan dari variabel yang sama, jadi seluruh halaman
     ikut berganti tanpa perlu aturan terpisah per komponen. */
    html[data-tema="gelap"] {
      --cream: #2A2A2A;
      --cream-bg: #141414;
      --slate: #DBDBDB;
      --slate-2: #BDBDBD;
      --gray: #909090;
      --line: #303030;
      --line-2: #2C2C2C;
      --white: #141414;
      --kartu: #1F1F1F;
      --hal: #141414;
      --teks-isi: #D1D1D1;
      /* jauh lebih terang supaya paragraf enak dibaca */
      --kaca: rgba(31, 31, 31, .75);
      --pop-kepala: #262626;
      --kaca-tepi: rgba(255, 255, 255, .09);
      --bayang-1: 0 1px 2px rgba(0, 0, 0, .30), 0 4px 14px rgba(0, 0, 0, .28);
      --bayang-2: 0 2px 8px rgba(0, 0, 0, .36), 0 14px 36px rgba(0, 0, 0, .42);
      --bayang-3: 0 10px 34px rgba(0, 0, 0, .50);
      --aksen-halus: rgba(242, 112, 29, .14);
      --orange-deep: #FDBA74;
      --win: #4ADE80;
      --loss: #F87171;
      --glow: 0 0 12px rgba(232, 236, 241, .13);
      --glow-kuat: 0 0 20px rgba(242, 112, 29, .35);
      --kursor: rgba(242, 112, 29, .09);
      color-scheme: dark;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--hal);
      font-family: var(--sans);
      color: var(--slate);
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* Cahaya lembut di latar — memberi kedalaman tanpa mengganggu keterbacaan. */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(760px 460px at 12% -6%, rgba(242, 112, 29, .11), transparent 62%),
        radial-gradient(680px 420px at 96% 4%, rgba(242, 112, 29, .07), transparent 60%);
    }

    html[data-tema="gelap"] body::before {
      background:
        radial-gradient(820px 500px at 10% -8%, rgba(242, 112, 29, .16), transparent 62%),
        radial-gradient(700px 440px at 98% 2%, rgba(93, 124, 178, .14), transparent 60%);
    }

    .shell,
    .top,
    .tabs {
      position: relative;
      z-index: 1;
    }

    .shell {
      max-width: 1180px;
      margin: 0 auto;
      background: var(--cream-bg);
      min-height: 100vh;
      box-shadow: 0 0 40px rgba(31, 41, 55, .08);
    }

    @media(min-width:1220px) {
      .shell {
        margin: 18px auto;
        border-radius: 14px;
        overflow: hidden;
        min-height: 0;
      }
    }

    /* header */
    .top {
      background: linear-gradient(135deg, #232F3E, #1A2430);
      color: #fff;
      padding: 16px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      position: relative;
      overflow: hidden;
    }

    .top::after {
      content: '';
      position: absolute;
      right: -90px;
      top: -90px;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(242, 112, 29, .20), transparent 66%);
      pointer-events: none;
    }

    html[data-tema="gelap"] .top {
      background: linear-gradient(135deg, #191919, #101010);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .brand img {
      height: 40px;
      width: auto;
      display: block;
      filter: drop-shadow(0 2px 6px rgba(242, 112, 29, .35));
    }

    .brand h1 {
      font-size: 15.5px;
      margin: 0;
      font-weight: 700;
      letter-spacing: .01em;
    }

    .brand span {
      display: block;
      font-size: 10px;
      color: #9aa4b1;
      letter-spacing: .17em;
      text-transform: uppercase;
      margin-top: 2px;
    }

    .acct-pick {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .acct-pick label {
      font-size: 10px;
      color: #9aa4b1;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .acct-pick select {
      background: var(--slate-2);
      color: #fff;
      border: 1px solid #4b5563;
      border-radius: 7px;
      padding: 7px 11px;
      font-size: 12.5px;
      font-family: var(--sans);
      max-width: 190px;
    }

    .tabs {
      display: flex;
      background: rgba(31, 41, 55, .92);
      padding: 9px 14px;
      gap: 4px;
      border-top: 1px solid rgba(255, 255, 255, .06);
      overflow-x: auto;
      position: sticky;
      top: 0;
      z-index: 30;
      scrollbar-width: none;
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }

    .tabs::-webkit-scrollbar {
      display: none;
    }

    .tab {
      background: none;
      border: none;
      color: #9aa4b1;
      padding: 9px 15px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      border-radius: 20px;
      font-family: var(--sans);
      white-space: nowrap;
      position: relative;
      transition: color .18s, background .18s, transform .18s;
    }

    .tab:hover {
      color: #fff;
      background: rgba(255, 255, 255, .07);
    }

    .tab:active {
      transform: scale(.96);
    }

    .tab.active {
      color: #fff;
      background: var(--orange);
      box-shadow: 0 3px 12px rgba(242, 112, 29, .34);
    }

    .tab.active:hover {
      background: var(--orange);
    }

    html[data-tema="gelap"] .tabs {
      background: rgba(24, 24, 24, .92);
    }

    .tab:focus-visible {
      outline: 2px solid var(--orange-light);
      outline-offset: -3px;
    }

    .body {
      padding: 20px 22px 30px;
    }

    .view {
      display: none;
    }

    .view.active {
      display: block;
    }

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 11px;
      margin-bottom: 18px;
    }

    @media(max-width:900px) {
      .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .kpi {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 13px 15px;
      position: relative;
      overflow: hidden;
    }

    .kpi::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: var(--orange);
    }

    .k-label {
      font-size: 9.5px;
      color: var(--gray);
      letter-spacing: .08em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .k-val {
      font-size: 21px;
      font-weight: 700;
      font-family: var(--mono);
      line-height: 1;
    }

    .k-sub {
      font-size: 11px;
      color: var(--gray);
      margin-top: 5px;
    }

    .pos {
      color: var(--win);
    }

    .neg {
      color: var(--loss);
    }

    .neu {
      color: var(--slate);
    }

    .panel {
      background: var(--kartu);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 17px 18px;
      margin-bottom: 15px;
      box-shadow: var(--bayang-1);
    }

    @supports ((backdrop-filter:blur(2px)) or (-webkit-backdrop-filter:blur(2px))) {
      .panel {
        background: var(--kaca);
        border-color: var(--kaca-tepi);
        -webkit-backdrop-filter: blur(var(--kaca-blur)) saturate(150%);
        backdrop-filter: blur(var(--kaca-blur)) saturate(150%);
      }
    }

    .panel h3 {
      margin: 0 0 13px;
      font-size: 11.5px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--slate-2);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .panel h3::before {
      content: '';
      width: 4px;
      height: 14px;
      background: var(--orange);
      border-radius: 2px;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }

    .panel-head h3 {
      margin: 0;
    }

    .panel-head .head-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    @media(max-width:900px) {
      .two-col {
        grid-template-columns: 1fr;
      }
    }

    svg.chart {
      width: 100%;
      display: block;
    }

    .stat-row {
      display: flex;
      justify-content: space-between;
      padding: 7px 0;
      border-bottom: 1px solid var(--line-2);
      font-size: 13px;
    }

    .stat-row:last-child {
      border-bottom: none;
    }

    .stat-row .lbl {
      color: var(--gray);
    }

    .stat-row .v {
      font-family: var(--mono);
      font-weight: 600;
    }

    .bar-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
      font-size: 12px;
    }

    .bar-row .bl {
      width: 118px;
      flex-shrink: 0;
      color: var(--slate-2);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .bar-track {
      flex: 1;
      height: 19px;
      background: var(--line-2);
      border-radius: 5px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      border-radius: 5px;
    }

    .bar-row .bv {
      width: 78px;
      text-align: right;
      font-family: var(--mono);
      font-weight: 600;
      flex-shrink: 0;
    }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 15px;
      flex-wrap: wrap;
    }

    .filters {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filters select,
    .filters input {
      background: var(--white);
      border: 1px solid var(--line);
      color: var(--slate);
      border-radius: 7px;
      padding: 8px 11px;
      font-size: 12.5px;
      font-family: var(--sans);
    }

    .btn {
      background: var(--orange);
      color: #fff;
      border: none;
      font-weight: 700;
      padding: 9px 16px;
      border-radius: 7px;
      cursor: pointer;
      font-size: 13px;
      font-family: var(--sans);
    }

    .btn:hover {
      background: var(--orange-deep);
    }

    .btn:focus-visible {
      outline: 2px solid var(--slate);
      outline-offset: 2px;
    }

    .btn.ghost {
      background: var(--white);
      border: 1px solid var(--line);
      color: var(--slate-2);
      font-weight: 600;
    }

    .btn.ghost:hover {
      background: var(--cream);
    }

    .btn.danger {
      background: var(--white);
      border: 1px solid var(--loss);
      color: var(--loss);
      font-weight: 600;
    }

    .btn.danger:hover {
      background: #fef2f2;
    }

    .btn.sm {
      padding: 6px 12px;
      font-size: 12px;
    }

    .form {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 17px;
      margin-bottom: 15px;
      display: none;
    }

    .form.open {
      display: block;
    }

    .fgrid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 11px;
    }

    @media(max-width:900px) {
      .fgrid {
        grid-template-columns: repeat(2, 1fr);
      }

      .field.s4 {
        grid-column: span 2 !important;
      }

      .calc-preview {
        grid-column: span 2 !important;
      }
    }

    .field label {
      display: block;
      font-size: 9.5px;
      color: var(--gray);
      letter-spacing: .06em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      background: var(--cream-bg);
      border: 1px solid var(--line);
      color: var(--slate);
      padding: 8px 10px;
      border-radius: 7px;
      font-size: 13px;
      font-family: var(--sans);
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      outline: 1.5px solid var(--orange);
      border-color: var(--orange);
    }

    .field.s2 {
      grid-column: span 2;
    }

    .field.s4 {
      grid-column: span 4;
    }

    .calc-preview {
      grid-column: span 4;
      display: flex;
      gap: 22px;
      flex-wrap: wrap;
      background: var(--cream);
      border: 1px dashed var(--orange-light);
      border-radius: 8px;
      padding: 11px 14px;
      margin-top: 3px;
    }

    .calc-preview span {
      display: block;
      font-size: 9.5px;
      color: var(--orange-deep);
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .calc-preview b {
      font-family: var(--mono);
      font-size: 15px;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 14px;
    }

    .tbl-wrap {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow-x: auto;
    }

    table.tbl {
      width: 100%;
      border-collapse: collapse;
      font-size: 12.5px;
    }

    table.tbl th {
      text-align: left;
      font-size: 9.5px;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--gray);
      padding: 11px 12px;
      border-bottom: 1.5px solid var(--line);
      white-space: nowrap;
      background: var(--cream-bg);
    }

    table.tbl td {
      padding: 9px 12px;
      border-bottom: 1px solid var(--line-2);
      white-space: nowrap;
      font-family: var(--mono);
    }

    table.tbl tr:last-child td {
      border-bottom: none;
    }

    table.tbl tr:hover td {
      background: var(--kartu)af3;
    }

    .pill {
      display: inline-block;
      padding: 2px 9px;
      border-radius: 20px;
      font-size: 10.5px;
      font-family: var(--sans);
      font-weight: 600;
    }

    .pill.win {
      background: #dcfce7;
      color: #15803d;
    }

    .pill.loss {
      background: #fee2e2;
      color: #b91c1c;
    }

    .pill.be {
      background: #f3f4f6;
      color: #4b5563;
    }

    .reason-cell {
      max-width: 210px;
      overflow: hidden;
      text-overflow: ellipsis;
      font-family: var(--sans);
      color: var(--gray);
    }

    .icon-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 13px;
      color: var(--gray);
      padding: 3px 6px;
      border-radius: 4px;
    }

    .icon-btn:hover {
      color: var(--loss);
      background: #fef2f2;
    }

    .icon-btn.edit:hover {
      color: var(--orange);
      background: var(--cream);
    }

    .empty {
      padding: 44px 20px;
      text-align: center;
      color: var(--gray);
      font-size: 13px;
    }

    .empty b {
      color: var(--slate);
      display: block;
      margin-bottom: 6px;
      font-size: 15px;
    }

    .acct-card {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .acct-info h4 {
      margin: 0 0 3px;
      font-size: 14px;
    }

    .acct-info .meta {
      font-size: 11.5px;
      color: var(--gray);
      font-family: var(--mono);
    }

    .acct-bal {
      text-align: right;
    }

    .acct-bal .cur {
      font-family: var(--mono);
      font-size: 17px;
      font-weight: 700;
    }

    .acct-bal .st {
      font-size: 9.5px;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--gray);
    }

    .dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--win);
      margin-right: 5px;
    }

    .dot.off {
      background: var(--gray);
    }

    .kurs-box {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--cream);
      border: 1px solid var(--orange-light);
      border-radius: 8px;
      padding: 10px 14px;
      margin-bottom: 15px;
      font-size: 13px;
      flex-wrap: wrap;
    }

    .kurs-box input {
      width: 110px;
      background: var(--kartu);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 6px 9px;
      font-family: var(--mono);
    }

    /* onboarding modal */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(31, 41, 55, .72);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 99;
    }

    .overlay[hidden] {
      display: none;
    }

    .welcome {
      background: var(--cream-bg);
      border-radius: 14px;
      max-width: 520px;
      width: 100%;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .3);
    }

    .welcome-top {
      background: var(--pop-kepala);
      padding: 26px 26px 22px;
      text-align: center;
    }

    .welcome-top img {
      height: 62px;
      margin-bottom: 12px;
    }

    .welcome-top h2 {
      color: #fff;
      margin: 0 0 5px;
      font-size: 19px;
    }

    .welcome-top p {
      color: #9A9A9A;
      margin: 0;
      font-size: 12.5px;
    }

    .welcome-body {
      padding: 22px 26px 26px;
    }

    .welcome-body ul {
      margin: 0 0 18px;
      padding-left: 19px;
      font-size: 13.5px;
      line-height: 1.75;
      color: var(--slate-2);
    }

    .welcome-body ul b {
      color: var(--slate);
    }

    .welcome-actions {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
    }

    .welcome-actions .btn {
      flex: 1;
      min-width: 150px;
    }

    .note {
      background: var(--cream);
      border-left: 3px solid var(--orange);
      padding: 11px 13px;
      border-radius: 0 7px 7px 0;
      font-size: 12.5px;
      color: var(--slate-2);
      line-height: 1.6;
      margin-bottom: 16px;
    }

    /* help */
    .help-block {
      margin-bottom: 22px;
    }

    .help-block h4 {
      font-size: 13.5px;
      margin: 0 0 8px;
      color: var(--slate);
    }

    .help-block p,
    .help-block li {
      font-size: 13px;
      line-height: 1.7;
      color: var(--slate-2);
      margin: 0 0 8px;
    }

    .help-block ol,
    .help-block ul {
      padding-left: 20px;
      margin: 0 0 10px;
    }

    .kbd {
      font-family: var(--mono);
      background: var(--cream);
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 1px 6px;
      font-size: 12px;
    }

    /* kalkulator */
    .calc-out {
      background: var(--cream);
      border: 1px dashed var(--orange-light);
      border-radius: 8px;
      padding: 13px 15px;
      margin-top: 13px;
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .calc-out .co {
      min-width: 96px;
    }

    .calc-out .co span {
      display: block;
      font-size: 9.5px;
      color: var(--orange-deep);
      letter-spacing: .06em;
      text-transform: uppercase;
      margin-bottom: 3px;
    }

    .calc-out .co b {
      font-family: var(--mono);
      font-size: 17px;
      font-weight: 700;
    }

    .calc-out.muted {
      background: #F7F4EF;
      border-color: var(--line);
      color: var(--gray);
      display: block;
      font-size: 12.5px;
      padding: 14px 15px;
    }

    .calc-note {
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.6;
      margin: 10px 0 0;
    }

    .calc-big {
      font-size: 22px !important;
    }


    /* ==================== ANIMASI & TRANSISI ==================== */
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(10px)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    @keyframes fadeIn {
      from {
        opacity: 0
      }

      to {
        opacity: 1
      }
    }

    @keyframes popIn {
      0% {
        opacity: 0;
        transform: scale(.94)
      }

      60% {
        transform: scale(1.015)
      }

      100% {
        opacity: 1;
        transform: scale(1)
      }
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-8px)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    @keyframes shimmer {
      0% {
        background-position: -380px 0
      }

      100% {
        background-position: 380px 0
      }
    }

    @keyframes spin {
      to {
        transform: rotate(360deg)
      }
    }

    @keyframes pulseDot {

      0%,
      100% {
        opacity: 1
      }

      50% {
        opacity: .35
      }
    }

    .view.anim-in {
      animation: fadeUp .34s cubic-bezier(.22, .8, .3, 1) both
    }

    .view.anim-in .panel {
      animation: fadeUp .4s cubic-bezier(.22, .8, .3, 1) both
    }

    .view.anim-in .panel:nth-child(2) {
      animation-delay: .05s
    }

    .view.anim-in .panel:nth-child(3) {
      animation-delay: .1s
    }

    .view.anim-in .panel:nth-child(4) {
      animation-delay: .15s
    }

    .kpi {
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .view.anim-in .kpi {
      animation: popIn .4s cubic-bezier(.22, .8, .3, 1) both;
    }

    .view.anim-in .kpi:nth-child(1) {
      animation-delay: .02s
    }

    .view.anim-in .kpi:nth-child(2) {
      animation-delay: .06s
    }

    .view.anim-in .kpi:nth-child(3) {
      animation-delay: .1s
    }

    .view.anim-in .kpi:nth-child(4) {
      animation-delay: .14s
    }

    .view.anim-in .kpi:nth-child(5) {
      animation-delay: .18s
    }

    .view.anim-in .kpi:nth-child(6) {
      animation-delay: .22s
    }

    .view.anim-in .kpi:nth-child(7) {
      animation-delay: .26s
    }

    .view.anim-in .kpi:nth-child(8) {
      animation-delay: .3s
    }

    .kpi:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 22px rgba(242, 112, 29, .16);
    }

    .tab {
      transition: color .2s ease, background .2s ease;
      position: relative;
    }

    .tab::after {
      content: '';
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 0;
      height: 2.5px;
      background: var(--orange);
      border-radius: 2px;
      transform: scaleX(0);
      transition: transform .26s cubic-bezier(.22, .8, .3, 1);
    }

    .tab.active::after {
      transform: scaleX(1);
    }

    .btn {
      transition: transform .14s ease, box-shadow .18s ease, background .18s ease, opacity .18s ease;
    }

    .btn:hover {
      transform: translateY(-1.5px);
      box-shadow: 0 6px 16px rgba(242, 112, 29, .22);
    }

    .btn:active {
      transform: translateY(0) scale(.985);
    }

    .btn.ghost:hover {
      box-shadow: 0 4px 12px rgba(0, 0, 0, .07);
    }

    .icon-btn {
      transition: transform .15s ease, background .15s ease, color .15s ease;
    }

    .icon-btn:hover {
      transform: scale(1.14);
    }

    .acct-card {
      animation: fadeUp .36s cubic-bezier(.22, .8, .3, 1) both;
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .acct-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, .07);
      border-color: var(--orange-light);
    }

    #journal-tbody tr {
      transition: background .15s ease;
    }

    #journal-tbody tr:hover {
      background: var(--cream);
    }

    .bar-fill {
      transition: width .7s cubic-bezier(.22, .8, .3, 1);
    }

    .pill {
      transition: transform .15s ease;
    }

    .pill:hover {
      transform: scale(1.06);
    }

    .field input,
    .field select,
    .field textarea {
      transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      box-shadow: 0 0 0 3.5px rgba(242, 112, 29, .14);
    }

    .calc-out {
      animation: fadeIn .28s ease both;
    }

    .calc-out .co b {
      transition: color .2s ease;
    }

    #gate-overlay,
    #welcome-overlay {
      animation: fadeIn .3s ease both;
    }

    #gate-overlay .gate-card,
    #welcome-overlay .gate-card {
      animation: popIn .42s cubic-bezier(.22, .8, .3, 1) both;
    }

    .eq-line {
      stroke-dasharray: 2600;
      stroke-dashoffset: 2600;
      animation: drawLine 1.5s cubic-bezier(.3, .7, .3, 1) forwards;
    }

    @keyframes drawLine {
      to {
        stroke-dashoffset: 0
      }
    }

    .eq-area {
      animation: fadeIn .9s ease .5s both;
    }

    .donut-seg {
      transition: stroke-dasharray .8s cubic-bezier(.22, .8, .3, 1);
    }

    .skeleton {
      background: linear-gradient(90deg, #F0EBE4 25%, #F8F5F1 50%, #F0EBE4 75%);
      background-size: 760px 100%;
      animation: shimmer 1.3s infinite linear;
      border-radius: 7px;
    }

    .spinner {
      width: 17px;
      height: 17px;
      border: 2.2px solid rgba(242, 112, 29, .25);
      border-top-color: var(--orange);
      border-radius: 50%;
      animation: spin .7s linear infinite;
      display: inline-block;
    }

    @media(prefers-reduced-motion:reduce) {

      *,
      *::after,
      *::before {
        animation-duration: .001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .001ms !important;
      }
    }


    /* ==================== BERITA & ANALISA ==================== */
    .feed-stamp {
      font-size: 10.5px;
      color: var(--gray);
      font-family: var(--mono);
    }

    .feed-item {
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 13px;
      background: var(--kartu);
      box-shadow: var(--bayang-1);
      animation: fadeUp .42s cubic-bezier(.22, .8, .3, 1) both;
      transition: box-shadow .24s ease, border-color .24s ease, transform .24s ease;
    }

    .feed-item:hover {
      box-shadow: var(--bayang-2);
      border-color: var(--orange-light);
      transform: translateY(-2px);
    }

    .feed-item.buka {
      box-shadow: var(--bayang-2);
    }

    .feed-item:nth-child(2) {
      animation-delay: .05s
    }

    .feed-item:nth-child(3) {
      animation-delay: .1s
    }

    .feed-item:nth-child(4) {
      animation-delay: .15s
    }

    .feed-item:nth-child(5) {
      animation-delay: .2s
    }

    /* Gambar sampul tampil UTUH — tidak dipotong.
     Gambar yang sangat tinggi otomatis dikecilkan agar muat, bukan dipangkas. */
    .feed-cover {
      width: 100%;
      display: block;
      background: var(--cream);
      cursor: zoom-in;
      height: auto;
      max-height: 520px;
      object-fit: contain;
      transition: opacity .2s ease;
    }

    .feed-cover:hover {
      opacity: .93;
    }

    .feed-pad {
      padding: 15px 17px 17px;
    }

    .feed-top {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
      margin-bottom: 7px;
    }

    .feed-tag {
      font-size: 9.5px;
      letter-spacing: .07em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 3.5px 9px;
      border-radius: 20px;
      background: var(--cream);
      color: var(--orange-deep);
    }

    .feed-tag.bull {
      background: #DCFCE7;
      color: #15803D;
    }

    .feed-tag.bear {
      background: #FEE2E2;
      color: #B91C1C;
    }

    .feed-tag.neu {
      background: #F1F5F9;
      color: #475569;
    }

    .feed-date {
      font-size: 10.5px;
      color: var(--gray);
      font-family: var(--mono);
    }

    .feed-item h4 {
      margin: 0 0 8px;
      font-size: 16.5px;
      line-height: 1.35;
      color: var(--slate);
    }

    .feed-body {
      font-size: 13.5px;
      line-height: 1.75;
      color: var(--teks-isi);
      word-break: break-word;
    }

    .feed-body b {
      color: var(--slate);
    }

    .feed-body a {
      color: var(--orange-deep);
    }

    .feed-body .wa-ul,
    .feed-body .wa-ol {
      margin: 8px 0;
      padding-left: 22px;
    }

    .feed-body .wa-ul li,
    .feed-body .wa-ol li {
      margin: 4px 0;
      line-height: 1.7;
    }

    .feed-body .wa-ul {
      list-style: disc;
    }

    .feed-body .wa-ol {
      list-style: decimal;
    }

    .feed-body .wa-q {
      margin: 9px 0;
      padding: 8px 13px;
      border-left: 3px solid var(--orange);
      background: var(--cream);
      border-radius: 0 8px 8px 0;
      color: var(--slate-2);
      font-style: italic;
    }

    .ann p .wa-ul,
    .ann p .wa-ol,
    .ann-hl p .wa-ul,
    .ann-hl p .wa-ol {
      margin: 6px 0;
      padding-left: 20px;
    }

    .ann p .wa-ul li,
    .ann-hl p .wa-ul li,
    .ann p .wa-ol li,
    .ann-hl p .wa-ol li {
      margin: 3px 0;
    }

    .feed-body code {
      background: var(--cream);
      padding: 1.5px 5px;
      border-radius: 4px;
      font-family: var(--mono);
      font-size: 12.5px;
    }

    .feed-gal {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 8px;
      margin-top: 11px;
    }

    .feed-gal img {
      width: 100%;
      border-radius: 8px;
      border: 1px solid var(--line);
      cursor: zoom-in;
      display: block;
      transition: transform .18s ease;
    }

    .feed-gal img:hover {
      transform: scale(1.02);
    }

    .feed-empty {
      text-align: center;
      padding: 38px 20px;
      color: var(--gray);
      font-size: 13px;
      line-height: 1.7;
    }


    /* ===== konsultasi admin ===== */
    .konsul {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px;
    }

    .konsul-kartu {
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--kartu);
      box-shadow: var(--bayang-1);
      padding: 13px 10px;
      text-align: center;
      cursor: pointer;
      transition: transform .16s ease, box-shadow .2s ease, border-color .2s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
    }

    .konsul-kartu:hover {
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
      border-color: #25D366;
    }

    .konsul-ic {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #25D366, #128C7E);
      box-shadow: 0 4px 12px rgba(37, 211, 102, .3);
    }

    .konsul-ic svg {
      width: 20px;
      height: 20px;
      fill: #fff;
      display: block;
    }

    .konsul-kartu b {
      font-size: 12.5px;
      color: var(--teks-isi);
      font-weight: 700;
      white-space: nowrap;
    }

    /* ===== ajakan gabung grup di beranda ===== */
    .grup-cta {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-top: 15px;
      border: 1px solid #25D366;
      border-radius: 15px;
      padding: 14px 15px;
      background: linear-gradient(135deg, rgba(37, 211, 102, .09), rgba(18, 140, 126, .05));
      cursor: pointer;
      transition: transform .16s ease, box-shadow .2s ease;
    }

    .grup-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(37, 211, 102, .2);
    }

    .grup-cta .ic {
      width: 42px;
      height: 42px;
      border-radius: 13px;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #25D366, #128C7E);
      box-shadow: 0 5px 14px rgba(37, 211, 102, .32);
    }

    .grup-cta .ic svg {
      width: 23px;
      height: 23px;
      fill: #fff;
      display: block;
    }

    .grup-cta b {
      display: block;
      font-size: 13.5px;
      color: var(--teks-isi);
      margin-bottom: 2px;
    }

    .grup-cta p {
      margin: 0;
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.55;
    }

    .grup-cta .go {
      font-size: 12px;
      font-weight: 700;
      color: #128C7E;
      white-space: nowrap;
    }

    /* bilah ringkas pengumuman di Beranda */
    .ann-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 15px;
      border: 1px solid var(--orange-light);
      border-radius: 14px;
      padding: 12px 14px;
      background: var(--aksen-halus);
      cursor: pointer;
      transition: transform .16s ease, box-shadow .2s ease;
    }

    .ann-bar:hover {
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
    }

    .ann-bar .ic {
      width: 36px;
      height: 36px;
      border-radius: 11px;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
      background: var(--kartu);
      border: 1px solid var(--orange-light);
    }

    .ann-bar b {
      display: block;
      font-size: 13px;
      color: var(--teks-isi);
    }

    .ann-bar p {
      margin: 2px 0 0;
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.5;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ann-bar .go {
      font-size: 12px;
      font-weight: 700;
      color: var(--orange-deep);
      white-space: nowrap;
    }

    /* ===== pop-up pengumuman ===== */
    .peng-kotak {
      max-width: 430px;
      width: 100%;
      max-height: 82vh;
      display: flex;
      flex-direction: column;
    }

    .peng-atas {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }

    .peng-ic {
      width: 42px;
      height: 42px;
      border-radius: 13px;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      background: var(--aksen-halus);
      border: 1px solid var(--orange-light);
    }

    .peng-atas b {
      display: block;
      font-size: 16px;
      color: var(--teks-isi);
      letter-spacing: -.01em;
    }

    .peng-atas span {
      display: block;
      font-size: 11.5px;
      color: var(--gray);
      margin-top: 1px;
    }

    .peng-isi {
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      flex: 1;
      min-height: 0;
      margin: 0 -4px;
      padding: 0 4px;
    }

    .peng-item {
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 13px 14px;
      margin-bottom: 11px;
      background: var(--kartu);
      text-align: left;
    }

    .peng-item:last-child {
      margin-bottom: 0;
    }

    .peng-pill {
      display: inline-block;
      font-size: 9.5px;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      padding: 3px 9px;
      border-radius: 999px;
      margin-bottom: 8px;
    }

    .peng-pill.info {
      background: var(--aksen-halus);
      color: var(--orange-deep);
    }

    .peng-pill.penting {
      background: #FEE2E2;
      color: #B91C1C;
    }

    .peng-pill.live {
      background: #DCFCE7;
      color: #15803D;
    }

    .peng-item h4 {
      margin: 0 0 6px;
      font-size: 14.5px;
      line-height: 1.4;
      color: var(--teks-isi);
    }

    .peng-item .teks {
      font-size: 12.5px;
      line-height: 1.7;
      color: var(--slate-2);
    }

    .peng-item img {
      width: 100%;
      border-radius: 10px;
      margin-bottom: 10px;
      display: block;
    }

    .peng-item .tgl {
      display: block;
      margin-top: 9px;
      font-size: 11px;
      color: var(--gray);
    }

    .peng-kotak .welcome-actions {
      margin-top: 15px;
    }

    /* ===== tab Informasi ===== */
    .inf-grup {
      margin-bottom: 20px;
    }

    .inf-grup:last-child {
      margin-bottom: 0;
    }

    .inf-lbl {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--gray);
      margin: 0 0 10px;
    }

    .inf-baris {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      text-align: left;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--kartu);
      padding: 11px 13px;
      margin-bottom: 9px;
      cursor: pointer;
      font-family: inherit;
      box-shadow: var(--bayang-1);
      transition: transform .16s ease, box-shadow .2s ease, border-color .18s ease;
    }

    .inf-baris:hover {
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
    }

    /* Lambang merek sudah membawa latarnya sendiri, jadi kotaknya dibiarkan
     polos dan gambarnya mengisi penuh. Discord berbentuk lingkaran, jadi
     kotaknya diberi warna yang sama supaya menyatu dengan yang lain. */
    .inf-ic {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      flex: 0 0 auto;
      overflow: hidden;
      display: block;
    }

    .inf-ic img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .inf-ic.dc {
      background: #5865F2;
    }

    .inf-baris b {
      display: block;
      font-size: 13.5px;
      color: var(--teks-isi);
    }

    .inf-baris span {
      display: block;
      font-size: 11.5px;
      color: var(--gray);
      margin-top: 1px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .inf-baris .pan {
      color: var(--gray);
      font-size: 17px;
      flex: 0 0 auto;
    }

    .inf-baris.ig:hover {
      border-color: #E1306C;
    }

    .inf-baris.tt:hover {
      border-color: #111;
    }

    .inf-baris.wa:hover {
      border-color: #25D366;
    }

    .inf-baris.dc:hover {
      border-color: #5865F2;
    }

    .inf-cp {
      border: 1.5px solid var(--orange);
      border-radius: 16px;
      padding: 17px;
      background: linear-gradient(150deg, var(--aksen-halus), var(--kartu) 70%);
    }

    .inf-cp h4 {
      margin: 0 0 6px;
      font-size: 16px;
      color: var(--teks-isi);
      letter-spacing: -.01em;
    }

    .inf-cp>p {
      margin: 0 0 13px;
      font-size: 12.5px;
      line-height: 1.65;
      color: var(--slate-2);
    }

    .inf-jenis {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }

    .inf-jenis span {
      font-size: 11px;
      font-weight: 600;
      padding: 4px 11px;
      border-radius: 999px;
      background: var(--cream);
      border: 1px solid var(--line);
      color: var(--slate-2);
    }

    /* ===== ajakan Discord ===== */
    .dc-cta {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-top: 11px;
      border: 1px solid #5865F2;
      border-radius: 15px;
      padding: 14px 15px;
      background: linear-gradient(135deg, rgba(88, 101, 242, .10), rgba(88, 101, 242, .03));
      cursor: pointer;
      transition: transform .16s ease, box-shadow .2s ease;
    }

    .dc-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(88, 101, 242, .22);
    }

    .dc-cta .ic {
      width: 42px;
      height: 42px;
      border-radius: 13px;
      flex: 0 0 auto;
      overflow: hidden;
      background: #5865F2;
      box-shadow: 0 5px 14px rgba(88, 101, 242, .34);
    }

    .dc-cta .ic img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .dc-cta b {
      display: block;
      font-size: 13.5px;
      color: var(--teks-isi);
      margin-bottom: 2px;
    }

    .dc-cta p {
      margin: 0;
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.55;
    }

    .dc-cta .go {
      font-size: 12px;
      font-weight: 700;
      color: #5865F2;
      white-space: nowrap;
    }

    /* ===== KELAS: segera dibuka (latar buram) ===== */
    .soon-wrap {
      position: relative;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--orange);
      box-shadow: var(--bayang-2);
    }

    .soon-bg {
      filter: blur(7px) saturate(.75);
      opacity: .5;
      pointer-events: none;
      user-select: none;
      padding: 14px 13px 4px;
      transform: scale(1.03);
    }

    .soon-bg .kls-kartu {
      cursor: default;
      box-shadow: none;
    }

    .soon-bg .kls-kartu:hover {
      transform: none;
      border-color: var(--line);
    }

    .soon-bar {
      height: 12px;
      border-radius: 5px;
      background: var(--line);
      margin-bottom: 8px;
    }

    .soon-bar.w1 {
      width: 82%;
    }

    .soon-bar.w2 {
      width: 54%;
    }

    .soon-bar.tebal {
      height: 19px;
      width: 42%;
      margin-bottom: 0;
      background: var(--orange-light);
    }

    /* Dulu lapisan depan dipaksa setinggi latar buramnya, jadi isinya
     mengambang di tengah dengan ruang kosong menganga di atas dan bawah.
     Sekarang tingginya mengikuti isi, latar buram yang menyesuaikan. */
    .soon-wrap {
      display: grid;
    }

    .soon-wrap>.soon-bg {
      grid-area: 1/1;
      max-height: 100%;
      overflow: hidden;
    }

    /* Isinya diratakan ke ATAS, bukan ditengahkan secara tegak — kalau
     ditengahkan, judulnya melayang jauh dari tepi kartu. */
    .soon-depan {
      grid-area: 1/1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 30px 18px 26px;
      text-align: center;
      background: radial-gradient(120% 90% at 50% 50%,
          rgba(255, 255, 255, .34), var(--kartu) 74%);
    }

    [data-tema="gelap"] .soon-depan {
      background: radial-gradient(120% 90% at 50% 45%,
          rgba(20, 22, 28, .42), var(--kartu) 78%);
    }

    .soon-dalam {
      max-width: 340px;
      width: 100%;
    }

    .soon-sel {
      animation: soonNyala 2.8s ease-in-out infinite;
    }

    .soon-sel b {
      text-shadow: 0 0 16px rgba(242, 112, 29, .55);
    }

    @keyframes soonNyala {

      0%,
      100% {
        box-shadow: 0 0 0 rgba(242, 112, 29, 0), var(--bayang-1);
      }

      50% {
        box-shadow: 0 0 20px rgba(242, 112, 29, .34), var(--bayang-1);
      }
    }

    .soon-tag {
      box-shadow: 0 0 18px rgba(242, 112, 29, .5);
    }

    /* ===== KELAS: segera dibuka ===== */
    .soon {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--orange);
      border-radius: 18px;
      padding: 30px 20px 26px;
      text-align: center;
      background: linear-gradient(160deg, var(--aksen-halus), var(--kartu) 62%);
      box-shadow: var(--bayang-2);
    }

    .soon::before {
      content: '';
      position: absolute;
      inset: -40% -20% auto;
      height: 190px;
      background: radial-gradient(closest-side, rgba(242, 112, 29, .20), transparent);
      pointer-events: none;
    }

    .soon-tag {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #fff;
      background: var(--orange);
      padding: 5px 13px;
      border-radius: 999px;
      margin-bottom: 15px;
    }

    .soon-tag i {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #fff;
      display: block;
      animation: soonKedip 1.6s ease-in-out infinite;
    }

    @keyframes soonKedip {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: .25;
      }
    }

    /* Judul di kartu ini tidak boleh memakai gaya judul panel yang punya
     garis oranye di kiri — garis itu ikut terhitung lebar, jadi teksnya
     tampak meleset dari tengah. */
    .soon h3,
    .soon-dalam h3 {
      position: relative;
      margin: 0 0 10px;
      display: block;
      width: 100%;
      padding: 0;
      font-family: var(--font-judul, var(--font-ui, inherit));
      font-size: clamp(19px, 5.6vw, 24px);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -.02em;
      color: var(--teks-isi);
      text-align: center;
      text-shadow: 0 0 26px rgba(242, 112, 29, .22);
    }

    /* Judul di sini memakai gaya sendiri, bukan gaya judul panel yang
     punya garis oranye di kiri — garis itu bikin teksnya tidak center. */
    .soon-dalam h3::before,
    .soon h3::before,
    .soon-dalam h3::after,
    .soon h3::after {
      content: none !important;
      display: none !important;
    }

    .soon-dalam {
      text-align: center;
    }

    .soon-dalam>p {
      margin: 0 auto 20px;
      max-width: 330px;
      font-size: 13px;
      line-height: 1.7;
      color: var(--slate-2);
      text-align: center;
    }

    .soon>p {
      position: relative;
      margin: 0 auto 20px;
      max-width: 330px;
      font-size: 13px;
      line-height: 1.7;
      color: var(--slate-2);
    }

    /* Empat kolom sama lebar, TIDAK boleh turun baris — di layar sempit
     ukurannya yang mengecil, bukan "Detik" yang menggantung sendirian. */
    .soon-jam {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 7px;
      margin-bottom: 20px;
    }

    .soon-sel {
      min-width: 0;
      background: var(--kartu);
      border: 1px solid var(--line);
      border-radius: 13px;
      padding: 11px 3px;
      box-shadow: var(--bayang-1);
    }

    .soon-sel b {
      display: block;
      font-family: var(--mono);
      line-height: 1.1;
      font-size: clamp(19px, 6.2vw, 25px);
      color: var(--orange-deep);
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }

    .soon-sel span {
      display: block;
      margin-top: 4px;
      letter-spacing: .05em;
      font-size: clamp(8px, 2.3vw, 9.5px);
      text-transform: uppercase;
      color: var(--gray);
      font-weight: 700;
    }

    .soon-tgl {
      position: relative;
      font-size: 12.5px;
      color: var(--teks-isi);
      background: var(--cream);
      border: 1px dashed var(--orange);
      border-radius: 11px;
      padding: 11px 14px;
      margin: 0 auto 17px;
      max-width: 330px;
      line-height: 1.6;
    }

    .soon-tgl b {
      color: var(--orange-deep);
    }

    .soon-aksi {
      position: relative;
    }

    .soon-nb {
      position: relative;
      margin: 15px auto 0;
      max-width: 330px;
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.6;
    }

    /* catatan bantuan grup */
    .grup-nb {
      margin: 9px 2px 0;
      font-size: 11.5px;
      line-height: 1.6;
      color: var(--gray);
    }

    .grup-nb b {
      color: var(--orange-deep);
    }

    /* ===== panel terkunci terpadu ===== */
    .lk-wrap {
      position: relative;
      display: grid;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--line);
      box-shadow: var(--bayang-1);
    }

    .lk-bg {
      grid-area: 1/1;
      filter: blur(9px) saturate(.7);
      opacity: .45;
      pointer-events: none;
      user-select: none;
      transform: scale(1.04);
      padding: 12px;
      max-height: 520px;
      overflow: hidden;
    }

    .lk-bg .lk-baris {
      display: flex;
      gap: 11px;
      align-items: center;
      margin-bottom: 11px;
    }

    .lk-bg .lk-thumb {
      width: 88px;
      height: 62px;
      border-radius: 9px;
      flex: 0 0 auto;
      background: var(--line);
      overflow: hidden;
    }

    .lk-bg .lk-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .lk-bg .lk-teks {
      flex: 1;
      min-width: 0;
    }

    .lk-bg .lk-bar {
      height: 13px;
      border-radius: 5px;
      background: var(--line);
      margin-bottom: 7px;
    }

    .lk-bg .lk-bar.w1 {
      width: 88%;
    }

    .lk-bg .lk-bar.w2 {
      width: 56%;
    }

    .lk-depan {
      grid-area: 1/1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 34px 20px;
      text-align: center;
      background: radial-gradient(120% 90% at 50% 50%,
          rgba(255, 255, 255, .42), var(--kartu) 72%);
    }

    [data-tema="gelap"] .lk-depan {
      background: radial-gradient(120% 90% at 50% 50%,
          rgba(20, 22, 28, .52), var(--kartu) 72%);
    }

    .lk-dalam {
      max-width: 330px;
      width: 100%;
    }

    .lk-gembok {
      width: 56px;
      height: 56px;
      border-radius: 18px;
      margin: 0 auto 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      background: var(--aksen-halus);
      border: 1px solid var(--orange-light);
      box-shadow: 0 6px 20px rgba(242, 112, 29, .18);
    }

    .lk-dalam h4 {
      margin: 0 0 8px;
      font-size: 17px;
      line-height: 1.3;
      color: var(--teks-isi);
      letter-spacing: -.01em;
    }

    .lk-dalam>p {
      margin: 0 0 16px;
      font-size: 12.5px;
      line-height: 1.7;
      color: var(--slate-2);
    }

    .lk-aksi {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .lk-nb {
      margin: 14px 0 0;
      font-size: 11.5px;
      line-height: 1.6;
      color: var(--gray);
    }

    /* ===== KONSULTASI ===== */
    .ks-step {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      margin-bottom: 13px;
    }

    .ks-step .n {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 800;
      background: var(--orange);
      color: #fff;
    }

    .ks-step p {
      margin: 0;
      font-size: 12.5px;
      line-height: 1.65;
      color: var(--teks-isi);
    }

    .ks-faq {
      border-top: 1px solid var(--line);
      margin-top: 15px;
      padding-top: 14px;
    }

    .ks-faq h5 {
      margin: 0 0 10px;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--gray);
    }

    .ks-faq dt {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--teks-isi);
      margin-top: 11px;
    }

    .ks-faq dt:first-child {
      margin-top: 0;
    }

    .ks-faq dd {
      margin: 4px 0 0;
      font-size: 12px;
      line-height: 1.65;
      color: var(--slate-2);
    }

    /* Kartu "Ajukan Konsultasi Bebas" — dibuat lebih tenang dan berkelas:
     garis tepi tipis, sorot oranye halus di sisi kiri, tanpa kotak ikon
     yang berat. Emoji diganti bentuk gambar supaya tidak terlihat murahan. */
    .ks-bebas {
      position: relative;
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 15px;
      border: 1px solid var(--line-2);
      border-radius: 16px;
      padding: 16px 17px 16px 19px;
      background: var(--kartu);
      cursor: pointer;
      overflow: hidden;
      box-shadow: var(--bayang-1);
      transition: border-color .2s ease, box-shadow .22s ease, transform .16s ease;
    }

    .ks-bebas::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, var(--orange), var(--orange-light));
    }

    .ks-bebas::after {
      content: '';
      position: absolute;
      right: -40px;
      top: -40px;
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--aksen-halus) 0%, transparent 70%);
      pointer-events: none;
    }

    .ks-bebas:hover {
      transform: translateY(-2px);
      border-color: var(--orange);
      box-shadow: var(--bayang-2);
    }

    .ks-bebas .ic {
      width: 38px;
      height: 38px;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
    }

    .ks-bebas .ic svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .ks-bebas .isi {
      flex: 1;
      min-width: 0;
      position: relative;
      z-index: 1;
    }

    .ks-bebas .tag {
      display: inline-block;
      font-size: 8.5px;
      font-weight: 800;
      letter-spacing: .7px;
      text-transform: uppercase;
      color: var(--orange-deep);
      background: var(--aksen-halus);
      padding: 2.5px 8px;
      border-radius: 999px;
      margin-bottom: 6px;
    }

    .ks-bebas b {
      display: block;
      font-size: 14px;
      font-weight: 800;
      color: var(--slate);
      margin-bottom: 3px;
      letter-spacing: -.1px;
    }

    .ks-bebas p {
      margin: 0;
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.6;
    }

    .ks-bebas .go {
      position: relative;
      z-index: 1;
      flex: 0 0 auto;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--line-2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 700;
      color: var(--orange-deep);
      transition: .18s;
    }

    .ks-bebas:hover .go {
      background: var(--orange);
      color: #fff;
      border-color: var(--orange);
      transform: translateX(2px);
    }

    /* Tombol pilih admin di dalam pop-up */
    .ks-adm-pilih {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 10px;
    }

    .ks-adm {
      display: block;
      width: 100%;
      text-align: left;
      font-family: inherit;
      border: 1px solid var(--line-2);
      background: var(--kartu);
      border-radius: 12px;
      padding: 11px 14px;
      cursor: pointer;
      transition: .16s;
    }

    .ks-adm:hover {
      border-color: var(--orange);
      background: var(--aksen-halus);
      transform: translateX(2px);
    }

    .ks-adm b {
      display: block;
      font-size: 13px;
      font-weight: 800;
      color: var(--slate);
      margin-bottom: 1px;
    }

    .ks-adm span {
      font-size: 11px;
      color: var(--gray);
      line-height: 1.5;
    }

    .ks-hari {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 18px 0 9px;
    }

    .ks-hari b {
      font-size: 13px;
      color: var(--slate);
      font-weight: 700;
    }

    .ks-hari .kini {
      font-size: 9.5px;
      font-weight: 800;
      background: var(--orange);
      color: #fff;
      padding: 2px 9px;
      border-radius: 999px;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .ks-grup:first-child .ks-hari {
      margin-top: 0;
    }

    .ks-slot {
      display: flex;
      align-items: center;
      gap: 13px;
      width: 100%;
      text-align: left;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--kartu);
      padding: 13px 14px;
      margin-bottom: 10px;
      cursor: pointer;
      font-family: inherit;
      box-shadow: var(--bayang-1);
      transition: transform .16s ease, box-shadow .2s ease, border-color .18s ease;
    }

    .ks-slot:hover:not(.mati) {
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
      border-color: var(--orange);
    }

    .ks-slot.mati {
      opacity: .5;
      cursor: default;
    }

    .ks-jam {
      flex: 0 0 auto;
      text-align: center;
      min-width: 62px;
    }

    .ks-jam b {
      display: block;
      font-family: var(--mono);
      font-size: 15.5px;
      color: var(--teks-isi);
      font-weight: 800;
      letter-spacing: -.01em;
    }

    .ks-jam span {
      display: block;
      font-size: 10.5px;
      color: var(--gray);
      margin-top: 2px;
    }

    .ks-isi {
      flex: 1;
      min-width: 0;
    }

    .ks-isi b {
      display: block;
      font-size: 13.5px;
      color: var(--teks-isi);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ks-isi p {
      margin: 2px 0 0;
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.5;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ks-pita {
      display: inline-block;
      font-size: 9.5px;
      font-weight: 800;
      letter-spacing: .05em;
      text-transform: uppercase;
      padding: 3px 9px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .ks-pita.ada {
      background: #DCFCE7;
      color: #15803D;
    }

    .ks-pita.penuh {
      background: #FEE2E2;
      color: #B91C1C;
    }

    .ks-pita.penuh .siapa {
      display: block;
      font-size: 9px;
      font-weight: 600;
      opacity: .85;
      margin-top: 1px;
      max-width: 92px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ks-pita.gelap {
      background: var(--cream);
      color: var(--gray);
    }

    .ks-pita.ajukan {
      background: var(--aksen-halus);
      color: var(--orange-deep);
    }

    .ks-pita.eks {
      background: #FEF3C7;
      color: #92400E;
      margin-left: 6px;
    }

    .ks-beta {
      display: flex;
      gap: 11px;
      align-items: flex-start;
      border: 1px dashed var(--orange);
      border-radius: 12px;
      padding: 12px 14px;
      background: var(--aksen-halus);
      margin-bottom: 15px;
    }

    .ks-beta .ic {
      font-size: 17px;
      flex: 0 0 auto;
    }

    .ks-beta p {
      margin: 0;
      font-size: 11.5px;
      line-height: 1.65;
      color: var(--slate-2);
    }

    .ks-detail {
      border: 1.5px solid var(--orange);
      border-radius: 16px;
      padding: 17px;
      background: linear-gradient(150deg, var(--aksen-halus), var(--kartu) 70%);
    }

    .ks-detail h4 {
      margin: 0 0 4px;
      font-size: 17px;
      color: var(--teks-isi);
    }

    .ks-detail .wkt {
      font-size: 12.5px;
      color: var(--slate-2);
      margin-bottom: 13px;
    }

    .ks-baris {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      font-size: 12.5px;
      padding: 8px 0;
      border-top: 1px solid var(--line);
    }

    .ks-baris span {
      color: var(--gray);
    }

    .ks-baris b {
      color: var(--teks-isi);
      text-align: right;
    }

    /* ===== FNC CHALLENGE ===== */
    .ch-hero {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--orange);
      border-radius: 18px;
      padding: 30px 20px 26px;
      text-align: center;
      background: linear-gradient(160deg, var(--aksen-halus), var(--kartu) 62%);
      box-shadow: var(--bayang-2);
    }

    .ch-hero::before {
      content: '';
      position: absolute;
      inset: -40% -20% auto;
      height: 200px;
      background: radial-gradient(closest-side, rgba(242, 112, 29, .22), transparent);
      pointer-events: none;
    }

    .ch-tag {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #fff;
      background: var(--orange);
      padding: 5px 13px;
      border-radius: 999px;
      margin-bottom: 15px;
      box-shadow: 0 0 18px rgba(242, 112, 29, .5);
    }

    .ch-tag i {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #fff;
      display: block;
      animation: soonKedip 1.6s ease-in-out infinite;
    }

    .ch-hero h3 {
      position: relative;
      margin: 0 0 10px;
      display: block;
      width: 100%;
      padding: 0;
      font-size: clamp(21px, 6.2vw, 27px);
      line-height: 1.15;
      font-weight: 800;
      letter-spacing: -.02em;
      color: var(--teks-isi);
      text-align: center;
      text-shadow: 0 0 26px rgba(242, 112, 29, .24);
    }

    .ch-hero h3::before {
      content: none;
    }

    .ch-hero>p {
      position: relative;
      margin: 0 auto;
      max-width: 340px;
      font-size: 13px;
      line-height: 1.7;
      color: var(--slate-2);
    }

    .ch-lbl {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--gray);
      margin: 22px 0 11px;
    }

    .ch-list {
      display: grid;
      gap: 10px;
    }

    .ch-item {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--kartu);
      padding: 13px 14px;
      box-shadow: var(--bayang-1);
    }

    .ch-ic {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      background: var(--aksen-halus);
      border: 1px solid var(--orange-light);
    }

    .ch-item b {
      display: block;
      font-size: 13.5px;
      color: var(--teks-isi);
      margin-bottom: 3px;
    }

    .ch-item p {
      margin: 0;
      font-size: 12px;
      color: var(--gray);
      line-height: 1.6;
    }

    .ch-nb {
      margin-top: 16px;
      font-size: 11.5px;
      line-height: 1.7;
      color: var(--gray);
      background: var(--cream);
      border-radius: 12px;
      padding: 12px 14px;
    }

    /* ===== KELAS ===== */
    .kls-kartu {
      border: 1px solid var(--line);
      border-radius: 16px;
      overflow: hidden;
      background: var(--kartu);
      box-shadow: var(--bayang-1);
      margin-bottom: 14px;
      cursor: pointer;
      transition: transform .18s ease, box-shadow .22s ease, border-color .22s ease;
    }

    .kls-kartu:hover {
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
      border-color: var(--orange);
    }

    .kls-gbr {
      width: 100%;
      aspect-ratio: 16/10;
      object-fit: cover;
      display: block;
      background: var(--cream);
    }

    .kls-gbr.ph {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
    }

    .kls-isi {
      padding: 14px 15px;
    }

    .kls-isi h4 {
      margin: 0 0 5px;
      font-size: 14.5px;
      line-height: 1.4;
      color: var(--teks-isi);
    }

    .kls-isi p {
      margin: 0 0 11px;
      font-size: 12px;
      color: var(--gray);
      line-height: 1.55;
    }

    .kls-harga {
      display: flex;
      align-items: baseline;
      gap: 9px;
      flex-wrap: wrap;
    }

    .kls-harga b {
      font-size: 17px;
      color: var(--orange-deep);
      font-weight: 800;
    }

    .kls-harga s {
      font-size: 12px;
      color: var(--gray);
    }

    .kls-hemat {
      font-size: 10.5px;
      font-weight: 700;
      background: var(--loss);
      color: #fff;
      padding: 2px 8px;
      border-radius: 999px;
    }

    .kls-stok {
      font-size: 11px;
      color: var(--gray);
      margin-top: 7px;
    }

    .kls-stok.tipis {
      color: var(--loss);
      font-weight: 700;
    }

    .kls-stok.habis {
      color: var(--gray);
      font-weight: 700;
    }

    .kls-detail .kls-gbr {
      aspect-ratio: 16/10;
      border-radius: 14px;
      margin-bottom: 14px;
    }

    .kls-detail h3 {
      margin: 0 0 8px;
      font-size: 18px;
      line-height: 1.35;
      color: var(--teks-isi);
      letter-spacing: -.01em;
    }

    .kls-desk {
      font-size: 13px;
      line-height: 1.75;
      color: var(--teks-isi);
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .kls-desk b {
      font-weight: 800;
      color: var(--slate);
    }

    .kls-desk ul,
    .kls-desk ol {
      margin: 8px 0;
      padding-left: 21px;
    }

    .kls-desk li {
      margin: 3px 0;
    }

    .kls-desk blockquote {
      margin: 8px 0;
      padding-left: 11px;
      border-left: 3px solid var(--orange-light);
      color: var(--gray);
    }

    .kls-desk code {
      background: var(--cream);
      padding: 1px 5px;
      border-radius: 4px;
      font-size: 12px;
    }

    .kls-desk a {
      color: var(--orange-deep);
    }

    .fi-bagi {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      margin-top: 11px;
      padding-top: 10px;
      padding-left: 96px;
      border-top: 1px solid var(--line-2);
      min-height: 30px;
    }

    .fi-bagi button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 5px 13px;
      cursor: pointer;
      font-family: inherit;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--gray);
      transition: border-color .15s, color .15s;
    }

    .fi-bagi button:hover {
      border-color: var(--orange);
      color: var(--orange-deep);
    }

    .feed-item.disorot {
      border-color: var(--orange);
      box-shadow: 0 0 0 3px var(--aksen-halus), var(--bayang-2);
    }

    .kls-beli {
      position: sticky;
      bottom: 0;
      padding: 13px 0 4px;
      margin-top: 16px;
      background: linear-gradient(to top, var(--kartu) 72%, transparent);
      display: flex;
      gap: 9px;
      align-items: stretch;
    }

    .kls-beli .btn {
      flex: 1;
    }

    .kls-beli .bagi {
      flex: 0 0 auto;
      width: 46px;
      padding: 0;
      font-size: 17px;
    }

    /* pop-up pembayaran */
    .byr-opsi {
      display: flex;
      align-items: center;
      gap: 13px;
      width: 100%;
      text-align: left;
      border: 1.5px solid var(--line);
      border-radius: 14px;
      background: var(--kartu);
      padding: 11px 13px;
      margin-bottom: 10px;
      cursor: pointer;
      font-family: inherit;
      box-shadow: var(--bayang-1);
      transition: border-color .16s ease, transform .16s ease, box-shadow .18s ease;
    }

    .byr-opsi:hover {
      border-color: var(--orange);
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
    }

    /* Kotak logo: putih supaya logo merek apa pun tetap terbaca,
     baik di mode terang maupun gelap. */
    .byr-ic {
      width: 56px;
      height: 38px;
      border-radius: 9px;
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, .08);
      padding: 5px;
    }

    .byr-ic img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      display: block;
    }

    /* Tampilan cadangan kalau logo belum di-upload dari admin. */
    .byr-wm {
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: -.02em;
      line-height: 1;
      font-family: var(--font-ui, inherit);
    }

    .byr-wm.bca {
      color: #0060AF;
    }

    .byr-wm.gopay {
      color: #00AAD2;
    }

    .byr-wm.dana {
      color: #108EE9;
    }

    .byr-wm.qris {
      color: #111;
      letter-spacing: .06em;
      font-size: 11px;
    }

    .byr-opsi b {
      display: block;
      font-size: 13.5px;
      color: var(--teks-isi);
    }

    .byr-opsi span {
      display: block;
      font-size: 11.5px;
      color: var(--gray);
      margin-top: 1px;
    }

    .byr-nomor {
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1px dashed var(--orange);
      border-radius: 12px;
      padding: 13px 14px;
      background: var(--aksen-halus);
      margin: 13px 0;
    }

    .byr-nomor .no {
      flex: 1;
      min-width: 0;
    }

    .byr-nomor .no b {
      display: block;
      font-family: var(--mono);
      font-size: 17px;
      color: var(--teks-isi);
      letter-spacing: .02em;
      word-break: break-all;
    }

    .byr-nomor .no span {
      display: block;
      font-size: 11.5px;
      color: var(--gray);
      margin-top: 3px;
    }

    .byr-ingat {
      font-size: 12px;
      line-height: 1.65;
      color: var(--slate-2);
      background: var(--cream);
      border-radius: 11px;
      padding: 11px 13px;
      margin: 12px 0;
    }

    .byr-total {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 12.5px;
      color: var(--gray);
      border-top: 1px solid var(--line);
      padding-top: 11px;
      margin-top: 3px;
    }

    .byr-total b {
      font-size: 16px;
      color: var(--orange-deep);
    }

    /* ===== KALENDER EKONOMI ===== */
    /* saringan dampak — tiap level memakai warnanya sendiri supaya
     tombolnya sekaligus jadi keterangan warna, bukan sederet oranye */
    .kal-filter {
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
      margin: 3px 0 14px;
    }

    .kal-tgl {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
      align-items: center;
      margin: 3px 0 12px;
    }

    .kal-tgl .lbl {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--gray);
      margin-right: 1px;
    }

    .kal-tgl select {
      padding: 6px 10px;
      font-size: 12px;
      border-radius: 9px;
      border: 1.5px solid var(--line);
      background: var(--kartu);
      color: var(--teks-isi);
      font-family: inherit;
      cursor: pointer;
    }

    .kal-tgl select:focus {
      border-color: var(--orange);
      outline: none;
    }

    .kal-lalu {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 14px 0 0;
      border: 1px dashed var(--line);
      border-radius: 11px;
      padding: 9px 12px;
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.55;
    }

    .kal-lalu button {
      margin-left: auto;
      flex: 0 0 auto;
    }

    .kal-filter .lbl {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--gray);
      margin-right: 1px;
    }

    .kdc {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      border: 1.5px solid var(--line);
      background: var(--kartu);
      color: var(--slate-2);
      border-radius: 20px;
      padding: 6px 13px;
      font-size: 12px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: var(--bayang-1);
      transition: all .16s;
    }

    .kdc:hover {
      transform: translateY(-1px);
    }

    .kdc i {
      width: 3px;
      height: 10px;
      border-radius: 1px;
      display: block;
      background: var(--line);
    }

    .kdc i:last-of-type {
      margin-right: 7px;
    }

    .kdc.d1 i:nth-of-type(1) {
      background: var(--gray);
    }

    .kdc.d2 i:nth-of-type(-n+2) {
      background: #EAB308;
    }

    .kdc.d3 i {
      background: var(--loss);
    }

    .kdc.all.on {
      background: var(--orange);
      border-color: var(--orange);
      color: #fff;
      box-shadow: 0 3px 12px rgba(242, 112, 29, .3);
    }

    .kdc.d3.on {
      background: var(--loss);
      border-color: var(--loss);
      color: #fff;
    }

    .kdc.d2.on {
      background: #D99B07;
      border-color: #D99B07;
      color: #fff;
    }

    .kdc.d1.on {
      background: var(--slate-2);
      border-color: var(--slate-2);
      color: #fff;
    }

    .kdc.on i {
      background: rgba(255, 255, 255, .85);
    }

    /* pemisah tanggal di dalam tabel, seperti kalender ekonomi pada umumnya */
    .kal-band {
      background: var(--cream);
      border-bottom: 1px solid var(--line);
      padding: 9px 12px;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--slate);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
    }

    .kal-band .kini {
      font-size: 9.5px;
      font-weight: 700;
      background: var(--orange);
      color: #fff;
      padding: 2px 8px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    .kal-tbl {
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
      background: var(--kartu);
      box-shadow: var(--bayang-1);
    }

    .kal-baris {
      display: grid;
      grid-template-columns: 46px 38px 22px minmax(0, 1fr);
      gap: 9px;
      padding: 10px 11px;
      border-bottom: 1px solid var(--line-2);
      align-items: start;
    }

    .kal-baris:last-child {
      border-bottom: none;
    }

    .kal-baris.tinggi {
      background: var(--aksen-halus);
    }

    .kal-jam {
      font-family: var(--mono);
      font-size: 11.5px;
      color: var(--gray);
      padding-top: 2px;
    }

    .kal-neg {
      font-size: 11px;
      font-weight: 700;
      color: var(--slate-2);
      padding-top: 2px;
      letter-spacing: .02em;
    }

    .kal-dmp {
      display: flex;
      gap: 2px;
      padding-top: 4px;
    }

    .kal-dmp i {
      width: 4px;
      height: 12px;
      border-radius: 1px;
      background: var(--line);
      display: block;
    }

    .kal-dmp.d1 i:nth-child(1) {
      background: var(--gray);
    }

    .kal-dmp.d2 i:nth-child(-n+2) {
      background: #EAB308;
    }

    .kal-dmp.d3 i {
      background: var(--loss);
    }

    .kal-nama {
      font-size: 13px;
      color: var(--teks-isi);
      line-height: 1.5;
      word-break: break-word;
    }

    .kal-ang {
      font-size: 11.5px;
      color: var(--gray);
      margin-top: 3px;
    }

    .kal-ang b {
      font-weight: 700;
      color: var(--slate-2);
    }

    .kal-ang b.naik {
      color: var(--win);
    }

    .kal-ang b.turun {
      color: var(--loss);
    }

    .kal-cat {
      font-size: 11.5px;
      color: var(--orange-deep);
      margin-top: 5px;
      line-height: 1.5;
    }

    .kal-bar {
      height: 11px;
      border-radius: 4px;
      background: var(--line);
      filter: blur(2.5px);
    }

    .kal-cta {
      margin-top: 15px;
      text-align: center;
    }

    .kal-cta p {
      font-size: 12.5px;
      color: var(--gray);
      margin: 0 0 10px;
      line-height: 1.6;
    }

    .seg {
      display: flex;
      width: 100%;
      background: var(--cream);
      border-radius: 10px;
      padding: 4px;
      gap: 4px;
      margin-bottom: 15px;
      border: 1px solid var(--orange-light);
    }

    .seg-btn {
      flex: 1;
      background: none;
      border: none;
      font-family: inherit;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--orange-deep);
      padding: 8px 14px;
      border-radius: 7px;
      cursor: pointer;
      text-align: center;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      white-space: nowrap;
      transition: background .2s ease, color .2s ease, box-shadow .2s ease, transform .14s ease;
    }

    .seg-btn:hover:not(.active) {
      transform: translateY(-1px);
    }

    .seg-btn.active {
      background: var(--kartu);
      color: var(--slate);
      box-shadow: 0 2px 7px rgba(0, 0, 0, .09);
    }

    .lock-box {
      text-align: center;
      padding: 34px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .lock-ico {
      font-size: 34px;
      margin-bottom: 11px;
      animation: popIn .5s cubic-bezier(.22, .8, .3, 1) both;
    }

    .lock-row {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .lock-row input {
      background: var(--kartu);
      border: 1.5px solid var(--line);
      border-radius: 8px;
      padding: 10px 13px;
      font-family: var(--mono);
      font-size: 14px;
      letter-spacing: .1em;
      text-align: center;
      min-width: 210px;
      transition: border-color .18s, box-shadow .18s;
    }

    .lock-row input:focus {
      outline: none;
      border-color: var(--orange);
      box-shadow: 0 0 0 3.5px rgba(242, 112, 29, .14);
    }

    .lock-err {
      margin-top: 11px;
      color: #B91C1C;
      font-size: 12.5px;
      animation: slideDown .25s ease both;
    }

    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(17, 24, 39, .93);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      animation: fadeIn .2s ease both;
      cursor: zoom-out;
    }

    .lightbox img {
      max-width: 100%;
      max-height: 100%;
      border-radius: 9px;
      animation: popIn .3s cubic-bezier(.22, .8, .3, 1) both;
    }

    .lightbox .lb-x {
      position: absolute;
      top: 16px;
      right: 20px;
      color: #fff;
      font-size: 30px;
      background: none;
      border: none;
      cursor: pointer;
      line-height: 1;
      opacity: .8;
    }

    .lightbox .lb-x:hover {
      opacity: 1;
    }

    .foot {
      text-align: center;
      padding: 16px;
      font-size: 11.5px;
      color: var(--gray);
      border-top: 1px solid var(--line);
    }

    .foot a {
      color: var(--orange-deep);
      text-decoration: none;
      font-weight: 600;
    }

    /* ===== v2: tier, profil, beranda, watermark ===== */
    .tier-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .tier-chip.priv {
      background: rgba(255, 255, 255, .14);
      color: #fde9d7;
    }

    .tier-chip.eks {
      background: var(--orange);
      color: #fff;
    }

    .hero {
      background: linear-gradient(135deg, #232F3E 0%, #1A2430 55%, #161F2A 100%);
      color: #fff;
      border-radius: 18px;
      padding: 22px 22px 20px;
      margin-bottom: 15px;
      position: relative;
      overflow: hidden;
      box-shadow: var(--bayang-2);
    }

    .hero::after {
      content: '';
      position: absolute;
      right: -70px;
      bottom: -110px;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(242, 112, 29, .26), transparent 66%);
      pointer-events: none;
    }

    .hero>* {
      position: relative;
      z-index: 1;
    }

    .hero h2 {
      margin: 0 0 3px;
      font-size: 19px;
      color: #fff;
      font-weight: 700;
    }

    .hero p {
      margin: 0;
      font-size: 12.5px;
      color: #b6c0cc;
      line-height: 1.6;
    }

    .hero-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .hero-cta {
      margin-top: 13px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .home-sec {
      margin-bottom: 18px;
    }

    @media(min-width:1000px) {
      .beranda-grid {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 18px;
        align-items: start;
      }

      .beranda-grid .kanan {
        position: sticky;
        top: 74px;
      }
    }

    .home-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 9px;
    }

    .home-head h3 {
      margin: 0;
      font-size: 13px;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--slate);
    }

    .home-head a {
      font-size: 12px;
      color: var(--orange-deep);
      cursor: pointer;
      font-weight: 600;
    }

    .home-card {
      background: var(--kartu);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 12px 13px;
      margin-bottom: 9px;
      cursor: pointer;
      box-shadow: var(--bayang-1);
      transition: border-color .2s, transform .2s, box-shadow .2s;
      display: flex;
      gap: 13px;
      align-items: flex-start;
    }

    .home-card:hover {
      border-color: var(--orange);
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
    }

    .home-card:active {
      transform: translateY(0);
    }

    .home-card .hc-top {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 6px;
      flex-wrap: wrap;
    }

    .home-card h4 {
      margin: 0;
      font-size: 14px;
      color: var(--slate);
      line-height: 1.42;
      font-weight: 700;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Thumbnail kecil: pakai cover supaya bingkainya terisi penuh tanpa celah.
     Yang terpotong hanya tepi atas & bawah; gambar utuh tetap bisa dilihat
     saat kirimannya dibuka. */
    .hc-thumb {
      flex: 0 0 124px;
      width: 124px;
      aspect-ratio: 16/9;
      border-radius: 8px;
      overflow: hidden;
      background: #F1EEE7;
      position: relative;
    }

    .hc-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .hc-thumb .ph {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #E8E3D8, #F3EFE6);
      font-size: 19px;
      opacity: .5;
    }

    .hc-thumb.blur img,
    .hc-thumb.blur .ph {
      filter: blur(7px);
      transform: scale(1.12);
    }

    .hc-thumb .lk-mini {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(31, 41, 55, .28);
      font-size: 17px;
    }

    .hc-body {
      flex: 1;
      min-width: 0;
    }

    .hc-lockrow {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      color: var(--orange-deep);
      font-weight: 600;
      margin-top: 5px;
    }

    @media(max-width:460px) {
      .hc-thumb {
        flex: 0 0 96px;
        width: 96px;
      }
    }

    /* ===== penyesuaian layar besar ===== */
    @media(min-width:1220px) {
      .top {
        padding: 20px 30px;
      }

      .tabs {
        padding: 11px 26px;
      }

      .view {
        padding: 22px 30px 30px;
      }

      .hero {
        padding: 28px 30px 26px;
      }

      .hero h2 {
        font-size: 23px;
      }

      .fi-thumb {
        flex: 0 0 128px;
        width: 128px;
      }

      .fi-info h4 {
        font-size: 15.5px;
      }

      .feed-body {
        font-size: 14px;
      }
    }

    /* ===== penyesuaian HP ===== */
    @media(max-width:560px) {
      .top {
        padding: 13px 15px;
      }

      .tabs {
        padding: 8px 10px;
      }

      .tab {
        padding: 8px 13px;
        font-size: 12.5px;
      }

      .view {
        padding: 15px 14px 26px;
      }

      .hero {
        padding: 18px 17px 17px;
        border-radius: 16px;
      }

      .hero h2 {
        font-size: 17.5px;
      }

      .hero p {
        font-size: 12px;
      }

      .panel {
        padding: 14px 14px;
        border-radius: 14px;
      }

      .fi-head {
        padding: 12px 12px;
        gap: 11px;
        align-items: center;
      }

      .fi-thumb {
        flex: 0 0 88px;
        width: 88px;
      }

      .fi-info h4 {
        font-size: 13.5px;
        line-height: 1.38;
        -webkit-line-clamp: 3;
      }

      .fi-chev {
        align-self: center;
      }

      .mini b {
        font-size: 17px;
      }

      .pintas {
        grid-template-columns: 1fr 1fr;
      }

      .pintas a {
        padding: 12px;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }

      .pintas .tx span {
        display: none;
      }
    }

    .hc-src {
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: 20px;
      background: var(--cream);
      color: var(--orange-deep);
    }

    .hc-src.eks {
      background: #FEF3C7;
      color: #92400E;
    }

    .hc-src.an {
      background: #E0F2FE;
      color: #075985;
    }

    .hc-date {
      font-size: 11px;
      color: var(--gray);
      margin-left: auto;
    }

    /* ===== ringkasan jurnal ===== */
    .mini-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(104px, 1fr));
      gap: 10px;
    }

    .mini {
      background: var(--kartu);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px 15px;
      box-shadow: var(--bayang-1);
      position: relative;
      overflow: hidden;
      transition: transform .2s, box-shadow .2s;
    }

    .mini:hover {
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
    }

    .mini::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--orange);
      opacity: .55;
    }

    .mini span {
      display: block;
      font-size: 9.5px;
      color: var(--gray);
      letter-spacing: .07em;
      text-transform: uppercase;
      margin-bottom: 5px;
      font-weight: 700;
    }

    .mini b {
      font-size: 20px;
      color: var(--slate);
      font-weight: 700;
      letter-spacing: -.01em;
    }

    /* ===== pintasan cepat di bawah beranda ===== */
    .pintas {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(146px, 1fr));
      gap: 10px;
    }

    .pintas a {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 14px 15px;
      border-radius: 14px;
      background: var(--kartu);
      border: 1px solid var(--line);
      cursor: pointer;
      text-decoration: none;
      box-shadow: var(--bayang-1);
      transition: transform .2s, box-shadow .2s, border-color .2s;
    }

    .pintas a:hover {
      transform: translateY(-2px);
      box-shadow: var(--bayang-2);
      border-color: var(--orange);
    }

    .pintas a:active {
      transform: translateY(0);
    }

    .pintas .ik {
      flex: 0 0 38px;
      width: 38px;
      height: 38px;
      border-radius: 11px;
      background: var(--aksen-halus);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
    }

    .pintas .tx b {
      display: block;
      font-size: 13.5px;
      color: var(--slate);
      margin-bottom: 1px;
    }

    .pintas .tx span {
      display: block;
      font-size: 11.5px;
      color: var(--gray);
      line-height: 1.45;
    }

    /* ===== catatan penutup beranda ===== */
    .tutup {
      text-align: center;
      padding: 20px 16px 6px;
      color: var(--gray);
      font-size: 11.5px;
      line-height: 1.7;
    }

    .tutup .garis {
      width: 44px;
      height: 2px;
      background: var(--orange);
      opacity: .5;
      border-radius: 2px;
      margin: 0 auto 12px;
    }

    .upsell {
      background: linear-gradient(135deg, #FFF7ED, #FFEDD5);
      border: 1px dashed var(--orange);
      border-radius: 12px;
      padding: 16px;
      text-align: center;
    }

    .upsell h4 {
      margin: 0 0 5px;
      font-size: 14.5px;
      color: var(--orange-deep);
    }

    .upsell p {
      margin: 0 0 11px;
      font-size: 12.5px;
      color: var(--slate-2);
      line-height: 1.6;
    }

    .tab .lockdot {
      font-size: 9px;
      opacity: .75;
      margin-left: 3px;
    }

    /* watermark halus */
    /* Penanda kode ditaruh di kiri bawah supaya tidak bertabrakan dengan
     tombol Bagikan yang rata kanan. Berlaku di HP maupun laptop. */
    .wm-tag {
      position: absolute;
      left: 14px;
      bottom: 9px;
      font-size: 9.5px;
      letter-spacing: .13em;
      color: var(--gray);
      opacity: .34;
      pointer-events: none;
      user-select: none;
      font-family: var(--mono, monospace);
    }

    .wm-field {
      position: absolute;
      inset: 0;
      pointer-events: none;
      user-select: none;
      overflow: hidden;
      display: flex;
      flex-wrap: wrap;
      align-content: center;
      justify-content: center;
      gap: 26px 34px;
      transform: rotate(-21deg) scale(1.35);
      opacity: .033;
    }

    .wm-field span {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .2em;
      color: #1F2937;
      white-space: nowrap;
    }

    #analisa-list .feed-item,
    #news-list .feed-item {
      position: relative;
    }

    /* profil */
    .prof-card {
      background: var(--kartu);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 14px;
    }

    .prof-row {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .prof-av {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: var(--orange);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
      font-weight: 700;
      flex: 0 0 auto;
    }

    .prof-meta b {
      display: block;
      font-size: 15px;
      color: var(--slate);
    }

    .prof-meta span {
      display: block;
      font-size: 11.5px;
      color: var(--gray);
      letter-spacing: .06em;
      margin-top: 2px;
    }

    /* ===== v3: terkunci-buram, media, materi, animasi ===== */
    .lk-img {
      width: 100%;
      aspect-ratio: 16/9;
      overflow: hidden;
      background: var(--cream);
      position: relative;
      display: block;
    }

    .lk-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: blur(15px) saturate(1.15);
      transform: scale(1.22);
    }

    .lk-img .noimg {
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #DED8CB, #EFEAE0, #E4DED1);
    }

    .lk-veil {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 7px;
      text-align: center;
      padding: 16px;
      background: linear-gradient(180deg, rgba(31, 41, 55, .30), rgba(31, 41, 55, .52));
    }

    .lk-veil .ic {
      font-size: 26px;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .4));
    }

    .lk-veil b {
      font-size: 13px;
      color: #fff;
      text-shadow: 0 1px 6px rgba(0, 0, 0, .5);
    }

    .lk-veil span {
      font-size: 11.5px;
      color: #e7ebf0;
      text-shadow: 0 1px 5px rgba(0, 0, 0, .5);
    }

    .lk-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 10px 14px 12px;
      flex-wrap: wrap;
    }

    /* ===== AI Agent (WhatsApp) ===== */
    .ai-card {
      background: linear-gradient(135deg, #0B5F4A, #12886A);
      border-radius: 14px;
      padding: 16px 17px;
      margin-bottom: 16px;
      display: flex;
      gap: 13px;
      align-items: flex-start;
      cursor: pointer;
      transition: transform .14s, box-shadow .18s;
    }

    .ai-card:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(11, 95, 74, .28);
    }

    .ai-ic {
      flex: 0 0 40px;
      width: 40px;
      height: 40px;
      border-radius: 11px;
      background: rgba(255, 255, 255, .16);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .ai-card b {
      display: block;
      font-size: 14.5px;
      color: #fff;
      margin-bottom: 3px;
    }

    .ai-card p {
      margin: 0;
      font-size: 12.5px;
      color: #c8e6da;
      line-height: 1.6;
    }

    .ai-card .go {
      margin-top: 10px;
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      padding: 7px 14px;
      border-radius: 20px;
      background: #fff;
      color: #0B5F4A;
    }

    .ai-fab {
      position: fixed;
      right: 16px;
      bottom: 16px;
      z-index: 60;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 11px 16px 11px 13px;
      border-radius: 30px;
      background: linear-gradient(135deg, #0B5F4A, #12886A);
      color: #fff;
      border: none;
      cursor: pointer;
      box-shadow: 0 5px 18px rgba(0, 0, 0, .24);
      font-size: 13px;
      font-weight: 700;
      font-family: inherit;
      transition: transform .14s, box-shadow .18s;
    }

    .ai-fab:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .3);
    }

    .ai-fab .wa {
      font-size: 17px;
      line-height: 1;
    }

    .ai-fab .lbl {
      white-space: nowrap;
    }

    @media(max-width:520px) {
      .ai-fab {
        right: 12px;
        bottom: 12px;
        padding: 11px 14px;
      }

      .ai-fab .lbl {
        display: none;
      }
    }

    .shell.locked~.ai-fab {
      display: none;
    }

    /* ===== permukaan kaca =====
     Kalau browser tidak mendukung blur, otomatis memakai warna solid
     supaya tampilan tetap rapi dan teks tetap terbaca. */
    .kaca {
      background: var(--kartu);
      border: 1px solid var(--line);
    }

    @supports ((backdrop-filter:blur(2px)) or (-webkit-backdrop-filter:blur(2px))) {
      .kaca {
        background: var(--kaca);
        border-color: var(--kaca-tepi);
        -webkit-backdrop-filter: blur(var(--kaca-blur)) saturate(150%);
        backdrop-filter: blur(var(--kaca-blur)) saturate(150%);
      }
    }

    /* Perangkat kecil / hemat daya: blur dikurangi supaya gulir tetap mulus. */
    @media(max-width:640px) {
      :root {
        --kaca-blur: 9px;
      }
    }

    @media(prefers-reduced-motion:reduce) {
      :root {
        --kaca-blur: 0px;
      }
    }

    /* penyesuaian komponen saat mode gelap */
    html[data-tema="gelap"] .shell {
      box-shadow: 0 0 50px rgba(0, 0, 0, .5);
    }

    html[data-tema="gelap"] .top {
      background: #0F0F0F;
    }

    html[data-tema="gelap"] .tabs {
      background: #181818;
    }

    html[data-tema="gelap"] h1,
    html[data-tema="gelap"] h2,
    html[data-tema="gelap"] h3,
    html[data-tema="gelap"] h4 {
      text-shadow: var(--glow);
    }

    html[data-tema="gelap"] .brand h1 {
      text-shadow: var(--glow-kuat);
    }

    html[data-tema="gelap"] .tab.active {
      text-shadow: var(--glow-kuat);
    }

    /* Glow sengaja TIDAK dipakai pada paragraf panjang — efeknya membuat
     teks berkabut dan susah dibaca. Hanya judul yang diberi cahaya. */
    html[data-tema="gelap"] .fi-info h4 {
      text-shadow: var(--glow);
    }

    html[data-tema="gelap"] .feed-body {
      text-shadow: none;
    }

    html[data-tema="gelap"] .feed-body i,
    html[data-tema="gelap"] .feed-body em {
      color: #EDEDED;
    }

    html[data-tema="gelap"] .feed-body b,
    html[data-tema="gelap"] .feed-body strong {
      color: #FFFFFF;
    }

    html[data-tema="gelap"] .feed-body a {
      color: #FDBA74;
    }

    html[data-tema="gelap"] .wa-q {
      color: #C4C4C4;
    }

    html[data-tema="gelap"] .home-card p,
    html[data-tema="gelap"] .fi-info h4 {
      color: var(--slate);
    }

    html[data-tema="gelap"] .feed-date,
    html[data-tema="gelap"] .hc-date {
      color: #9A9A9A;
    }

    html[data-tema="gelap"] .pill.be {
      background: #333333;
      color: #C4C4C4;
    }

    /* label & kotak berwarna: versi gelap */
    html[data-tema="gelap"] .pill.win {
      background: #14351F;
      color: #86EFAC;
    }

    html[data-tema="gelap"] .pill.loss {
      background: #3A1717;
      color: #FCA5A5;
    }

    html[data-tema="gelap"] .feed-tag {
      background: #303030;
      color: #C4C4C4;
    }

    html[data-tema="gelap"] .feed-tag.bull {
      background: #14351F;
      color: #86EFAC;
    }

    html[data-tema="gelap"] .feed-tag.bear {
      background: #3A1717;
      color: #FCA5A5;
    }

    html[data-tema="gelap"] .feed-tag.neu {
      background: #303030;
      color: #C4C4C4;
    }

    html[data-tema="gelap"] .hc-src {
      background: #303030;
      color: #E2C4A8;
    }

    html[data-tema="gelap"] .hc-src.eks {
      background: #3A2C0E;
      color: #FCD34D;
    }

    html[data-tema="gelap"] .hc-src.an {
      background: #122E42;
      color: #A8D8F5;
    }

    html[data-tema="gelap"] .mat-kind.pdf {
      background: #3A1717;
      color: #FCA5A5;
    }

    html[data-tema="gelap"] .mat-kind.slide {
      background: #3A2C0E;
      color: #FCD34D;
    }

    html[data-tema="gelap"] .mat-kind.video {
      background: #1D2151;
      color: #C7CDFF;
    }

    html[data-tema="gelap"] .gate-err {
      background: #2A1414;
      color: #FCA5A5;
    }

    html[data-tema="gelap"] .calc-out.muted {
      background: #242424;
      color: var(--gray);
    }

    html[data-tema="gelap"] .btn.danger:hover,
    html[data-tema="gelap"] .icon-btn:hover {
      background: #2A1414;
    }

    html[data-tema="gelap"] .tier-chip.priv {
      background: rgba(255, 255, 255, .12);
      color: #DBDBDB;
    }

    html[data-tema="gelap"] .fi-thumb .ph,
    html[data-tema="gelap"] .hc-thumb .ph {
      color: #909090;
    }

    html[data-tema="gelap"] .lagi {
      border-color: #3A3A3A;
    }

    html[data-tema="gelap"] .lagi:hover {
      background: #2A2A2A;
      border-color: var(--orange);
    }

    html[data-tema="gelap"] .cari input {
      background: #1A1A1A;
    }

    html[data-tema="gelap"] .cari .hapus {
      background: #303030;
      color: #C4C4C4;
    }

    html[data-tema="gelap"] .mini {
      background: #242424;
    }

    html[data-tema="gelap"] .prof-av {
      color: #fff;
    }

    html[data-tema="gelap"] .notice-bar {
      background: #2E2410;
      border-color: #5C4712;
      color: #FCD34D;
    }

    html[data-tema="gelap"] .hero {
      background: linear-gradient(135deg, #262626, #171717);
    }

    html[data-tema="gelap"] .fi-thumb,
    html[data-tema="gelap"] .hc-thumb {
      background: #2A2A2A;
    }

    html[data-tema="gelap"] .fi-thumb .ph,
    html[data-tema="gelap"] .hc-thumb .ph {
      background: linear-gradient(135deg, #333333, #222222);
    }

    html[data-tema="gelap"] .fi-head:hover {
      background: #262626;
    }

    html[data-tema="gelap"] .seg {
      background: #2A2A2A;
    }

    html[data-tema="gelap"] .seg-btn.active {
      background: #383838;
      color: #fff;
    }

    html[data-tema="gelap"] .upsell {
      background: linear-gradient(135deg, #2A2118, #231B14);
    }

    html[data-tema="gelap"] mark {
      background: #7C5A16;
      color: #FDE68A;
    }

    html[data-tema="gelap"] .lk-img {
      background: #2A2A2A;
    }

    html[data-tema="gelap"] .wa-q {
      background: #2A2A2A;
    }

    html[data-tema="gelap"] .feed-body code {
      background: #2A2A2A;
    }

    html[data-tema="gelap"] input,
    html[data-tema="gelap"] select,
    html[data-tema="gelap"] textarea {
      color: var(--slate);
      background: var(--kartu);
      border-color: var(--line);
    }

    html[data-tema="gelap"] .ann.info {
      background: linear-gradient(135deg, #12293A, #0F2130);
      border-color: #1E4A63;
      color: #BAE0F5;
    }

    html[data-tema="gelap"] .ann.penting {
      background: linear-gradient(135deg, #2E2410, #241C0C);
      border-color: #6B5214;
      color: #FCD34D;
    }

    html[data-tema="gelap"] .ann.live {
      background: linear-gradient(135deg, #33161A, #251013);
      border-color: #6B2229;
      color: #FCA5A5;
    }

    /* ===== lencana posisi Buy / Sell ===== */
    .posisi {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 11px;
      border-radius: 20px;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .07em;
      white-space: nowrap;
      border: 1.5px solid transparent;
      transition: box-shadow .2s, transform .16s;
    }

    .posisi::before {
      content: '';
      width: 0;
      height: 0;
      border-left: 4.5px solid transparent;
      border-right: 4.5px solid transparent;
    }

    .posisi.buy {
      background: rgba(22, 163, 74, .12);
      color: #15803D;
      border-color: rgba(22, 163, 74, .42);
      box-shadow: 0 0 10px rgba(22, 163, 74, .30);
    }

    .posisi.buy::before {
      border-bottom: 7px solid #16A34A;
    }

    .posisi.sell {
      background: rgba(220, 38, 38, .12);
      color: #B91C1C;
      border-color: rgba(220, 38, 38, .42);
      box-shadow: 0 0 10px rgba(220, 38, 38, .30);
    }

    .posisi.sell::before {
      border-top: 7px solid #DC2626;
    }

    .posisi:hover {
      transform: translateY(-1px);
    }

    .posisi.buy:hover {
      box-shadow: 0 0 16px rgba(22, 163, 74, .48);
    }

    .posisi.sell:hover {
      box-shadow: 0 0 16px rgba(220, 38, 38, .48);
    }

    html[data-tema="gelap"] .posisi.buy {
      background: rgba(74, 222, 128, .14);
      color: #86EFAC;
      border-color: rgba(74, 222, 128, .45);
      box-shadow: 0 0 14px rgba(74, 222, 128, .34);
    }

    html[data-tema="gelap"] .posisi.buy::before {
      border-bottom-color: #4ADE80;
    }

    html[data-tema="gelap"] .posisi.sell {
      background: rgba(248, 113, 113, .14);
      color: #FCA5A5;
      border-color: rgba(248, 113, 113, .45);
      box-shadow: 0 0 14px rgba(248, 113, 113, .34);
    }

    html[data-tema="gelap"] .posisi.sell::before {
      border-top-color: #F87171;
    }

    html[data-tema="gelap"] .posisi.buy:hover {
      box-shadow: 0 0 22px rgba(74, 222, 128, .55);
    }

    html[data-tema="gelap"] .posisi.sell:hover {
      box-shadow: 0 0 22px rgba(248, 113, 113, .55);
    }

    /* ===== masa percobaan ===== */
    .tier-chip.trial {
      background: #0EA5E9;
      color: #fff;
    }

    html[data-tema="gelap"] .tier-chip.trial {
      background: #0369A1;
      color: #E0F2FE;
    }

    .trial-bar {
      display: flex;
      align-items: center;
      gap: 11px;
      flex-wrap: wrap;
      background: linear-gradient(135deg, #E0F2FE, #F0F9FF);
      border: 1px solid #7DD3FC;
      border-radius: 13px;
      padding: 12px 15px;
      margin-bottom: 13px;
      color: #075985;
    }

    html[data-tema="gelap"] .trial-bar {
      background: linear-gradient(135deg, #0C2836, #0A1F2B);
      border-color: #1E4A63;
      color: #BAE0F5;
    }

    .trial-bar .ic {
      font-size: 19px;
      flex: 0 0 auto;
    }

    .trial-bar b {
      display: block;
      font-size: 13.5px;
      margin-bottom: 2px;
    }

    .trial-bar p {
      margin: 0;
      font-size: 12px;
      line-height: 1.6;
      opacity: .9;
    }

    .trial-bar .sisa {
      margin-left: auto;
      font-size: 12.5px;
      font-weight: 800;
      background: rgba(255, 255, 255, .7);
      padding: 6px 13px;
      border-radius: 20px;
      white-space: nowrap;
    }

    html[data-tema="gelap"] .trial-bar .sisa {
      background: rgba(255, 255, 255, .12);
    }

    .trial-bar.abis {
      background: linear-gradient(135deg, #FEE2E2, #FEF2F2);
      border-color: #FCA5A5;
      color: #7F1D1D;
    }

    html[data-tema="gelap"] .trial-bar.abis {
      background: linear-gradient(135deg, #33161A, #251013);
      border-color: #6B2229;
      color: #FCA5A5;
    }

    .tab[hidden] {
      display: none !important;
    }

    /* ===== sakelar tema ===== */
    .tema-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, .16);
      background: rgba(255, 255, 255, .08);
      color: #fff;
      cursor: pointer;
      font-size: 15px;
      font-family: inherit;
      transition: background .16s, transform .16s;
      flex: 0 0 auto;
    }

    .tema-btn:hover {
      background: rgba(255, 255, 255, .18);
      transform: translateY(-1px);
    }

    .tema-btn:active {
      transform: translateY(0);
    }

    /* ===== sorotan mengikuti kursor (hanya perangkat berkursor & mode gelap) ===== */
    #sorot-kursor {
      position: fixed;
      pointer-events: none;
      z-index: 5;
      width: 460px;
      height: 460px;
      border-radius: 50%;
      opacity: 0;
      transition: opacity .35s ease;
      background: radial-gradient(circle, var(--kursor) 0%, transparent 68%);
      transform: translate(-50%, -50%);
      will-change: transform;
    }

    html[data-tema="gelap"] #sorot-kursor.on {
      opacity: 1;
    }

    @media(hover:none), (pointer:coarse) {
      #sorot-kursor {
        display: none;
      }
    }

    @media(prefers-reduced-motion:reduce) {
      #sorot-kursor {
        display: none;
      }
    }

    /* ===== kartu ringkas: judul dulu, isi dibuka kalau diklik ===== */
    .fi-head {
      display: flex;
      gap: 13px;
      align-items: flex-start;
      padding: 13px 15px;
      cursor: pointer;
      user-select: none;
      transition: background .14s;
    }

    .fi-head:hover {
      background: var(--cream);
    }

    .fi-thumb {
      flex: 0 0 104px;
      width: 104px;
      aspect-ratio: 16/9;
      border-radius: 10px;
      overflow: hidden;
      background: #F1EEE7;
      position: relative;
      align-self: flex-start;
    }

    .fi-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .fi-thumb .ph {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #E8E3D8, #F3EFE6);
      font-size: 17px;
      opacity: .5;
    }

    .fi-thumb .vmark {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: rgba(242, 112, 29, .92);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .fi-thumb .vmark::after {
      content: '';
      border-left: 8px solid #fff;
      border-top: 5px solid transparent;
      border-bottom: 5px solid transparent;
      margin-left: 2px;
    }

    .fi-info {
      flex: 1;
      min-width: 0;
    }

    /* Judul dibatasi 3 baris — kalau tidak, judul panjang membuat kotak teks
     jauh lebih tinggi daripada gambarnya dan tampilannya jadi timpang. */
    .fi-info h4 {
      margin: 0 0 6px;
      font-size: 14.5px;
      line-height: 1.42;
      color: var(--slate);
      font-weight: 700;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .feed-item.buka .fi-info h4 {
      -webkit-line-clamp: unset;
      overflow: visible;
    }

    .fi-meta {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .fi-chev {
      flex: 0 0 auto;
      align-self: center;
      color: var(--gray);
      font-size: 12px;
      transition: transform .22s ease;
    }

    .feed-item.buka .fi-chev {
      transform: rotate(180deg);
    }

    .fi-isi {
      display: none;
      border-top: 1px solid var(--line);
    }

    .feed-item.buka .fi-isi {
      display: block;
      animation: bukaIsi .28s ease both;
    }

    @keyframes bukaIsi {
      from {
        opacity: 0;
        transform: translateY(-5px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    /* ===== pencarian ===== */
    .cari {
      position: relative;
      margin-bottom: 13px;
    }

    .cari input {
      width: 100%;
      padding: 11px 38px 11px 38px;
      border: 1.5px solid var(--line);
      border-radius: 11px;
      font-size: 13.5px;
      font-family: inherit;
      color: var(--slate);
      background: var(--kartu);
      transition: border-color .15s, box-shadow .15s;
    }

    .cari input:focus {
      outline: none;
      border-color: var(--orange);
      box-shadow: 0 0 0 3px rgba(242, 112, 29, .12);
    }

    .cari .ic {
      position: absolute;
      left: 13px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--gray);
      font-size: 14px;
      pointer-events: none;
    }

    .cari .hapus {
      position: absolute;
      right: 11px;
      top: 50%;
      transform: translateY(-50%);
      width: 22px;
      height: 22px;
      border: none;
      border-radius: 50%;
      background: var(--cream);
      color: var(--slate-2);
      cursor: pointer;
      font-size: 13px;
      line-height: 1;
      display: none;
    }

    .cari.isi .hapus {
      display: block;
    }

    .cari .hapus:hover {
      background: var(--orange);
      color: #fff;
    }

    .cari-info {
      font-size: 12px;
      color: var(--gray);
      margin: -6px 0 11px;
    }

    /* ===== KARTU SOROTAN (kiriman teratas) =====
     Di layar lebar tampil besar dengan gambar penuh; di HP menumpuk
     jadi satu kolom supaya tetap nyaman dibaca. */
    .utama {
      position: relative;
      border-radius: 18px;
      overflow: hidden;
      margin-bottom: 14px;
      background: var(--kartu);
      border: 1px solid var(--line);
      box-shadow: var(--bayang-2);
      cursor: pointer;
      transition: transform .24s, box-shadow .24s, border-color .24s;
      animation: riseIn .5s cubic-bezier(.22, .8, .3, 1) both;
    }

    .utama:hover {
      transform: translateY(-3px);
      box-shadow: var(--bayang-3);
      border-color: var(--orange);
    }

    .utama:active {
      transform: translateY(-1px);
    }

    .utama-gbr {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      overflow: hidden;
      background: #EFEAE2;
    }

    .utama-gbr img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .5s cubic-bezier(.22, .8, .3, 1);
    }

    .utama:hover .utama-gbr img {
      transform: scale(1.04);
    }

    .utama-gbr .ph {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #E8E3D8, #F3EFE6);
      font-size: 34px;
      opacity: .45;
    }

    .utama-gbr .vmark {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(242, 112, 29, .94);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 18px rgba(0, 0, 0, .34);
    }

    .utama-gbr .vmark::after {
      content: '';
      border-left: 16px solid #fff;
      border-top: 10px solid transparent;
      border-bottom: 10px solid transparent;
      margin-left: 4px;
    }

    .utama-pita {
      position: absolute;
      left: 14px;
      top: 14px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 20px;
      background: var(--orange);
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      box-shadow: 0 3px 12px rgba(0, 0, 0, .28);
    }

    .utama-isi {
      padding: 16px 18px 18px;
    }

    .utama-isi h3 {
      margin: 0 0 8px;
      font-size: 19px;
      line-height: 1.32;
      color: var(--slate);
      font-weight: 700;
      letter-spacing: -.01em;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .utama-isi p {
      margin: 0 0 12px;
      font-size: 13px;
      line-height: 1.65;
      color: var(--slate-2);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .utama-kaki {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
    }

    .utama-full {
      display: none;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .utama.buka .utama-full {
      display: block;
      animation: bukaIsi .3s ease both;
    }

    .utama.buka .utama-isi h3 {
      -webkit-line-clamp: unset;
      overflow: visible;
    }

    .utama.buka .utama-isi p {
      display: none;
    }

    .utama.buka .utama-baca {
      background: var(--orange);
    }

    .utama.buka .utama-baca::after {
      content: '\2191';
    }

    .utama-baca {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 17px;
      border-radius: 22px;
      background: var(--slate);
      color: #fff;
      font-size: 12.5px;
      font-weight: 700;
      transition: background .18s, gap .18s;
    }

    .utama:hover .utama-baca {
      background: var(--orange);
      gap: 10px;
    }

    .utama-baca::after {
      content: '\2192';
      font-size: 14px;
    }

    html[data-tema="gelap"] .utama-baca {
      background: #303030;
    }

    html[data-tema="gelap"] .utama:hover .utama-baca {
      background: var(--orange);
    }

    html[data-tema="gelap"] .utama-gbr {
      background: #2A2A2A;
    }

    html[data-tema="gelap"] .utama-isi h3 {
      text-shadow: var(--glow);
    }

    /* Susunan dua kolom di layar lebar: sorotan di kiri, daftar di kanan. */
    @media(min-width:1000px) {
      .sorot-grid {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 18px;
        align-items: start;
      }

      .sorot-grid .kanan {
        max-height: none;
      }

      .utama {
        margin-bottom: 0;
      }

      .utama-isi {
        padding: 18px 20px 20px;
      }

      .utama-isi h3 {
        font-size: 21px;
      }
    }

    @media(min-width:1220px) {
      .sorot-grid {
        grid-template-columns: 1.5fr 1fr;
        gap: 22px;
      }

      .utama-isi h3 {
        font-size: 23px;
      }
    }

    /* HP: gambar tetap di atas, teks di bawah, ukuran dirapatkan. */
    @media(max-width:560px) {
      .utama {
        border-radius: 16px;
        margin-bottom: 12px;
      }

      .utama-isi {
        padding: 13px 14px 15px;
      }

      .utama-isi h3 {
        font-size: 16px;
        -webkit-line-clamp: 3;
      }

      .utama-isi p {
        font-size: 12.5px;
        -webkit-line-clamp: 2;
      }

      .utama-baca {
        padding: 8px 15px;
        font-size: 12px;
      }

      .utama-pita {
        left: 11px;
        top: 11px;
        padding: 4px 10px;
        font-size: 9.5px;
      }

      .utama-gbr .vmark {
        width: 44px;
        height: 44px;
      }
    }

    /* ===== penyaring cepat ===== */
    .saring {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
      align-items: center;
      margin: -4px 0 13px;
      transition: opacity .2s;
    }

    .saring.memuat {
      opacity: .45;
      pointer-events: none;
    }

    .saring .chip {
      border: 1.5px solid var(--line);
      background: var(--kartu);
      color: var(--slate-2);
      border-radius: 20px;
      padding: 6px 13px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
      transition: all .16s;
      box-shadow: var(--bayang-1);
    }

    .saring .chip:hover {
      border-color: var(--orange);
      color: var(--orange-deep);
      transform: translateY(-1px);
    }

    .saring .chip.on {
      background: var(--orange);
      border-color: var(--orange);
      color: #fff;
      box-shadow: 0 3px 12px rgba(242, 112, 29, .32);
    }

    .saring .chip.on:hover {
      color: #fff;
    }

    .saring .tgl {
      display: flex;
      align-items: center;
      gap: 6px;
      border: 1.5px solid var(--line);
      background: var(--kartu);
      border-radius: 20px;
      padding: 4px 6px 4px 12px;
      box-shadow: var(--bayang-1);
    }

    .saring .tgl label {
      font-size: 11.5px;
      color: var(--gray);
      font-weight: 600;
    }

    .saring .tgl input {
      border: none;
      background: transparent;
      color: var(--slate);
      font-family: inherit;
      font-size: 12px;
      padding: 3px 4px;
      width: 132px;
    }

    .saring .tgl input:focus {
      outline: none;
    }

    .saring .tgl.on {
      border-color: var(--orange);
    }

    html[data-tema="gelap"] .saring .chip {
      background: #242424;
    }

    html[data-tema="gelap"] .saring .tgl {
      background: #242424;
    }

    html[data-tema="gelap"] .saring .tgl input {
      color-scheme: dark;
    }

    mark {
      background: #FEF3C7;
      color: inherit;
      border-radius: 3px;
      padding: 0 2px;
    }

    /* ===== muat lebih banyak ===== */
    .lagi {
      width: 100%;
      padding: 12px;
      margin-top: 11px;
      border: 1.5px dashed var(--line);
      border-radius: 12px;
      background: transparent;
      color: var(--orange-deep);
      font-weight: 700;
      font-size: 13px;
      font-family: inherit;
      cursor: pointer;
      transition: all .15s;
    }

    .lagi:hover {
      border-color: var(--orange);
      background: var(--cream);
    }

    .lagi small {
      display: block;
      font-weight: 400;
      color: var(--gray);
      font-size: 11.5px;
      margin-top: 3px;
    }

    @media(max-width:460px) {
      .fi-thumb {
        flex: 0 0 78px;
        width: 78px;
      }
    }

    /* sorotan singkat saat kiriman dibuka dari Beranda */
    @keyframes sorot {
      0% {
        box-shadow: 0 0 0 0 rgba(242, 112, 29, .55);
      }

      35% {
        box-shadow: 0 0 0 5px rgba(242, 112, 29, .28);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(242, 112, 29, 0);
      }
    }

    .feed-item.sorot {
      animation: sorot 1.7s ease-out 1;
      border-color: var(--orange) !important;
    }

    /* pengumuman versi highlight (dengan gambar) */
    .ann-hl {
      position: relative;
      border-radius: 15px;
      overflow: hidden;
      margin-bottom: 14px;
      background: var(--slate);
      box-shadow: 0 6px 22px rgba(31, 41, 55, .16);
      animation: popSoft .5s cubic-bezier(.22, .8, .3, 1) both;
    }

    .ann-hl-img {
      width: 100%;
      display: block;
      background: #111827;
      height: auto;
      max-height: 560px;
      object-fit: contain;
    }

    /* Teks diletakkan DI BAWAH gambar, bukan menimpanya — poster yang sudah
     berisi tulisan sendiri jadi tetap terbaca utuh. */
    .ann-hl-body {
      padding: 14px 16px 16px;
      background: #1F2937;
    }

    .ann-hl-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 11px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .ann-hl-pill.live {
      background: #DC2626;
      color: #fff;
    }

    .ann-hl-pill.penting {
      background: #F59E0B;
      color: #3b2500;
    }

    .ann-hl-pill.info {
      background: #0EA5E9;
      color: #fff;
    }

    .ann-hl h4 {
      margin: 0 0 5px;
      font-size: 17px;
      color: #fff;
      line-height: 1.35;
      font-weight: 700;
      text-shadow: 0 2px 10px rgba(0, 0, 0, .5);
    }

    .ann-hl p {
      margin: 0;
      font-size: 12.5px;
      color: #dfe5ec;
      line-height: 1.62;
      text-shadow: 0 1px 8px rgba(0, 0, 0, .55);
    }

    .ann-hl .ann-time {
      display: block;
      font-size: 11px;
      color: #8f9aa8;
      margin-top: 9px;
    }

    .ann-hl h4 {
      text-shadow: none;
    }

    .ann-hl p {
      text-shadow: none;
      color: #c9d1da;
    }

    .ann-hl .ann-btn {
      background: var(--orange);
      color: #fff;
      margin-top: 11px;
      padding: 8px 16px;
      font-size: 12.5px;
      box-shadow: 0 3px 12px rgba(242, 112, 29, .4);
    }

    .ann-hl .ann-btn:hover {
      background: var(--orange-deep);
    }

    .ann-hl .dot-live {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #fff;
      animation: pulseDot 1.3s ease-in-out infinite;
    }

    @media(max-width:520px) {
      .ann-hl h4 {
        font-size: 15.5px;
      }

      .ann-hl-body {
        padding: 38px 14px 14px;
      }
    }

    /* pengumuman */
    .ann {
      border-radius: 13px;
      padding: 14px 16px;
      margin-bottom: 13px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
      border: 1px solid transparent;
    }

    .ann .ann-ic {
      font-size: 20px;
      flex: 0 0 auto;
      line-height: 1.3;
    }

    .ann b {
      display: block;
      font-size: 14px;
      margin-bottom: 3px;
      line-height: 1.4;
    }

    .ann p {
      margin: 0;
      font-size: 12.5px;
      line-height: 1.62;
    }

    .ann .ann-time {
      display: block;
      font-size: 11px;
      opacity: .8;
      margin-top: 6px;
    }

    .ann.live {
      background: linear-gradient(135deg, #FEE2E2, #FEF2F2);
      border-color: #FCA5A5;
      color: #7F1D1D;
    }

    .ann.penting {
      background: linear-gradient(135deg, #FEF3C7, #FFFBEB);
      border-color: #FCD34D;
      color: #78350F;
    }

    .ann.info {
      background: linear-gradient(135deg, #E0F2FE, #F0F9FF);
      border-color: #7DD3FC;
      color: #075985;
    }

    .ann-btn {
      display: inline-block;
      margin-top: 9px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      padding: 6px 13px;
      border-radius: 20px;
      background: rgba(255, 255, 255, .72);
    }

    .ann-btn:hover {
      background: #fff;
    }

    .ann.live .ann-ic {
      animation: pulseDot 1.5s ease-in-out infinite;
    }

    @keyframes pulseDot {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: .55;
        transform: scale(.9);
      }
    }

    .feed-time {
      font-size: 11px;
      color: var(--gray);
    }

    .vid-wrap {
      position: relative;
      display: block;
      border-radius: 10px;
      overflow: hidden;
      background: var(--slate);
      cursor: pointer;
    }

    /* Ukuran mengikuti gambar aslinya — sama seperti .feed-cover, tidak dipotong. */
    .vid-wrap img {
      width: 100%;
      display: block;
      background: var(--cream);
      height: auto;
      max-height: 520px;
      object-fit: contain;
      opacity: .88;
      transition: opacity .18s, transform .3s;
    }

    .vid-wrap:hover img {
      opacity: 1;
      transform: scale(1.02);
    }

    .vid-ph {
      width: 100%;
      aspect-ratio: 16/9;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #1F2937, #374151);
      color: #6b7686;
      font-size: 12px;
      letter-spacing: .1em;
    }

    .vid-play {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(242, 112, 29, .94);
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      box-shadow: 0 4px 18px rgba(0, 0, 0, .35);
    }

    .vid-play::after {
      content: '';
      border-left: 16px solid #fff;
      border-top: 10px solid transparent;
      border-bottom: 10px solid transparent;
      margin-left: 4px;
    }

    .vid-dur {
      position: absolute;
      right: 8px;
      bottom: 8px;
      background: rgba(0, 0, 0, .74);
      color: #fff;
      font-size: 10.5px;
      padding: 2px 7px;
      border-radius: 5px;
      letter-spacing: .04em;
      pointer-events: none;
    }

    .mat-kind {
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: 20px;
    }

    .mat-kind.pdf {
      background: #FEE2E2;
      color: #991B1B;
    }

    .mat-kind.slide {
      background: #FEF3C7;
      color: #92400E;
    }

    .mat-kind.video {
      background: #E0E7FF;
      color: #3730A3;
    }

    .ext-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--orange-deep);
      cursor: pointer;
    }

    .ext-btn:hover {
      text-decoration: underline;
    }

    /* animasi masuk bertahap */
    @keyframes riseIn {
      from {
        opacity: 0;
        transform: translateY(14px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes kilau {
      from {
        background-position: -320px 0;
      }

      to {
        background-position: 320px 0;
      }
    }

    /* transisi halus saat berganti tema */
    .shell,
    .top,
    .tabs,
    .panel,
    .feed-item,
    .home-card,
    .mini,
    .pintas a,
    .hero {
      transition: background-color .3s ease, border-color .3s ease, color .3s ease,
        box-shadow .24s ease, transform .2s ease;
    }

    .view.active .pintas a {
      animation: riseIn .42s cubic-bezier(.22, .8, .3, 1) both;
    }

    .view.active .pintas a:nth-child(1) {
      animation-delay: .04s;
    }

    .view.active .pintas a:nth-child(2) {
      animation-delay: .09s;
    }

    .view.active .pintas a:nth-child(3) {
      animation-delay: .14s;
    }

    .view.active .pintas a:nth-child(4) {
      animation-delay: .19s;
    }

    .view.active .tutup {
      animation: riseIn .5s ease .22s both;
    }

    @keyframes fadeSlide {
      from {
        opacity: 0;
        transform: translateX(-10px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes popSoft {
      from {
        opacity: 0;
        transform: scale(.965);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .view.active .feed-item,
    .view.active .home-card,
    .view.active .mini,
    .view.active .kpi,
    .view.active .panel {
      animation: riseIn .42s cubic-bezier(.22, .8, .3, 1) both;
    }

    .view.active .feed-item:nth-child(1),
    .view.active .home-card:nth-child(1) {
      animation-delay: .02s;
    }

    .view.active .feed-item:nth-child(2),
    .view.active .home-card:nth-child(2) {
      animation-delay: .07s;
    }

    .view.active .feed-item:nth-child(3),
    .view.active .home-card:nth-child(3) {
      animation-delay: .12s;
    }

    .view.active .feed-item:nth-child(4),
    .view.active .home-card:nth-child(4) {
      animation-delay: .17s;
    }

    .view.active .feed-item:nth-child(n+5),
    .view.active .home-card:nth-child(n+5) {
      animation-delay: .22s;
    }

    .view.active .hero {
      animation: popSoft .45s cubic-bezier(.22, .8, .3, 1) both;
    }

    .view.active .home-head {
      animation: fadeSlide .38s ease both;
    }

    .view.active .seg,
    .view.active .kurs-box {
      animation: fadeSlide .34s ease both;
    }

    @media(prefers-reduced-motion:reduce) {
      .view.active * {
        animation: none !important;
      }
    }

    /* gate + notice */
    .shell.locked {
      filter: blur(7px);
      pointer-events: none;
      user-select: none;
    }

    .gate-input {
      width: 100%;
      background: var(--kartu);
      border: 1.5px solid var(--line);
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 16px;
      font-family: var(--mono);
      letter-spacing: .12em;
      text-align: center;
      text-transform: uppercase;
      color: var(--slate);
    }

    .gate-input:focus {
      outline: 2px solid var(--orange);
      border-color: var(--orange);
    }

    .gate-err {
      background: #fef2f2;
      border-left: 3px solid var(--loss);
      color: #b91c1c;
      font-size: 12.5px;
      padding: 9px 12px;
      border-radius: 0 6px 6px 0;
      margin-top: 11px;
    }

    .gate-hint {
      font-size: 12px;
      color: var(--gray);
      text-align: center;
      margin: 16px 0 0;
      line-height: 1.6;
    }

    /* ===== ajakan gabung grup publik ===== */
    .grup-ic {
      width: 62px;
      height: 62px;
      border-radius: 19px;
      margin: 0 auto 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #25D366, #128C7E);
      box-shadow: 0 8px 22px rgba(37, 211, 102, .34);
    }

    .grup-ic svg {
      width: 34px;
      height: 34px;
      fill: #fff;
      display: block;
    }

    .grup-card {
      text-align: center;
    }

    .grup-card h3 {
      margin: 0 0 8px;
      font-size: 18px;
      letter-spacing: -.01em;
    }

    .grup-card>p {
      margin: 0 0 15px;
      font-size: 13px;
      color: var(--slate-2);
      line-height: 1.7;
    }

    .grup-list {
      list-style: none;
      padding: 0;
      margin: 0 0 17px;
      text-align: left;
      background: var(--cream);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 13px 15px;
    }

    .grup-list li {
      font-size: 12.5px;
      color: var(--teks-isi);
      line-height: 1.6;
      padding: 5px 0 5px 22px;
      position: relative;
    }

    .grup-list li::before {
      content: '\2713';
      position: absolute;
      left: 0;
      top: 5px;
      color: #25D366;
      font-weight: 800;
    }

    .btn.wa-btn {
      background: #25D366;
      border-color: #25D366;
      color: #fff;
    }

    .btn.wa-btn:hover {
      background: #1EBE5A;
      border-color: #1EBE5A;
    }

    .notice-bar {
      background: #FEF3C7;
      border-bottom: 1px solid #FCD34D;
      color: #92400E;
      padding: 9px 20px;
      font-size: 12.5px;
      line-height: 1.5;
    }

    .notice-bar b {
      color: #78350F;
    }

    /* ===== MARKET BERANDA ===== */
    .mk-sesi {
      margin-bottom: 16px;
    }

    .mk-judul {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0 0 9px;
      flex-wrap: wrap;
    }

    .mk-judul .mk-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--orange);
      box-shadow: 0 0 0 3px var(--aksen-halus);
      flex: 0 0 auto;
    }

    .mk-judul h3 {
      margin: 0;
      font-size: 14px;
      font-weight: 800;
      color: var(--slate);
      letter-spacing: .2px;
    }

    .mk-pill {
      background: var(--aksen-halus);
      color: var(--orange-deep);
      font-size: 10px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 999px;
    }

    .mk-kotak {
      background: var(--kartu);
      border: 1px solid var(--line-2);
      border-radius: 16px;
      padding: 7px;
      box-shadow: var(--bayang-1);
    }

    .mk-pita {
      border-radius: 11px;
      overflow: hidden;
      height: 82px;
      background: var(--kartu);
    }

    /* Widget dibuat lebih besar dari kotaknya lalu digeser, supaya garis tepi
     terang bawaan TradingView terpangkas dan tidak bocor kelihatan. */
    .mk-pita iframe {
      width: calc(100% + 8px);
      height: 90px;
      border: 0;
      display: block;
      margin: -4px 0 0 -4px;
      background: var(--kartu);
    }

    .mk-geser-bungkus {
      position: relative;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .mk-geser {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 2px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .mk-geser::-webkit-scrollbar {
      display: none;
    }

    .mk-nav {
      flex: 0 0 26px;
      height: 180px;
      border: 1px solid var(--line-2);
      background: var(--kartu);
      color: var(--orange-deep);
      border-radius: 9px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      padding: 0;
      font-family: inherit;
      transition: .14s;
    }

    .mk-nav:hover:not(:disabled) {
      background: var(--aksen-halus);
      border-color: var(--orange);
    }

    .mk-nav:disabled {
      opacity: .22;
      cursor: default;
    }

    .mk-kartu {
      flex: 0 0 240px;
      border: 1px solid var(--line-2);
      border-radius: 13px;
      background: var(--kartu);
      scroll-snap-align: start;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: .16s;
    }

    .mk-kartu:hover {
      border-color: var(--orange);
      box-shadow: var(--bayang-2);
      transform: translateY(-2px);
    }

    .mk-atas {
      cursor: pointer;
      padding: 10px 11px 9px;
      flex: 1;
    }

    .mk-tag {
      display: inline-block;
      font-size: 8.5px;
      font-weight: 800;
      letter-spacing: .6px;
      text-transform: uppercase;
      padding: 2.5px 7px;
      border-radius: 999px;
      margin-bottom: 6px;
    }

    .mk-tag.forex {
      background: rgba(59, 130, 246, .13);
      color: #3B82F6;
    }

    .mk-tag.komoditas {
      background: var(--aksen-halus);
      color: var(--orange-deep);
    }

    .mk-tag.kripto {
      background: rgba(139, 92, 246, .14);
      color: #8B5CF6;
    }

    .mk-harga {
      height: 96px;
      margin: 2px 0 0;
      overflow: hidden;
      border-radius: 9px;
      background: var(--kartu);
    }

    .mk-harga iframe {
      width: calc(100% + 8px);
      height: 104px;
      border: 0;
      display: block;
      margin: -4px 0 0 -4px;
      background: var(--kartu);
    }

    .mk-buka {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 6px;
      font-size: 10.5px;
      font-weight: 700;
      color: var(--orange-deep);
      letter-spacing: .2px;
    }

    .mk-buka i {
      font-style: normal;
      font-size: 13px;
      transition: transform .16s;
    }

    .mk-kartu:hover .mk-buka i {
      transform: translateX(3px);
    }

    .mk-analisa {
      border: 0;
      border-top: 1px solid var(--line-2);
      background: var(--aksen-halus);
      color: var(--orange-deep);
      font-family: inherit;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: .3px;
      padding: 10px 8px;
      cursor: pointer;
      width: 100%;
      transition: .14s;
    }

    .mk-analisa:hover {
      background: var(--orange);
      color: #fff;
    }

    .mk-hint {
      font-size: 10.5px;
      color: var(--gray);
      text-align: center;
      padding: 9px 0 2px;
    }

    .mk-layar {
      position: fixed;
      inset: 0;
      background: var(--hal);
      z-index: 9999;
      display: none;
      flex-direction: column;
    }

    .mk-layar.on {
      display: flex;
    }

    .mk-layar-atas {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 14px;
      border-bottom: 1px solid var(--line-2);
      background: var(--cream);
    }

    .mk-layar-atas b {
      font-size: 14px;
      color: var(--slate);
    }

    .mk-tutup {
      background: var(--orange);
      color: #fff;
      border: 0;
      border-radius: 10px;
      padding: 8px 15px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      font-family: inherit;
    }

    .mk-layar-isi {
      flex: 1;
      min-height: 0;
      position: relative;
      background: var(--kartu);
    }

    .mk-layar-isi iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    .mk-memuat {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12.5px;
      color: var(--gray);
      background: var(--kartu);
    }

    .mk-layar-kaki {
      font-size: 10px;
      color: var(--gray);
      text-align: center;
      padding: 8px 12px;
      border-top: 1px solid var(--line-2);
      line-height: 1.45;
      background: var(--kartu);
    }

    /* ===== TOMBOL SEMBUNYIKAN KARTU SAPAAN ===== */
    .hero {
      position: relative;
    }

    .hero-tutup {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 26px;
      height: 26px;
      border: 1px solid var(--line-2);
      background: var(--kartu);
      color: var(--gray);
      border-radius: 8px;
      font-size: 12px;
      font-weight: 800;
      line-height: 1;
      cursor: pointer;
      font-family: inherit;
      padding: 0;
      opacity: .55;
      transition: .15s;
      z-index: 3;
    }

    .hero-tutup:hover {
      opacity: 1;
      background: var(--orange);
      color: #fff;
      border-color: var(--orange);
    }

    .hero-row {
      padding-right: 34px;
    }

    /* ===== CARI PAIR ===== */
    .mk-cari-bar {
      position: relative;
      display: flex;
      align-items: center;
      gap: 9px;
      border: 1px solid var(--line-2);
      border-radius: 12px;
      padding: 11px 13px;
      background: var(--kartu);
      transition: border-color .16s, box-shadow .16s;
    }

    .mk-cari-bar:focus-within {
      border-color: var(--orange);
      box-shadow: 0 0 0 3px var(--aksen-halus);
    }

    .mk-cari-bar svg {
      width: 17px;
      height: 17px;
      flex: 0 0 auto;
      color: var(--gray);
    }

    .mk-cari-bar input {
      flex: 1;
      min-width: 0;
      border: 0;
      background: transparent;
      outline: none;
      font-family: inherit;
      font-size: 13.5px;
      color: var(--teks-isi);
    }

    .mk-cari-bar input::placeholder {
      color: var(--gray);
    }

    .mk-cari-x {
      border: 0;
      background: transparent;
      color: var(--gray);
      font-size: 15px;
      cursor: pointer;
      padding: 0 2px;
      display: none;
      font-family: inherit;
    }

    .mk-cari-x.on {
      display: block;
    }

    .mk-hasil {
      margin-top: 8px;
      border: 1px solid var(--line-2);
      border-radius: 12px;
      overflow: hidden;
      display: none;
    }

    .mk-hasil.on {
      display: block;
    }

    .mk-hs {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 13px;
      cursor: pointer;
      border-bottom: 1px solid var(--line-2);
      transition: background .13s;
    }

    .mk-hs:last-child {
      border-bottom: 0;
    }

    .mk-hs:hover {
      background: var(--aksen-halus);
    }

    .mk-hs-nama {
      flex: 1;
      min-width: 0;
    }

    .mk-hs-nama b {
      display: block;
      font-size: 13px;
      font-weight: 800;
      color: var(--slate);
      letter-spacing: -.1px;
    }

    .mk-hs-nama span {
      font-size: 11px;
      color: var(--gray);
    }

    .mk-tag.indeks {
      background: rgba(16, 185, 129, .14);
      color: #10B981;
    }

    .mk-tag.saham {
      background: rgba(236, 72, 153, .14);
      color: #EC4899;
    }

    .mk-tag.idx {
      background: rgba(234, 179, 8, .16);
      color: #CA8A04;
    }

    .mk-tag.lain {
      background: var(--line-2);
      color: var(--gray);
    }

    .mk-kosong {
      padding: 16px 14px;
      font-size: 12.5px;
      color: var(--gray);
      line-height: 1.65;
      text-align: center;
    }

    .mk-coba {
      margin-top: 10px;
      border: 1px solid var(--orange);
      background: var(--aksen-halus);
      color: var(--orange-deep);
      border-radius: 10px;
      padding: 8px 14px;
      font-family: inherit;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: .14s;
    }

    .mk-coba:hover {
      background: var(--orange);
      color: #fff;
    }

    .mk-ringkas {
      margin-top: 10px;
      border: 1px solid var(--line-2);
      border-radius: 14px;
      background: var(--kartu);
      overflow: hidden;
      display: none;
    }

    .mk-ringkas.on {
      display: block;
    }

    .mk-rk-atas {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 13px 6px;
      gap: 10px;
    }

    .mk-rk-judul b {
      display: block;
      font-size: 15px;
      font-weight: 800;
      color: var(--slate);
      letter-spacing: -.2px;
    }

    .mk-rk-judul span {
      font-size: 11px;
      color: var(--gray);
    }

    .mk-rk-harga {
      height: 96px;
      overflow: hidden;
      margin: 0 8px;
      border-radius: 10px;
      background: var(--kartu);
    }

    .mk-rk-harga iframe {
      width: calc(100% + 8px);
      height: 104px;
      border: 0;
      display: block;
      margin: -4px 0 0 -4px;
      background: var(--kartu);
    }

    .mk-rk-tbl {
      display: flex;
      gap: 8px;
      padding: 10px 12px 12px;
    }

    .mk-rk-tbl button {
      flex: 1;
      border: 0;
      border-radius: 11px;
      padding: 11px;
      font-family: inherit;
      font-size: 12.5px;
      font-weight: 800;
      cursor: pointer;
      transition: filter .13s;
    }

    .mk-rk-tbl button:hover {
      filter: brightness(.93);
    }

    .mk-b-chart {
      background: var(--orange);
      color: #fff;
    }

    .mk-b-tutup {
      background: var(--hal);
      color: var(--gray);
      border: 1px solid var(--line-2) !important;
    }

    /* ===== JURNAL: MODE PENGISIAN ===== */
    .jm-mode {
      display: flex;
      gap: 6px;
      margin: 0 0 12px;
      background: var(--hal);
      border: 1px solid var(--line-2);
      border-radius: 12px;
      padding: 4px;
    }

    .jm-tab {
      flex: 1;
      border: 0;
      background: transparent;
      color: var(--gray);
      font-family: inherit;
      font-size: 12.5px;
      font-weight: 800;
      padding: 9px 8px;
      border-radius: 9px;
      cursor: pointer;
      transition: .15s;
    }

    .jm-tab:hover {
      color: var(--slate);
    }

    .jm-tab.active {
      background: var(--orange);
      color: #fff;
    }

    .jm-panel {
      display: none;
    }

    .jm-panel.on {
      display: block;
    }

    .jm-nb {
      margin: 0 0 12px;
      font-size: 12px;
      color: var(--gray);
      line-height: 1.6;
    }

    .jm-contoh {
      background: var(--hal);
      border: 1px solid var(--line-2);
      border-radius: 12px;
      padding: 12px 13px;
    }

    .jm-contoh-atas {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
    }

    .jm-contoh-atas b {
      font-size: 12px;
      color: var(--slate);
      letter-spacing: .2px;
    }

    .jm-contoh code {
      display: block;
      font-family: var(--mono), monospace;
      font-size: 11.5px;
      color: var(--orange-deep);
      background: var(--aksen-halus);
      padding: 7px 10px;
      border-radius: 8px;
      margin-bottom: 8px;
      word-break: break-word;
    }

    .jm-contoh pre {
      margin: 0;
      font-family: var(--mono), monospace;
      font-size: 11.5px;
      line-height: 1.85;
      color: var(--teks-isi);
      white-space: pre-wrap;
      word-break: break-word;
    }

    .jm-ket {
      margin: 9px 0 0;
      font-size: 11px;
      color: var(--gray);
      line-height: 1.75;
    }

    .jm-ket code {
      display: inline-block;
      margin-top: 5px;
      font-size: 10.5px;
    }

    .jm-lapor {
      margin-top: 12px;
      border-radius: 11px;
      padding: 11px 13px;
      font-size: 12px;
      line-height: 1.7;
      border: 1px solid var(--line-2);
      background: var(--hal);
    }

    .jm-lapor b {
      color: var(--slate);
    }

    .jm-lapor .ok {
      color: var(--win);
      font-weight: 800;
    }

    .jm-lapor .bad {
      color: var(--loss);
      font-weight: 800;
    }

    .jm-lapor ul {
      margin: 7px 0 0;
      padding-left: 17px;
    }

    .jm-lapor li {
      margin-bottom: 3px;
    }

    /* ===== BANTUAN: FAQ & TUTORIAL ===== */
    .hp-cari-bar {
      display: flex;
      align-items: center;
      gap: 9px;
      border: 1px solid var(--line-2);
      border-radius: 12px;
      padding: 12px 14px;
      background: var(--kartu);
      margin-bottom: 11px;
      transition: border-color .16s, box-shadow .16s;
    }

    .hp-cari-bar:focus-within {
      border-color: var(--orange);
      box-shadow: 0 0 0 3px var(--aksen-halus);
    }

    .hp-cari-bar svg {
      width: 17px;
      height: 17px;
      flex: 0 0 auto;
      color: var(--gray);
    }

    .hp-cari-bar input {
      flex: 1;
      min-width: 0;
      border: 0;
      background: transparent;
      outline: none;
      font-family: inherit;
      font-size: 13.5px;
      color: var(--teks-isi);
    }

    .hp-cari-x {
      border: 0;
      background: transparent;
      color: var(--gray);
      font-size: 15px;
      cursor: pointer;
      display: none;
      font-family: inherit;
      padding: 0 2px;
    }

    .hp-cari-x.on {
      display: block;
    }

    .hp-chips {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      padding-bottom: 3px;
      margin-bottom: 13px;
      scrollbar-width: none;
    }

    .hp-chips::-webkit-scrollbar {
      display: none;
    }

    .hp-chip {
      flex: 0 0 auto;
      border: 1px solid var(--line-2);
      background: var(--kartu);
      color: var(--gray);
      font-family: inherit;
      font-size: 11.5px;
      font-weight: 700;
      padding: 7px 13px;
      border-radius: 999px;
      cursor: pointer;
      transition: .14s;
    }

    .hp-chip:hover {
      border-color: var(--orange);
      color: var(--orange-deep);
    }

    .hp-chip.on {
      background: var(--orange);
      color: #fff;
      border-color: var(--orange);
    }

    .hp-info {
      font-size: 12px;
      color: var(--gray);
      margin-bottom: 11px;
    }

    .hp-grup {
      margin-bottom: 16px;
    }

    .hp-grup-judul {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0 0 9px;
    }

    .hp-grup-judul .ic {
      width: 26px;
      height: 26px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      background: var(--aksen-halus);
    }

    .hp-grup-judul h3 {
      margin: 0;
      font-size: 14px;
      font-weight: 800;
      color: var(--slate);
    }

    .hp-item {
      border: 1px solid var(--line-2);
      border-radius: 12px;
      background: var(--kartu);
      margin-bottom: 7px;
      overflow: hidden;
    }

    .hp-t {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      text-align: left;
      border: 0;
      background: transparent;
      font-family: inherit;
      font-size: 13px;
      font-weight: 700;
      color: var(--slate);
      padding: 13px 14px;
      cursor: pointer;
      line-height: 1.5;
    }

    .hp-t:hover {
      background: var(--aksen-halus);
    }

    .hp-t .pan {
      margin-left: auto;
      flex: 0 0 auto;
      color: var(--orange-deep);
      font-size: 11px;
      transition: transform .2s;
    }

    .hp-item.buka .hp-t .pan {
      transform: rotate(180deg);
    }

    .hp-j {
      display: none;
      padding: 0 14px 14px;
      font-size: 12.5px;
      line-height: 1.8;
      color: var(--teks-isi);
    }

    .hp-item.buka .hp-j {
      display: block;
    }

    .hp-j b {
      color: var(--slate);
    }

    .hp-j ol,
    .hp-j ul {
      margin: 8px 0 0;
      padding-left: 19px;
    }

    .hp-j li {
      margin-bottom: 5px;
    }

    .hp-j code {
      font-family: var(--mono), monospace;
      font-size: 11.5px;
      background: var(--hal);
      padding: 2px 6px;
      border-radius: 5px;
      color: var(--orange-deep);
    }

    .hp-kosong {
      text-align: center;
      padding: 26px 16px;
      font-size: 12.5px;
      color: var(--gray);
      line-height: 1.7;
    }

    .hp-kosong b {
      color: var(--slate);
    }

    mark {
      background: var(--aksen-halus);
      color: var(--orange-deep);
      padding: 0 2px;
      border-radius: 3px;
    }

    /* ===== BARIS TAB: lebih mudah dijelajahi di HP =====
     Tab paling kanan (Kalkulator, Profil, Bantuan, Informasi) dulu nyaris
     tak terlihat karena harus digeser buta. Sekarang ada tombol geser,
     bayangan di tepi sebagai penanda masih ada lanjutannya, dan tab yang
     sedang aktif otomatis digeser ke tengah. */
    .tabs-bungkus { 
      position: relative;
      display: flex;
      align-items: stretch;
    }

    .tabs-bungkus .tabs {
      flex: 1;
      min-width: 0;
      scroll-behavior: smooth;
    }

    .tabs-bungkus::before,
    .tabs-bungkus::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 26px;
      pointer-events: none;
      z-index: 31;
      opacity: 0;
      transition: opacity .2s;
    }

    .tabs-bungkus::before {
      left: 0;
      background: linear-gradient(90deg, var(--hal), transparent);
    }

    .tabs-bungkus::after {
      right: 0;
      background: linear-gradient(270deg, var(--hal), transparent);
    }

    .tabs-bungkus.ada-kiri::before {
      opacity: .95;
    }

    .tabs-bungkus.ada-kanan::after {
      opacity: .95;
    }

    .tabs-nav {
      flex: 0 0 30px;
      border: 0;
      background: transparent;
      color: var(--orange-deep);
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      padding: 0;
      font-family: inherit;
      z-index: 32;
      position: relative;
      transition: opacity .18s, background .15s;
    }

    .tabs-nav:hover:not(:disabled) {
      background: var(--aksen-halus);
    }

    .tabs-nav:disabled {
      opacity: 0;
      pointer-events: none;
    }

    /* Di HP tombolnya disembunyikan — geser jari sudah lebih enak dan
     tombolnya makan tempat. Bayangan tepi tetap ada sebagai penanda.
     Di layar besar tombol dipertahankan karena tidak ada geser jari. */
    @media(max-width:900px) {
      .tabs-nav {
        display: none;
      }
    }
  </style>
</head>

<body>

  <div class="overlay" id="gate-overlay" hidden>
    <div class="welcome">
      <div class="welcome-top">
        <img
          src="data:image/png;base64,"
          alt="FNC Academy">
        <h2>Area Member Private</h2>
        <p>FNC ACADEMY</p>
      </div>
      <div class="welcome-body">
        <label for="gate-code" style="display:block;font-size:10px;color:var(--gray);
        letter-spacing:.1em;text-transform:uppercase;margin-bottom:7px;">Kode Akses</label>
        <input type="password" id="gate-code" class="gate-input" placeholder="XXXX-XXXX-XXXX" autocomplete="off"
          spellcheck="false" maxlength="20">
        <div class="gate-err" id="gate-err" hidden>Kode akses salah. Cek lagi kode dari admin.</div>
        <div class="welcome-actions" style="margin-top:14px;">
          <button class="btn" id="gate-submit">Masuk</button>
        </div>
        <div style="display:flex;align-items:center;gap:10px;margin:16px 0 14px;">
          <span style="flex:1;height:1px;background:var(--line);"></span>
          <span style="font-size:10.5px;color:var(--gray);letter-spacing:.08em;">ATAU</span>
          <span style="flex:1;height:1px;background:var(--line);"></span>
        </div>
        <div class="welcome-actions">
          <button class="btn ghost" id="gate-umum" type="button">Lihat-lihat dulu</button>
        </div>
        <p class="gate-hint">Tanpa kode kamu tetap bisa membaca Berita, Kalender Ekonomi,
          Jurnal, Statistik, dan Kalkulator.<br>
          Kode akses dibagikan di grup private FNC Academy.</p>
      </div>
    </div>
  </div>

  <div id="sorot-kursor" aria-hidden="true"></div>

  <button class="ai-fab" id="ai-fab" type="button" hidden>
    <span class="wa">&#128172;</span><span class="lbl">Tanya AI</span>
  </button>

  <div class="overlay" id="byr-overlay" hidden>
    <div class="gate-card">
      <div id="byr-isi"></div>
      <div class="welcome-actions" style="margin-top:6px;">
        <button class="btn ghost" id="byr-tutup" type="button">Tutup</button>
      </div>
    </div>
  </div>

  <div class="overlay" id="ks-info-overlay" hidden>
    <div class="gate-card peng-kotak">
      <div class="peng-atas">
        <div class="peng-ic" aria-hidden="true" id="ks-info-ic">&#128197;</div>
        <div style="flex:1;min-width:0;">
          <b id="ks-info-judul">Cara Mengajukan Konsultasi</b>
          <span id="ks-info-sub">Baca sebentar sebelum memilih jadwal</span>
        </div>
      </div>
      <div class="peng-isi" id="ks-info-isi"></div>
      <div class="welcome-actions">
        <button class="btn ghost" id="ks-info-batal" type="button" hidden>Nanti Saja</button>
        <button class="btn" id="ks-info-ok" type="button">Saya Paham, Lihat Jadwal</button>
      </div>
    </div>
  </div>
  <div class="overlay" id="peng-overlay" hidden>
    <div class="gate-card peng-kotak">
      <div class="peng-atas">
        <div class="peng-ic" aria-hidden="true">&#128226;</div>
        <div style="flex:1;min-width:0;">
          <b>Pengumuman</b>
          <span>Dari tim FNC Academy</span>
        </div>
      </div>
      <div class="peng-isi" id="peng-isi"></div>
      <div class="welcome-actions">
        <button class="btn" id="peng-lanjut" type="button">Lanjut ke Website</button>
      </div>
    </div>
  </div>
  <div class="overlay" id="grup-overlay" hidden>
    <div class="gate-card grup-card">
      <div class="grup-ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="img" aria-label="WhatsApp">
          <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15
          -.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47
          -.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.53
          .15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.6-.92-2.2
          -.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.470
          0 1.45 1.06 2.86 1.21 3.06.15.2 2.09 3.2 5.08 4.48.71.31 1.26.49 1.69.63
          .71.23 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41
          -.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2
          -3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.18 4.22-9.4 9.42-9.4
          2.51 0 4.88.98 6.65 2.76a9.34 9.34 0 0 1 2.75 6.65c0 5.19-4.22 9.41-9.41 9.41z
          M20.52 3.49A11.78 11.78 0 0 0 12.04 0C5.5 0 .18 5.32.18 11.86c0 2.09.55 4.13 1.6 5.93
          L.08 24l6.35-1.66a11.83 11.83 0 0 0 5.61 1.43h.01c6.53 0 11.85-5.32 11.85-11.86
          0-3.17-1.23-6.15-3.38-8.42z" />
        </svg>
      </div>
      <h3>Gabung Grup Publik FNC Academy</h3>
      <p>Grup WhatsApp gratis untuk yang lagi belajar trading. Tempat ngobrol,
        tanya-tanya, dan dapat info duluan.</p>
      <ul class="grup-list">
        <li>Info sesi live &amp; kelas dibuka</li>
        <li>Bahasan market ringan bareng member lain</li>
        <li>Tanya-jawab bebas, gratis selamanya</li>
      </ul>
      <div class="welcome-actions">
        <button class="btn wa-btn" id="grup-join" type="button">Gabung Sekarang</button>
        <button class="btn ghost" id="grup-skip" type="button">Nanti Saja</button>
      </div>
      <p class="gate-hint">Tautannya juga selalu ada di tab <b>Bantuan</b>,
        jadi bisa gabung kapan saja.</p>
    </div>
  </div>

  <div class="overlay" id="profil-overlay" hidden>
    <div class="gate-card">
      <h3 style="margin:0 0 6px;font-size:17px;">Buat Profil Dulu</h3>
      <p style="font-size:13px;color:var(--slate-2);line-height:1.65;margin:0 0 14px;" id="profil-why">
        Profil dipakai untuk menandai catatan jurnal kamu.
      </p>
      <label for="profil-nama" style="display:block;font-size:10px;color:var(--gray);
      letter-spacing:.09em;text-transform:uppercase;margin-bottom:5px;">Nama Panggilan</label>
      <input id="profil-nama" class="gate-input" placeholder="Contoh: Radit" maxlength="24" autocomplete="off">
      <div class="gate-err" id="profil-err" hidden>Isi nama panggilan dulu ya.</div>
      <div style="background:#FFF7ED;border-left:3px solid var(--orange);border-radius:0 8px 8px 0;
      padding:11px 13px;margin:13px 0 0;font-size:12px;color:var(--slate-2);line-height:1.65;">
        <b>Perlu kamu tahu:</b> profil dan jurnal tersimpan di <b>perangkat ini</b>, bukan di server.
        Kalau ganti HP atau hapus data browser, isinya hilang. Sinkronisasi antar-perangkat menyusul.
        Rutin klik <b>Backup</b> di tab Jurnal ya.
      </div>
      <div style="display:flex;gap:8px;margin-top:15px;">
        <button class="btn" id="profil-save">Buat Profil</button>
        <button class="btn ghost" id="profil-cancel">Nanti Saja</button>
      </div>
    </div>
  </div>

  <div class="overlay" id="upgrade-overlay" hidden>
    <div class="gate-card">
      <h3 style="margin:0 0 6px;font-size:17px;">Masukkan Kode Eksklusif</h3>
      <p style="font-size:13px;color:var(--slate-2);line-height:1.65;margin:0 0 14px;">
        Masukkan kode member yang kamu terima dari admin untuk membuka akses lebih lengkap.
      </p>
      <input type="password" id="upg-code" class="gate-input" placeholder="XXXX-XXXX-XXXX" autocomplete="off"
        spellcheck="false" maxlength="20">
      <div class="gate-err" id="upg-err" hidden>Kode tidak dikenali. Cek lagi dari admin.</div>
      <div style="display:flex;gap:8px;margin-top:15px;">
        <button class="btn" id="upg-save">Buka Akses</button>
        <button class="btn ghost" id="upg-cancel">Tutup</button>
      </div>
    </div>
  </div>

  <div class="overlay" id="welcome-overlay" hidden>
    <div class="welcome">
      <div class="welcome-top">
        <img
          src="data:image/png;base64,"
          alt="FNC Academy">
        <h2>FNC ACADEMY</h2>
        <p>Learn the market, track your progress</p>
      </div>
      <div class="welcome-body">
        <p style="margin:0 0 13px;font-size:13px;line-height:1.75;color:var(--teks-isi);">
          Ini <b>ruang belajar trading</b> milik komunitas FNC Academy &mdash;
          tempat kamu memantau market, membaca update, dan mencatat perkembangan
          trading kamu sendiri.
        </p>
        <ul>
          <li><b>Beranda</b> &mdash; harga real-time &amp; chart semua pair</li>
          <li><b>Berita</b> &mdash; update market &amp; jadwal news penting</li>
          <li><b>Jurnal &amp; Statistik</b> &mdash; catat trade, win rate dan P/L dihitung otomatis</li>
          <li><b>Kalkulator</b> &mdash; ukuran lot dari risiko, nilai pip, cek R:R</li>
          <li><b>Kelas</b> &mdash; pilihan kelas &amp; keanggotaan FNC</li>
        </ul>
        <div class="note">
          <b>Semua di atas gratis dibuka</b>, tanpa kode apa pun. Isi khusus member
          (Analisa, Rekap Live, Materi) terbuka setelah kamu memasukkan kode akses
          di tab <b>Profil</b>.
        </div>
        <div class="note" style="margin-top:9px;">
          <b>Gabung grup WhatsApp publik FNC</b> &mdash; info sesi live, bahasan market,
          dan tanya-jawab bareng member lain. Gratis.
        </div>
        <div class="welcome-actions">
          <button class="btn" id="w-grup">Gabung Grup WhatsApp</button>
          <button class="btn ghost" id="w-skip">Mulai Jelajahi</button>
        </div>
      </div>
    </div>
  </div>

  <div class="shell locked" id="shell">
    <div class="notice-bar" id="storage-notice" hidden>
      <b>Penyimpanan browser tidak aktif.</b> Data hanya bertahan selama halaman ini terbuka.
      Klik <b>Backup</b> di tab Jurnal sebelum menutup, atau buka lewat browser biasa (bukan mode incognito).
    </div>
    <div class="top">
      <div class="brand">
        <img
          src="data:image/png;base64,"
          alt="FNC Academy">
        <div>
          <h1>FNC ACADEMY</h1><span>Learn the market, track your progress</span>
        </div>
      </div>
      <div class="acct-pick">
        <button class="tema-btn" id="tema-btn" type="button" aria-label="Ganti mode terang / gelap"
          title="Mode terang / gelap">&#9789;</button>
        <span class="tier-chip priv" id="tier-chip">Private</span>
        <label for="acct-filter">Akun</label>
        <select id="acct-filter"></select>
      </div>
    </div>

    <div class="tabs-bungkus"><button class="tabs-nav kiri" id="tabs-kiri" type="button"
        aria-label="Tab sebelumnya">&#10094;</button>
      <div class="tabs" id="tabs">
        <button class="tab active" data-view="beranda">Beranda</button>
        <button class="tab" data-view="news">Berita</button>
        <button class="tab" data-view="kelas">Kelas</button>
        <button class="tab" data-view="challenge">Challenge</button>
        <button class="tab" data-view="konsul">Konsultasi<span class="lockdot" id="ks-lockdot">&#128274;</span></button>
        <button class="tab" data-view="analisa">Analisa<span class="lockdot" id="an-lockdot">&#128274;</span></button>
        <button class="tab" data-view="rekap">Rekap Live</button>
        <button class="tab" data-view="materi">Materi</button>
        <button class="tab" data-view="calendar">Kalender</button>
        <button class="tab" data-view="journal">Jurnal</button>
        <button class="tab" data-view="dashboard">Statistik</button>
        <button class="tab" data-view="calc">Kalkulator</button>
        <button class="tab" data-view="accounts">Profil</button>
        <button class="tab" data-view="help">Bantuan</button>
        <button class="tab" data-view="info">Informasi</button>
      </div><button class="tabs-nav kanan" id="tabs-kanan" type="button" aria-label="Tab berikutnya">&#10095;</button>
    </div>

    <div class="body">
      <!-- BERANDA -->
      <div class="view active" id="v-beranda">
        <div class="hero" id="hero-kartu">
          <button class="hero-tutup" id="hero-tutup" title="Sembunyikan sapaan"
            aria-label="Sembunyikan sapaan">&#10005;</button>
          <div class="hero-row">
            <div>
              <h2 id="hero-title">Selamat datang</h2>
              <p id="hero-sub">Learn the market, track your progress.</p>
            </div>
            <span class="tier-chip priv" id="hero-tier">Private</span>
          </div>
          <div class="hero-cta" id="hero-cta"></div>
        </div>
        <div id="mk-wrap"></div>
        <div id="beranda-body"></div>
      </div>

      <!-- REKAP LIVE -->
      <div class="view" id="v-rekap">
        <div class="panel">
          <div class="panel-head">
            <h3>REKAP LIVE SESSION</h3>
            <div style="display:flex;align-items:center;gap:9px;">
              <span class="feed-stamp" id="rk-stamp"></span>
              <button class="btn ghost sm" id="rk-reload">Muat Ulang</button>
            </div>
          </div>
          <div class="seg" id="rk-seg" style="margin-bottom:14px;">
            <button class="seg-btn active" type="button" data-rk="umum">Private</button>
            <button class="seg-btn" type="button" data-rk="eks">Eksklusif &#128274;</button>
          </div>
          <div class="cari" id="cari-rk-box"><span class="ic">&#128269;</span><input type="search" id="cari-rk"
              placeholder="Cari judul atau isi..." autocomplete="off"><button class="hapus" type="button"
              aria-label="Hapus pencarian">&times;</button></div>
          <div class="cari-info" id="cari-rk-info" hidden></div>
          <div class="saring" id="saring-rk"><span class="tgl" id="tgl-rk-box"><label for="tgl-rk">Tanggal</label><input
                type="date" id="tgl-rk"></span><button class="chip" type="button" id="tgl-rk-hapus" hidden>Hapus
              tanggal</button></div>
          <div id="rk-list"></div>
        </div>
      </div>

      <!-- MATERI -->
      <div class="view" id="v-materi">
        <div class="panel">
          <div class="panel-head">
            <h3>MATERI BELAJAR</h3>
            <div style="display:flex;align-items:center;gap:9px;">
              <span class="feed-stamp" id="mt-stamp"></span>
              <button class="btn ghost sm" id="mt-reload">Muat Ulang</button>
            </div>
          </div>
          <div class="seg" id="mt-seg" style="margin-bottom:14px;">
            <button class="seg-btn active" type="button" data-mt="umum">Private</button>
            <button class="seg-btn" type="button" data-mt="eks">Eksklusif &#128274;</button>
          </div>
          <div class="cari" id="cari-mt-box"><span class="ic">&#128269;</span><input type="search" id="cari-mt"
              placeholder="Cari judul atau isi..." autocomplete="off"><button class="hapus" type="button"
              aria-label="Hapus pencarian">&times;</button></div>
          <div class="cari-info" id="cari-mt-info" hidden></div>
          <div class="saring" id="saring-mt"></div>
          <div id="mt-list"></div>
        </div>
      </div>

      <!-- STATISTIK -->
      <div class="view" id="v-dashboard">
        <div class="kpi-grid" id="kpi-grid"></div>
        <div class="panel">
          <h3>Equity Curve</h3>
          <svg class="chart" id="equity-chart" viewBox="0 0 800 210" preserveAspectRatio="none"></svg>
        </div>
        <div class="two-col">
          <div class="panel">
            <h3>Statistik Trade</h3>
            <div id="stat-panel"></div>
          </div>
          <div class="panel">
            <h3>Distribusi Hasil</h3>
            <svg class="chart" id="donut-chart" viewBox="0 0 320 200"></svg>
          </div>
        </div>
        <div class="two-col">
          <div class="panel">
            <h3>P/L per Strategi</h3>
            <div id="by-strategy"></div>
          </div>
          <div class="panel">
            <h3>P/L per Market</h3>
            <div id="by-symbol"></div>
          </div>
        </div>
        <div class="panel">
          <h3>P/L Bulanan</h3>
          <svg class="chart" id="monthly-chart" viewBox="0 0 800 200"></svg>
        </div>
      </div>

      <!-- JOURNAL -->
      <div class="view" id="v-journal">
        <div class="toolbar">
          <div class="filters">
            <select id="jf-market">
              <option value="">Semua Market</option>
            </select>
            <select id="jf-result">
              <option value="">Semua Hasil</option>
              <option>Win</option>
              <option>Loss</option>
              <option>BE</option>
            </select>
            <select id="jf-strategy">
              <option value="">Semua Strategi</option>
            </select>
            <input id="jf-search" type="text" placeholder="Cari alasan entry...">
          </div>
          <div style="display:flex;gap:7px;flex-wrap:wrap;">
            <button class="btn ghost sm" id="backup-btn">Backup</button>
            <button class="btn ghost sm" id="restore-btn">Restore</button>
            <button class="btn ghost sm" id="export-csv">CSV</button>
            <button class="btn" id="toggle-form">+ Trade Baru</button>
          </div>
        </div>
        <input type="file" id="restore-file" accept="application/json" hidden>

        <div class="jm-mode" id="jm-mode" hidden>
          <button type="button" class="jm-tab active" data-jm="cepat">Cepat</button>
          <button type="button" class="jm-tab" data-jm="tempel">Tempel</button>
          <button type="button" class="jm-tab" data-jm="lengkap">Lengkap</button>
        </div>

        <div class="form jm-panel" id="jm-cepat">
          <p class="jm-nb">Isi yang penting saja. Sisanya bisa dilengkapi nanti lewat tombol ubah.</p>
          <div class="fgrid">
            <div class="field"><label for="q-market">Market</label>
              <input id="q-market" placeholder="XAUUSD" autocomplete="off">
            </div>
            <div class="field"><label for="q-posisi">Posisi</label>
              <select id="q-posisi">
                <option>Buy</option>
                <option>Sell</option>
              </select>
            </div>
            <div class="field"><label for="q-entry">Entry</label>
              <input id="q-entry" type="number" step="any" inputmode="decimal">
            </div>
            <div class="field"><label for="q-sl">Stop Loss</label>
              <input id="q-sl" type="number" step="any" inputmode="decimal">
            </div>
            <div class="field"><label for="q-tp">Take Profit</label>
              <input id="q-tp" type="number" step="any" inputmode="decimal">
            </div>
            <div class="field"><label for="q-result">Hasil</label>
              <select id="q-result">
                <option>Win</option>
                <option>Loss</option>
                <option>BE</option>
              </select>
            </div>
            <div class="field"><label for="q-risk">Risk %</label>
              <input id="q-risk" type="number" step="any" inputmode="decimal">
              <div class="hint" style="font-size:11px;color:var(--gray);margin-top:4px;">
                Dipakai menghitung untung-rugi di Statistik. Terisi otomatis dari yang terakhir kamu pakai.</div>
            </div>
          </div>
          <div class="welcome-actions" style="margin-top:13px;">
            <button class="btn ghost" type="button" id="q-batal">Batal</button>
            <button class="btn" type="button" id="q-simpan">Simpan Trade</button>
          </div>
        </div>

        <div class="form jm-panel" id="jm-tempel">
          <p class="jm-nb">Salin catatan trade kamu, tempel di bawah. <b>Satu trade satu baris.</b></p>
          <div class="jm-contoh">
            <div class="jm-contoh-atas"><b>Format</b>
              <button class="btn ghost sm" type="button" id="p-salin">Salin Contoh</button>
            </div>
            <code id="p-format">MARKET | ARAH | ENTRY | SL | TP | HASIL</code>
            <pre id="p-contoh">XAUUSD | buy | 4450 | 4440 | 4470 | win
BTCUSD | sell | 78000 | 78500 | 77000 | loss
EURUSD | buy | 1.0850 | 1.0820 | 1.0910 | be</pre>
            <p class="jm-ket">Arah: <b>buy</b> / <b>sell</b> &middot; Hasil: <b>win</b> / <b>loss</b> / <b>be</b><br>
              Mau lebih detail? Tambah Risk % dan tanggal di belakang:<br>
              <code>XAUUSD | buy | 4450 | 4440 | 4470 | win | 1.5 | 2026-08-30</code>
            </p>
          </div>
          <div class="field" style="margin-top:12px;">
            <label for="p-teks">Tempel di sini</label>
            <textarea id="p-teks" rows="7" spellcheck="false"
              placeholder="XAUUSD | buy | 4450 | 4440 | 4470 | win"></textarea>
          </div>
          <div id="p-lapor" class="jm-lapor" hidden></div>
          <div class="welcome-actions" style="margin-top:13px;">
            <button class="btn ghost" type="button" id="p-batal">Batal</button>
            <button class="btn ghost" type="button" id="p-periksa">Periksa Dulu</button>
            <button class="btn" type="button" id="p-simpan">Simpan Semua</button>
          </div>
        </div>

        <div class="form" id="trade-form">
          <div class="fgrid">
            <div class="field"><label for="in-date">Tanggal</label><input type="date" id="in-date"></div>
            <div class="field"><label for="in-jam">Jam Entry</label>
              <input type="time" id="in-jam" step="60">
              <div class="hint" style="font-size:11px;color:var(--gray);margin-top:4px;">
                Dipakai mengurutkan trade di hari yang sama.</div>
            </div>
            <div class="field"><label for="in-account">Akun</label><select id="in-account"></select></div>
            <div class="field"><label for="in-market">Market</label><input type="text" id="in-market"
                placeholder="XAUUSD"></div>
            <div class="field"><label for="in-vol">Volume (Lot)</label><input type="number" step="any" id="in-vol"
                placeholder="0.10"></div>
            <div class="field"><label for="in-entry">Entry</label><input type="number" step="any" id="in-entry"></div>
            <div class="field"><label for="in-sl">Stop Loss</label><input type="number" step="any" id="in-sl"></div>
            <div class="field"><label for="in-tp">Take Profit</label><input type="number" step="any" id="in-tp"></div>
            <div class="field"><label for="in-riskpct">Risk %</label><input type="number" step="any" id="in-riskpct"
                placeholder="1"></div>
            <div class="field"><label for="in-posisi">Posisi</label>
              <select id="in-posisi">
                <option value="Buy">Buy</option>
                <option value="Sell">Sell</option>
              </select>
            </div>
            <div class="field"><label for="in-result">Hasil</label>
              <select id="in-result">
                <option>Win</option>
                <option>Loss</option>
                <option>BE</option>
              </select>
            </div>
            <div class="field"><label for="in-strategy">Strategi</label><input type="text" id="in-strategy"
                placeholder="Order Block"></div>
            <div class="field"><label for="in-tf">Time Frame</label>
              <select id="in-tf">
                <option>M5</option>
                <option>M15</option>
                <option>M30</option>
                <option>H1</option>
                <option>H4</option>
                <option>D1</option>
              </select>
            </div>
            <div class="field"><label>&nbsp;</label>
              <div style="font-size:11px;color:var(--gray);padding-top:9px;">Risk $, R:R & P/L otomatis ↓</div>
            </div>
            <div class="field s4"><label for="in-reason">Alasan Entry</label>
              <textarea id="in-reason" rows="2" placeholder="Setup, konfirmasi, evaluasi..."></textarea>
            </div>
            <div class="calc-preview">
              <div><span id="lbl-cp-risk">Risk $</span><b id="cp-risk">—</b></div>
              <div><span>R:R</span><b id="cp-rr">—</b></div>
              <div><span id="lbl-cp-usd">Net P/L $</span><b id="cp-usd">—</b></div>
              <div><span id="lbl-cp-rp">Setara Rupiah</span><b id="cp-rp">—</b></div>
            </div>
          </div>
          <div class="form-actions">
            <button class="btn ghost" id="cancel-form">Batal</button>
            <button class="btn" id="save-trade">Simpan Trade</button>
          </div>
        </div>

        <div class="tbl-wrap">
          <table class="tbl">
            <thead>
              <tr>
                <th>#</th>
                <th>Tanggal</th>
                <th>Jam</th>
                <th>Market</th>
                <th>Posisi</th>
                <th>Entry</th>
                <th>SL</th>
                <th>TP</th>
                <th>Vol</th>
                <th>Risk%</th>
                <th id="th-risk">Risk $</th>
                <th>R:R</th>
                <th>Hasil</th>
                <th id="th-netmain">Net P/L $</th>
                <th id="th-netsub">Net P/L Rp</th>
                <th>Strategi</th>
                <th>TF</th>
                <th>Alasan</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="journal-tbody"></tbody>
          </table>
          <div class="empty" id="journal-empty" style="display:none;">
            <b>Belum ada trade</b>Klik "+ Trade Baru" untuk mulai mengisi jurnal.
          </div>
        </div>
      </div>


      <!-- BERITA -->
      <div class="view" id="v-news">
        <div class="panel">
          <div class="panel-head">
            <h3>Berita &amp; Update Market</h3>
            <div class="head-actions">
              <span class="feed-stamp" id="news-stamp"></span>
              <button class="btn ghost sm" id="news-reload">Muat Ulang</button>
            </div>
          </div>

          <div class="seg" id="news-seg">
            <button class="seg-btn active" data-nk="umum">Umum</button>
            <button class="seg-btn" data-nk="eks">Eksklusif &#128274;</button>
          </div>

          <div class="cari" id="cari-news-box"><span class="ic">&#128269;</span><input type="search" id="cari-news"
              placeholder="Cari judul atau isi..." autocomplete="off"><button class="hapus" type="button"
              aria-label="Hapus pencarian">&times;</button></div>
          <div class="cari-info" id="cari-news-info" hidden></div>
          <div class="saring" id="saring-news"></div>
          <div id="news-list"></div>

          <div id="news-lock" hidden>
            <div class="lock-box">
              <div class="lock-ico">&#128274;</div>
              <h3 style="margin:0 0 6px;">Berita Eksklusif</h3>
              <p style="font-size:12.5px;color:var(--gray);line-height:1.65;margin:0 0 16px;max-width:430px;">
                Bagian ini butuh kode khusus. Kodenya sama dengan kode untuk membuka
                tab Analisa — sekali dibuka, dua-duanya ikut terbuka.</p>
              <div class="lock-row">
                <input type="password" id="nx-code" placeholder="Kode eksklusif" autocomplete="off" spellcheck="false">
                <button class="btn" id="nx-submit">Buka</button>
              </div>
              <div class="lock-err" id="nx-err" hidden>Kode salah. Coba lagi.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ANALISA (EKSKLUSIF) -->
      <div class="view" id="v-analisa">
        <div class="panel" id="analisa-lock">
          <div class="lock-box">
            <div class="lock-ico">&#128274;</div>
            <h3 style="margin:0 0 6px;">Analisa Market — Akses Khusus</h3>
            <p style="font-size:12.5px;color:var(--gray);line-height:1.65;margin:0 0 16px;max-width:430px;">
              Bagian ini terpisah dari jurnal. Masukkan kode analisa yang dibagikan
              khusus untuk kamu. Kode jurnal biasa tidak berlaku di sini.</p>
            <div class="lock-row">
              <input type="password" id="an-code" placeholder="Kode analisa" autocomplete="off" spellcheck="false">
              <button class="btn" id="an-submit">Buka</button>
            </div>
            <div class="lock-err" id="an-err" hidden>Kode analisa salah. Coba lagi.</div>
          </div>
        </div>

        <div class="panel" id="analisa-body" hidden>
          <div class="panel-head">
            <h3>Analisa Market</h3>
            <div class="head-actions">
              <span class="feed-stamp" id="an-stamp"></span>
              <button class="btn ghost sm" id="an-reload">Muat Ulang</button>
              <button class="btn ghost sm" id="an-lock">Kunci</button>
            </div>
          </div>
          <div class="cari" id="cari-an-box"><span class="ic">&#128269;</span><input type="search" id="cari-an"
              placeholder="Cari judul atau isi..." autocomplete="off"><button class="hapus" type="button"
              aria-label="Hapus pencarian">&times;</button></div>
          <div class="cari-info" id="cari-an-info" hidden></div>
          <div class="saring" id="saring-an"></div>
          <div id="analisa-list"></div>
        </div>
      </div>

      <!-- KALENDER EKONOMI -->
      <div class="view" id="v-calendar">
        <div class="panel">
          <div class="panel-head">
            <h3>KALENDER EKONOMI</h3>
            <div style="display:flex;align-items:center;gap:9px;">
              <span class="feed-stamp" id="kal-stamp"></span>
              <button class="btn ghost sm" id="kal-reload">Muat Ulang</button>
            </div>
          </div>
          <div class="cari" id="cari-kal-box"><span class="ic">&#128269;</span><input type="search" id="cari-kal"
              placeholder="Cari nama rilis atau negara..." autocomplete="off"><button class="hapus" type="button"
              aria-label="Hapus pencarian">&times;</button></div>
          <div class="cari-info" id="cari-kal-info" hidden></div>
          <div class="kal-tgl" id="kal-tgl-pilih">
            <span class="lbl">Tanggal</span>
            <select id="kal-th" aria-label="Tahun"></select>
            <select id="kal-bl" aria-label="Bulan"></select>
            <select id="kal-tg" aria-label="Tanggal"></select>
            <button class="btn ghost sm" type="button" id="kal-tgl-clr">Semua</button>
          </div>
          <div class="kal-filter" id="kal-dmp-chips">
            <span class="lbl">Dampak</span>
            <button class="kdc all on" type="button" data-dmp="0">Semua</button>
            <button class="kdc d3" type="button" data-dmp="3"><i></i><i></i><i></i>Tinggi</button>
            <button class="kdc d2" type="button" data-dmp="2"><i></i><i></i><i></i>Sedang</button>
            <button class="kdc d1" type="button" data-dmp="1"><i></i><i></i><i></i>Rendah</button>
          </div>
          <div id="kal-list"></div>
        </div>
      </div>

      <!-- KONSULTASI -->
      <div class="view" id="v-konsul">
        <div class="panel">
          <div class="panel-head">
            <h3>KONSULTASI 1-ON-1</h3>
            <button class="btn ghost sm" id="ks-reload">Muat Ulang</button>
          </div>
          <div class="seg" id="ks-seg" style="margin-bottom:14px;">
            <button class="seg-btn active" type="button" data-ks="ada">Kosong</button>
            <button class="seg-btn" type="button" data-ks="semua">Semua Jadwal</button>
            <button class="seg-btn" type="button" data-ks="saya">Ajuan Saya</button>
          </div>
          <div id="ks-list"></div>
        </div>
        <div class="panel" id="ks-panel-detail" hidden>
          <button class="btn ghost sm" id="ks-kembali" style="margin-bottom:13px;">&larr; Semua Jadwal</button>
          <div id="ks-detail"></div>
        </div>
      </div>

      <!-- FNC CHALLENGE -->
      <div class="view" id="v-challenge">
        <div class="panel">
          <div class="panel-head">
            <h3>FNC CHALLENGE</h3>
          </div>
          <div id="ch-isi"></div>
        </div>
      </div>

      <!-- KELAS -->
      <div class="view" id="v-kelas">
        <div class="panel">
          <div class="panel-head">
            <h3>KELAS FNC ACADEMY</h3>
            <button class="btn ghost sm" id="kls-reload">Muat Ulang</button>
          </div>
          <div id="kls-list"></div>
        </div>
        <div class="panel kls-detail" id="kls-detail" hidden>
          <button class="btn ghost sm" id="kls-kembali" style="margin-bottom:13px;">&larr; Semua Kelas</button>
          <div id="kls-detail-isi"></div>
        </div>
      </div>

      <!-- INFORMASI -->
      <div class="view" id="v-info">
        <div class="panel">
          <div class="panel-head">
            <h3>INFORMASI &amp; KONTAK</h3>
          </div>
          <div id="info-isi"></div>
        </div>
      </div>

      <!-- CALCULATOR -->
      <div class="view" id="v-calc">
        <div class="panel">
          <h3>Setelan Instrumen</h3>
          <div class="fgrid">
            <div class="field s2"><label for="c-inst">Instrumen</label>
              <select id="c-inst"></select>
            </div>
            <div class="field"><label for="c-contract">Contract Size</label>
              <input type="number" step="any" id="c-contract">
            </div>
            <div class="field"><label for="c-pip">Ukuran 1 Pip</label>
              <input type="number" step="any" id="c-pip">
            </div>
            <div class="field s2"><label for="c-price">Harga Sekarang</label>
              <input type="number" step="any" id="c-price" placeholder="mis. 3300">
            </div>
            <div class="field s2"><label for="c-cur">Satuan Hasil</label>
              <select id="c-cur">
                <option value="USD">USD — akun dolar</option>
                <option value="USC">USC — akun cent</option>
              </select>
            </div>
          </div>
          <div class="calc-out" id="c-pipval"></div>
          <p class="calc-note" id="c-inst-note"></p>
        </div>

        <div class="two-col">
          <div class="panel">
            <h3>Ukuran Lot dari Risiko</h3>
            <p class="calc-note" style="margin-top:-4px;">Hitung berapa lot supaya kerugian saat kena SL persis sesuai
              risiko yang kamu tetapkan.</p>
            <div class="fgrid" style="grid-template-columns:1fr 1fr;">
              <div class="field"><label for="c-bal">Saldo</label>
                <input type="number" step="any" id="c-bal" placeholder="1000">
              </div>
              <div class="field"><label for="c-risk">Risk %</label>
                <input type="number" step="any" id="c-risk" placeholder="1">
              </div>
              <div class="field"><label for="c-ls-entry">Entry</label>
                <input type="number" step="any" id="c-ls-entry">
              </div>
              <div class="field"><label for="c-ls-sl">Stop Loss</label>
                <input type="number" step="any" id="c-ls-sl">
              </div>
            </div>
            <div class="calc-out" id="c-lotout"></div>
          </div>

          <div class="panel">
            <h3>Simulasi Profit / Loss</h3>
            <p class="calc-note" style="margin-top:-4px;">Perkirakan hasil sebelum entry, atau cek berapa harusnya P/L
              dari trade yang sudah jalan.</p>
            <div class="fgrid" style="grid-template-columns:1fr 1fr;">
              <div class="field"><label for="c-pl-lot">Volume (Lot)</label>
                <input type="number" step="any" id="c-pl-lot" placeholder="0.01">
              </div>
              <div class="field"><label for="c-pl-dir">Arah</label>
                <select id="c-pl-dir">
                  <option value="buy">Buy / Long</option>
                  <option value="sell">Sell / Short</option>
                </select>
              </div>
              <div class="field"><label for="c-pl-entry">Entry</label>
                <input type="number" step="any" id="c-pl-entry">
              </div>
              <div class="field"><label for="c-pl-exit">Exit</label>
                <input type="number" step="any" id="c-pl-exit">
              </div>
            </div>
            <div class="calc-out" id="c-plout"></div>
          </div>
        </div>

        <div class="panel">
          <h3>Cek Risk : Reward</h3>
          <p class="calc-note" style="margin-top:-4px;">Lihat rasio R:R dan jarak pip sebelum pasang order.</p>
          <div class="fgrid">
            <div class="field"><label for="c-rr-entry">Entry</label><input type="number" step="any" id="c-rr-entry">
            </div>
            <div class="field"><label for="c-rr-sl">Stop Loss</label><input type="number" step="any" id="c-rr-sl"></div>
            <div class="field"><label for="c-rr-tp">Take Profit</label><input type="number" step="any" id="c-rr-tp">
            </div>
            <div class="field"><label for="c-rr-lot">Volume (Lot)</label><input type="number" step="any" id="c-rr-lot"
                placeholder="0.01"></div>
          </div>
          <div class="calc-out" id="c-rrout"></div>
        </div>

        <div class="panel">
          <h3>Catatan Penting</h3>
          <div class="help-block">
            <ul>
              <li><b>Pip vs point.</b> Untuk XAUUSD, 1 pip = 0.1 (setara 10 point di MT5). Sebagian trader menyebut 0.01
                sebagai "pip" — kalau kamu terbiasa begitu, ubah saja kolom Ukuran 1 Pip jadi 0.01.</li>
              <li><b>Akun cent (USC).</b> Angka pip value-nya sama, cuma satuannya USC, bukan dolar. Contoh: 1 lot
                XAUUSD = 10 per pip — di akun standar artinya $10, di akun cent artinya 10 USC (setara $0,10).</li>
              <li><b>Hasil ini perkiraan.</b> Belum termasuk spread, komisi, swap, dan slippage. Angka riil di broker
                akan sedikit berbeda — selalu cross-check contract size di spesifikasi kontrak broker kamu.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- ACCOUNTS -->
      <div class="view" id="v-accounts">
        <div class="prof-card" id="profil-card"></div>
        <div class="kurs-box">
          <span>Kurs USD → IDR:</span>
          <input type="number" id="kurs-input" step="any">
          <button class="btn sm" id="save-kurs">Simpan Kurs</button>
          <span style="color:var(--gray);font-size:11.5px;">Dipakai untuk konversi P/L ke Rupiah.</span>
        </div>
        <div class="toolbar">
          <div style="font-size:11.5px;color:var(--gray);letter-spacing:.08em;text-transform:uppercase;">Master Data
            Akun</div>
          <button class="btn" id="toggle-acct-form">+ Akun Baru</button>
        </div>
        <div class="form" id="acct-form">
          <div class="fgrid">
            <div class="field s2"><label for="a-name">Nama Akun</label><input type="text" id="a-name"
                placeholder="Akun Utama"></div>
            <div class="field"><label for="a-broker">Broker</label><input type="text" id="a-broker"
                placeholder="EXNESS"></div>
            <div class="field"><label for="a-type">Tipe Akun</label><input type="text" id="a-type"
                placeholder="Standard / Raw Spread"></div>
            <div class="field"><label for="a-currency">Currency</label><select id="a-currency">
                <option value="USD">USD — Dolar</option>
                <option value="USC">USC — Cent (akun sen)</option>
                <option value="IDR">IDR — Rupiah</option>
              </select></div>
            <div class="field"><label for="a-balance">Saldo Awal</label><input type="number" step="any" id="a-balance"
                placeholder="1000"></div>
            <div class="field"><label for="a-start">Start Date</label><input type="date" id="a-start"></div>
            <div class="field"><label for="a-status">Status</label><select id="a-status">
                <option>Active</option>
                <option>Inactive</option>
              </select></div>
            <div class="field s4"><label for="a-notes">Catatan</label><input type="text" id="a-notes"
                placeholder="Opsional"></div>
          </div>
          <div class="form-actions">
            <button class="btn ghost" id="cancel-acct">Batal</button>
            <button class="btn" id="save-acct">Simpan Akun</button>
          </div>
        </div>
        <div id="acct-list"></div>
        <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--line);">
          <button class="btn danger sm" id="reset-all">Hapus Semua Data</button>
          <span style="font-size:11px;color:var(--gray);margin-left:8px;">Backup dulu sebelum reset.</span>
        </div>
      </div>

      <!-- HELP -->
      <div class="view" id="v-help">
        <div class="hp-cari-bar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7" />
            <path d="M20 20l-3.5-3.5" />
          </svg>
          <input id="hp-cari" type="text" autocomplete="off"
            placeholder="Cari: jurnal, kode akses, konsultasi, chart...">
          <button class="hp-cari-x" id="hp-cari-x" type="button">&#10005;</button>
        </div>
        <div class="hp-chips" id="hp-chips"></div>
        <div class="hp-info" id="hp-info" hidden></div>
        <div id="hp-isi"></div>
      </div>
    </div>

    <div class="foot">
      FNC Academy — Edukasi Trading. Semua isi di sini adalah bahan belajar dan alat bantu evaluasi pribadi, bukan
      sinyal atau rekomendasi investasi.
    </div>
  </div>

  <script>
    (function () {
      "use strict";
      /* ============================================================
         KODE AKSES MEMBER PRIVATE (gerbang aplikasi jurnal)
         Kodenya SENGAJA tidak ditulis di sini. Berkas ini publik di GitHub —
         siapa pun bisa membacanya. Yang disimpan hanya sidik SHA-256 di bawah,
         dan sidik tidak bisa dibalik menjadi kode.
         (tanda strip & spasi diabaikan saat member mengetik)
    
         Cara ganti kode:
         1. Tentukan kode baru, huruf besar semua. Hindari huruf I/O dan angka 0/1
            supaya member tidak salah baca.
         2. Hitung SHA-256 dari kode itu (huruf besar, TANPA tanda strip).
            Cara cepat: buka Console browser (F12), tempel perintah ini:
              crypto.subtle.digest('SHA-256',new TextEncoder().encode('KODEBARU'))
                .then(b=>console.log([...new Uint8Array(b)]
                .map(x=>x.toString(16).padStart(2,'0')).join('')))
         3. Tempel hasil hex-nya ke ACCESS_CODE_HASH di bawah, dan perbarui
            catatan kode di komentar ini biar tidak lupa.
    
         Catatan jujur: gerbang ini menyaring, bukan mengunci. Kode aslinya memang
         sudah tidak bisa dibaca dari source, tapi orang yang paham DevTools tetap
         bisa melewatinya. Yang benar-benar terkunci adalah ISI berita eksklusif &
         analisa — itu dienkripsi AES-256-GCM, bukan sekadar dijaga gerbang.
         ============================================================ */
      /* Hash SHA-256 dari kode jurnal — kode aslinya TIDAK tersimpan di berkas ini.
         Ganti kode: hitung SHA-256 dari kode baru (huruf besar, tanpa tanda hubung),
         tempel hex-nya di sini. */
      const ACCESS_CODE_HASH = 'c1dd83f96b78adc013a54064353e5023a566748f37585a4eb05172ffedf14915';
      /* Sidik kode eksklusif. Dulu kode ini HANYA diuji dengan mencoba membuka
         berkas di server — jadi begitu salah satu berkas eksklusif basi, gagal
         diunduh, atau terlalu besar untuk dibuka di HP, kode yang BENAR pun
         ditolak dengan pesan "kode salah". Sidik ini dipakai sebagai cadangan.
         Aman: sidik tidak bisa dibalik jadi kode, dan isinya tetap butuh
         dekripsi sungguhan untuk terbaca. */
      const EKS_CODE_HASH = '8b14cdc5ab58d02cbd3a7b9d5799f5158cda619752844ca73f52861339734c04';
      async function kodeEksCocok(kode) {
        try { return (await fncHash(fncNormKode(kode))) === EKS_CODE_HASH; } catch (e) { return false; }
      }

      /* ------------------------------------------------------------
         KODE EKSKLUSIF (berita eksklusif + analisa).
         TIDAK ADA di berkas ini — sengaja. Isi berita-eksklusif.json dan
         analisa.json dienkripsi AES-256-GCM memakai kode itu sebagai kunci.
         Kode dinyatakan benar kalau berhasil membuka berkasnya; salah sedikit
         saja, isinya tetap tidak terbaca. Ganti kode = cukup unduh ulang
         berkas dari admin.html memakai kode baru, berkas ini tidak perlu diubah.
         ------------------------------------------------------------ */

      /* ============================================================
         KRIPTO FNC — AES-256-GCM + PBKDF2-SHA256
         Isi berkas benar-benar dienkripsi. Tanpa kode yang benar,
         isinya tidak bisa dibuka dengan cara apapun (termasuk DevTools).
         ============================================================ */
      /* Normalisasi kode: huruf besar, buang strip/spasi/simbol.
         WAJIB identik di admin & member — kalau beda, kunci tidak akan cocok. */
      /* ============================================================
         KRIPTO FNC v3 — AES-256-GCM + PBKDF2-SHA256
         Format v3: { v:3, teaser:[...], salt, iv, ct }
           teaser = TIDAK dikunci (judul, tanggal, label) -> untuk pratinjau buram
           ct     = TERKUNCI penuh (isi, link, gambar)    -> hanya dengan kode benar
         Isi asli tidak pernah dikirim ke member yang belum punya kode.
         ============================================================ */
      function fncNormKode(s) { return String(s || '').toUpperCase().replace(/[^A-Z0-9]/g, ''); }
      const FNC_ITER = 200000;
      const _keyCache = new Map();
      function _b64e(buf) {
        const b = new Uint8Array(buf); let s = '';
        for (let i = 0; i < b.length; i += 8192)s += String.fromCharCode.apply(null, b.subarray(i, i + 8192));
        return btoa(s);
      }
      function _b64d(str) {
        const s = atob(str), b = new Uint8Array(s.length);
        for (let i = 0; i < s.length; i++)b[i] = s.charCodeAt(i); return b;
      }
      function fncKriptoSiap() {
        return !!(typeof crypto !== 'undefined' && crypto.subtle && crypto.getRandomValues);
      }
      async function _kunci(code, salt, iter) {
        const tag = code + '|' + _b64e(salt) + '|' + iter;
        if (_keyCache.has(tag)) return _keyCache.get(tag);
        const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(code), 'PBKDF2', false, ['deriveKey']);
        const k = await crypto.subtle.deriveKey(
          { name: 'PBKDF2', salt: salt, iterations: iter, hash: 'SHA-256' },
          base, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
        _keyCache.set(tag, k);
        return k;
      }
      /* Ringkasan aman untuk pratinjau — SENGAJA TIDAK memuat judul.
         Judul saja sudah cukup membocorkan isi. */
      function fncTeaser(arr) {
        return (arr || []).map(function (x) {
          return {
            id: x.id || '',
            date: x.date || '',
            pub: x.pub || null,
            tag: x.tag || '',
            jenis: x.jenis || '',
            blur: x.blur || null,
            vid: !!(x.url || x.video)
          };
        });
      }
      /* ---------- v4: enkripsi sekali, kunci dibungkus per kode ---------- */
      async function fncEnkripsiV4(kodeList, obj, pakaiTeaser) {
        if (!fncKriptoSiap()) throw new Error('NOCRYPTO');
        const kode = (kodeList || []).map(fncNormKode).filter(Boolean);
        if (!kode.length) throw new Error('NOKODE');

        /* kunci isi: acak, tidak berasal dari kode manapun */
        const kunciIsi = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, true, ['encrypt', 'decrypt']);
        const iv = crypto.getRandomValues(new Uint8Array(12));
        const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv: iv }, kunciIsi,
          new TextEncoder().encode(JSON.stringify(obj)));
        const mentah = await crypto.subtle.exportKey('raw', kunciIsi);

        const bungkus = [];
        for (const k of kode) {
          const salt = crypto.getRandomValues(new Uint8Array(16));
          const ivk = crypto.getRandomValues(new Uint8Array(12));
          const kk = await _kunci(k, salt, FNC_ITER);
          const wrap = await crypto.subtle.encrypt({ name: 'AES-GCM', iv: ivk }, kk, mentah);
          bungkus.push({ salt: _b64e(salt), iv: _b64e(ivk), wrap: _b64e(wrap) });
        }
        const out = {
          v: 4, alg: 'AES-256-GCM', kdf: 'PBKDF2-SHA256', iter: FNC_ITER,
          iv: _b64e(iv), ct: _b64e(ct), kunci: bungkus
        };
        if (pakaiTeaser !== false) out.teaser = fncTeaser(obj);
        return out;
      }
      /* v3 lama: satu kode, kunci diturunkan langsung dari kodenya */
      async function fncEnkripsi(code, obj, pakaiTeaser) {
        return fncEnkripsiV4([code], obj, pakaiTeaser);
      }
      async function fncDekripsi(code, d) {
        if (!fncKriptoSiap()) throw new Error('NOCRYPTO');
        const k = fncNormKode(code);
        if (d && d.v === 4 && Array.isArray(d.kunci)) {
          /* coba tiap bungkus kunci sampai ada yang terbuka */
          for (const b of d.kunci) {
            try {
              const kk = await _kunci(k, _b64d(b.salt), d.iter || FNC_ITER);
              const mentah = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: _b64d(b.iv) }, kk, _b64d(b.wrap));
              const kunciIsi = await crypto.subtle.importKey('raw', mentah, { name: 'AES-GCM' }, false, ['decrypt']);
              const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: _b64d(d.iv) }, kunciIsi, _b64d(d.ct));
              return JSON.parse(new TextDecoder().decode(pt));
            } catch (e) { /* bungkus ini bukan untuk kode tersebut, coba berikutnya */ }
          }
          throw new Error('KODESALAH');
        }
        /* format lama v2/v3 */
        const key = await _kunci(k, _b64d(d.salt), d.iter || FNC_ITER);
        const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: _b64d(d.iv) }, key, _b64d(d.ct));
        return JSON.parse(new TextDecoder().decode(pt));
      }
      async function fncHash(s) {
        const h = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
        return Array.from(new Uint8Array(h)).map(x => x.toString(16).padStart(2, '0')).join('');
      }
      /* ---------- jadwal tayang ---------- */
      function fncWaktuTerbit(it) {
        if (it && it.pub) { const t = new Date(it.pub).getTime(); if (!isNaN(t)) return t; }
        if (it && it.date) { const t = new Date(it.date + 'T00:00:00').getTime(); if (!isNaN(t)) return t; }
        return 0;
      }
      function fncSudahTayang(it) {
        if (!it || !it.pub) return true;
        const t = new Date(it.pub).getTime();
        return isNaN(t) ? true : t <= Date.now();
      }

      const K_ACC = 'fncjt_accounts', K_TR = 'fncjt_trades', K_SET = 'fncjt_settings',
        K_SEEN = 'fncjt_seen', K_GATE = 'fncjt_unlocked',
        K_DEMO = 'fncjt_demo_ditawarkan',
        K_PROFIL = 'fncjt_profil', K_TIER = 'fncjt_tier';
      let tier = 'private';          /* 'private' | 'eks' */
      let profil = null;             /* {id,nama,dibuat} — tersimpan LOKAL, bukan server */
      let accounts = [], trades = [], settings = { kurs: 17000 };
      let editTradeId = null, editAcctId = null;
      const $ = id => document.getElementById(id);

      /* ---------- STORAGE ADAPTER (berlapis + tahan gagal) ----------
         Urutan: window.storage (khusus preview Claude) → localStorage (saat di-host
         atau dibuka sendiri) → memori sesi (darurat, hilang saat halaman ditutup).
         Kalau satu lapis error, otomatis turun ke lapis berikutnya. */
      const store = (function () {
        const mem = {};
        let claudeOK = typeof window !== 'undefined' && window.storage &&
          typeof window.storage.get === 'function';
        let localOK = (function () {
          try {
            const k = '__probe_' + Date.now(); window.localStorage.setItem(k, '1');
            window.localStorage.removeItem(k); return true;
          } catch (e) { return false; }
        })();
        return {
          get mode() { return claudeOK ? 'claude' : (localOK ? 'local' : 'memory'); },
          async get(k) {
            if (claudeOK) {
              try {
                const r = await window.storage.get(k, false);
                if (r && r.value != null) return JSON.parse(r.value);
              } catch (e) { }
            }
            if (localOK) {
              try {
                const r = window.localStorage.getItem(k);
                if (r != null) return JSON.parse(r);
              } catch (e) { }
            }
            return (k in mem) ? mem[k] : null;
          },
          async set(k, v) {
            mem[k] = v;
            if (claudeOK) {
              try { await window.storage.set(k, JSON.stringify(v), false); return true; }
              catch (e) { claudeOK = false; }
            }
            if (localOK) {
              try { window.localStorage.setItem(k, JSON.stringify(v)); return true; }
              catch (e) { localOK = false; }
            }
            return false;
          }
        };
      })();

      function updateStorageNotice() {
        const el = $('storage-notice');
        if (!el) return;
        el.hidden = store.mode !== 'memory';
      }

      async function persist() {
        const a = await store.set(K_ACC, accounts);
        const b = await store.set(K_TR, trades);
        const c = await store.set(K_SET, settings);
        updateStorageNotice();
        return a && b && c;
      }

      /* ---------- DEMO DATA ---------- */
      function demoData() {
        const acc = {
          id: 'demo_acc', name: 'Akun Demo', broker: 'EXNESS', type: 'Standard', currency: 'USD',
          startBalance: 1000, startDate: '2026-01-01', status: 'Active', notes: 'Contoh — hapus kalau sudah paham'
        };
        const rows = [
          ['2026-05-04', 'XAUUSD', 3210.5, 3204.2, 3229.4, 0.05, 1, 'Win', 'Order Block', 'H1', 'Retest OB demand, konfirmasi bullish'],
          ['2026-05-06', 'XAUUSD', 3241.8, 3248.6, 3221.4, 0.05, 1, 'Win', 'Liquidity Sweep', 'M15', 'Sweep high lalu reversal'],
          ['2026-05-08', 'EURUSD', 1.0912, 1.0928, 1.0880, 0.10, 1, 'Loss', 'Break of Structure', 'H1', 'Struktur gagal lanjut, kena SL'],
          ['2026-05-12', 'XAUUSD', 3268.3, 3261.9, 3287.5, 0.05, 1, 'Win', 'FVG Fill', 'H4', 'Isi imbalance lalu lanjut trend'],
          ['2026-05-14', 'XAUUSD', 3290.1, 3296.4, 3277.6, 0.05, 1, 'BE', 'Supply/Demand', 'M15', 'Tutup manual di BE, momentum melemah'],
          ['2026-05-18', 'GBPUSD', 1.2745, 1.2762, 1.2711, 0.10, 1, 'Win', 'Trend Following', 'H1', 'Pullback ke EMA, lanjut trend turun'],
          ['2026-05-21', 'XAUUSD', 3312.7, 3305.8, 3333.4, 0.05, 1, 'Win', 'Order Block', 'H4', 'OB H4 valid, target R tercapai'],
          ['2026-05-25', 'XAUUSD', 3345.2, 3352.1, 3331.5, 0.05, 1, 'Loss', 'Liquidity Sweep', 'M15', 'Salah baca sweep, kena SL']
        ];
        const tr = rows.map((r, i) => ({
          id: 'demo_' + i, accountId: acc.id, date: r[0], market: r[1], entry: r[2], sl: r[3], tp: r[4],
          vol: r[5], riskPct: r[6], result: r[7], strategy: r[8], tf: r[9], reason: r[10]
        }));
        return { acc, tr };
      }

      /* ---------- HELPERS ---------- */
      const acctById = id => accounts.find(a => a.id === id);
      function balUSD(a) {
        if (!a) return 0;
        if (a.currency === 'IDR') return a.startBalance / (settings.kurs || 1);
        if (a.currency === 'USC') return a.startBalance / 100;   // 1 USD = 100 USC
        return a.startBalance;
      }
      function money(n) { return (n < 0 ? '-$' : '$') + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
      function uscFmt(n) { return (n < 0 ? '-' : '') + Math.abs(n).toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' USC'; }
      function usc(n) { return uscFmt(n * 100); }
      function rupiah(n) { return (n < 0 ? '-Rp' : 'Rp') + Math.abs(n).toLocaleString('id-ID', { maximumFractionDigits: 0 }); }

      /* ---------------------------------------------------------------
         SATU-SATUNYA formatter uang. Semua nilai disimpan internal dalam
         USD; fungsi ini yang mengubahnya ke mata uang akun bersangkutan.
         Jangan panggil money()/rupiah() langsung di tampilan — pakai ini,
         supaya akun cent & rupiah tidak pernah salah satuan lagi.
         --------------------------------------------------------------- */
      function fmtByCur(usdVal, cur) {
        if (cur === 'USC') return uscFmt(usdVal * 100);
        if (cur === 'IDR') return rupiah(usdVal * (settings.kurs || 0));
        return money(usdVal);
      }
      function unitOf(cur) { return cur === 'USC' ? 'USC' : (cur === 'IDR' ? 'Rp' : '$'); }
      /* Baris kedua: akun USD/USC dapat padanan Rupiah, akun IDR dapat padanan USD */
      function fmtSubByCur(usdVal, cur) {
        return cur === 'IDR' ? money(usdVal) : rupiah(usdVal * (settings.kurs || 0));
      }

      function activeCurrency() {
        const id = currentAccId();
        if (!id) return 'USD';
        const a = acctById(id);
        return a ? a.currency : 'USD';
      }
      function fmtMain(usdVal) { return fmtByCur(usdVal, activeCurrency()); }
      function mainUnit() { return unitOf(activeCurrency()); }
      function fmtSub(usdVal) { return fmtSubByCur(usdVal, activeCurrency()); }
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

      /* Arah posisi. Trade lama belum punya kolom ini, jadi ditebak dari
         letak Stop Loss: SL di bawah Entry = Buy, SL di atas Entry = Sell. */
      function arahPosisi(t) {
        if (t.posisi === 'Buy' || t.posisi === 'Sell') return t.posisi;
        const e = parseFloat(t.entry), s = parseFloat(t.sl);
        if (isNaN(e) || isNaN(s)) return '';
        return s < e ? 'Buy' : 'Sell';
      }
      function lencanaPosisi(t) {
        const a = arahPosisi(t);
        if (!a) return '<span style="color:var(--gray)">&mdash;</span>';
        return '<span class="posisi ' + a.toLowerCase() + '">' + a.toUpperCase() + '</span>';
      }

      function compute(t) {
        const a = acctById(t.accountId);
        if (!a) return { risk: 0, rr: 0, usd: 0, rp: 0 };
        const risk = (t.riskPct / 100) * balUSD(a);
        const slDist = Math.abs(t.entry - t.sl), tpDist = Math.abs(t.tp - t.entry);
        const rr = slDist > 0 ? tpDist / slDist : 0;
        let usd = 0;
        if (t.result === 'Win') usd = risk * rr;
        else if (t.result === 'Loss') usd = -risk;
        return { risk, rr, usd, rp: usd * (settings.kurs || 0) };
      }
      const currentAccId = () => $('acct-filter').value || null;
      function tradesFor(id) { return id ? trades.filter(t => t.accountId === id) : trades.slice(); }

      function stats(list) {
        const wc = list.map(t => ({ t, c: compute(t) }));
        const wins = wc.filter(x => x.t.result === 'Win'), losses = wc.filter(x => x.t.result === 'Loss');
        const bes = wc.filter(x => x.t.result === 'BE'), total = wc.length;
        const netUsd = wc.reduce((s, x) => s + x.c.usd, 0);
        const sumWin = wins.reduce((s, x) => s + x.c.usd, 0), sumLoss = Math.abs(losses.reduce((s, x) => s + x.c.usd, 0));
        /* kurva ekuitas: kronologis, jadi kebalikan dari daftar jurnal */
        const sorted = [...wc].map((x, i) => ({ x: x, k: kunciUrut(x.t, i) }))
          .sort((a, b) => bandingTrade(b.k, a.k)).map(o => o.x);
        let eq = 0, peak = 0, maxDD = 0; const curve = [0];
        sorted.forEach(x => { eq += x.c.usd; curve.push(eq); if (eq > peak) peak = eq; const dd = peak - eq; if (dd > maxDD) maxDD = dd; });
        return {
          total, wins: wins.length, losses: losses.length, bes: bes.length, netUsd,
          winRate: total ? wins.length / total * 100 : 0,
          pf: sumLoss > 0 ? sumWin / sumLoss : (sumWin > 0 ? Infinity : 0),
          avgWin: wins.length ? sumWin / wins.length : 0,
          avgLoss: losses.length ? -sumLoss / losses.length : 0,
          expectancy: total ? netUsd / total : 0,
          avgRR: total ? wc.reduce((s, x) => s + x.c.rr, 0) / total : 0,
          largestWin: wins.length ? Math.max(...wins.map(x => x.c.usd)) : 0,
          largestLoss: losses.length ? Math.min(...losses.map(x => x.c.usd)) : 0,
          maxDD, curve, netRp: netUsd * (settings.kurs || 0)
        };
      }

      /* ---------- DASHBOARD ---------- */
      function kpi(l, v, sub, cls) {
        return `<div class="kpi"><div class="k-label">${l}</div>
    <div class="k-val ${cls}">${v}</div>${sub ? `<div class="k-sub">${sub}</div>` : ''}</div>`;
      }

      function renderDashboard() {
        const id = currentAccId(), list = tradesFor(id), s = stats(list), acc = id ? acctById(id) : null;
        const base = acc ? balUSD(acc) : accounts.reduce((sum, a) => sum + balUSD(a), 0);
        const cls = v => v > 0 ? 'pos' : v < 0 ? 'neg' : 'neu';
        $('kpi-grid').innerHTML =
          kpi('Total Trades', s.total, '', 'neu') +
          kpi('Win Rate', s.total ? s.winRate.toFixed(1) + '%' : '—', '', s.winRate >= 50 ? 'pos' : 'neu') +
          kpi('Net P/L (' + mainUnit() + ')', fmtMain(s.netUsd), fmtSub(s.netUsd), cls(s.netUsd)) +
          kpi('Profit Factor', s.total ? (s.pf === Infinity ? '∞' : s.pf.toFixed(2)) : '—', '', s.pf >= 1 ? 'pos' : 'neu') +
          kpi('Saldo Saat Ini', fmtMain(base + s.netUsd), fmtSub(base + s.netUsd), 'neu') +
          kpi('Max Drawdown', fmtMain(-s.maxDD), '', s.maxDD > 0 ? 'neg' : 'neu') +
          kpi('Avg R-Multiple', s.total ? s.avgRR.toFixed(2) + 'R' : '—', '', s.avgRR >= 1 ? 'pos' : 'neu') +
          kpi('Expectancy / Trade', fmtMain(s.expectancy), '', cls(s.expectancy));

        $('stat-panel').innerHTML = [
          ['Winning Trades', s.wins], ['Losing Trades', s.losses], ['BE Trades', s.bes],
          ['Avg Win', fmtMain(s.avgWin)], ['Avg Loss', fmtMain(s.avgLoss)],
          ['Avg R:R', s.avgRR.toFixed(2)], ['Largest Win', fmtMain(s.largestWin)],
          ['Largest Loss', fmtMain(s.largestLoss)]
        ].map(([l, v]) => `<div class="stat-row"><span class="lbl">${l}</span><span class="v">${v}</span></div>`).join('');

        renderEquity(s.curve); renderDonut(s);
        renderBreak(list, 'strategy', 'by-strategy'); renderBreak(list, 'market', 'by-symbol');
        renderMonthly(list);
      }

      function renderEquity(curve) {
        const svg = $('equity-chart'), w = 800, h = 210, pad = 10;
        if (!curve || curve.length < 2) { svg.innerHTML = `<line x1="0" y1="${h / 2}" x2="${w}" y2="${h / 2}" stroke="#EAD9C7"/>`; return; }
        const min = Math.min(...curve), max = Math.max(...curve), range = (max - min) || 1;
        const stepX = w / (curve.length - 1);
        const pts = curve.map((v, i) => [i * stepX, h - pad - ((v - min) / range) * (h - pad * 2)]);
        const line = pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
        const zeroY = h - pad - ((0 - min) / range) * (h - pad * 2);
        const col = curve[curve.length - 1] >= 0 ? '#16A34A' : '#DC2626';
        svg.innerHTML = `<defs><linearGradient id="eqg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="${col}" stop-opacity=".18"/>
      <stop offset="100%" stop-color="${col}" stop-opacity="0"/></linearGradient></defs>
      <line x1="0" y1="${zeroY.toFixed(1)}" x2="${w}" y2="${zeroY.toFixed(1)}" stroke="#EAD9C7" stroke-dasharray="4 4"/>
      <path class="eq-area" d="${line} L${w},${h} L0,${h} Z" fill="url(#eqg)"/>
      <path class="eq-line" d="${line}" fill="none" stroke="${col}" stroke-width="2.5" stroke-linejoin="round"/>`;
      }

      function renderDonut(s) {
        const svg = $('donut-chart');
        if (!s.total) { svg.innerHTML = `<text x="160" y="100" text-anchor="middle" font-size="12" fill="#9CA3AF" font-family="sans-serif">Belum ada data</text>`; return; }
        const data = [['Win', s.wins, '#16A34A'], ['Loss', s.losses, '#DC2626'], ['BE', s.bes, '#9CA3AF']];
        let a0 = -Math.PI / 2; const cx = 90, cy = 100, r = 62, rin = 38; let paths = '';
        data.forEach(([, val, col]) => {
          if (!val) return;
          const a1 = a0 + (val / s.total) * Math.PI * 2;
          const x0 = cx + r * Math.cos(a0), y0 = cy + r * Math.sin(a0), x1 = cx + r * Math.cos(a1), y1 = cy + r * Math.sin(a1);
          const xi1 = cx + rin * Math.cos(a1), yi1 = cy + rin * Math.sin(a1), xi0 = cx + rin * Math.cos(a0), yi0 = cy + rin * Math.sin(a0);
          const lg = (a1 - a0) > Math.PI ? 1 : 0;
          paths += `<path class="donut-seg" d="M${x0},${y0} A${r},${r} 0 ${lg} 1 ${x1},${y1} L${xi1},${yi1} A${rin},${rin} 0 ${lg} 0 ${xi0},${yi0} Z" fill="${col}"/>`;
          a0 = a1;
        });
        const legend = data.map(([l, v, c], i) => `<g transform="translate(190,${70 + i * 26})">
      <rect width="10" height="10" rx="2" fill="${c}"/>
      <text x="16" y="9" font-size="12" fill="#374151" font-family="sans-serif">${l}: ${v} (${(v / s.total * 100).toFixed(0)}%)</text></g>`).join('');
        svg.innerHTML = paths + `<text x="${cx}" y="${cy - 2}" text-anchor="middle" font-size="20" font-weight="700" fill="#1F2937" font-family="monospace">${s.total}</text>
      <text x="${cx}" y="${cy + 15}" text-anchor="middle" font-size="9" fill="#6B7280" font-family="sans-serif">TRADES</text>` + legend;
      }

      function renderBreak(list, key, elId) {
        const map = {};
        list.forEach(t => { const k = t[key] || '—'; map[k] = (map[k] || 0) + compute(t).usd; });
        const e = Object.entries(map).sort((a, b) => b[1] - a[1]);
        if (!e.length) { $(elId).innerHTML = '<div style="color:#9CA3AF;font-size:12px;">Belum ada data.</div>'; return; }
        const mx = Math.max(...e.map(x => Math.abs(x[1]))) || 1;
        $(elId).innerHTML = e.map(([k, v]) => {
          const col = v >= 0 ? '#16A34A' : '#DC2626';
          return `<div class="bar-row"><div class="bl" title="${esc(k)}">${esc(k)}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${Math.abs(v) / mx * 100}%;background:${col};"></div></div>
        <div class="bv" style="color:${col}">${fmtMain(v)}</div></div>`;
        }).join('');
      }

      function renderMonthly(list) {
        const map = {};
        list.forEach(t => { const m = (t.date || '').slice(0, 7); map[m] = (map[m] || 0) + compute(t).usd; });
        const months = Object.keys(map).filter(Boolean).sort();
        const svg = $('monthly-chart'), w = 800, h = 200, padB = 30, padT = 12;
        if (!months.length) { svg.innerHTML = `<text x="400" y="100" text-anchor="middle" font-size="12" fill="#9CA3AF" font-family="sans-serif">Belum ada data</text>`; return; }
        const mx = Math.max(...months.map(m => Math.abs(map[m]))) || 1;
        const bw = w / months.length, gap = bw * 0.3, mid = padT + (h - padT - padB) / 2;
        let out = '';
        months.forEach((m, i) => {
          const v = map[m], bh = (Math.abs(v) / mx) * ((h - padT - padB) / 2);
          const x = i * bw + gap / 2, bwidth = bw - gap, y = v >= 0 ? mid - bh : mid;
          const col = v >= 0 ? '#16A34A' : '#DC2626';
          out += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bwidth.toFixed(1)}" height="${bh.toFixed(1)}" rx="3" fill="${col}"/>
        <text x="${(x + bwidth / 2).toFixed(1)}" y="${h - padB + 16}" text-anchor="middle" font-size="10" fill="#6B7280" font-family="sans-serif">${m.slice(5)}/${m.slice(2, 4)}</text>
        <text x="${(x + bwidth / 2).toFixed(1)}" y="${(v >= 0 ? y - 4 : y + bh + 11).toFixed(1)}" text-anchor="middle" font-size="9" fill="${col}" font-family="monospace">${v >= 0 ? '+' : ''}${v.toFixed(0)}</text>`;
        });
        svg.innerHTML = `<line x1="0" y1="${mid}" x2="${w}" y2="${mid}" stroke="#EAD9C7"/>${out}`;
      }

      /* ---------- JOURNAL ---------- */
      function fillSelect(id, all, items) {
        const el = $(id), cur = el.value;
        el.innerHTML = `<option value="">${all}</option>` + items.map(x => `<option value="${esc(x)}">${esc(x)}</option>`).join('');
        el.value = cur;
      }
      function journalFiltered() {
        const list = tradesFor(currentAccId());
        const m = $('jf-market').value, r = $('jf-result').value, s = $('jf-strategy').value;
        const q = $('jf-search').value.trim().toLowerCase();
        return list.filter(t => (!m || t.market === m) && (!r || t.result === r) && (!s || t.strategy === s) &&
          (!q || (t.reason || '').toLowerCase().includes(q)));
      }
      /* ============================================================
         URUTAN JURNAL
         Sebelumnya hanya membandingkan tanggal, jadi semua trade di hari
         yang sama dianggap sama persis dan urutannya jatuh ke urutan input.
         Sekarang bertingkat: tanggal -> jam entry -> waktu pencatatan.
         Trade lama yang belum punya jam tetap tertangani lewat urutan
         pencatatannya, jadi tidak perlu diisi ulang satu per satu.
         ============================================================ */
      function kunciUrut(t, i) {
        const tgl = String(t.date || '');
        const jam = String(t.jam || '');
        /* waktu pencatatan: dari penanda dibuat, atau dari nomor id demo */
        let catat = 0;
        if (t.dibuat) { const x = new Date(t.dibuat).getTime(); if (!isNaN(x)) catat = x; }
        return { tgl: tgl, jam: jam, catat: catat, i: i };
      }
      function bandingTrade(A, B) {
        /* tanggal: terbaru dulu; yang kosong ditaruh paling bawah */
        if (A.tgl !== B.tgl) {
          if (!A.tgl) return 1;
          if (!B.tgl) return -1;
          return B.tgl.localeCompare(A.tgl);
        }
        /* jam: terbaru dulu; yang belum punya jam ditaruh setelah yang punya */
        if (A.jam !== B.jam) {
          if (!A.jam) return 1;
          if (!B.jam) return -1;
          return B.jam.localeCompare(A.jam);
        }
        /* waktu pencatatan: yang dicatat belakangan dianggap lebih baru */
        if (A.catat !== B.catat) return B.catat - A.catat;
        /* benar-benar seri: yang diinput belakangan tetap di atas */
        return B.i - A.i;
      }
      function urutJurnal(arr) {
        return arr.map((t, i) => ({ t: t, k: kunciUrut(t, i) }))
          .sort((a, b) => bandingTrade(a.k, b.k))
          .map(x => x.t);
      }

      function renderJournal() {
        const base = tradesFor(currentAccId());
        fillSelect('jf-market', 'Semua Market', [...new Set(base.map(t => t.market).filter(Boolean))].sort());
        fillSelect('jf-strategy', 'Semua Strategi', [...new Set(base.map(t => t.strategy).filter(Boolean))].sort());
        const list = urutJurnal(journalFiltered());
        $('journal-empty').style.display = list.length ? 'none' : 'block';
        const uh = $('th-netmain'); if (uh) uh.textContent = 'Net P/L ' + mainUnit();
        const rh = $('th-netsub'); if (rh) rh.textContent = activeCurrency() === 'IDR' ? 'Net P/L $' : 'Net P/L Rp';
        const kh = $('th-risk'); if (kh) kh.textContent = 'Risk ' + mainUnit();
        $('journal-tbody').innerHTML = list.map((t, i) => {
          const c = compute(t);
          const rc = t.result === 'Win' ? 'win' : t.result === 'Loss' ? 'loss' : 'be';
          const uc = c.usd > 0 ? 'pos' : c.usd < 0 ? 'neg' : 'neu';
          return `<tr><td>${list.length - i}</td><td>${esc(t.date)}</td>
        <td>${t.jam ? esc(t.jam) : '<span style="color:var(--gray)">&mdash;</span>'}</td>
        <td>${esc(t.market)}</td>
        <td>${lencanaPosisi(t)}</td>
        <td>${t.entry}</td><td>${t.sl}</td><td>${t.tp}</td><td>${t.vol == null ? '-' : t.vol}</td>
        <td>${t.riskPct}%</td><td>${fmtMain(c.risk)}</td><td>${c.rr.toFixed(2)}</td>
        <td><span class="pill ${rc}">${esc(t.result)}</span></td>
        <td class="${uc}">${fmtMain(c.usd)}</td><td class="${uc}">${fmtSub(c.usd)}</td>
        <td style="font-family:var(--sans)">${esc(t.strategy) || '-'}</td><td>${esc(t.tf) || '-'}</td>
        <td class="reason-cell" title="${esc(t.reason)}">${esc(t.reason)}</td>
        <td style="white-space:nowrap">
          <button class="icon-btn edit" data-edit="${t.id}" title="Edit">&#9998;</button>
          <button class="icon-btn" data-del="${t.id}" title="Hapus">&#10005;</button></td></tr>`;
        }).join('');
        $('journal-tbody').querySelectorAll('[data-del]').forEach(b => b.onclick = async () => {
          if (confirm('Hapus trade ini?')) { trades = trades.filter(t => t.id !== b.dataset.del); await persist(); renderAll(); }
        });
        $('journal-tbody').querySelectorAll('[data-edit]').forEach(b => b.onclick = () => openEdit(b.dataset.edit));
      }

      function fillAccountSelects() {
        const opts = accounts.map(a =>
          `<option value="${a.id}">${esc(a.name)}${a.broker ? ' — ' + esc(a.broker) : ''}${a.status !== 'Active' ? ' (nonaktif)' : ''}</option>`
        ).join('');
        $('in-account').innerHTML = accounts.map(a => `<option value="${a.id}">${esc(a.name)}</option>`).join('');
        const af = $('acct-filter'), cur = af.value;
        af.innerHTML =
          (accounts.length > 1 ? '<option value="">Semua Akun</option>' : '') +
          opts +
          (accounts.length ? '<option disabled>──────────</option>' : '') +
          '<option value="__new">+ Tambah Akun Baru…</option>';
        const stillExists = cur && cur !== '__new' && accounts.some(a => a.id === cur);
        af.value = stillExists ? cur : (accounts.length > 1 ? '' : (accounts[0] ? accounts[0].id : ''));
      }

      function openNewAccount() {
        go('accounts'); resetAcctForm();
        $('acct-form').classList.add('open');
        $('a-name').focus();
        $('acct-form').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function readForm() {
        return {
          accountId: $('in-account').value, date: $('in-date').value, jam: $('in-jam').value || '',
          market: $('in-market').value.trim().toUpperCase(),
          entry: parseFloat($('in-entry').value), sl: parseFloat($('in-sl').value), tp: parseFloat($('in-tp').value),
          vol: parseFloat($('in-vol').value) || null, riskPct: parseFloat($('in-riskpct').value),
          posisi: $('in-posisi').value,
          result: $('in-result').value, strategy: $('in-strategy').value.trim(),
          tf: $('in-tf').value, reason: $('in-reason').value.trim()
        };
      }
      /* Saat Entry & SL diisi, arah posisi menyesuaikan sendiri — tapi tetap
         bisa diubah manual kalau member memang menginginkannya. */
      let posisiDiubahManual = false;
      function selaraskanPosisi() {
        if (posisiDiubahManual) return;
        const e = parseFloat($('in-entry').value), s = parseFloat($('in-sl').value);
        if (isNaN(e) || isNaN(s)) return;
        $('in-posisi').value = s < e ? 'Buy' : 'Sell';
      }

      function updatePreview() {
        selaraskanPosisi();
        const d = readForm();
        if (!d.accountId || isNaN(d.entry) || isNaN(d.sl) || isNaN(d.tp) || isNaN(d.riskPct)) {
          ['cp-risk', 'cp-rr', 'cp-usd', 'cp-rp'].forEach(i => { $(i).textContent = '—'; $(i).className = ''; }); return;
        }
        const c = compute(d);
        /* Pakai mata uang akun yang dipilih DI FORM, bukan filter di atas.
           Ini yang dulu bikin akun cent & rupiah tampil dalam dolar. */
        const acc = acctById(d.accountId);
        const cur = acc ? acc.currency : 'USD';
        const lblMain = $('lbl-cp-usd'), lblRisk = $('lbl-cp-risk'), lblSub = $('lbl-cp-rp');
        if (lblMain) lblMain.textContent = 'Net P/L ' + unitOf(cur);
        if (lblRisk) lblRisk.textContent = 'Risk ' + unitOf(cur);
        if (lblSub) lblSub.textContent = cur === 'IDR' ? 'Setara USD' : 'Setara Rupiah';
        $('cp-risk').textContent = fmtByCur(c.risk, cur);
        $('cp-rr').textContent = c.rr.toFixed(2);
        $('cp-usd').textContent = fmtByCur(c.usd, cur); $('cp-usd').className = c.usd >= 0 ? 'pos' : 'neg';
        $('cp-rp').textContent = fmtSubByCur(c.usd, cur); $('cp-rp').className = c.usd >= 0 ? 'pos' : 'neg';
      }
      function resetForm() {
        editTradeId = null;
        $('in-date').value = new Date().toISOString().slice(0, 10);
        /* jam diisi otomatis dengan waktu sekarang — tinggal diubah kalau perlu */
        (function () {
          const d = new Date();
          $('in-jam').value = String(d.getHours()).padStart(2, '0') + ':' +
            String(d.getMinutes()).padStart(2, '0');
        })();
        if (accounts.length) $('in-account').value = currentAccId() || accounts[0].id;
        ['in-market', 'in-vol', 'in-entry', 'in-sl', 'in-tp', 'in-riskpct', 'in-strategy', 'in-reason'].forEach(i => $(i).value = '');
        $('in-result').value = 'Win'; $('in-tf').value = 'H1';
        $('save-trade').textContent = 'Simpan Trade'; updatePreview();
      }
      function openEdit(id) {
        const t = trades.find(x => x.id === id); if (!t) return;
        editTradeId = id;
        $('in-date').value = t.date; $('in-jam').value = t.jam || '';
        $('in-posisi').value = arahPosisi(t) || 'Buy';
        $('in-account').value = t.accountId; $('in-market').value = t.market;
        $('in-vol').value = t.vol == null ? '' : t.vol; $('in-entry').value = t.entry; $('in-sl').value = t.sl; $('in-tp').value = t.tp;
        $('in-riskpct').value = t.riskPct; $('in-result').value = t.result; $('in-strategy').value = t.strategy || '';
        $('in-tf').value = t.tf || 'H1'; $('in-reason').value = t.reason || '';
        $('save-trade').textContent = 'Update Trade';
        $('trade-form').classList.add('open'); updatePreview();
        $('trade-form').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      /* ---------- ACCOUNTS ---------- */
      function renderAccounts() {
        $('kurs-input').value = settings.kurs;
        const w = $('acct-list');
        if (!accounts.length) { w.innerHTML = '<div class="empty"><b>Belum ada akun</b>Tambah akun dulu sebelum mencatat trade.</div>'; return; }
        w.innerHTML = accounts.map(a => {
          const list = trades.filter(t => t.accountId === a.id), s = stats(list);
          const cur = balUSD(a) + s.netUsd;
          const f = v => fmtByCur(v, a.currency);
          const sub = fmtSubByCur(cur, a.currency);
          return `<div class="acct-card">
        <div class="acct-info"><h4>${esc(a.name)}</h4>
          <div class="meta"><span class="dot ${a.status !== 'Active' ? 'off' : ''}"></span>${esc(a.broker) || '—'} · ${esc(a.type) || '—'} · ${esc(a.currency)} · ${list.length} trade</div>
          ${a.notes ? `<div class="meta" style="margin-top:3px;color:#9CA3AF;">${esc(a.notes)}</div>` : ''}</div>
        <div style="display:flex;align-items:center;gap:15px;">
          <div class="acct-bal"><div class="st">Saldo Saat Ini</div>
            <div class="cur ${s.netUsd >= 0 ? 'pos' : 'neg'}">${f(cur)}</div>
            <div class="st" style="color:#9CA3AF">${sub}</div>
            <div class="st" style="color:${s.netUsd >= 0 ? '#16A34A' : '#DC2626'}">${s.netUsd >= 0 ? '+' : ''}${f(s.netUsd)} · WR ${s.total ? s.winRate.toFixed(0) : 0}%</div></div>
          <div style="display:flex;flex-direction:column;gap:4px;">
            <button class="icon-btn edit" data-eacct="${a.id}" title="Edit">&#9998;</button>
            <button class="icon-btn" data-dacct="${a.id}" title="Hapus">&#10005;</button></div>
        </div></div>`;
        }).join('');
        w.querySelectorAll('[data-eacct]').forEach(b => b.onclick = () => openEditAcct(b.dataset.eacct));
        w.querySelectorAll('[data-dacct]').forEach(b => b.onclick = async () => {
          const id = b.dataset.dacct, n = trades.filter(t => t.accountId === id).length;
          if (confirm(`Hapus akun ini${n ? ` beserta ${n} trade-nya` : ''}?`)) {
            accounts = accounts.filter(a => a.id !== id); trades = trades.filter(t => t.accountId !== id);
            await persist(); renderAll();
          }
        });
      }
      function resetAcctForm() {
        editAcctId = null;
        ['a-name', 'a-broker', 'a-type', 'a-balance', 'a-notes'].forEach(i => $(i).value = '');
        $('a-currency').value = 'USD'; $('a-status').value = 'Active';
        $('a-start').value = new Date().toISOString().slice(0, 10);
        $('save-acct').textContent = 'Simpan Akun';
      }
      function openEditAcct(id) {
        const a = acctById(id); if (!a) return; editAcctId = id;
        $('a-name').value = a.name; $('a-broker').value = a.broker || ''; $('a-type').value = a.type || '';
        $('a-currency').value = a.currency; $('a-balance').value = a.startBalance;
        $('a-start').value = a.startDate || ''; $('a-status').value = a.status; $('a-notes').value = a.notes || '';
        $('save-acct').textContent = 'Update Akun'; $('acct-form').classList.add('open');
        $('acct-form').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }


      /* ================= BERITA & ANALISA =================
         Konten TIDAK disimpan di browser member. Aplikasi menarik tiga berkas
         dari repo yang sama:
           berita.json           -> berita umum, semua member bisa lihat
           berita-eksklusif.json -> berita eksklusif, butuh kode
           analisa.json          -> analisa market, butuh kode yang sama
         Admin membuat berkas itu lewat admin.html lalu meng-upload-nya ke repo.
         Sekali upload, SEMUA member langsung dapat isi terbaru.
         ==================================================== */
      const ANN_URL = 'pengumuman.json';
      const NEWS_URL = 'berita.json', NEWS_EX_URL = 'berita-eksklusif.json', ANALISA_URL = 'analisa.json',
        REKAP_URL = 'rekap.json', REKAP_EX_URL = 'rekap-eksklusif.json',
        MATERI_URL = 'materi.json', MATERI_EX_URL = 'materi-eksklusif.json';
      let rekapCache = null, rekapExCache = null, materiCache = null, materiExCache = null;
      let rkKind = 'umum', mtKind = 'umum';
      const K_ANGATE = 'fncjt_an_unlocked';   /* menyimpan KODE-nya, bukan sekadar true */
      let newsCache = null, newsExCache = null, analisaCache = null, newsKind = 'umum';

      /* Format ala WhatsApp: *tebal*  _miring_  ~coret~  ```mono``` */
      /* ---------- format teks ala WhatsApp ----------
         Perbaikan: penanda (*_~) kini boleh didahului tanda baca apa pun,
         bukan hanya spasi. Jadi "2._miring_" dan "-_miring_" ikut berlaku.
         Garis bawah di tengah kata (nama_berkas) tetap TIDAK diubah. */
      function waFormat(s) {
        let t = esc(s || '');

        /* blok kode dulu, supaya isinya tidak ikut diproses */
        const kode = [];
        t = t.replace(/```([\s\S]+?)```/g, (m, c) => { kode.push(c); return '\u0000K' + (kode.length - 1) + '\u0000'; });

        const B = '[^A-Za-z0-9]';   /* pembatas: apa pun selain huruf & angka */
        t = t.replace(new RegExp('(^|' + B + ')\\*([^*\\n]+)\\*(?=' + B + '|$)', 'g'), '$1<b>$2</b>');
        t = t.replace(new RegExp('(^|' + B + ')_([^_\\n]+)_(?=' + B + '|$)', 'g'), '$1<i>$2</i>');
        t = t.replace(new RegExp('(^|' + B + ')~([^~\\n]+)~(?=' + B + '|$)', 'g'), '$1<s>$2</s>');

        t = t.replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>');

        /* daftar & kutipan, dikenali per baris */
        const baris = t.split('\n');
        let keluar = '', mode = null;   /* mode: 'ul' | 'ol' | 'q' | null */
        function tutup() {
          if (mode === 'ul') keluar += '</ul>';
          else if (mode === 'ol') keluar += '</ol>';
          else if (mode === 'q') keluar += '</blockquote>';
          mode = null;
        }
        for (let i = 0; i < baris.length; i++) {
          const b = baris[i];
          const mUl = b.match(/^\s*[-•]\s+(.*)$/);
          const mOl = b.match(/^\s*\d+[.)]\s+(.*)$/);
          const mQ = b.match(/^\s*&gt;\s?(.*)$/);
          if (mUl) {
            if (mode !== 'ul') { tutup(); keluar += '<ul class="wa-ul">'; mode = 'ul'; }
            keluar += '<li>' + mUl[1] + '</li>';
          } else if (mOl) {
            if (mode !== 'ol') { tutup(); keluar += '<ol class="wa-ol">'; mode = 'ol'; }
            keluar += '<li>' + mOl[1] + '</li>';
          } else if (mQ) {
            if (mode !== 'q') { tutup(); keluar += '<blockquote class="wa-q">'; mode = 'q'; }
            keluar += mQ[1] + '<br>';
          } else if (!b.trim() && (mode === 'ul' || mode === 'ol')) {
            /* Baris kosong di TENGAH daftar tidak memutus daftarnya. */
            let lanjut = false;
            for (let k = i + 1; k < baris.length; k++) {
              const n = baris[k];
              if (!n.trim()) continue;
              lanjut = mode === 'ul' ? /^\s*[-•]\s+/.test(n) : /^\s*\d+[.)]\s+/.test(n);
              break;
            }
            if (!lanjut) { tutup(); }
          } else {
            tutup();
            keluar += b + (i < baris.length - 1 ? '<br>' : '');
          }
        }
        tutup();
        t = keluar.replace(/<br>(?=<\/(ul|ol|blockquote)>)/g, '');

        /* kembalikan blok kode */
        t = t.replace(/\u0000K(\d+)\u0000/g, (m, i) => '<code>' + kode[+i] + '</code>');
        return t;
      }
      function tanggalID(iso) {
        if (!iso) return '';
        const d = new Date(iso); if (isNaN(d)) return esc(iso);
        return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
      }
      function skeletonFeed(n) {
        let s = '';
        for (let i = 0; i < (n || 2); i++) s += '<div class="feed-item"><div class="skeleton" style="height:150px"></div>' +
          '<div class="feed-pad"><div class="skeleton" style="height:15px;width:55%;margin-bottom:9px"></div>' +
          '<div class="skeleton" style="height:11px;margin-bottom:6px"></div>' +
          '<div class="skeleton" style="height:11px;width:80%"></div></div></div>';
        return s;
      }
      function lightbox(src) {
        const d = document.createElement('div'); d.className = 'lightbox';
        d.innerHTML = '<button class="lb-x" aria-label="Tutup">&times;</button><img alt="">';
        d.querySelector('img').src = src;
        d.onclick = () => d.remove();
        document.body.appendChild(d);
      }
      document.addEventListener('click', e => {
        const im = e.target.closest('.feed-cover,.feed-gal img');
        if (im && im.src) lightbox(im.src);
      });

      async function fetchJSON(url) {
        const r = await fetch(url + '?t=' + Date.now(), { cache: 'no-store' });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return await r.json();
      }
      /* ---------- format jam ---------- */
      function jamID(iso) {
        if (!iso) return '';
        try {
          const d = new Date(iso); if (isNaN(d.getTime())) return '';
          return d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }).replace('.', ':');
        } catch (e) { return ''; }
      }
      function stempelWaktu(it, tanpaJam) {
        const tgl = tanggalID(it.pub || it.date);
        if (tanpaJam) return tgl;
        const jam = it.pub ? jamID(it.pub) : '';
        return jam ? (tgl + ' &middot; ' + jam) : tgl;
      }
      /* ---------- kartu terkunci (kerangka buram, BUKAN isi asli) ----------
         Isi sungguhan tidak pernah dikirim ke member tanpa kode. Yang diburamkan
         hanyalah bar kosong. Judul & tanggal berasal dari bagian teaser yang
         memang sengaja dibuat publik oleh admin. */
      /* Kartu terkunci: HANYA gambar mini yang diburamkan.
         Judul sengaja tidak ditampilkan — judul saja sudah membocorkan isi. */
      /* Satu panel untuk semua tab terkunci. Dulu tiap kiriman punya kartu
         gembok sendiri — layarnya jadi penuh pengulangan, dan arahannya
         ("Buka Akses") membuka kotak isian kode, padahal kode sekarang
         diurus di tab Profil. */
      const LK_LABEL = { eks: 'Eksklusif', priv: 'Private' };
      function lkLatar(teaser) {
        const t = (teaser || []).filter(fncSudahTayang)
          .sort((a, b) => fncWaktuTerbit(b) - fncWaktuTerbit(a)).slice(0, 5);
        if (!t.length) return '';
        /* Sengaja tanpa teks apa pun: buram cuma efek tampilan, tulisan yang
           diburamkan tetap terbaca lewat inspect element. */
        return '<div class="lk-bg" aria-hidden="true">' +
          t.map(x => '<div class="lk-baris">' +
            '<div class="lk-thumb">' + (x.blur ? '<img src="' + esc(x.blur) + '" alt="">' : '') + '</div>' +
            '<div class="lk-teks"><div class="lk-bar w1"></div><div class="lk-bar w2"></div></div>' +
            '</div>').join('') + '</div>';
      }
      function panelTerkunci(jenis, teaser, namaIsi) {
        const lbl = LK_LABEL[jenis] || 'Eksklusif';
        const punyaKode = (jenis === 'eks') ? (tier === 'eks') : (tier !== 'umum');
        const dalam =
          '<div class="lk-dalam">' +
          '<div class="lk-gembok">&#128274;</div>' +
          '<h4>Khusus Member ' + lbl + '</h4>' +
          '<p>' + esc(namaIsi) + ' hanya bisa dibuka member ' + lbl + '.' +
          (punyaKode
            ? ' Tingkatan kamu sudah sesuai, tapi kodenya belum tersimpan di perangkat ini.'
            : ' Kamu belum punya akses ini.') + '</p>' +
          '<div class="lk-aksi">' +
          (punyaKode
            ? '<button class="btn" type="button" onclick="window.__go(\'accounts\')">' +
            'Masukkan Kode di Profil</button>'
            : '<button class="btn" type="button" onclick="window.__go(\'kelas\')">' +
            'Lihat Kelas &amp; Cara Gabung</button>' +
            '<button class="btn ghost" type="button" onclick="window.__go(\'accounts\')">' +
            'Sudah Punya Kode? Masukkan di Profil</button>') +
          '</div>' +
          '<p class="lk-nb">Sudah gabung tapi kodenya lupa? Chat admin lewat menu ' +
          'Konsultasi di Beranda.</p>' +
          '</div>';
        const latar = lkLatar(teaser);
        return latar
          ? '<div class="lk-wrap">' + latar + '<div class="lk-depan">' + dalam + '</div></div>'
          : '<div class="lk-wrap"><div class="lk-depan" style="min-height:290px;">' + dalam + '</div></div>';
      }
      function kartuTerkunci(t) {
        const tag = t.tag || t.jenis || '';
        return '<div class="feed-item">' +
          '<div class="lk-img">' +
          (t.blur ? '<img src="' + esc(t.blur) + '" alt="" aria-hidden="true">' : '<div class="noimg"></div>') +
          '<div class="lk-veil"><div class="ic">&#128274;</div>' +
          '<b>Konten Eksklusif</b>' +
          '<span>' + (t.vid ? 'Video &middot; ' : '') + 'Butuh kode dari admin</span>' +
          '</div>' +
          '</div>' +
          '<div class="lk-meta">' +
          '<span style="font-size:11.5px;color:var(--gray);">' +
          (tag ? esc(tag) + ' &middot; ' : '') + stempelWaktu(t) + '</span>' +
          '<button class="btn sm" onclick="window.__bukaUpgrade()">Buka Akses</button>' +
          '</div></div>';
      }
      /* Menggambar daftar kartu terkunci lewat mesin yang sama dengan daftar
         biasa, supaya pencarian dan penyaring tetap berlaku dan tidak ada
         dua jalur penggambaran yang saling menimpa. */
      function gambarTerkunci(elId, teaser, kosongTxt, jenis, namaIsi) {
        const el = $(elId); if (!el) return;
        daftarPenuh[elId] = [];
        modeTerkunci[elId] = true;
        pembuatKartu[elId] = null;
        /* Pencarian & penyaring dimatikan di sini: tidak ada yang bisa dicari
           ketika isinya memang belum terbuka. */
        const kotak = el.parentNode && el.parentNode.querySelector('.saring');
        if (kotak) kotak.innerHTML = '';
        el.innerHTML = panelTerkunci(jenis || 'eks', teaser, namaIsi || 'Isi ini');
      }
      function daftarTerkunci(teaser, kosongTxt, jenis, namaIsi) {
        const t = (teaser || []).filter(fncSudahTayang).sort((a, b) => fncWaktuTerbit(b) - fncWaktuTerbit(a));
        if (!t.length) return '<div class="feed-empty">' + kosongTxt + '</div>';
        return panelTerkunci(jenis || 'eks', t, namaIsi || 'Isi ini');
      }
      /* ---------- media ---------- */
      /* Sampul hanya diberi ikon putar kalau isinya memang VIDEO.
         Riset PDF dan materi tidak diberi ikon putar supaya member tidak
         mengira ada rekaman yang bisa ditonton. */
      function itVideo(it) {
        return String(labelTautan(it)).indexOf('Tonton') >= 0;
      }
      function blokVideo(it) {
        if (!it.url) return '';
        const thumb = it.thumb || it.image || ((it.images || [])[0]) || '';
        const vid = itVideo(it);
        return '<div class="vid-wrap" onclick="window.__buka(\'' + esc(it.url).replace(/'/g, "\\'") + '\')">' +
          (thumb ? '<img src="' + esc(thumb) + '" alt="" loading="lazy">'
            : '<div class="vid-ph">' + (vid ? 'REKAMAN VIDEO' : 'DOKUMEN') + '</div>') +
          (vid ? '<div class="vid-play"></div>' : '') +
          ((vid && it.dur) ? '<div class="vid-dur">' + esc(it.dur) + '</div>' : '') +
          '</div>';
      }
      window.__buka = u => { try { window.open(u, '_blank', 'noopener'); } catch (e) { } };

      /* Membuka isi berkas.
         v2  = AES-256-GCM sungguhan, wajib kode benar (kalau salah -> melempar KODESALAH)
         v1  = base64 lama (masih didukung supaya berkas lama tetap terbaca)
         polos = berita umum, memang tidak dikunci */
      async function bukaIsi(d, kode) {
        if (d && (d.v === 2 || d.v === 3 || d.v === 4) && d.ct) {
          if (!kode) throw new Error('KODESALAH');
          try { return await fncDekripsi(kode, d); }
          catch (e) { throw new Error('KODESALAH'); }
        }
        if (d && d.enc) { try { return JSON.parse(decodeURIComponent(escape(atob(d.enc)))); } catch (e) { return []; } }
        return (d && d.items) || [];
      }
      /* Urut terbaru dulu, DAN sembunyikan yang jadwal tayangnya belum tiba. */
      /* Urutan tampil.
         Kalau admin sudah menyusun urutannya sendiri (semua kiriman punya
         nomor "urut"), urutan itulah yang dipakai — penting untuk Materi,
         karena modul harus berurutan 1,2,3, bukan yang terbaru di atas.
         Kalau tidak ada nomor urut, kembali ke urutan terbaru seperti biasa. */
      function adaUrutManual(a) {
        return !!(a && a.length && a.every(x => x && typeof x.urut === 'number'));
      }
      const urutBaru = a => {
        const isi = (a || []).filter(fncSudahTayang);
        if (adaUrutManual(a)) return isi.sort((x, y) => x.urut - y.urut);
        return isi.sort((x, y) => fncWaktuTerbit(y) - fncWaktuTerbit(x));
      };
      /* Kapan item terjadwal berikutnya muncul (untuk penyegaran otomatis). */
      function tayangBerikut(a) {
        const now = Date.now();
        const next = (a || []).map(fncWaktuTerbit).filter(t => t > now).sort((x, y) => x - y)[0];
        return next || null;
      }

      /* ============================================================
         MESIN DAFTAR: pencarian + muat bertahap + kartu ringkas
         ============================================================ */
      const daftarPenuh = {};                 /* seluruh kiriman per daftar, sebelum disaring */
      /* Nomor urut permintaan per daftar. Setiap kali daftar diminta digambar
         ulang, nomornya naik. Hasil pengambilan berkas yang datang terlambat
         akan dibuang kalau nomornya sudah tidak cocok — inilah yang mencegah
         tampilan satu segmen menimpa segmen lain. */
      const proses = {};
      /* Menandai daftar yang sedang menampilkan kartu terkunci, supaya
         kiriman terkunci tidak pernah dijadikan sorotan besar. */
      const modeTerkunci = {};
      const WADAH_SARING = {
        'news-list': 'saring-news', 'analisa-list': 'saring-an',
        'rk-list': 'saring-rk', 'mt-list': 'saring-mt'
      };
      /* Selama daftar dimuat, tombol penyaring dinonaktifkan. Tanpa ini,
         pengguna bisa menekan tombol milik daftar LAMA yang belum sempat
         diperbarui — dan hasilnya jadi kosong atau tertukar. */
      function kunciSaring(id, aktif) {
        const el = $(WADAH_SARING[id]); if (!el) return;
        el.classList.toggle('memuat', !!aktif);
      }
      function mulaiProses(id) {
        proses[id] = (proses[id] || 0) + 1;
        kunciSaring(id, true);
        return proses[id];
      }
      function prosesUsang(id, n) { return proses[id] !== n; }
      const PER_HAL = 12;                     /* dimuat lebih dulu saat tab dibuka */
      const tampil = {};                      /* berapa yang sedang ditampilkan per daftar */
      const kataCari = {};                    /* kata kunci per daftar */

      function teksPolos(s) {
        return String(s || '').replace(/[*_~`]/g, ' ').replace(/\s+/g, ' ').trim();
      }
      const saringAktif = {};   /* label / kode market / jenis yang sedang dipilih */
      const saringTgl = {};     /* tanggal yang dipilih (khusus Rekap Live) */

      function cocok(it, q, elId) {
        /* penyaring label */
        const s = saringAktif[elId];
        if (s) {
          const nilai = [it.tag, it.pair, it.jenis].map(x => String(x || '').toLowerCase());
          if (nilai.indexOf(s.toLowerCase()) < 0) return false;
        }
        /* penyaring tanggal */
        const t = saringTgl[elId];
        if (t) {
          const tgl = (it.pub ? String(it.pub).slice(0, 10) : String(it.date || '').slice(0, 10));
          if (tgl !== t) return false;
        }
        if (!q) return true;
        const k = q.toLowerCase();
        return [it.title, it.body, it.tag, it.pair, it.bias, it.jenis]
          .some(x => String(x || '').toLowerCase().indexOf(k) >= 0);
      }

      /* Menyusun tombol penyaring dari data yang ada — bukan daftar tetap,
         jadi label baru yang kamu buat di admin otomatis muncul di sini. */
      function gambarSaring(elId, wadahId, ambil, labelSemua) {
        const w = $(wadahId); if (!w) return;
        const semua = daftarPenuh[elId] || [];
        const daftar = [];
        semua.forEach(it => {
          const v = String(ambil(it) || '').trim();
          if (v && daftar.indexOf(v) < 0) daftar.push(v);
        });
        daftar.sort((a, b) => a.localeCompare(b));
        /* Rekap Live punya kotak tanggal yang harus tetap ada di depan. */
        const tetap = wadahId === 'saring-rk'
          ? w.querySelector('#tgl-rk-box').outerHTML +
          '<button class="chip" type="button" id="tgl-rk-hapus"' +
          (saringTgl[elId] ? '' : ' hidden') + '>Hapus tanggal</button>'
          : '';
        if (!daftar.length && !tetap) { w.innerHTML = ''; return; }
        const aktif = saringAktif[elId] || '';
        w.innerHTML = tetap +
          '<button class="chip' + (aktif ? '' : ' on') + '" data-saring="' + elId + '" data-nilai="">' +
          esc(labelSemua) + '</button>' +
          daftar.map(v => '<button class="chip' + (aktif === v ? ' on' : '') + '" data-saring="' + elId +
            '" data-nilai="' + esc(v) + '">' + esc(v) + '</button>').join('');
        /* pasang ulang kotak tanggal setelah innerHTML diganti */
        if (wadahId === 'saring-rk') pasangTanggalRekap();
      }

      function pasangTanggalRekap() {
        const inp = $('tgl-rk'); if (!inp) return;
        inp.value = saringTgl['rk-list'] || '';
        $('tgl-rk-box').classList.toggle('on', !!saringTgl['rk-list']);
        inp.onchange = () => {
          saringTgl['rk-list'] = inp.value || '';
          tampil['rk-list'] = PER_HAL;
          gambarUlang('rk-list');
          gambarSaring('rk-list', 'saring-rk', it => '', 'Semua');
        };
        const hapus = $('tgl-rk-hapus');
        if (hapus) hapus.onclick = () => {
          saringTgl['rk-list'] = '';
          tampil['rk-list'] = PER_HAL;
          gambarUlang('rk-list');
          gambarSaring('rk-list', 'saring-rk', it => '', 'Semua');
        };
      }

      const PETA_SARING = {
        'news-list': ['saring-news', it => it.tag, 'Semua'],
        'analisa-list': ['saring-an', it => it.pair, 'Semua Market'],
        'mt-list': ['saring-mt', it => it.jenis, 'Semua Jenis'],
        'rk-list': ['saring-rk', it => '', 'Semua']
      };
      function segarkanSaring(elId) {
        const c = PETA_SARING[elId]; if (!c) return;
        gambarSaring(elId, c[0], c[1], c[2]);
      }
      /* Menandai kata yang dicari. Dijalankan pada teks yang SUDAH di-escape,
         dan tag HTML dilewati supaya tidak merusak markup. */
      function tandai(html, q) {
        if (!q) return html;
        const k = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return html.replace(/>([^<]+)</g, (m, isi) =>
          '>' + isi.replace(new RegExp('(' + k + ')', 'gi'), '<mark>$1</mark>') + '<');
      }
      function ringkasan(it) {
        const t = teksPolos(it.body);
        return t.length > 96 ? t.slice(0, 96) + '...' : t;
      }
      /* Kepala kartu: gambar kecil + judul + waktu. Isi disembunyikan sampai diklik. */
      function kepalaKartu(it, label, adaVideo, tanpaJam) {
        const gbr = it.thumb || it.image || ((it.images || [])[0]) || '';
        const thumb = '<div class="fi-thumb">' +
          (gbr ? '<img src="' + esc(gbr) + '" alt="" loading="lazy">' : '<div class="ph">&#128196;</div>') +
          (adaVideo ? '<div class="vmark"></div>' : '') + '</div>';
        return '<div class="fi-head">' + thumb +
          '<div class="fi-info">' +
          (it.title ? '<h4>' + esc(it.title) + '</h4>' : '<h4>&mdash;</h4>') +
          '<div class="fi-meta">' + (label || '') +
          '<span class="feed-date">' + stempelWaktu(it, tanpaJam) + '</span></div>' +
          '</div>' +
          '<span class="fi-chev">&#9660;</span></div>';
      }
      function tombolLagi(elId, sisa) {
        return '<button class="lagi" data-lagi="' + elId + '">Muat lebih banyak' +
          '<small>' + sisa + ' kiriman lagi</small></button>';
      }
      /* Menyaring, memotong sesuai halaman, lalu menggambar. */
      function gambarDaftar(elId, semua, buatKartu, kosongTxt) {
        const el = $(elId); if (!el) return;
        const q = kataCari[elId] || '';
        /* Sorotan hanya dipakai di tab Berita, dan hanya saat tidak sedang
           mencari atau menyaring — supaya hasil pencarian tetap setara. */
        /* Sorotan hanya untuk kiriman yang benar-benar terbuka. Kiriman
           terkunci tidak boleh dibesarkan — judulnya memang tidak ada,
           dan tampilannya jadi kosong. */
        const pakaiSorotan = (elId === 'news-list') && !q && !modeTerkunci[elId] &&
          !saringAktif[elId] && !saringTgl[elId];
        const hasil = (semua || []).filter(it => cocok(it, q, elId));
        const batas = tampil[elId] || PER_HAL;
        const potong = hasil.slice(0, batas);

        const info = $((elId === 'news-list' ? 'cari-news' :
          elId === 'analisa-list' ? 'cari-an' :
            elId === 'rk-list' ? 'cari-rk' : 'cari-mt') + '-info');
        if (info) {
          const sAktif = saringAktif[elId] || '';
          const tAktif = saringTgl[elId] || '';
          const bagian = [];
          if (q) bagian.push('"' + q + '"');
          if (sAktif) bagian.push(sAktif);
          if (tAktif) bagian.push('tanggal ' + tanggalID(tAktif));
          if (bagian.length) {
            info.hidden = false;
            info.textContent = (hasil.length ? hasil.length + ' hasil' : 'Tidak ada hasil') +
              ' untuk ' + bagian.join(' · ');
          } else info.hidden = true;
        }
        if (!hasil.length) {
          const adaSaring = q || saringAktif[elId] || saringTgl[elId];
          el.innerHTML = '<div class="feed-empty">' +
            (adaSaring ? 'Tidak ada yang cocok.<br>Coba ubah kata kunci atau penyaringnya.' : kosongTxt) +
            '</div>';
          return;
        }
        let out = '';
        if (pakaiSorotan && potong.length) {
          const s = potong[0];
          out += kartuSorotan(s, 'Berita', 'news', 'window.__tutupBukaSorotan(this)', true);
          out += potong.slice(1).map((it, i) => buatKartu(it, i + 1)).join('');
        } else {
          out += potong.map((it, i) => buatKartu(it, i)).join('');
        }
        if (q) out = tandai(out, q);
        if (hasil.length > batas) out += tombolLagi(elId, hasil.length - batas);
        el.innerHTML = out;
      }

      /* Menggambar ulang satu daftar dari data yang sudah tersimpan. */
      function gambarUlang(elId) {
        const semua = daftarPenuh[elId] || [];
        const f = pembuatKartu[elId];
        if (f) gambarDaftar(elId, semua, f.buat, f.kosong);
      }
      /* Dipanggil setiap daftar baru selesai dimuat. */
      function pasangSaring(elId) {
        try { segarkanSaring(elId); } catch (e) { }
        kunciSaring(elId, false);
      }
      const pembuatKartu = {};                /* cara menggambar tiap daftar */

      /* buka/tutup kartu */
      document.addEventListener('click', function (e) {
        const chip = e.target.closest('[data-saring]');
        if (chip) {
          const id = chip.dataset.saring;
          /* Abaikan kalau daftarnya sedang dimuat — tombol ini milik daftar
             lama yang belum sempat diperbarui, jadi hasilnya akan salah. */
          const wadah = $(WADAH_SARING[id]);
          if (wadah && wadah.classList.contains('memuat')) return;
          saringAktif[id] = chip.dataset.nilai || '';
          tampil[id] = PER_HAL;
          gambarUlang(id);
          segarkanSaring(id);
          return;
        }
        const lagi = e.target.closest('[data-lagi]');
        if (lagi) {
          const id = lagi.dataset.lagi;
          tampil[id] = (tampil[id] || PER_HAL) + PER_HAL;
          gambarUlang(id);
          return;
        }
        const kepala = e.target.closest('.fi-head');
        if (kepala) {
          const kartu = kepala.closest('.feed-item');
          if (kartu) kartu.classList.toggle('buka');
        }
      });

      /* Tombol tautan luar menyesuaikan isinya: riset/PDF beda dengan video.
         Dilihat dari label kiriman atau alamat tautannya. */
      function labelTautan(it) {
        const t = String((it.tag || '') + ' ' + (it.title || '')).toLowerCase();
        const u = String(it.url || '').toLowerCase();
        if (t.indexOf('riset') >= 0 || t.indexOf('research') >= 0 || u.indexOf('.pdf') >= 0)
          return '&#128196; Buka Riset (PDF)';
        if (t.indexOf('materi') >= 0 || t.indexOf('modul') >= 0 || t.indexOf('ebook') >= 0)
          return '&#128214; Buka Materi';
        return '&#9654; Tonton di Google Drive';
      }

      function renderFeed(elId, items, kind) {
        daftarPenuh[elId] = items || [];
        modeTerkunci[elId] = false;
        const buat = (it, i) => {
          const imgs = (it.images || []).filter(Boolean);
          const cover = it.image || imgs[0] || null;
          const rest = it.image ? imgs : imgs.slice(1);
          let tagCls = '';
          const bias = (it.bias || '').toLowerCase();
          if (bias.indexOf('bull') >= 0) tagCls = 'bull'; else if (bias.indexOf('bear') >= 0) tagCls = 'bear';
          else if (bias) tagCls = 'neu';
          const tag = it.bias || it.tag || '';
          const wm = (kind === 'an' || it.__eks) && profil
            ? '<div class="wm-tag">' + esc(profil.id) + '</div>' : '';
          const vid = it.url ? blokVideo(it) : '';
          const label = (it.pair ? '<span class="feed-tag">' + esc(it.pair) + '</span>' : '') +
            (tag ? '<span class="feed-tag ' + tagCls + '">' + esc(tag) + '</span>' : '') +
            (it.url && it.dur ? '<span class="feed-tag">' + esc(it.dur) + '</span>' : '');
          /* kiriman paling baru dibiarkan terbuka */
          const buka = (i === 0 && !(kataCari[elId] || '')) ? ' buka' : '';
          return '<div class="feed-item' + buka + '" data-kid="' + esc(it.id || '') + '">' + wm +
            kepalaKartu(it, label, !!it.url) +
            '<div class="fi-isi">' +
            (vid ? '<div class="feed-pad" style="padding-bottom:0;">' + vid + '</div>' : '') +
            (!vid && cover ? '<img class="feed-cover" src="' + esc(cover) + '" alt="" loading="lazy">' : '') +
            '<div class="feed-pad">' +
            '<div class="feed-body">' + waFormat(it.body) + '</div>' +
            (it.url ? '<div class="ext-btn" onclick="event.stopPropagation();window.__buka(\'' +
              esc(it.url).replace(/'/g, "\\'") + '\')">' + labelTautan(it) + '</div>' : '') +
            (rest.length ? '<div class="feed-gal">' + rest.map(s => '<img src="' + esc(s) + '" alt="" loading="lazy">').join('') + '</div>' : '') +
            (it.id ? '<div class="fi-bagi"><button type="button" title="Bagikan kiriman ini" ' +
              'onclick="event.stopPropagation();window.__feedBagi(\'' + esc(it.id) + '\',\'' +
              (kind === 'an' ? 'analisa' : 'berita') + '\',this)">&#128279; Bagikan</button></div>' : '') +
            '</div></div></div>';
        };
        const kosong = 'Belum ada ' + (kind === 'an' ? 'analisa' : 'berita') +
          ' yang diposting.<br>Cek lagi nanti ya.';
        pembuatKartu[elId] = { buat: buat, kosong: kosong };
        gambarDaftar(elId, items, buat, kosong);
        pasangSaring(elId);
      }

      /* ---------- gerbang bersama untuk berita eksklusif & analisa ----------
         Tidak ada kode tersimpan di berkas ini untuk dicocokkan. Kode dinyatakan
         benar HANYA kalau berhasil mendekripsi berkas asli dari server. */
      let kodeEks = null;   /* hanya di memori + storage member, tidak pernah dikirim ke mana pun */
      async function ambilKode() {
        if (kodeEks) return kodeEks;
        const k = await store.get(K_ANGATE);
        kodeEks = (typeof k === 'string' && k) ? k : null;
        return kodeEks;
      }
      /* Kode yang dipakai untuk membuka berkas private (Rekap & Materi).
         Member eksklusif memakai kode eksklusifnya — berkas private punya
         bungkus kunci untuk kedua kode. */
      async function ambilKodeAkses() {
        if (kodeAkses) return kodeAkses;
        let k = null;
        try { k = await store.get(K_KODE); } catch (e) { }
        kodeAkses = (typeof k === 'string' && k) ? k : null;
        return kodeAkses;
      }
      const sudahBuka = async () => {
        if (await ambilKode()) return true;
        /* Tingkatan sudah eksklusif berarti kodenya PERNAH terbukti benar di
           perangkat ini. Jadi tab Analisa dibuka langsung tanpa mengetik lagi,
           dengan kode yang sama yang dipakai masuk lewat gerbang depan. */
        /* Tingkatan sudah eksklusif tapi kode gerbangnya kosong — biasanya sisa
           dari bug lama yang mencabutnya diam-diam. Kode aksesnya masih tersimpan
           sejak masuk lewat gerbang depan, jadi dipulihkan saja: member tidak
           perlu mengetik kode yang sama dua kali. */
        if (tier === 'eks') {
          const k = await ambilKodeAkses();
          if (k) {
            kodeEks = k;
            try { await store.set(K_ANGATE, k); } catch (e) { }
            return true;
          }
        }
        return false;
      };
      /* Uji kode ke berkas sungguhan. true kalau ada berkas yang berhasil dibuka. */
      async function ujiKode(kode) {
        if (await kodeEksCocok(kode)) return true;
        /* Semua format terenkripsi diuji, bukan cuma v2. Dulu hanya v2 yang
           diakui, sementara berkas asli sudah v4 — akibatnya kode yang BENAR
           pun ditolak dengan pesan "kode salah". */
        for (const url of [ANALISA_URL, NEWS_EX_URL, REKAP_EX_URL, MATERI_EX_URL]) {
          try {
            const d = await fetchJSON(url);
            if (d && (d.v === 2 || d.v === 3 || d.v === 4) && d.ct) { await fncDekripsi(kode, d); return true; }
            if (d && (d.enc || d.items)) return true;   /* berkas lama belum dienkripsi */
          } catch (e) { /* berkas tidak ada / kode salah -> coba berkas berikutnya */ }
        }
        return false;
      }
      async function bukaGerbang(kode) {
        kodeEks = kode;
        await store.set(K_ANGATE, kode);
        newsExCache = null; analisaCache = null;
        if ($('v-analisa').classList.contains('active')) await checkAnalisaGate();
        if ($('v-news').classList.contains('active')) await showNews(true);
      }
      async function kunciGerbang() {
        kodeEks = null;
        await store.set(K_ANGATE, '');
        newsExCache = null; analisaCache = null; rekapExCache = null; materiExCache = null;
        /* Bersihkan isi terdekripsi dari DOM, bukan sekadar disembunyikan —
           kalau hanya di-hide, teksnya masih bisa dibaca lewat DevTools. */
        if ($('analisa-list')) $('analisa-list').innerHTML = '';
        if ($('an-stamp')) $('an-stamp').textContent = '';
        if (newsKind === 'eks' && $('news-list')) { $('news-list').innerHTML = ''; $('news-stamp').textContent = ''; }
        await checkAnalisaGate();
        if ($('v-news').classList.contains('active')) await showNews();
      }

      /* ---------- berita ---------- */
      async function loadNewsUmum(force) {
        if (newsCache && !force) return newsCache;
        const d = await fetchJSON(NEWS_URL);
        const semua = await bukaIsi(d, null);
        newsCache = { items: urutBaru(semua), semua: semua, updated: d.updated, next: tayangBerikut(semua) };
        return newsCache;
      }
      async function loadNewsEks(force) {
        if (newsExCache && !force) return newsExCache;
        const d = await fetchJSON(NEWS_EX_URL);
        const semua = (await bukaIsi(d, await ambilKode())).map(x => Object.assign({}, x, { __eks: true }));
        newsExCache = { items: urutBaru(semua), updated: d.updated, next: tayangBerikut(semua) };
        return newsExCache;
      }
      async function showNews(force) {
        const eks = newsKind === 'eks';
        const n = mulaiProses('news-list');
        $('news-lock').hidden = true; $('news-list').hidden = false;
        $('news-list').innerHTML = skeletonFeed(2);
        if (eks && tier !== 'eks') {
          try {
            const d = await fetchJSON(NEWS_EX_URL);
            if (prosesUsang('news-list', n)) return;      /* segmen sudah berganti, buang hasil ini */
            gambarTerkunci('news-list', d.teaser, 'Belum ada berita eksklusif.', 'eks', 'Berita Eksklusif');
          } catch (e) {
            if (prosesUsang('news-list', n)) return;
            gambarTerkunci('news-list', [], 'Belum ada berita eksklusif.', 'eks', 'Berita Eksklusif');
          }
          $('news-stamp').textContent = '';
          return;
        }
        try {
          const c = eks ? await loadNewsEks(force) : await loadNewsUmum(force);
          if (prosesUsang('news-list', n)) return;
          renderFeed('news-list', c.items, 'news');
          $('news-stamp').textContent = c.updated ? 'Diperbarui ' + tanggalID(c.updated) : '';
        } catch (e) {
          if (prosesUsang('news-list', n)) return;
          /* Berkas ini gagal dibuka — biasanya karena admin belum meng-upload
             ulang versi terbarunya. Yang bermasalah HANYA berkas ini, jadi kode
             gerbang sengaja TIDAK dicabut: dulu pencabutan otomatis inilah yang
             bikin member eksklusif disuruh memasukkan kode berulang kali. */
          const nm = eks ? 'berita-eksklusif.json' : 'berita.json';
          daftarPenuh['news-list'] = []; pembuatKartu['news-list'] = null;
          kunciSaring('news-list', false);
          $('news-list').innerHTML = '<div class="feed-empty">Belum ada berita, atau berkas <b>' + nm + '</b> ' +
            'belum di-upload ke server.<br>Coba muat ulang beberapa saat lagi.</div>';
          $('news-stamp').textContent = '';
        }
      }

      /* ---------- analisa ---------- */
      async function loadAnalisa(force) {
        if (analisaCache && !force) { renderFeed('analisa-list', analisaCache.items, 'an'); return; }
        $('analisa-list').innerHTML = skeletonFeed(1);
        try {
          const d = await fetchJSON(ANALISA_URL);
          const semua = await bukaIsi(d, await ambilKode());
          analisaCache = { items: urutBaru(semua), updated: d.updated, next: tayangBerikut(semua) };
          renderFeed('analisa-list', analisaCache.items, 'an');
          $('an-stamp').textContent = analisaCache.updated ? 'Diperbarui ' + tanggalID(analisaCache.updated) : '';
        } catch (e) {
          /* Berkas ini gagal dibuka — biasanya karena admin belum meng-upload
             ulang versi terbarunya. Yang bermasalah HANYA berkas ini, jadi kode
             gerbang sengaja TIDAK dicabut: dulu pencabutan otomatis inilah yang
             bikin member eksklusif disuruh memasukkan kode berulang kali. */
          kunciSaring('analisa-list', false);
          $('analisa-list').innerHTML = '<div class="feed-empty">Belum ada analisa, atau berkas <b>analisa.json</b> ' +
            'belum di-upload ke server.</div>';
          $('an-stamp').textContent = '';
        }
      }
      async function checkAnalisaGate() {
        if (tier !== 'eks') {
          $('analisa-lock').hidden = true; $('analisa-body').hidden = false;
          const n = mulaiProses('analisa-list');
          $('analisa-list').innerHTML = skeletonFeed(1);
          $('an-stamp').textContent = '';
          try {
            const d = await fetchJSON(ANALISA_URL);
            if (prosesUsang('analisa-list', n)) return;
            gambarTerkunci('analisa-list', d.teaser, 'Belum ada analisa.', 'eks', 'Analisa Market');
          } catch (e) {
            if (prosesUsang('analisa-list', n)) return;
            gambarTerkunci('analisa-list', [], 'Belum ada analisa.', 'eks', 'Analisa Market');
          }
          return;
        }
        if (await sudahBuka()) {
          $('analisa-lock').hidden = true; $('analisa-body').hidden = false; loadAnalisa();
        } else {
          $('analisa-lock').hidden = false; $('analisa-body').hidden = true;
        }
      }

      /* Cek tiap 30 detik: kalau ada kiriman terjadwal yang waktunya sudah tiba,
         tampilkan sendiri tanpa member perlu memuat ulang halaman. */
      function mulaiPengawasJadwal() {
        setInterval(async () => {
          const now = Date.now();
          const cekBerita = $('v-news') && $('v-news').classList.contains('active');
          const cekAnalisa = $('v-analisa') && $('v-analisa').classList.contains('active');
          if (cekBerita) {
            const c = (newsKind === 'eks') ? newsExCache : newsCache;
            if (c && c.next && c.next <= now) { if (newsKind === 'eks') newsExCache = null; else newsCache = null; await showNews(true); }
          }
          if (cekAnalisa && analisaCache && analisaCache.next && analisaCache.next <= now) {
            analisaCache = null; await loadAnalisa(true);
          }
          /* Beranda hanya disegarkan kalau memang ADA yang jatuh tempo —
             entah kiriman terjadwal atau pengumuman yang habis masa tayangnya.
             Tanpa syarat ini, halaman ter-render ulang tiap 30 detik dan
             terlihat seperti me-refresh sendiri. */
          if ($('v-beranda') && $('v-beranda').classList.contains('active') &&
            berandaJatuhTempo && berandaJatuhTempo <= now) {
            berandaJatuhTempo = null;
            try { await renderBeranda(); } catch (e) { }
          }
          if ($('v-rekap') && $('v-rekap').classList.contains('active')) {
            const c = (rkKind === 'eks') ? rekapExCache : rekapCache;
            if (c && c.next && c.next <= now) { if (rkKind === 'eks') rekapExCache = null; else rekapCache = null; await showRekap(true); }
          }
          if ($('v-materi') && $('v-materi').classList.contains('active')) {
            const c = (mtKind === 'eks') ? materiExCache : materiCache;
            if (c && c.next && c.next <= now) { if (mtKind === 'eks') materiExCache = null; else materiCache = null; await showMateri(true); }
          }
        }, 30000);
      }

      /* ================= INFORMASI & PENGUMUMAN ================= */
      const IK_IG = '<img src="data:image/svg+xml;base64," alt="">';
      const IK_TT = '<img src="data:image/svg+xml;base64," alt="">';
      const IK_WA = '<img src="data:image/svg+xml;base64," alt="">';
      const IK_DC = '<img src="data:image/svg+xml;base64," alt="">';

      const SOS_BAWAAN = {
        ig_fnc: 'https://www.instagram.com/tradewithfnc',
        tt_fnc: 'https://www.tiktok.com/@fncacademy',
        tt_radit: 'https://www.tiktok.com/@raditzfx',
        discord: 'https://discord.gg/Hst9s4jX3',
        ig_mfx: 'https://www.instagram.com/momentum_fxindo',
        ig_pk: 'https://www.instagram.com/psikologidankeuangan',
        tt_pk: 'https://www.tiktok.com/@psikologidankeuangan'
      };
      function sosLink(kunci) {
        const p = pengaturan || {};
        const v = (p.sos && typeof p.sos[kunci] === 'string') ? p.sos[kunci].trim() : '';
        return v || SOS_BAWAAN[kunci] || '';
      }
      window.__bukaLuar = (url) => {
        if (!url) return;
        try { window.open(url, '_blank', 'noopener'); } catch (e) { location.href = url; }
      };
      window.__bukaDiscord = async () => {
        const siap = pengaturanSiap();
        if (!siap) await ambilPengaturan();
        const url = sosLink('discord');
        if (!url) return;
        bukaWA(url, siap);
      };
      window.__cpBisnis = async () => {
        const siap = pengaturanSiap();
        const p = siap ? pengaturan : (await ambilPengaturan());
        const no = waNormal((p && p.cp && p.cp.no) || '087713361586');
        const bawaan = 'Halo Kak Radit, saya mau menghubungi FNC Academy untuk kerja sama. ' +
          'Boleh minta informasi lebih lanjut?';
        const teks = ((p && p.cp && p.cp.teks) || '').trim() || bawaan;
        bukaWA('https://wa.me/' + no + '?text=' + encodeURIComponent(teks), siap);
      };

      function infBaris(jenis, ikon, judul, ket, aksi) {
        return '<button class="inf-baris ' + jenis + '" type="button" onclick="' + aksi + '">' +
          '<span class="inf-ic ' + jenis + '">' + ikon + '</span>' +
          '<span style="flex:1;min-width:0;"><b>' + esc(judul) + '</b><span>' + esc(ket) + '</span></span>' +
          '<span class="pan">&rsaquo;</span></button>';
      }
      function bukaLuarAksi(kunci) {
        return "window.__bukaLuar(window.__sos('" + kunci + "'))";
      }
      window.__sos = (k) => sosLink(k);


      /* ============================================================
         BANTUAN — FAQ & tutorial yang bisa dicari.
         Isinya ditulis di sini (bukan dari berkas luar) supaya tetap
         terbaca walau koneksi member sedang buruk.
         ============================================================ */
      const HP_DATA = [["Mulai di Sini", "&#128075;", [["Saya baru pertama masuk, harus mulai dari mana?", "Tiga langkah saja:<ol><li>Buka tab <b>Profil</b>, isi namamu. Ini dipakai menandai catatan jurnalmu.</li><li>Masih di Profil, buat <b>akun trading</b> — isi nama akun, broker, mata uang, dan saldo awal. Saldo awal dipakai menghitung risiko.</li><li>Buka tab <b>Jurnal</b>, tekan <b>+ Trade Baru</b>, pilih mode <b>Cepat</b>.</li></ol>Selesai. Statistik langsung terisi sendiri."], ["Apa bedanya Umum, Private, dan Eksklusif?", "<b>Umum</b> bisa melihat Beranda, Berita, Kelas, Kalender, Jurnal, Statistik, dan Kalkulator — gratis tanpa kode.<br><b>Private</b> menambah Rekap Live dan Materi.<br><b>Eksklusif</b> menambah Analisa, Berita Eksklusif, Rekap dan Materi Eksklusif, plus prioritas konsultasi."], ["Data saya disimpan di mana? Aman?", "Jurnal, akun, dan profilmu disimpan <b>di dalam browser HP atau laptopmu sendiri</b> — tidak dikirim ke server mana pun. Artinya tidak ada yang bisa melihatnya selain kamu.<br><br>Konsekuensinya: kalau kamu menghapus data browser atau ganti HP, catatanmu ikut hilang. Makanya <b>rutin tekan tombol Backup</b> di tab Jurnal."]]], ["Jurnal Trading", "&#128221;", [["Cara mencatat trade paling cepat", "Tab <b>Jurnal</b> &rarr; <b>+ Trade Baru</b> &rarr; pilih <b>Cepat</b>. Isi market, arah, entry, stop loss, take profit, dan hasil. Tanggal, jam, dan akun diisi sistem otomatis."], ["Cara menempel banyak trade sekaligus", "Tab <b>Jurnal</b> &rarr; <b>+ Trade Baru</b> &rarr; <b>Tempel</b>. Tulis <b>satu trade satu baris</b> dengan format:<br><code>MARKET | ARAH | ENTRY | SL | TP | HASIL</code><br>Contoh:<br><code>XAUUSD | buy | 4450 | 4440 | 4470 | win</code><br><br>Arah boleh <code>buy</code>/<code>sell</code> atau <code>beli</code>/<code>jual</code>. Hasil boleh <code>win</code>/<code>loss</code>/<code>be</code>. Koma dianggap titik desimal, jadi <code>1,0850</code> juga diterima.<br><br>Tekan <b>Periksa Dulu</b> untuk melihat mana yang sudah benar sebelum disimpan."], ["Apa itu Risk % dan kenapa wajib diisi?", "Risk % adalah berapa persen saldo yang kamu pertaruhkan di satu trade. Contoh: saldo $1.000 dengan risk 1% berarti kamu siap rugi $10 kalau kena stop loss.<br><br>Ini <b>wajib</b> karena seluruh perhitungan untung-rugi di tab Statistik memakai angka ini. Kalau kosong, statistikmu jadi nol."], ["Kenapa Net P/L saya beda dengan saldo di broker?", "Angka di sini adalah <b>hasil teoretis</b> berdasarkan jarak stop loss dan take profit — bukan harga eksekusi asli dari broker.<br><br>Perbedaan wajar muncul karena spread, komisi, swap, dan slippage. Untuk mencocokkan saldo asli, tetap pakai laporan dari brokermu."], ["Cara mengamankan catatan jurnal", "Tab <b>Jurnal</b> &rarr; tombol <b>Backup</b>. Sebuah berkas akan terunduh — simpan di Google Drive atau kirim ke chat WhatsApp dirimu sendiri.<br><br>Untuk mengembalikannya di HP baru: tekan <b>Restore</b>, pilih berkas itu.<br><br>Biasakan backup <b>seminggu sekali</b>."]]], ["Kode Akses & Keanggotaan", "&#128273;", [["Di mana memasukkan kode akses?", "Tab <b>Profil</b> &rarr; tombol <b>Masukkan Kode</b>. Setelah kodenya benar, tab yang terkunci langsung terbuka."], ["Kode saya ditolak, padahal sudah benar", "Coba periksa:<ul><li>Huruf besar-kecil dan tanda hubung sudah persis sama</li><li>Tidak ada spasi ikut tersalin di depan atau belakang</li><li>Masa aktif keanggotaanmu belum habis</li></ul>Kalau tetap ditolak, hubungi admin lewat tab Konsultasi di Beranda."], ["Saya sudah bayar tapi tab masih terkunci", "Kode dikirim admin secara manual setelah pembayaran dicek. Kalau sudah lewat beberapa jam dan belum ada kabar, chat admin dan sertakan bukti transfernya."], ["Kenapa saya diminta memasukkan kode lagi?", "Biasanya karena data browser terhapus, memakai mode penyamaran, atau berpindah perangkat. Kodenya masih berlaku — tinggal masukkan lagi di tab Profil."]]], ["Market & Chart", "&#128200;", [["Cara membuka chart sebuah pair", "Di <b>Beranda</b>, ketik nama pair di kotak <b>Cari Pair</b> — bisa pakai kode (<code>gbpjpy</code>) atau nama Indonesia (<code>emas</code>, <code>minyak</code>). Pencet hasilnya, harganya langsung muncul, lalu tekan <b>Buka Chart</b> untuk melihat chart layar penuh beserta alat analisanya.<br><br>Harga beberapa pair utama juga berjalan otomatis di pita <b>Harga Berjalan</b> paling atas."], ["Pair yang saya cari tidak ada di daftar", "Ketik saja simbolnya, nanti muncul tombol <b>Coba buka</b>. Sebagian besar simbol TradingView bisa dibuka lewat jalur itu."], ["Bisakah analisa di chart saya simpan?", "Coretan di chart ini <b>tidak bisa disimpan</b>, karena chart-nya tidak terhubung ke akun TradingView-mu. Begitu ditutup, coretannya hilang.<br><br>Tapi ada <b>ikon kamera</b> di pojok chart — pakai itu untuk menyimpan analisamu sebagai gambar. Untuk analisa yang tersimpan permanen, pakai TradingView atau MT5 milikmu sendiri."], ["Harganya tidak muncul / kosong", "Hampir selalu masalah koneksi. Coba muat ulang halaman. Kalau memakai penghemat data atau pemblokir iklan, coba matikan dulu untuk situs ini."]]], ["Konsultasi 1-on-1", "&#128172;", [["Siapa yang bisa ikut konsultasi?", "Konsultasi 1-on-1 adalah benefit paket <b>Lifetime</b> dan <b>Eksklusif</b>.<br><br><b>Lifetime</b> mengajukan slot dari jadwal yang tersedia. <b>Eksklusif</b> mendapat prioritas, plus bisa mengajukan waktu sendiri di luar jadwal."], ["Cara mengajukan sesi", "Tab <b>Konsultasi</b> &rarr; pilih slot berstatus <b>Kosong</b> &rarr; tekan <b>Ajukan Slot Ini</b>. WhatsApp terbuka dengan pesan yang sudah terisi — tinggal kirim, lalu tunggu konfirmasi admin."], ["Kenapa ajuan saya ditolak karena waktu?", "Pengajuan ditutup <b>1 jam sebelum sesi dimulai</b>, supaya mentor sempat menyiapkan bahan dan meninjau jurnalmu. Silakan pilih jadwal lain."], ["Status slot belum berubah padahal admin sudah membalas", "Jadwal diperbarui admin secara manual, biasanya 15&ndash;30 menit. <b>Konfirmasi dari admin lebih berlaku</b> daripada tampilan di halaman ini."], ["Slot saya keduluan orang lain", "Bisa terjadi kalau dua orang mengajukan berbarengan. Admin akan menawarkan jadwal terdekat yang masih kosong."]]], ["Statistik & Kalkulator", "&#128202;", [["Cara membaca tab Statistik", "<b>Win Rate</b> — persentase trade yang untung.<br><b>Profit Factor</b> — total untung dibagi total rugi; di atas 1 berarti secara keseluruhan kamu untung.<br><b>Drawdown</b> — penurunan terdalam dari puncak saldo.<br><b>Equity Curve</b> — grafik naik-turun saldomu dari waktu ke waktu."], ["Statistik saya kosong padahal sudah ada trade", "Paling sering karena <b>Risk %</b> belum terisi di trade-trade itu. Buka trade-nya, isi Risk %, lalu statistik langsung terhitung."], ["Cara pakai Kalkulator", "Tab <b>Kalkulator</b> punya empat alat: nilai pip, ukuran lot dari risiko, hitung untung-rugi, dan rasio risk-reward. Pilih instrumennya dulu di bagian atas, karena tiap instrumen beda ukuran kontraknya."], ["Ukuran lot dari kalkulator beda dengan broker saya", "Ukuran kontrak tiap broker bisa berbeda. Cek spesifikasi kontrak di brokermu, lalu sesuaikan kolom <b>Contract Size</b> di kalkulator."]]], ["Tampilan & Lainnya", "&#9881;&#65039;", [["Cara mengubah mode gelap atau terang", "Tekan ikon matahari/bulan di pojok kanan atas halaman. Pilihanmu tersimpan di perangkat ini."], ["Kartu sapaan di Beranda bisa disembunyikan?", "Bisa. Tekan tanda <b>&#10005;</b> di pojok kanan atas kartu sapaan. Dia akan muncul lagi saat kamu membuka website berikutnya."], ["Tombol Tanya AI tidak berfungsi", "AI Agent sedang dalam perbaikan. Sementara ini pertanyaanmu dijawab langsung oleh Admin Yudhis lewat WhatsApp — tombolnya sudah otomatis mengarah ke sana."], ["Halaman terasa lambat dibuka", "Coba muat ulang halaman. Kalau tab Berita yang terasa berat, itu karena berkas gambarnya besar — tim sedang mengerjakan perbaikannya."], ["Saya menemukan masalah lain", "Chat admin lewat tab <b>Konsultasi</b> di Beranda. Sertakan tangkapan layar dan sebutkan tab mana yang bermasalah — itu sangat membantu mempercepat perbaikan."]]]];
      let hpKategori = '';

      function hpTandai(teks, q) {
        if (!q) return teks;
        const k = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return teks.replace(/>([^<]+)</g, (m, isi) =>
          '>' + isi.replace(new RegExp('(' + k + ')', 'gi'), '<mark>$1</mark>') + '<');
      }
      function hpCocok(t, j, q) {
        if (!q) return true;
        const k = q.toLowerCase();
        return (t + ' ' + j).toLowerCase().replace(/<[^>]*>/g, ' ').indexOf(k) >= 0;
      }
      function hpGambar() {
        const q = (($('hp-cari') && $('hp-cari').value) || '').trim();
        let total = 0, out = '';
        HP_DATA.forEach((g, gi) => {
          if (hpKategori && hpKategori !== g[0]) return;
          const isi = g[2].filter(x => hpCocok(x[0], x[1], q));
          if (!isi.length) return;
          total += isi.length;
          out += '<div class="hp-grup">' +
            '<div class="hp-grup-judul"><span class="ic">' + g[1] + '</span><h3>' + esc(g[0]) + '</h3></div>' +
            isi.map((x, xi) =>
              '<div class="hp-item' + ((q || hpKategori) && isi.length <= 3 ? ' buka' : '') + '">' +
              '<button type="button" class="hp-t" onclick="window.__hpBuka(this)">' +
              esc(x[0]) + '<span class="pan">&#9660;</span></button>' +
              '<div class="hp-j">' + x[1] + '</div>' +
              '</div>').join('') +
            '</div>';
        });
        const info = $('hp-info');
        if (info) {
          if (q || hpKategori) {
            info.hidden = false;
            info.textContent = total ? (total + ' jawaban ditemukan') : 'Tidak ada yang cocok';
          } else info.hidden = true;
        }
        $('hp-isi').innerHTML = total
          ? (q ? hpTandai(out, q) : out)
          : '<div class="hp-kosong"><b>Belum ketemu jawabannya?</b><br>' +
          'Coba kata kunci lain, atau chat admin lewat tab Konsultasi di Beranda.</div>';
      }
      window.__hpBuka = (b) => { b.parentNode.classList.toggle('buka'); };
      function hpChips() {
        const w = $('hp-chips'); if (!w) return;
        w.innerHTML = '<button type="button" class="hp-chip' + (hpKategori ? '' : ' on') + '" ' +
          'data-hp="">Semua</button>' +
          HP_DATA.map(g => '<button type="button" class="hp-chip' +
            (hpKategori === g[0] ? ' on' : '') + '" data-hp="' + esc(g[0]) + '">' + esc(g[0]) + '</button>').join('');
        w.querySelectorAll('[data-hp]').forEach(b => b.onclick = () => {
          hpKategori = b.dataset.hp; hpChips(); hpGambar();
        });
      }
      function showHelp() {
        if (!$('hp-isi')) return;
        hpChips(); hpGambar();
      }
      function hpPasang() {
        const inp = $('hp-cari'), x = $('hp-cari-x');
        if (!inp) return;
        let jeda = null;
        inp.addEventListener('input', () => {
          if (x) x.classList.toggle('on', !!inp.value);
          clearTimeout(jeda); jeda = setTimeout(hpGambar, 180);
        });
        inp.addEventListener('keydown', e => { if (e.key === 'Escape') { inp.value = ''; hpGambar(); } });
        if (x) x.onclick = () => { inp.value = ''; x.classList.remove('on'); hpGambar(); inp.focus(); };
      }

      async function showInfo() {
        if (!$('info-isi')) return;
        await ambilPengaturan();
        const p = pengaturan || {};
        const jenisCP = ((p.cp && p.cp.jenis) || 'Media Berita, Kerja Sama')
          .split(',').map(x => x.trim()).filter(Boolean);
        $('info-isi').innerHTML =
          '<div class="inf-grup">' +
          '<p class="inf-lbl">Sosial Media FNC Academy</p>' +
          infBaris('ig', IK_IG, 'Instagram FNC Academy', '@tradewithfnc', bukaLuarAksi('ig_fnc')) +
          infBaris('tt', IK_TT, 'TikTok FNC Academy', '@fncacademy', bukaLuarAksi('tt_fnc')) +
          infBaris('tt', IK_TT, 'TikTok Raditz', '@raditzfx \u00b7 Founder FNC Academy', bukaLuarAksi('tt_radit')) +
          infBaris('wa', IK_WA, 'Grup Publik WhatsApp', 'Gratis, tempat ngobrol & tanya-jawab', 'window.__bukaGrup()') +
          infBaris('dc', IK_DC, 'Server Discord FNC', 'Tempat sesi live & diskusi member', 'window.__bukaDiscord()') +
          '</div>' +
          '<div class="inf-grup">' +
          '<p class="inf-lbl">Partner</p>' +
          infBaris('ig', IK_IG, 'Instagram MomentumFX', '@momentum_fxindo', bukaLuarAksi('ig_mfx')) +
          infBaris('ig', IK_IG, 'Instagram Psikologi dan Keuangan', '@psikologidankeuangan', bukaLuarAksi('ig_pk')) +
          infBaris('tt', IK_TT, 'TikTok Psikologi dan Keuangan', '@psikologidankeuangan', bukaLuarAksi('tt_pk')) +
          '</div>' +
          '<div class="inf-grup">' +
          '<p class="inf-lbl">Kontak Kerja Sama</p>' +
          '<div class="inf-cp">' +
          '<h4>Business Inquiry</h4>' +
          '<p>Untuk urusan kerja sama dan peliputan, hubungi langsung. ' +
          'Pertanyaan seputar kelas dan membership lebih cepat lewat menu ' +
          'Konsultasi di Beranda.</p>' +
          '<div class="inf-jenis">' + jenisCP.map(x => '<span>' + esc(x) + '</span>').join('') + '</div>' +
          '<button class="btn" type="button" style="width:100%;" ' +
          'onclick="window.__cpBisnis()">' + IKON_WA_KECIL + ' Contact Now</button>' +
          '</div>' +
          '</div>';
      }

      /* ---------- pop-up pengumuman ----------
         Muncul sekali sehari, dan langsung muncul lagi begitu ada pengumuman
         baru. Kalau muncul tiap kali dibuka, member yang membuka lima kali
         sehari akan cepat terganggu dan berhenti membacanya. */
      const K_PENG = 'fncjt_peng_seen';
      function pengSidik(list) {
        return (list || []).map(a => String(a.id || a.title || '') + '|' + String(a.pub || a.date || '')).join(';');
      }
      function pengHariIni() {
        const d = new Date();
        return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
      }
      function pengKartu(a) {
        const j = String(a.jenis || 'info').toLowerCase();
        const lbl = j === 'live' ? 'Live Sekarang' : (j === 'penting' ? 'Penting' : 'Info');
        return '<div class="peng-item">' +
          (a.image ? '<img src="' + esc(a.image) + '" alt="" loading="lazy">' : '') +
          '<span class="peng-pill ' + esc(j) + '">' + lbl + '</span>' +
          (a.title ? '<h4>' + esc(a.title) + '</h4>' : '') +
          (a.body ? '<div class="teks">' + waFormat(a.body) + '</div>' : '') +
          (a.url ? '<div class="ann-btn" style="margin-top:11px;" onclick="window.__buka(\'' +
            esc(a.url).replace(/'/g, "\\'") + '\')">' + esc(a.cta || 'Buka Link') + '</div>' : '') +
          '<span class="tgl">' + stempelWaktu(a) + '</span>' +
          '</div>';
      }
      window.__ujiPeng = () => tampilPengumuman();
      window.__bukaPengumuman = () => tampilPengumuman(true);
      async function tampilPengumuman(paksa) {
        let list = [];
        try { list = await ambilPengumuman(); } catch (e) { return false; }
        if (!list.length) return false;
        const sidik = pengSidik(list);
        if (!paksa) {
          let simpan = null;
          try { simpan = await store.get(K_PENG); } catch (e) { }
          if (simpan && simpan.sidik === sidik && simpan.hari === pengHariIni()) return false;
        }
        $('peng-isi').innerHTML = list.map(pengKartu).join('');
        $('peng-lanjut').textContent = paksa ? 'Tutup' : 'Lanjut ke Website';
        $('peng-lanjut').onclick = async () => {
          $('peng-overlay').hidden = true;
          try { await store.set(K_PENG, { sidik: sidik, hari: pengHariIni() }); } catch (e) { }
          if (!paksa) go('beranda');
        };
        $('peng-overlay').hidden = false;
        return true;
      }

      /* ================= KONSULTASI 1-ON-1 (beta) =================
         Situs ini statis, tanpa server maupun basis data. Jadi ini BUKAN
         booking langsung: slot yang dipilih dikirim sebagai ajuan lewat
         WhatsApp, lalu admin yang menandainya penuh di panel admin.
         Konsekuensinya, dua orang bisa mengajukan slot yang sama sebelum
         admin sempat memperbaruinya — makanya statusnya ditulis "ajuan",
         bukan "terpesan". */
      const KS_URL = 'jadwal.json';
      const K_KSAYA = 'fncjt_konsul_ajuan';
      let ksCache = null, ksSeg = 'ada', ksPilih = null, ksAjuan = [];

      async function ksMuatAjuan() {
        try { const v = await store.get(K_KSAYA); ksAjuan = Array.isArray(v) ? v : []; }
        catch (e) { ksAjuan = []; }
      }
      function ksSudahAjukan(id) { return ksAjuan.indexOf(id) >= 0; }
      function ksJamKe(t) {
        const m = String(t || '').match(/^(\d{1,2}):(\d{2})$/);
        return m ? (+m[1]) * 60 + (+m[2]) : 0;
      }
      function ksLewat(x) {
        const hari = kalHariIni();
        if (String(x.tgl || '') < hari) return true;
        if (String(x.tgl || '') > hari) return false;
        const d = new Date();
        return ksJamKe(x.jam) + (+x.durasi || 60) < d.getHours() * 60 + d.getMinutes();
      }
      function ksBoleh(x) {
        /* Slot bertanda eksklusif hanya untuk tingkat eksklusif. */
        return (String(x.tingkat || '') !== 'eks') || tier === 'eks';
      }
      function ksUrut(a) {
        return (a || []).slice().sort((x, y) =>
          x.tgl === y.tgl ? ksJamKe(x.jam) - ksJamKe(y.jam)
            : String(x.tgl || '').localeCompare(String(y.tgl || '')));
      }
      function ksSaring(a) {
        let isi = ksUrut((a || []).filter(x => x && x.tgl && x.jam));
        if (ksSeg === 'saya') return isi.filter(x => ksSudahAjukan(x.id));
        if (ksSeg === 'ada') return isi.filter(x => !ksLewat(x) && !x.penuh && ksBoleh(x));
        /* Semua Jadwal sekaligus jadi riwayat: yang sudah terisi maupun sudah
           lewat tetap ditampilkan, terbaru di atas. */
        return isi.reverse();
      }
      function ksAkhir(x) {
        const t = ksJamKe(x.jam) + (+x.durasi || 60);
        return String(Math.floor(t / 60) % 24).padStart(2, '0') + ':' + String(t % 60).padStart(2, '0');
      }
      function ksPita(x) {
        /* Slot terisi diberi warna merah dan menyebut siapa yang mengambil,
           supaya member lain langsung paham slotnya bukan sekadar "tidak bisa
           diklik" — dan tidak perlu bertanya ke admin. */
        if (ksLewat(x) && !x.penuh) return '<span class="ks-pita gelap">Sudah Lewat</span>';
        if (x.penuh) {
          return '<span class="ks-pita penuh">Terisi' +
            (x.pemesan ? '<span class="siapa">' + esc(x.pemesan) + '</span>' : '') + '</span>';
        }
        if (ksSudahAjukan(x.id)) return '<span class="ks-pita ajukan">Sudah Diajukan</span>';
        if (!ksBoleh(x)) return '<span class="ks-pita gelap">Eksklusif</span>';
        return '<span class="ks-pita ada">Kosong</span>';
      }
      function ksSlot(x) {
        const mati = x.penuh || !ksBoleh(x) || ksLewat(x);
        return '<button class="ks-slot' + (mati ? ' mati' : '') + '" type="button"' +
          (mati ? ' disabled' : ' onclick="window.__ksBuka(\'' + esc(x.id) + '\')"') + '>' +
          '<span class="ks-jam"><b>' + esc(x.jam) + '</b><span>' + (+x.durasi || 60) + ' mnt</span></span>' +
          '<span class="ks-isi"><b>' + esc(x.topik || 'Sesi Konsultasi') + '</b>' +
          '<p>Bersama ' + esc(x.mentor || 'Mentor FNC') + '</p></span>' +
          ksPita(x) +
          (String(x.tingkat || '') === 'eks' ? '<span class="ks-pita eks">Eks</span>' : '') +
          '</button>';
      }
      function ksKosong() {
        if (ksSeg === 'saya') return '<div class="feed-empty">Belum ada slot yang kamu ajukan.<br>' +
          'Pilih jadwal di tab Tersedia.</div>';
        if (ksSeg === 'ada') return '<div class="feed-empty">Semua slot sudah terisi untuk saat ini.<br>' +
          'Cek lagi nanti, atau tanya admin lewat Beranda.</div>';
        return '<div class="feed-empty">Jadwal konsultasi belum dibuka.<br>Cek lagi nanti ya.</div>';
      }
      function ksGambar(items) {
        $('ks-panel-detail').hidden = true;
        $('ks-list').closest('.panel').hidden = false;
        const isi = ksSaring(items);
        /* Penjelasan panjangnya sudah pindah ke pop-up tata cara. Di sini
           cukup pengingat singkat plus jalur khusus member eksklusif. */
        const beta = '<div class="ks-beta"><span class="ic">&#8505;&#65039;</span>' +
          '<p>Memilih slot berarti mengirim <b>ajuan</b>, bukan langsung terpesan. ' +
          'Status jadwal diperbarui admin sekitar <b>15&ndash;30 menit</b> setelah ' +
          'ajuanmu disetujui. ' +
          '<a onclick="window.__ksInfo()" style="color:var(--orange-deep);cursor:pointer;' +
          'font-weight:700;">Baca tata cara</a></p></div>' +
          (tier === 'eks'
            ? '<div class="ks-bebas" onclick="window.__ksBebas()">' + '<div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="color:var(--orange);"><rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/><path d="M12 12.6v4.4M9.8 14.8h4.4"/></svg></div>' + '<div class="isi">' + '<span class="tag">Eksklusif</span>' + '<b>Ajukan Waktu Sendiri</b>' + '<p>Slot penuh atau jamnya belum cocok? Ajukan waktumu sendiri di luar jadwal, langsung ke admin pilihanmu.</p>' + '</div>' + '<span class="go">&#8594;</span>' + '</div>'
            : '');
        if (!isi.length) { $('ks-list').innerHTML = beta + ksKosong(); return; }
        const hari = kalHariIni();
        $('ks-list').innerHTML = beta + kalKelompok(isi).map(g =>
          '<div class="ks-grup"><div class="ks-hari"><b>' + kalTglID(g.tgl) + '</b>' +
          (g.tgl === hari ? '<span class="kini">Hari Ini</span>' : '') + '</div>' +
          g.isi.map(ksSlot).join('') + '</div>').join('');
      }
      async function ksMuat(force) {
        if (ksCache && !force) return ksCache;
        const d = await fetchJSON(KS_URL);
        ksCache = {
          items: (d && Array.isArray(d.items)) ? d.items : [],
          catatan: (d && d.catatan) || '', updated: (d && d.updated) || ''
        };
        return ksCache;
      }
      async function showKonsul(force) {
        if (!$('ks-list')) return;
        if (tier === 'umum') {
          $('ks-panel-detail').hidden = true;
          gambarTerkunci('ks-list', [], 'Jadwal konsultasi belum dibuka.', 'priv', 'Konsultasi 1-on-1');
          return;
        }
        const n = mulaiProses('ks-list');
        $('ks-list').innerHTML = skeletonFeed(1);
        /* Sekali per sesi. Kalau muncul tiap kali tab dibuka, member yang
           bolak-balik mengecek jadwal akan cepat terganggu — sementara isinya
           sama saja. Tombol "Baca tata cara" tetap tersedia kapan pun. */
        if (!ksInfoTampil) { ksInfoTampil = true; window.__ksInfo(); }
        await ksMuatAjuan();
        try {
          const c = await ksMuat(force);
          if (prosesUsang('ks-list', n)) return;
          ksGambar(c.items);
        } catch (e) {
          if (prosesUsang('ks-list', n)) return;
          $('ks-list').innerHTML = '<div class="feed-empty">Jadwal konsultasi belum dibuka.<br>' +
            'Cek lagi nanti, atau tanya admin lewat Beranda.</div>';
        }
      }
      let ksInfoTampil = false;
      window.__ksInfo = () => {
        $('ks-info-isi').innerHTML =
          '<div class="peng-item">' +
          '<div class="ks-step"><div class="n">1</div><p>Pilih slot yang berstatus ' +
          '<b>Kosong</b> di daftar jadwal.</p></div>' +
          '<div class="ks-step"><div class="n">2</div><p>Tekan <b>Ajukan Slot Ini</b>. ' +
          'Aplikasi menyiapkan pesan berisi tanggal, jam, dan mentornya &mdash; ' +
          'kamu tinggal kirim.</p></div>' +
          '<div class="ks-step"><div class="n">3</div><p>Tunggu balasan admin. ' +
          'Slot baru benar-benar milikmu setelah admin mengonfirmasi.</p></div>' +
          '<div class="ks-step"><div class="n">4</div><p>Status di halaman ini ' +
          'diperbarui <b>15&ndash;30 menit</b> setelah ajuanmu disetujui. ' +
          'Jadi jangan panik kalau belum berubah &mdash; yang menentukan ' +
          'balasan admin, bukan tampilan di sini.</p></div>' +
          '<div class="ks-faq"><h5>Pertanyaan Umum</h5><dl>' +
          '<dt>Kenapa statusnya belum berubah padahal sudah diterima?</dt>' +
          '<dd>Jadwal diperbarui manual oleh admin, sekitar 15&ndash;30 menit. ' +
          'Konfirmasi dari admin lebih dulu berlaku daripada tampilan di halaman ini.</dd>' +
          '<dt>Slotnya sudah keduluan orang lain?</dt>' +
          '<dd>Bisa terjadi kalau dua orang mengajukan berbarengan. ' +
          'Admin akan menawarkan jadwal terdekat yang masih kosong.</dd>' +
          '<dt>Bisa ganti atau batal?</dt>' +
          '<dd>Bisa. Kabari admin yang sama, sebaiknya paling lambat sehari sebelumnya.</dd>' +
          '<dt>Kenapa ada slot yang tidak bisa saya klik?</dt>' +
          '<dd>Slot bertanda <b>Eks</b> khusus member Eksklusif. Slot <b>Terisi</b> ' +
          'sudah diambil member lain.</dd>' +
          '<dt>Sesinya lewat apa?</dt>' +
          '<dd>Tertulis di halaman detail tiap slot. Tautannya dikirim admin ' +
          'menjelang sesi dimulai.</dd>' +
          '</dl></div>' +
          '</div>';
        $('ks-info-overlay').hidden = false;
      };
      if ($('ks-info-ok')) $('ks-info-ok').onclick = () => { $('ks-info-overlay').hidden = true; };

      /* Pop-up penjelasan untuk member Private yang menekan Ajukan Slot. */
      /* Pop-up serbaguna bergaya website — menggantikan kotak bawaan browser
         yang tampilannya tidak menyatu dengan tampilan FNC. */
      function popupInfo(o) {
        const ov = $('ks-info-overlay');
        if (!ov) { if (o.aksi) o.aksi(); return; }
        $('ks-info-ic').innerHTML = o.ikon || '&#128161;';
        $('ks-info-judul').textContent = o.judul || 'Informasi';
        $('ks-info-sub').textContent = o.sub || '';
        $('ks-info-isi').innerHTML = o.isi || '';
        const ok = $('ks-info-ok'), batal = $('ks-info-batal');
        ok.textContent = o.tombol || 'Mengerti';
        ok.onclick = () => { tutupPopupInfo(); if (o.aksi) o.aksi(); };
        if (o.batal) {
          batal.hidden = false;
          batal.textContent = o.batal;
          batal.onclick = () => { tutupPopupInfo(); };
        } else { batal.hidden = true; batal.onclick = null; }
        ov.hidden = false;
      }
      function tutupPopupInfo() {
        const ov = $('ks-info-overlay'); if (ov) ov.hidden = true;
      }

      function ksPopupEksklusif() {
        popupInfo({
          ikon: '&#128274;',
          judul: 'Konsultasi 1-on-1',
          sub: 'Benefit paket Lifetime & Eksklusif',
          tombol: 'Lihat Pilihan Kelas',
          batal: 'Nanti Saja',
          aksi: () => { go('kelas'); },
          isi:
            '<p><b>Konsultasi 1-on-1 adalah benefit paket Lifetime &amp; Eksklusif.</b></p>' +
            '<p>Sesi ini bukan kelas grup &mdash; kamu ngobrol empat mata dengan mentor ' +
            'untuk membahas analisa, strategi, dan evaluasi jurnal trading kamu sendiri.</p>' +
            '<ul style="margin:8px 0 0;padding-left:18px;line-height:1.8;">' +
            '<li><b>Lifetime</b> &mdash; ajukan slot dari jadwal yang tersedia</li>' +
            '<li><b>Eksklusif</b> &mdash; prioritas, plus bisa ajukan waktu di luar jadwal</li>' +
            '</ul>' +
            '<p style="margin-top:12px;">Kamu belum punya akses ke fitur ini. ' +
            'Lihat pilihan paketnya dulu, yuk.</p>'
        });
      }

      /* Pop-up kalau member menekan Ajukan kurang dari 1 jam sebelum sesi. */
      function ksPopupTerlambat(sisa) {
        const kabar = (sisa !== null && sisa > 0)
          ? ('Sesi ini mulai <b>' + sisa + ' menit lagi</b>.')
          : 'Sesi ini sudah lewat waktunya.';
        popupInfo({
          ikon: '&#9200;',
          judul: 'Pengajuan Sudah Ditutup',
          sub: 'Batas ajuan 1 jam sebelum sesi',
          tombol: 'Pilih Jadwal Lain',
          isi:
            '<p>' + kabar + '</p>' +
            '<p><b>Pengajuan ditutup 1 jam sebelum sesi dimulai.</b></p>' +
            '<p>Ini supaya mentor punya waktu menyiapkan bahan dan meninjau jurnal kamu, ' +
            'jadi sesinya benar-benar terpakai &mdash; bukan habis untuk persiapan.</p>' +
            '<p style="margin-top:12px;">Silakan pilih jadwal lain, atau ajukan waktu sendiri ' +
            'kalau semua slot sudah penuh.</p>'
        });
      }

      /* Ajuan waktu bebas: member memilih sendiri mau menghubungi admin yang mana. */
      window.__ksBebas = () => {
        popupInfo({
          ikon: '&#128197;',
          judul: 'Ajukan Waktu Sendiri',
          sub: 'Khusus member Eksklusif',
          tombol: 'Nanti Saja',
          isi:
            '<p>Semua slot penuh atau jamnya belum cocok? Sebagai member <b>Eksklusif</b>, ' +
            'kamu bisa mengajukan waktu sendiri di luar jadwal.</p>' +
            '<p style="margin-top:10px;"><b>Mau diajukan ke admin yang mana?</b></p>' +
            '<div class="ks-adm-pilih">' +
            '<button type="button" class="ks-adm" onclick="window.__ksBebasKirim(\'a1\')">' +
            '<b>Yudhis</b><span>Mentor utama &middot; analisa &amp; strategi</span></button>' +
            '<button type="button" class="ks-adm" onclick="window.__ksBebasKirim(\'a2\')">' +
            '<b>Radit</b><span>Founder &middot; arah belajar &amp; evaluasi</span></button>' +
            '<button type="button" class="ks-adm" onclick="window.__ksBebasKirim(\'a3\')">' +
            '<b>Alief</b><span>Operasional &middot; jadwal &amp; keanggotaan</span></button>' +
            '</div>' +
            '<p style="margin-top:12px;font-size:11.5px;color:var(--gray);line-height:1.6;">' +
            'Sebutkan dua atau tiga pilihan waktu biar admin gampang mencocokkan. ' +
            'Ajuan tetap ditutup 1 jam sebelum sesi dimulai.</p>'
        });
      };
      window.__ksBebasKirim = async (tujuan) => {
        tutupPopupInfo();
        const siap = pengaturanSiap();
        const kode = { a1: 1, a2: 1, a3: 1 }[tujuan] ? tujuan : 'a1';
        const no = await nomorAdmin(kode === 'a2' ? 'a2priv' : kode);
        if (!no) { alert('Nomor admin belum diatur. Coba lagi nanti ya.'); return; }
        const sapa = { a1: 'Yudhis', a2: 'Radit', a3: 'Alief' }[kode] || 'Admin';
        const nama = (profil && profil.nama) ? (' Saya ' + profil.nama + '.') : '';
        const pesan = 'Halo Kak ' + sapa + '.' + nama + '\n\n' +
          'Saya mau mengajukan sesi konsultasi 1-on-1 di luar jadwal yang ada di website.\n\n' +
          'Paket saya: (Lifetime / Eksklusif)\n' +
          'Topik yang ingin dibahas: \n' +
          'Pilihan waktu saya:\n' +
          '1. \n' +
          '2. \n\n' +
          'Mohon dicek ketersediaannya ya. Terima kasih.';
        bukaWA('https://wa.me/' + no + '?text=' + encodeURIComponent(pesan), siap);
      };
      window.__ksBuka = (id) => {
        const c = ksCache; if (!c) return;
        const x = (c.items || []).find(y => y.id === id); if (!x) return;
        ksPilih = x;
        $('ks-detail').innerHTML =
          '<div class="ks-detail">' +
          '<h4>' + esc(x.topik || 'Sesi Konsultasi') + '</h4>' +
          '<div class="wkt">' + kalTglID(x.tgl) + ' &middot; ' + esc(x.jam) + '&ndash;' + ksAkhir(x) + ' WIB</div>' +
          '<div class="ks-baris"><span>Mentor</span><b>' + esc(x.mentor || 'Mentor FNC') + '</b></div>' +
          '<div class="ks-baris"><span>Ajukan ke</span><b>' +
          ({ a1: 'Admin Yudhis', a2: 'Admin Radit', a3: 'Admin Alief' }[x.tujuan] || 'Admin Yudhis') +
          '</b></div>' +
          '<div class="ks-baris"><span>Durasi</span><b>' + (+x.durasi || 60) + ' menit</b></div>' +
          '<div class="ks-baris"><span>Media</span><b>' + esc(x.media || 'Google Meet') + '</b></div>' +
          '<div class="ks-baris"><span>Status</span><b>' +
          (x.penuh
            ? '<span style="color:#B91C1C;">Terisi' + (x.pemesan ? ' &middot; ' + esc(x.pemesan) : '') + '</span>'
            : '<span style="color:#15803D;">Kosong</span>') + '</b></div>' +
          '<div class="ks-baris"><span>Untuk</span><b>' +
          (String(x.tingkat || '') === 'eks' ? 'Member Eksklusif' : 'Private &amp; Eksklusif') + '</b></div>' +
          (x.catatan ? '<p style="margin:13px 0 0;font-size:12px;line-height:1.7;' +
            'color:var(--slate-2);">' + waFormat(x.catatan) + '</p>' : '') +
          '<div class="welcome-actions" style="margin-top:15px;">' +
          (ksSudahAjukan(x.id)
            ? '<button class="btn ghost" type="button" onclick="window.__ksAjukan()">' +
            'Kirim Ulang Ajuan</button>'
            : '<button class="btn" type="button" onclick="window.__ksAjukan()">' +
            'Ajukan Slot Ini</button>') +
          '</div>' +
          '<p style="margin:12px 0 0;font-size:11.5px;color:var(--gray);line-height:1.6;">' +
          'Slot baru terkunci setelah admin membalas. Kalau keduluan orang lain, ' +
          'admin akan menawarkan jadwal terdekat.</p>' +
          '</div>';
        $('ks-panel-detail').hidden = false;
        $('ks-list').closest('.panel').hidden = true;
        window.scrollTo(0, 0);
      };
      /* Sisa waktu menuju slot, dalam menit. Minus berarti slot sudah lewat. */
      function ksSisaMenit(x) {
        try {
          const m = String(x.jam || '').match(/^(\d{1,2}):(\d{2})$/);
          if (!m) return null;
          const t = String(x.tgl || '').split('-');
          if (t.length !== 3) return null;
          const mulai = new Date(+t[0], (+t[1]) - 1, +t[2], +m[1], +m[2], 0, 0);
          return Math.round((mulai.getTime() - Date.now()) / 60000);
        } catch (e) { return null; }
      }
      /* Batas ajuan: paling lambat 1 jam sebelum sesi dimulai. */
      const KS_BATAS_MENIT = 60;

      window.__ksAjukan = async () => {
        if (!ksPilih) return;

        /* Konsultasi 1-on-1 adalah benefit paket Lifetime & Eksklusif. Sistem belum
           bisa membedakan Lifetime dari Private biasa (kodenya sama), jadi semua
           member berbayar boleh mengajukan dan admin yang memverifikasi saat
           konfirmasi. Sengaja dibuat longgar: memblokir member Lifetime yang sudah
           membayar jauh lebih merugikan daripada menolak satu ajuan yang keliru. */
        if (tier === 'umum') { ksPopupEksklusif(); return; }

        /* Admin butuh waktu menyiapkan sesi, jadi ajuan ditutup 1 jam sebelum mulai. */
        const sisa = ksSisaMenit(ksPilih);
        if (sisa !== null && sisa < KS_BATAS_MENIT) {
          ksPopupTerlambat(sisa);
          return;
        }

        const siap = pengaturanSiap();
        /* Tiap slot bisa diarahkan ke admin berbeda. Kalau admin belum memilih,
           ajuannya masuk ke Yudhis. */
        const tujuan = { a1: 1, a2: 1, a3: 1 }[ksPilih.tujuan] ? ksPilih.tujuan : 'a1';
        /* Konsultasi hanya untuk member berbayar, jadi Radit memakai nomor
           khususnya — bukan nomor yang dipajang untuk pengunjung umum. */
        const no = await nomorAdmin(tujuan === 'a2' ? 'a2priv' : tujuan);
        if (!no) { alert('Nomor admin belum diatur. Coba lagi nanti ya.'); return; }
        const nama = (profil && profil.nama) ? (' Saya ' + profil.nama + '.') : '';
        const sapa = { a1: 'Yudhis', a2: 'Radit', a3: 'Alief' }[tujuan] || '';
        const pesan = 'Halo Admin ' + sapa + '.' + nama + ' Saya mau mengajukan sesi konsultasi:\n\n' +
          'Topik: ' + (ksPilih.topik || 'Sesi Konsultasi') + '\n' +
          'Tanggal: ' + kalTglID(ksPilih.tgl) + '\n' +
          'Jam: ' + ksPilih.jam + '-' + ksAkhir(ksPilih) + ' WIB\n' +
          'Mentor: ' + (ksPilih.mentor || 'Mentor FNC') + '\n\n' +
          'Paket saya: (Lifetime / Eksklusif)\n\n' +
          'Mohon dikonfirmasi ya. Terima kasih.';
        if (!ksSudahAjukan(ksPilih.id)) {
          ksAjuan.push(ksPilih.id);
          try { await store.set(K_KSAYA, ksAjuan); } catch (e) { }
        }
        bukaWA('https://wa.me/' + no + '?text=' + encodeURIComponent(pesan), siap);
        window.__ksBuka(ksPilih.id);
      };
      function ksKembali() {
        $('ks-panel-detail').hidden = true;
        $('ks-list').closest('.panel').hidden = false;
        ksPilih = null; window.scrollTo(0, 0);
      }
      if ($('ks-kembali')) $('ks-kembali').onclick = ksKembali;
      if ($('ks-reload')) $('ks-reload').onclick = () => { ksCache = null; ksKembali(); showKonsul(true); };
      document.querySelectorAll('#ks-seg .seg-btn').forEach(b => {
        b.onclick = () => {
          document.querySelectorAll('#ks-seg .seg-btn').forEach(x => x.classList.remove('active'));
          b.classList.add('active'); ksSeg = b.dataset.ks;
          if (ksCache) ksGambar(ksCache.items); else showKonsul();
        };
      });

      /* ================= FNC CHALLENGE =================
         Isinya diatur dari admin lewat produk.json bagian "challenge",
         jadi teks dan manfaatnya bisa diganti tanpa menyentuh kode. */
      const CH_BAWAAN = {
        judul: 'FNC Challenge',
        teks: 'Program tantangan trading dari FNC Academy. Uji konsistensi ' +
          'strategimu dengan aturan yang jelas dan pendampingan dari mentor.',
        manfaat: [
          ['&#127942;', 'Uji Konsistensi Nyata', 'Bukan sekadar profit sekali dua kali — ' +
            'yang dinilai kedisiplinanmu mengikuti rencana.'],
          ['&#128200;', 'Evaluasi Jurnal', 'Setiap peserta dapat pembacaan jurnal: ' +
            'mana yang sudah benar, mana yang perlu diperbaiki.'],
          ['&#127891;', 'Pendampingan Mentor', 'Sesi bahas bareng selama masa tantangan ' +
            'berlangsung.'],
          ['&#128172;', 'Grup Peserta', 'Ruang diskusi khusus antar peserta challenge.'],
          ['&#128220;', 'Sertifikat Penyelesaian', 'Tanda kamu menuntaskan tantangan ' +
            'sesuai aturannya.']
        ]
      };
      function chData() {
        const c = (prdCache && prdCache.challenge) || {};
        return {
          judul: (c.judul || '').trim() || CH_BAWAAN.judul,
          teks: (c.teks || '').trim() || CH_BAWAAN.teks,
          manfaat: (Array.isArray(c.manfaat) && c.manfaat.length)
            ? c.manfaat.map(x => [x.ikon || '&#10003;', x.judul || '', x.teks || ''])
            : CH_BAWAAN.manfaat,
          nb: (c.nb || '').trim()
        };
      }
      async function showChallenge() {
        if (!$('ch-isi')) return;
        try { await loadProduk(); } catch (e) { }
        const d = chData();
        $('ch-isi').innerHTML =
          '<div class="ch-hero">' +
          '<span class="ch-tag"><i></i>Segera Hadir</span>' +
          '<h3>' + esc(d.judul) + '</h3>' +
          '<p>' + waFormat(d.teks) + '</p>' +
          '</div>' +
          '<p class="ch-lbl">Yang Kamu Dapat</p>' +
          '<div class="ch-list">' +
          d.manfaat.map(m =>
            '<div class="ch-item"><div class="ch-ic">' + m[0] + '</div>' +
            '<div style="flex:1;min-width:0;"><b>' + esc(m[1]) + '</b>' +
            '<p>' + esc(m[2]) + '</p></div></div>').join('') +
          '</div>' +
          '<div class="ch-nb">' +
          (d.nb ? waFormat(d.nb)
            : 'Syarat dan cara ikutnya masih disusun. Mau dapat kabar duluan ' +
            'saat dibuka? Gabung Grup Publik lewat tombol di Beranda.') +
          '</div>' +
          '<div class="welcome-actions" style="margin-top:15px;">' +
          '<button class="btn" type="button" onclick="window.__konsul(\'a3\')">' +
          'Tanya Admin Soal Challenge</button>' +
          '</div>';
      }

      /* ================= KELAS =================
         produk.json sengaja tidak dienkripsi: tab ini harus bisa dibuka
         pengunjung umum yang belum punya kode apa pun. */
      const PRD_URL = 'produk.json';
      let prdCache = null, prdPilih = null, byrPilih = null;

      function rupiah(n) {
        const v = Math.round(+n || 0);
        return 'Rp' + String(v).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      }
      function prdUrut(a) {
        return (a || []).slice().sort((x, y) =>
          ((+x.urut || 999) - (+y.urut || 999)) || String(x.nama || '').localeCompare(String(y.nama || '')));
      }
      function prdHabis(x) { return x && x.stok !== null && x.stok !== undefined && +x.stok <= 0; }
      function prdStokTeks(x) {
        if (x.stok === null || x.stok === undefined) return '';
        const n = +x.stok;
        if (n <= 0) return '<div class="kls-stok habis">Stok habis</div>';
        if (n <= 3) return '<div class="kls-stok tipis">Sisa ' + n + ' slot</div>';
        return '<div class="kls-stok">Sisa ' + n + ' slot</div>';
      }
      function prdGambar(x, kelas) {
        return x.gambar
          ? '<img class="kls-gbr' + (kelas ? ' ' + kelas : '') + '" src="' + esc(x.gambar) + '" alt="' + esc(x.nama || '') + '">'
          : '<div class="kls-gbr ph' + (kelas ? ' ' + kelas : '') + '">&#127891;</div>';
      }
      function prdHargaBlok(x) {
        const diskon = (+x.hargaAwal > +x.harga);
        let hemat = '';
        if (diskon) {
          const p = Math.round((1 - (+x.harga) / (+x.hargaAwal)) * 100);
          if (p > 0) hemat = '<span class="kls-hemat">-' + p + '%</span>';
        }
        return '<div class="kls-harga"><b>' + rupiah(x.harga) + '</b>' +
          (diskon ? '<s>' + rupiah(x.hargaAwal) + '</s>' : '') + hemat + '</div>';
      }

      /* ---------- mode "segera dibuka" ----------
         Selama tanggal buka belum lewat, daftar kelas diganti hitung mundur.
         Tanggalnya diatur dari admin, jadi tidak perlu ubah kode untuk menunda. */
      let soonJam = null;
      function soonBerhenti() { if (soonJam) { clearInterval(soonJam); soonJam = null; } }
      function soonTarget(t) {
        if (!t) return null;
        const v = String(t).trim();
        /* tanggal polos dianggap pukul 00:00 waktu setempat */
        const d = /^\d{4}-\d{2}-\d{2}$/.test(v) ? new Date(v + 'T00:00:00') : new Date(v);
        return isNaN(d.getTime()) ? null : d;
      }
      function soonBelumBuka(t) {
        const d = soonTarget(t);
        return !!(d && d.getTime() > Date.now());
      }
      function soonSel(n, label) {
        return '<div class="soon-sel"><b>' + String(Math.max(0, n)).padStart(2, '0') + '</b>' +
          '<span>' + label + '</span></div>';
      }
      function soonIsiJam(d) {
        const el = $('soon-jam'); if (!el) return;
        let sisa = Math.max(0, d.getTime() - Date.now());
        const hari = Math.floor(sisa / 86400000); sisa -= hari * 86400000;
        const jam = Math.floor(sisa / 3600000); sisa -= jam * 3600000;
        const men = Math.floor(sisa / 60000); sisa -= men * 60000;
        const det = Math.floor(sisa / 1000);
        el.innerHTML = soonSel(hari, 'Hari') + soonSel(jam, 'Jam') +
          soonSel(men, 'Menit') + soonSel(det, 'Detik');
      }
      /* Kartu latar sengaja TANPA teks nama & harga. Buram itu efek tampilan
         saja — teksnya tetap terbaca lewat inspect element kalau ditulis.
         Jadi yang ditampilkan cuma gambar + bilah abu. */
      function soonLatar(items) {
        const isi = prdUrut((items || []).filter(x => x && x.aktif !== false)).slice(0, 3);
        if (!isi.length) return '';
        return '<div class="soon-bg" aria-hidden="true">' +
          isi.map(x =>
            '<div class="kls-kartu">' + prdGambar(x) +
            '<div class="kls-isi">' +
            '<div class="soon-bar w1"></div>' +
            '<div class="soon-bar w2"></div>' +
            '<div class="soon-bar tebal"></div>' +
            '</div></div>').join('') +
          '</div>';
      }
      function gambarSoon(t, items) {
        soonBerhenti();
        const d = soonTarget(t);
        if (!d) { return false; }
        const tglTeks = d.toLocaleDateString('id-ID',
          { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        const latar = soonLatar(items);
        $('kls-list').innerHTML = latar
          ? ('<div class="soon-wrap">' + latar + '<div class="soon-depan"><div class="soon-dalam">' +
            soonPanel(tglTeks) + '</div></div></div>')
          : ('<div class="soon">' + soonPanel(tglTeks) + '</div>');
        soonIsiJam(d);
        soonJam = setInterval(() => {
          if (!$('soon-jam')) { soonBerhenti(); return; }
          if (d.getTime() <= Date.now()) { soonBerhenti(); prdCache = null; showKelas(true); return; }
          soonIsiJam(d);
        }, 1000);
        return true;
      }
      function soonPanel(tglTeks) {
        return '' +
          '<span class="soon-tag"><i></i>Segera Dibuka</span>' +
          '<h3>Kelas FNC Academy</h3>' +
          '<p>Kami sedang menyiapkan kelas berbayar FNC Academy. ' +
          'Pendaftaran dibuka serentak, dengan <b>slot terbatas</b>.</p>' +
          '<div class="soon-jam" id="soon-jam"></div>' +
          '<div class="soon-tgl">Pendaftaran dibuka <b>' + esc(tglTeks) + '</b></div>' +
          '<div class="soon-aksi">' +
          '<button class="btn" type="button" onclick="window.__konsul(\'a3\')">' +
          'Tanya Admin Soal Kelasnya</button>' +
          '</div>' +
          '<p class="soon-nb">Mau dapat kabar duluan saat dibuka? ' +
          'Gabung grup publik lewat tombol di Beranda.</p>';
      }

      async function loadProduk(force) {
        if (prdCache && !force) return prdCache;
        const d = await fetchJSON(PRD_URL);
        prdCache = {
          challenge: (d && d.challenge) ? d.challenge : null,
          items: (d && Array.isArray(d.items)) ? d.items : [],
          bayar: (d && d.bayar) ? d.bayar : {},
          bukaPada: (d && d.bukaPada) || '',
          updated: (d && d.updated) || ''
        };
        return prdCache;
      }
      async function showKelas(force) {
        if (!$('kls-list')) return;
        /* Diambil di depan supaya saat tombol WhatsApp ditekan datanya sudah
           ada, dan tab barunya tidak diblokir browser. */
        ambilPengaturan();
        const n = mulaiProses('kls-list');
        $('kls-list').innerHTML = skeletonFeed(1);
        try {
          const c = await loadProduk(force);
          if (prosesUsang('kls-list', n)) return;
          /* Belum waktunya dibuka -> tampilkan hitung mundur, sembunyikan daftar. */
          if (soonBelumBuka(c.bukaPada)) {
            $('kls-detail').hidden = true;
            $('kls-list').closest('.panel').hidden = false;
            gambarSoon(c.bukaPada, c.items);
            return;
          }
          soonBerhenti();
          gambarKelas(c.items);
        } catch (e) {
          if (prosesUsang('kls-list', n)) return;
          soonBerhenti();
          $('kls-list').innerHTML = '<div class="feed-empty">Belum ada kelas yang dibuka.<br>' +
            'Cek lagi nanti, atau tanya admin lewat Beranda.</div>';
        }
      }
      function gambarKelas(items) {
        const isi = prdUrut((items || []).filter(x => x && x.aktif !== false));
        $('kls-detail').hidden = true;
        if (!isi.length) {
          $('kls-list').innerHTML = '<div class="feed-empty">Belum ada kelas yang dibuka.<br>' +
            'Cek lagi nanti ya.</div>';
          return;
        }
        $('kls-list').innerHTML = isi.map(x =>
          '<div class="kls-kartu" onclick="window.__kelasBuka(\'' + esc(x.id) + '\')">' +
          prdGambar(x) +
          '<div class="kls-isi">' +
          '<h4>' + esc(x.nama || '') + '</h4>' +
          (x.ringkas ? '<p>' + waFormat(x.ringkas) + '</p>' : '') +
          prdHargaBlok(x) + prdStokTeks(x) +
          '</div></div>').join('');
      }
      window.__kelasBuka = (id) => {
        const c = prdCache; if (!c) return;
        const x = (c.items || []).find(y => y.id === id); if (!x) return;
        prdPilih = x;
        const habis = prdHabis(x);
        $('kls-detail-isi').innerHTML =
          prdGambar(x) +
          '<h3>' + esc(x.nama || '') + '</h3>' +
          prdHargaBlok(x) + prdStokTeks(x) +
          (x.deskripsi ? '<div class="kls-desk">' + waFormat(x.deskripsi) + '</div>' : '') +
          '<div class="kls-beli">' +
          (habis
            ? '<button class="btn" disabled style="opacity:.55;">Stok Habis</button>'
            : '<button class="btn" onclick="window.__kelasBeli()">Beli Sekarang</button>') +
          '<button class="btn ghost bagi" type="button" title="Bagikan kelas ini" ' +
          'aria-label="Bagikan kelas ini" onclick="window.__kelasBagi(this)">&#128279;</button>' +
          '</div>';
        $('kls-detail').hidden = false;
        $('kls-list').closest('.panel').hidden = true;
        window.scrollTo(0, 0);
      };
      /* Tautan langsung ke satu kelas: dibuka lagi, halaman langsung
         menampilkan kelas itu — berguna untuk dikirim ke calon member. */
      window.__kelasBagi = async (tombol) => {
        if (!prdPilih) return;
        const url = location.origin + location.pathname + '#kelas=' + encodeURIComponent(prdPilih.id);
        const judul = prdPilih.nama || 'Kelas FNC Academy';
        if (navigator.share) {
          try { await navigator.share({ title: judul, text: judul, url: url }); return; } catch (e) { }
        }
        const beres = () => {
          if (!tombol) return;
          const t = tombol.innerHTML; tombol.innerHTML = '&#10003;';
          setTimeout(() => { tombol.innerHTML = t; }, 1500);
        };
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(beres, () => prompt('Salin tautannya:', url));
            return;
          }
        } catch (e) { }
        prompt('Salin tautannya:', url);
      };
      /* Kalau halaman dibuka dengan #kelas=..., langsung ke kelas itu. */
      async function kelasDariTautan() {
        const h = String(location.hash || '');
        let m = h.match(/^#kelas=(.+)$/);
        if (m) {
          const id = decodeURIComponent(m[1]);
          try {
            const c = await loadProduk();
            if (soonBelumBuka(c.bukaPada)) return false;
            if (!(c.items || []).some(x => x.id === id)) return false;
            go('kelas');
            setTimeout(() => window.__kelasBuka(id), 260);
            return true;
          } catch (e) { return false; }
        }
        m = h.match(/^#(berita|analisa|rekap)=(.+)$/);
        if (m) {
          const jenis = m[1], id = decodeURIComponent(m[2]);
          go(jenis === 'analisa' ? 'analisa' : jenis === 'rekap' ? 'rekap' : 'news');
          buruKiriman(jenis, id);
          return true;
        }
        return false;
      }
      /* ---------- bagikan kiriman ----------
         Tautannya memakai id kiriman. Untuk isi eksklusif, penerima tetap
         harus punya kodenya — tautan cuma mengantar ke kirimannya. */
      async function bagikanTautan(url, judul, tombol) {
        if (navigator.share) {
          try { await navigator.share({ title: judul, text: judul, url: url }); return; } catch (e) { }
        }
        const beres = () => {
          if (!tombol) return;
          const t = tombol.innerHTML; tombol.innerHTML = '&#10003; Tersalin';
          setTimeout(() => { tombol.innerHTML = t; }, 1600);
        };
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(beres, () => prompt('Salin tautannya:', url));
            return;
          }
        } catch (e) { }
        prompt('Salin tautannya:', url);
      }
      function tautanKe(jenis, id) {
        return location.origin + location.pathname + '#' + jenis + '=' + encodeURIComponent(id);
      }
      window.__sorotKiriman = (id) => sorotKiriman(id);
      window.__feedBagi = (id, jenis, tombol) => {
        const kartu = document.querySelector('[data-kid="' + CSS.escape(id) + '"]');
        const judul = (kartu && kartu.querySelector('.fi-judul,h4,h3'))
          ? kartu.querySelector('.fi-judul,h4,h3').textContent.trim()
          : (jenis === 'analisa' ? 'Analisa FNC Academy'
            : jenis === 'rekap' ? 'Rekap Live FNC Academy' : 'Berita FNC Academy');
        bagikanTautan(tautanKe(jenis, id), judul, tombol);
      };
      /* Membuka kiriman tertentu: pindah tab, bentangkan kartunya, lalu
         digulir ke sana dan disorot sebentar supaya ketemu. */
      function sorotKiriman(id) {
        const kartu = document.querySelector('[data-kid="' + CSS.escape(id) + '"]');
        if (!kartu) return false;
        document.querySelectorAll('.feed-item.buka').forEach(x => {
          if (x !== kartu) x.classList.remove('buka');
        });
        kartu.classList.add('buka', 'disorot');
        try { kartu.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) { }
        setTimeout(() => kartu.classList.remove('disorot'), 2600);
        return true;
      }
      /* Kirimannya belum tentu langsung ada di layar. Tiga sebab, dan
         ketiganya ditangani di sini:
           1. berkasnya masih diunduh — jadi ditunggu berulang
           2. kirimannya eksklusif — segmen Eksklusif dibuka sendiri
           3. kirimannya sudah terdorong ke bawah — daftar dimuat lebih banyak
         Untuk isi eksklusif tanpa kode yang benar, kartunya memang tidak akan
         pernah ada, jadi pencarian berhenti sendiri tanpa membocorkan apa pun. */
      function buruKiriman(jenis, id) {
        const elId = (jenis === 'analisa') ? 'analisa-list'
          : (jenis === 'rekap') ? 'rk-list' : 'news-list';
        /* Rekap punya segmen Private/Eksklusif sendiri, sama seperti Berita. */
        const segId = (jenis === 'analisa') ? null
          : (jenis === 'rekap') ? 'rk-seg' : 'news-seg';
        let sisa = 30, sudahSegmen = false, muat = 0;
        const coba = setInterval(() => {
          if (sorotKiriman(id)) { clearInterval(coba); return; }
          if (--sisa <= 0) { clearInterval(coba); return; }
          const daftar = $(elId);
          if (!daftar) return;
          /* sesudah beberapa kali gagal, coba segmen Eksklusif */
          if (!sudahSegmen && sisa < 26 && segId) {
            const eks = document.querySelector('#' + segId + ' [data-nk="eks"]');
            if (eks && !eks.classList.contains('active')) { sudahSegmen = true; eks.click(); return; }
            sudahSegmen = true;
          }
          /* lalu muat sisa daftarnya, siapa tahu kirimannya sudah jauh ke bawah */
          const lagi = daftar.querySelector('[data-lagi]');
          if (lagi && muat < 6) { muat++; lagi.click(); }
        }, 240);
      }
      function kelasKembali() {
        $('kls-detail').hidden = true;
        $('kls-list').closest('.panel').hidden = false;
        prdPilih = null;
        window.scrollTo(0, 0);
      }
      if ($('kls-kembali')) $('kls-kembali').onclick = kelasKembali;
      if ($('kls-reload')) $('kls-reload').onclick = () => { prdCache = null; kelasKembali(); showKelas(true); };

      /* ---------- pop-up pembayaran ---------- */
      const BYR_LABEL = { bca: 'BCA', gopay: 'GoPay', dana: 'DANA', qris: 'QRIS' };
      /* Logo diambil dari yang di-upload admin. Kalau belum ada, dipakai
         tulisan berwarna merek — tetap rapi, tidak pernah kosong. */
      function byrIkon(kunci) {
        const b = (prdCache && prdCache.bayar) || {};
        const d = b[kunci] || {};
        const lg = d.logo || LOGO_BAWAAN[kunci] || '';
        const isi = lg
          ? '<img src="' + esc(lg) + '" alt="' + esc(BYR_LABEL[kunci] || '') + '">'
          : '<span class="byr-wm ' + kunci + '">' + esc(BYR_LABEL[kunci] || '') + '</span>';
        return '<span class="byr-ic">' + isi + '</span>';
      }
      /* Logo bawaan — dipakai kalau admin belum meng-upload gantinya.
         Ukurannya sudah dikecilkan (WebP tinggi 96px, GoPay memakai SVG). */
      const LOGO_BAWAAN = {
        bca: 'data:image/webp;base64,',
        gopay: 'data:image/svg+xml;base64,',
        dana: 'data:image/webp;base64,',
        qris: 'data:image/webp;base64,'
      };
      function byrTersedia() {
        const b = (prdCache && prdCache.bayar) || {};
        const out = [];
        if (b.bca && b.bca.no) out.push(['bca', 'Transfer Bank', 'BCA']);
        if (b.gopay && b.gopay.no) out.push(['gopay', 'E-wallet', 'GoPay']);
        if (b.dana && b.dana.no) out.push(['dana', 'E-wallet', 'DANA']);
        out.push(['qris', 'Scan QR', 'QRIS']);
        return out;
      }
      window.__kelasBeli = () => {
        if (!prdPilih) return;
        byrPilih = null;
        const opsi = byrTersedia();
        $('byr-isi').innerHTML =
          '<h3 style="margin:0 0 4px;font-size:17px;">Pilih Metode Pembayaran</h3>' +
          '<p style="margin:0 0 15px;font-size:12.5px;color:var(--gray);line-height:1.6;">' +
          esc(prdPilih.nama || '') + '</p>' +
          opsi.map(o =>
            '<button class="byr-opsi" type="button" onclick="window.__byrPilih(\'' + o[0] + '\')">' +
            byrIkon(o[0]) +
            '<span style="flex:1;min-width:0;"><b>' + o[2] + '</b><span>' + o[1] + '</span></span>' +
            '<span style="color:var(--gray);">&rsaquo;</span>' +
            '</button>').join('') +
          '<div class="byr-total"><span>Total tagihan</span><b>' + rupiah(prdPilih.harga) + '</b></div>';
        $('byr-overlay').hidden = false;
      };
      window.__byrPilih = (kunci) => {
        if (!prdPilih) return;
        byrPilih = kunci;
        const b = (prdCache && prdCache.bayar) || {};
        const d = b[kunci] || {};
        let blok = '';
        if (kunci === 'qris') {
          blok = '<div class="byr-ingat" style="background:var(--aksen-halus);">' +
            '<b>QRIS dibuatkan admin sesuai nominal pesananmu.</b><br>' +
            esc(d.catatan || 'Chat admin dulu ya, nanti kode QR-nya dikirim langsung.') +
            '</div>';
        } else {
          blok = '<div class="byr-nomor"><div class="no"><b>' + esc(d.no || '-') + '</b>' +
            '<span>a.n. ' + esc(d.nama || '-') + '</span></div>' +
            '<button class="btn ghost sm" type="button" ' +
            'onclick="window.__byrSalin(\'' + esc(String(d.no || '')) + '\',this)">Salin</button></div>' +
            '<div class="byr-ingat"><b>Transfer tepat ' + rupiah(prdPilih.harga) + '</b>, ' +
            'lalu <b>screenshot bukti transfernya</b>.<br>' +
            'Setelah itu tekan tombol di bawah &mdash; jangan lupa <b>lampirkan foto buktinya</b> ' +
            'di chat, supaya admin bisa langsung memproses.</div>';
        }
        $('byr-isi').innerHTML =
          '<button class="btn ghost sm" type="button" onclick="window.__kelasBeli()" ' +
          'style="margin-bottom:13px;">&larr; Ganti Metode</button>' +
          '<div style="display:flex;align-items:center;gap:11px;margin-bottom:9px;">' +
          byrIkon(kunci) +
          '<h3 style="margin:0;font-size:17px;">Bayar via ' + esc(BYR_LABEL[kunci] || '') + '</h3>' +
          '</div>' +
          '<p style="margin:0 0 6px;font-size:12.5px;color:var(--gray);line-height:1.6;">' +
          esc(prdPilih.nama || '') + '</p>' +
          blok +
          '<div class="welcome-actions">' +
          '<button class="btn" type="button" onclick="window.__byrKirim()">' +
          (kunci === 'qris' ? 'Chat Admin untuk QRIS' : 'Kirim Bukti Pembayaran') + '</button>' +
          '</div>' +
          '<div class="byr-total"><span>Total tagihan</span><b>' + rupiah(prdPilih.harga) + '</b></div>';
      };
      window.__byrSalin = (teks, tombol) => {
        const selesai = () => {
          if (tombol) {
            const t = tombol.textContent; tombol.textContent = 'Tersalin';
            setTimeout(() => { tombol.textContent = t; }, 1400);
          }
        };
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(teks).then(selesai, () => selesai());
          } else { selesai(); }
        } catch (e) { selesai(); }
      };
      window.__byrKirim = async () => {
        if (!prdPilih) return;
        const siap = pengaturanSiap();
        const no = await nomorAdmin('a2');
        if (!no) { alert('Nomor admin belum diatur. Coba lagi nanti ya.'); return; }
        const nama = (profil && profil.nama) ? (' Saya ' + profil.nama + '.') : '';
        const metode = BYR_LABEL[byrPilih] || '';
        let pesan;
        if (byrPilih === 'qris') {
          pesan = 'Halo Admin FNC.' + nama + ' Saya mau daftar ' + (prdPilih.nama || '') +
            ' (' + rupiah(prdPilih.harga) + ') dan mau bayar pakai QRIS. ' +
            'Boleh dibuatkan kode QR-nya?';
        } else if (prdPilih.wa) {
          pesan = String(prdPilih.wa).replace(/\{nama\}/g, prdPilih.nama || '')
            .replace(/\{harga\}/g, rupiah(prdPilih.harga));
        } else {
          pesan = 'Halo Admin FNC.' + nama + ' Saya sudah transfer untuk ' + (prdPilih.nama || '') +
            ' (' + rupiah(prdPilih.harga) + ') via ' + metode + '. ' +
            'Bukti transfernya saya lampirkan di chat ini ya.';
        }
        bukaWA('https://wa.me/' + no + '?text=' + encodeURIComponent(pesan), siap);
      };
      if ($('byr-tutup')) $('byr-tutup').onclick = () => { $('byr-overlay').hidden = true; };

      /* ================= KALENDER EKONOMI =================
         Berkas kalender.json dikunci dengan DUA kode (private + eksklusif),
         jadi member Private maupun Eksklusif sama-sama bisa membukanya.
         Pengguna percobaan hanya dapat teaser: tanggal + dampak, tanpa
         jam, negara, maupun nama rilis. */
      const KAL_URL = 'kalender.json';
      let kalCache = null;
      let kalCari = '';        /* kata kunci pencarian */
      let kalDmp = [];         /* dampak yang dipilih; kosong = semua */
      let kalTh = '', kalBl = '', kalTg = '';   /* saringan tahun / bulan / tanggal */
      let kalLihatLalu = false;             /* tampilkan hari yang sudah lewat? */

      function kalPad(n) { return String(n).length < 2 ? '0' + n : String(n); }
      function kalHariIni() {
        const d = new Date();
        return d.getFullYear() + '-' + kalPad(d.getMonth() + 1) + '-' + kalPad(d.getDate());
      }
      function kalTglID(t) {
        const p = String(t || '').split('-');
        if (p.length !== 3) return esc(t || '');
        const d = new Date(+p[0], +p[1] - 1, +p[2]);
        if (isNaN(d)) return esc(t || '');
        return d.toLocaleDateString('id-ID',
          { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      }
      /* Angka dari teks bebas: "142K", "-1,1%", "3.5" -> Number.
         Dipakai hanya untuk mewarnai aktual vs perkiraan. */
      function kalAngka(v) {
        if (v === null || v === undefined) return null;
        let t = String(v).trim().replace(/\s|%/g, '');
        if (!t) return null;
        if (t.indexOf(',') >= 0 && t.indexOf('.') < 0) t = t.replace(',', '.');
        else t = t.replace(/,/g, '');
        const m = t.match(/^(-?\d+(?:\.\d+)?)([KkMmBb])?$/);
        if (!m) return null;
        let n = parseFloat(m[1]);
        if (isNaN(n)) return null;
        const p = (m[2] || '').toLowerCase();
        if (p === 'k') n *= 1e3; else if (p === 'm') n *= 1e6; else if (p === 'b') n *= 1e9;
        return n;
      }
      function kalDmpBar(d) {
        const n = Math.max(1, Math.min(3, +d || 1));
        return '<span class="kal-dmp d' + n + '"><i></i><i></i><i></i></span>';
      }
      function kalUrut(a) {
        return (a || []).slice().sort((x, y) =>
          x.tgl === y.tgl ? String(x.jam || '').localeCompare(String(y.jam || ''))
            : String(x.tgl || '').localeCompare(String(y.tgl || '')));
      }
      function kalDmpNorm(v) { return Math.max(1, Math.min(3, +v || 1)); }
      function kalSaring(a) {
        const hari = kalHariIni();
        let isi = (a || []).filter(x => x && x.tgl);
        /* Hari yang sudah lewat disembunyikan supaya jadwal terdekat ada di
           paling atas — kalau ikut ditampilkan, member harus menggulir jauh
           melewati puluhan rilis lama sebelum sampai ke hari ini. */
        if (!kalLihatLalu && !kalTh && !kalBl && !kalTg) isi = isi.filter(x => x.tgl >= hari);
        if (kalTh) isi = isi.filter(x => String(x.tgl).slice(0, 4) === kalTh);
        if (kalBl) isi = isi.filter(x => String(x.tgl).slice(5, 7) === kalBl);
        if (kalTg) isi = isi.filter(x => String(x.tgl).slice(8, 10) === kalTg);
        if (kalDmp.length) isi = isi.filter(x => kalDmp.indexOf(kalDmpNorm(x.dmp)) >= 0);
        const q = kalCari.trim().toLowerCase();
        if (q) {
          isi = isi.filter(x => ((x.nama || '') + ' ' + (x.neg || '') + ' ' + (x.cat || ''))
            .toLowerCase().indexOf(q) >= 0);
        }
        return kalUrut(isi);
      }
      function kalAdaSaringan() {
        return !!(kalCari.trim() || kalDmp.length || kalTh || kalBl || kalTg);
      }
      const KAL_BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
        'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
      /* Pilihan tanggal dibangun dari jadwal yang benar-benar ada, jadi tidak
         ada bulan atau tanggal kosong yang bisa dipilih. */
      function renderKalTgl(items) {
        if (!$('kal-th')) return;
        const semua = (items || []).filter(x => x && x.tgl);
        const th = [], bl = [], tg = [];
        semua.forEach(x => {
          const t = String(x.tgl);
          const a = t.slice(0, 4), b = t.slice(5, 7), c = t.slice(8, 10);
          if (th.indexOf(a) < 0) th.push(a);
          if ((!kalTh || a === kalTh) && bl.indexOf(b) < 0) bl.push(b);
          if ((!kalTh || a === kalTh) && (!kalBl || b === kalBl) && tg.indexOf(c) < 0) tg.push(c);
        });
        th.sort(); bl.sort(); tg.sort();
        const isi = (el, daftar, nilai, semuaLbl, label) => {
          el.innerHTML = '<option value="">' + semuaLbl + '</option>' +
            daftar.map(v => '<option value="' + esc(v) + '"' + (v === nilai ? ' selected' : '') + '>' +
              esc(label ? label(v) : v) + '</option>').join('');
        };
        isi($('kal-th'), th, kalTh, 'Semua tahun');
        isi($('kal-bl'), bl, kalBl, 'Semua bulan', v => KAL_BULAN[parseInt(v, 10) - 1] || v);
        isi($('kal-tg'), tg, kalTg, 'Semua tgl', v => String(parseInt(v, 10)));
      }
      function renderKalChipDmp() {
        document.querySelectorAll('#kal-dmp-chips [data-dmp]').forEach(b => {
          const v = +b.dataset.dmp;
          b.classList.toggle('on', v === 0 ? kalDmp.length === 0 : kalDmp.indexOf(v) >= 0);
        });
      }
      function kalKelompok(isi) {
        const urut = [], peta = {};
        isi.forEach(x => { if (!peta[x.tgl]) { peta[x.tgl] = []; urut.push(x.tgl); } peta[x.tgl].push(x); });
        return urut.map(t => ({ tgl: t, isi: peta[t] }));
      }
      /* Pemisah tanggal: satu baris melebar di dalam tabel, bukan judul di luar. */
      function kalBand(tgl, hari) {
        return '<div class="kal-band">' + kalTglID(tgl) +
          (tgl === hari ? '<span class="kini">Hari Ini</span>' : '') + '</div>';
      }
      function kalBaris(x) {
        const akt = kalAngka(x.akt), prk = kalAngka(x.prk);
        let cls = '';
        if (akt !== null && prk !== null) cls = akt > prk ? ' naik' : (akt < prk ? ' turun' : '');
        const adaAngka = !!(x.akt || x.prk || x.sbl);
        return '<div class="kal-baris' + ((+x.dmp || 1) >= 3 ? ' tinggi' : '') + '">' +
          '<span class="kal-jam">' + esc(x.jam || '--:--') + '</span>' +
          '<span class="kal-neg">' + esc(x.neg || '') + '</span>' +
          kalDmpBar(x.dmp) +
          '<div><div class="kal-nama">' + esc(x.nama || '') + '</div>' +
          (adaAngka ? '<div class="kal-ang">Akt <b class="' + cls.trim() + '">' + esc(x.akt || '—') +
            '</b> &middot; Perk ' + esc(x.prk || '—') + ' &middot; Sblm ' + esc(x.sbl || '—') + '</div>' : '') +
          (x.cat ? '<div class="kal-cat">&#128161; ' + esc(x.cat) + '</div>' : '') +
          '</div></div>';
      }
      function kalKosong() {
        if (kalAdaSaringan()) {
          return '<div class="feed-empty">Tidak ada rilis yang cocok dengan saringan ini.<br>' +
            '<button class="btn ghost sm" style="margin-top:11px;" ' +
            'onclick="window.__kalReset()">Bersihkan Saringan</button></div>';
        }
        return '<div class="feed-empty">Belum ada jadwal kalender.<br>Cek lagi nanti ya.</div>';
      }
      function gambarKalender(items) {
        const semua = items || [];
        renderKalTgl(semua);
        renderKalChipDmp();
        const isi = kalSaring(semua);
        const info = $('cari-kal-info');
        if (info) {
          if (kalAdaSaringan()) {
            info.hidden = false;
            info.textContent = isi.length
              ? isi.length + ' rilis ditemukan dari ' + semua.length + ' jadwal'
              : 'Tidak ada yang cocok';
          } else { info.hidden = true; info.textContent = ''; }
        }
        const hari = kalHariIni();
        /* Kalau ada jadwal lama yang sedang disembunyikan, beri tahu — jangan
           biarkan member mengira datanya hilang. */
        let bilah = '';
        if (!kalLihatLalu && !kalTh && !kalBl && !kalTg) {
          const lalu = semua.filter(x => x && x.tgl && x.tgl < hari).length;
          if (lalu) {
            bilah = '<div class="kal-lalu"><span>' + lalu + ' jadwal lampau</span>' +
              '<button class="btn ghost sm" type="button" onclick="window.__kalLalu(true)">' +
              'Tampilkan</button></div>';
          }
        } else if (kalLihatLalu && !kalTh && !kalBl && !kalTg) {
          bilah = '<div class="kal-lalu"><span>Jadwal lampau ikut tampil</span>' +
            '<button class="btn ghost sm" type="button" onclick="window.__kalLalu(false)">' +
            'Sembunyikan</button></div>';
        }
        /* Bilah jadwal lama ditaruh di BAWAH daftar, bukan di atas — di atas
           dia menutupi jadwal terdekat yang justru paling ingin dilihat. */
        if (!isi.length) { $('kal-list').innerHTML = kalKosong() + bilah; return; }
        /* Satu tabel utuh; tanggal disisipkan sebagai baris pemisah di antaranya. */
        $('kal-list').innerHTML = '<div class="kal-tbl">' +
          kalKelompok(isi).map(g =>
            kalBand(g.tgl, hari) + g.isi.map(kalBaris).join('')).join('') +
          '</div>' + bilah;
      }
      /* Menggambar ulang dari data yang sudah ada — saringan tidak perlu
         mengunduh berkasnya lagi. */
      function gambarKalUlang() {
        if (!$('kal-list')) return;
        gambarKalender((kalCache && kalCache.items) || []);
      }
      async function loadKalender(force) {
        if (kalCache && !force) return kalCache;
        const d = await fetchJSON(KAL_URL);
        const semua = Array.isArray(d) ? d : (d && Array.isArray(d.items) ? d.items : []);
        kalCache = { items: semua, updated: (d && d.updated) || '' };
        return kalCache;
      }
      async function showKalender(force) {
        if (!$('kal-list')) return;
        const n = mulaiProses('kal-list');
        $('kal-list').innerHTML = skeletonFeed(1);
        try {
          const c = await loadKalender(force);
          if (prosesUsang('kal-list', n)) return;
          gambarKalender(c.items);
          $('kal-stamp').textContent = c.updated ? 'Diperbarui ' + tanggalID(c.updated) : '';
        } catch (e) {
          if (prosesUsang('kal-list', n)) return;
          $('kal-stamp').textContent = '';
          $('kal-list').innerHTML = '<div class="feed-empty">Belum ada kalender, atau berkas ' +
            '<b>kalender.json</b> belum di-upload ke server.</div>';
        }
      }
      if ($('kal-reload')) $('kal-reload').onclick = () => { kalCache = null; showKalender(true); };
      /* chip dampak — bisa pilih lebih dari satu; "Semua" mengosongkan pilihan */
      if ($('kal-dmp-chips')) $('kal-dmp-chips').onclick = e => {
        const b = e.target.closest('[data-dmp]'); if (!b) return;
        const v = +b.dataset.dmp;
        if (v === 0) { kalDmp = []; }
        else {
          const i = kalDmp.indexOf(v);
          if (i >= 0) kalDmp.splice(i, 1); else kalDmp.push(v);
        }
        gambarKalUlang();
      };
      if ($('cari-kal')) {
        const kotak = $('cari-kal-box');
        let jeda = null;
        const jalan = () => {
          kalCari = ($('cari-kal').value || '').trim();
          kotak.classList.toggle('isi', !!kalCari);
          gambarKalUlang();
        };
        $('cari-kal').addEventListener('input', () => { clearTimeout(jeda); jeda = setTimeout(jalan, 200); });
        $('cari-kal').addEventListener('keydown', e => {
          if (e.key === 'Escape') { $('cari-kal').value = ''; jalan(); }
        });
        const hapus = kotak.querySelector('.hapus');
        if (hapus) hapus.onclick = () => { $('cari-kal').value = ''; jalan(); $('cari-kal').focus(); };
      }
      window.__kalLalu = (v) => { kalLihatLalu = !!v; gambarKalUlang(); };
      if ($('kal-th')) {
        const ubah = () => {
          kalTh = $('kal-th').value; kalBl = $('kal-bl').value; kalTg = $('kal-tg').value;
          gambarKalUlang();
        };
        $('kal-th').onchange = () => { kalTh = $('kal-th').value; kalBl = ''; kalTg = ''; gambarKalUlang(); };
        $('kal-bl').onchange = () => { kalBl = $('kal-bl').value; kalTg = ''; gambarKalUlang(); };
        $('kal-tg').onchange = ubah;
        $('kal-tgl-clr').onclick = () => { kalTh = ''; kalBl = ''; kalTg = ''; gambarKalUlang(); };
      }
      window.__kalReset = () => {
        kalCari = ''; kalDmp = []; kalTh = ''; kalBl = ''; kalTg = '';
        if ($('cari-kal')) { $('cari-kal').value = ''; $('cari-kal-box').classList.remove('isi'); }
        gambarKalUlang();
      };

      /* ---------- REKAP LIVE ---------- */
      function kartuRekap(it, i) {
        const wm = it.__eks && profil ? '<div class="wm-tag">' + esc(profil.id) + '</div>' : '';
        const label = (it.__eks ? '<span class="feed-tag">Eksklusif</span>' : '') +
          (it.dur ? '<span class="feed-tag">' + esc(it.dur) + '</span>' : '');
        const buka = (i === 0 && !(kataCari['rk-list'] || '')) ? ' buka' : '';
        return '<div class="feed-item' + buka + '" data-kid="' + esc(it.id || '') + '">' + wm +
          kepalaKartu(it, label, !!it.url) +
          '<div class="fi-isi"><div class="feed-pad">' +
          (it.url ? blokVideo(it) : '') +
          (it.body ? '<div class="feed-body" style="margin-top:10px;">' + waFormat(it.body) + '</div>' : '') +
          (it.url ? '<div class="ext-btn" onclick="window.__buka(\'' + esc(it.url).replace(/'/g, "\\'") + '\')">' +
            '&#9654; Tonton di Google Drive</div>' : '') +
          /* Tautan bagikan hanya membawa NOMOR kirimannya, tidak pernah kode akses
             maupun isinya. Penerima tanpa kode yang benar tidak bisa membuka
             rekap.json sama sekali, jadi tautan yang bocor pun tidak membocorkan isi. */
          (it.id ? '<div class="fi-bagi"><button type="button" title="Bagikan rekap ini" ' +
            'onclick="event.stopPropagation();window.__feedBagi(\'' + esc(it.id) + '\',\'rekap\',this)">' +
            '&#128279; Bagikan</button></div>' : '') +
          '</div></div></div>';
      }
      async function loadRekap(force) {
        const eks = rkKind === 'eks';
        if (eks) {
          if (rekapExCache && !force) return rekapExCache;
          const d = await fetchJSON(REKAP_EX_URL);
          const semua = (await bukaIsi(d, await ambilKode())).map(x => Object.assign({}, x, { __eks: true }));
          rekapExCache = { items: urutBaru(semua), updated: d.updated, next: tayangBerikut(semua) };
          return rekapExCache;
        }
        if (rekapCache && !force) return rekapCache;
        const d = await fetchJSON(REKAP_URL);
        const semua = await bukaIsi(d, await ambilKodeAkses());
        rekapCache = { items: urutBaru(semua), updated: d.updated, next: tayangBerikut(semua) };
        return rekapCache;
      }
      async function showRekap(force) {
        const eks = rkKind === 'eks';
        const n = mulaiProses('rk-list');
        $('rk-list').innerHTML = skeletonFeed(2);
        /* Tanpa kunci (pengguna percobaan) -> hanya teaser buram. */
        if (!eks && tier === 'umum') {
          $('rk-stamp').textContent = '';
          try {
            const d = await fetchJSON(REKAP_URL);
            if (prosesUsang('rk-list', n)) return;
            gambarTerkunci('rk-list', d.teaser, 'Belum ada rekap.', 'priv', 'Rekap Live');
          } catch (e) {
            if (prosesUsang('rk-list', n)) return;
            gambarTerkunci('rk-list', [], 'Belum ada rekap.', 'priv', 'Rekap Live');
          }
          return;
        }
        if (eks && tier !== 'eks') {
          $('rk-stamp').textContent = '';
          try {
            const d = await fetchJSON(REKAP_EX_URL);
            if (prosesUsang('rk-list', n)) return;
            gambarTerkunci('rk-list', d.teaser, 'Belum ada rekap eksklusif.', 'eks', 'Rekap Live Eksklusif');
          } catch (e) {
            if (prosesUsang('rk-list', n)) return;
            gambarTerkunci('rk-list', [], 'Belum ada rekap eksklusif.', 'eks', 'Rekap Live Eksklusif');
          }
          return;
        }
        try {
          const c = await loadRekap(force);
          if (prosesUsang('rk-list', n)) return;
          daftarPenuh['rk-list'] = c.items || [];
          pembuatKartu['rk-list'] = {
            buat: kartuRekap,
            kosong: 'Belum ada rekap yang diposting.<br>Cek lagi nanti ya.'
          };
          gambarDaftar('rk-list', c.items, kartuRekap,
            'Belum ada rekap yang diposting.<br>Cek lagi nanti ya.');
          pasangSaring('rk-list');
          $('rk-stamp').textContent = c.updated ? 'Diperbarui ' + tanggalID(c.updated) : '';
        } catch (e) {
          /* Berkas ini gagal dibuka — biasanya karena admin belum meng-upload
             ulang versi terbarunya. Yang bermasalah HANYA berkas ini, jadi kode
             gerbang sengaja TIDAK dicabut: dulu pencabutan otomatis inilah yang
             bikin member eksklusif disuruh memasukkan kode berulang kali. */
          kunciSaring('rk-list', false);
          $('rk-list').innerHTML = '<div class="feed-empty">Belum ada rekap, atau berkasnya belum di-upload.</div>';
          $('rk-stamp').textContent = '';
        }
      }

      /* ---------- MATERI ---------- */
      function kelasJenis(j) {
        const s = String(j || '').toLowerCase();
        if (s.indexOf('pdf') >= 0) return 'pdf';
        if (s.indexOf('slide') >= 0 || s.indexOf('ppt') >= 0) return 'slide';
        return 'video';
      }
      function kartuMateri(it, i) {
        const wm = it.__eks && profil ? '<div class="wm-tag">' + esc(profil.id) + '</div>' : '';
        const j = it.jenis || 'Video';
        const isVid = kelasJenis(j) === 'video';
        const label = '<span class="mat-kind ' + kelasJenis(j) + '">' + esc(j) + '</span>' +
          (it.__eks ? '<span class="feed-tag">Eksklusif</span>' : '') +
          (isVid && it.dur ? '<span class="feed-tag">' + esc(it.dur) + '</span>' : '');
        const buka = (i === 0 && !(kataCari['mt-list'] || '')) ? ' buka' : '';
        /* Materi tidak menampilkan jam — modul belajar tidak terikat waktu. */
        return '<div class="feed-item' + buka + '" data-kid="' + esc(it.id || '') + '">' + wm +
          kepalaKartu(it, label, isVid && !!it.url, true) +
          '<div class="fi-isi"><div class="feed-pad">' +
          (isVid && it.url ? blokVideo(it) :
            (it.thumb ? '<img class="feed-cover" src="' + esc(it.thumb) + '" alt="" loading="lazy">' : '')) +
          (it.body ? '<div class="feed-body" style="margin-top:10px;">' + waFormat(it.body) + '</div>' : '') +
          (it.url ? '<div class="ext-btn" onclick="window.__buka(\'' + esc(it.url).replace(/'/g, "\\'") + '\')">' +
            '&#128229; Buka materi</div>' : '') +
          '</div></div></div>';
      }
      async function loadMateri(force) {
        const eks = mtKind === 'eks';
        if (eks) {
          if (materiExCache && !force) return materiExCache;
          const d = await fetchJSON(MATERI_EX_URL);
          const semua = (await bukaIsi(d, await ambilKode())).map(x => Object.assign({}, x, { __eks: true }));
          materiExCache = { items: urutBaru(semua), updated: d.updated, next: tayangBerikut(semua) };
          return materiExCache;
        }
        if (materiCache && !force) return materiCache;
        const d = await fetchJSON(MATERI_URL);
        const semua = await bukaIsi(d, await ambilKodeAkses());
        materiCache = { items: urutBaru(semua), updated: d.updated, next: tayangBerikut(semua) };
        return materiCache;
      }
      async function showMateri(force) {
        const eks = mtKind === 'eks';
        const n = mulaiProses('mt-list');
        $('mt-list').innerHTML = skeletonFeed(2);
        if (!eks && tier === 'umum') {
          $('mt-stamp').textContent = '';
          try {
            const d = await fetchJSON(MATERI_URL);
            if (prosesUsang('mt-list', n)) return;
            gambarTerkunci('mt-list', d.teaser, 'Belum ada materi.', 'priv', 'Materi');
          } catch (e) {
            if (prosesUsang('mt-list', n)) return;
            gambarTerkunci('mt-list', [], 'Belum ada materi.', 'priv', 'Materi');
          }
          return;
        }
        if (eks && tier !== 'eks') {
          $('mt-stamp').textContent = '';
          try {
            const d = await fetchJSON(MATERI_EX_URL);
            if (prosesUsang('mt-list', n)) return;
            gambarTerkunci('mt-list', d.teaser, 'Belum ada materi eksklusif.', 'eks', 'Materi Eksklusif');
          } catch (e) {
            if (prosesUsang('mt-list', n)) return;
            gambarTerkunci('mt-list', [], 'Belum ada materi eksklusif.', 'eks', 'Materi Eksklusif');
          }
          return;
        }
        try {
          const c = await loadMateri(force);
          if (prosesUsang('mt-list', n)) return;
          daftarPenuh['mt-list'] = c.items || [];
          pembuatKartu['mt-list'] = {
            buat: kartuMateri,
            kosong: 'Belum ada materi yang diposting.<br>Cek lagi nanti ya.'
          };
          gambarDaftar('mt-list', c.items, kartuMateri,
            'Belum ada materi yang diposting.<br>Cek lagi nanti ya.');
          pasangSaring('mt-list');
          $('mt-stamp').textContent = c.updated ? 'Diperbarui ' + tanggalID(c.updated) : '';
        } catch (e) {
          /* Berkas ini gagal dibuka — biasanya karena admin belum meng-upload
             ulang versi terbarunya. Yang bermasalah HANYA berkas ini, jadi kode
             gerbang sengaja TIDAK dicabut: dulu pencabutan otomatis inilah yang
             bikin member eksklusif disuruh memasukkan kode berulang kali. */
          kunciSaring('mt-list', false);
          $('mt-list').innerHTML = '<div class="feed-empty">Belum ada materi, atau berkasnya belum di-upload.</div>';
          $('mt-stamp').textContent = '';
        }
      }

      /* Menyambungkan kotak pencarian ke daftarnya masing-masing. */
      function pasangPencarian() {
        [['cari-news', 'news-list'], ['cari-an', 'analisa-list'],
        ['cari-rk', 'rk-list'], ['cari-mt', 'mt-list']].forEach(([inp, list]) => {
          const el = $(inp); if (!el) return;
          const kotak = $(inp + '-box');
          let jeda = null;
          const jalan = () => {
            const q = (el.value || '').trim();
            kotak.classList.toggle('isi', !!q);
            kataCari[list] = q;
            tampil[list] = PER_HAL;          /* mulai lagi dari halaman pertama */
            gambarUlang(list);
            pasangSaring(list);
          };
          el.addEventListener('input', () => { clearTimeout(jeda); jeda = setTimeout(jalan, 220); });
          el.addEventListener('keydown', e => { if (e.key === 'Escape') { el.value = ''; jalan(); } });
          kotak.querySelector('.hapus').onclick = () => { el.value = ''; el.focus(); jalan(); };
        });
      }

      function initFeeds() {
        mulaiPengawasJadwal();
        pasangPencarian();
        $('rk-reload').onclick = () => showRekap(true);
        $('mt-reload').onclick = () => showMateri(true);
        /* Penyaring & pencarian dikosongkan saat berpindah segmen —
           daftarnya berbeda, jadi penyaring lama tidak lagi relevan. */
        function resetSaring(id) {
          kataCari[id] = ''; saringAktif[id] = ''; saringTgl[id] = ''; tampil[id] = PER_HAL;
          const kotak = { 'rk-list': 'cari-rk', 'mt-list': 'cari-mt', 'news-list': 'cari-news' }[id];
          if (kotak && $(kotak)) { $(kotak).value = ''; $(kotak + '-box').classList.remove('isi'); }
        }
        window.__resetSaring = resetSaring;
        document.querySelectorAll('#rk-seg .seg-btn').forEach(b => {
          b.onclick = () => {
            document.querySelectorAll('#rk-seg .seg-btn').forEach(x => x.classList.remove('active'));
            b.classList.add('active'); rkKind = b.dataset.rk; resetSaring('rk-list'); showRekap();
          };
        });
        document.querySelectorAll('#mt-seg .seg-btn').forEach(b => {
          b.onclick = () => {
            document.querySelectorAll('#mt-seg .seg-btn').forEach(x => x.classList.remove('active'));
            b.classList.add('active'); mtKind = b.dataset.mt; resetSaring('mt-list'); showMateri();
          };
        });
        $('news-reload').onclick = () => showNews(true);
        $('an-reload').onclick = () => loadAnalisa(true);
        $('an-lock').onclick = kunciGerbang;

        document.querySelectorAll('#news-seg .seg-btn').forEach(b => {
          b.onclick = () => {
            document.querySelectorAll('#news-seg .seg-btn').forEach(x => x.classList.remove('active'));
            b.classList.add('active'); newsKind = b.dataset.nk;
            if (window.__resetSaring) window.__resetSaring('news-list');
            showNews();
          };
        });

        /* dua kotak kode, satu logika */
        [['nx-code', 'nx-submit', 'nx-err'], ['an-code', 'an-submit', 'an-err']].forEach(([ci, si, ei]) => {
          const cek = async () => {
            const v = normCode($(ci).value);
            if (!v) { $(ei).hidden = false; $(ci).focus(); return; }
            const tb = $(si), teksLama = tb.textContent;
            tb.disabled = true; tb.textContent = 'Memeriksa...'; $(ei).hidden = true;
            let ok = false;
            try { ok = await ujiKode(v); } catch (e) { ok = false; }
            tb.disabled = false; tb.textContent = teksLama;
            if (ok) { $(ei).hidden = true; $(ci).value = ''; await bukaGerbang(v); }
            else { $(ei).hidden = false; $(ci).value = ''; $(ci).focus(); }
          };
          $(si).onclick = cek;
          $(ci).addEventListener('keydown', ev => { if (ev.key === 'Enter') cek(); });
        });
      }

      /* ================= KALKULATOR ================= */
      /* quote:'USD'  -> mata uang kutipan adalah USD (EURUSD, XAUUSD)
         quote:'BASE' -> USD ada di depan (USDJPY, USDCAD), pip value dibagi harga */
      const INSTRUMENTS = {
        'XAUUSD': {
          label: 'XAUUSD — Emas', contract: 100, pip: 0.1, quote: 'USD', price: 3300,
          note: '1 lot = 100 troy ounce. 1 pip = 0.1 (setara 10 point di MT5).'
        },
        'XAGUSD': {
          label: 'XAGUSD — Perak', contract: 5000, pip: 0.01, quote: 'USD', price: 38,
          note: '1 lot = 5.000 troy ounce.'
        },
        'EURUSD': { label: 'EURUSD', contract: 100000, pip: 0.0001, quote: 'USD', price: 1.08 },
        'GBPUSD': { label: 'GBPUSD', contract: 100000, pip: 0.0001, quote: 'USD', price: 1.27 },
        'AUDUSD': { label: 'AUDUSD', contract: 100000, pip: 0.0001, quote: 'USD', price: 0.65 },
        'NZDUSD': { label: 'NZDUSD', contract: 100000, pip: 0.0001, quote: 'USD', price: 0.59 },
        'USDJPY': {
          label: 'USDJPY', contract: 100000, pip: 0.01, quote: 'BASE', price: 150,
          note: 'USD di depan, jadi pip value ikut berubah mengikuti harga.'
        },
        'USDCAD': {
          label: 'USDCAD', contract: 100000, pip: 0.0001, quote: 'BASE', price: 1.36,
          note: 'USD di depan, jadi pip value ikut berubah mengikuti harga.'
        },
        'USDCHF': {
          label: 'USDCHF', contract: 100000, pip: 0.0001, quote: 'BASE', price: 0.88,
          note: 'USD di depan, jadi pip value ikut berubah mengikuti harga.'
        },
        'BTCUSD': {
          label: 'BTCUSD', contract: 1, pip: 1, quote: 'USD', price: 95000,
          note: '1 lot = 1 BTC. Cek lagi contract size di broker kamu, tiap broker beda.'
        },
        'ETHUSD': { label: 'ETHUSD', contract: 1, pip: 0.1, quote: 'USD', price: 3200 },
        'US30': { label: 'US30 — Dow Jones', contract: 1, pip: 1, quote: 'USD', price: 44000 },
        'NAS100': { label: 'NAS100 — Nasdaq', contract: 1, pip: 1, quote: 'USD', price: 20500 },
        'CUSTOM': {
          label: 'Lainnya — isi manual', contract: 100000, pip: 0.0001, quote: 'USD', price: 1,
          note: 'Isi contract size & ukuran pip sesuai spesifikasi kontrak di broker kamu.'
        }
      };

      function calcCur() { return $('c-cur').value; }
      function fmtCalc(v, dec) {
        const d = dec == null ? 2 : dec;
        const n = Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
        const sign = v < 0 ? '-' : '';
        return calcCur() === 'USC' ? sign + n + ' USC' : sign + '$' + n;
      }
      function calcCfg() {
        const contract = parseFloat($('c-contract').value);
        const pip = parseFloat($('c-pip').value);
        const price = parseFloat($('c-price').value);
        const key = $('c-inst').value;
        const quote = (INSTRUMENTS[key] || {}).quote || 'USD';
        return { contract, pip, price, quote, key };
      }
      /* Nilai 1 pip untuk 1.00 lot */
      function pipValuePerLot() {
        const c = calcCfg();
        if (!(c.contract > 0) || !(c.pip > 0)) return null;
        const base = c.pip * c.contract;
        if (c.quote === 'BASE') {
          if (!(c.price > 0)) return null;
          return base / c.price;
        }
        return base;
      }
      function pipsBetween(a, b) {
        const c = calcCfg();
        if (!(c.pip > 0)) return null;
        return Math.abs(a - b) / c.pip;
      }
      function muted(id, msg) { $(id).className = 'calc-out muted'; $(id).textContent = msg; }
      function out(id, items) {
        $(id).className = 'calc-out';
        $(id).innerHTML = items.map(([l, v, cls]) =>
          `<div class="co"><span>${l}</span><b class="${cls || ''}">${v}</b></div>`).join('');
      }

      function fillInstruments() {
        $('c-inst').innerHTML = Object.entries(INSTRUMENTS)
          .map(([k, v]) => `<option value="${k}">${v.label}</option>`).join('');
      }
      function applyInstrument() {
        const it = INSTRUMENTS[$('c-inst').value];
        if (!it) return;
        $('c-contract').value = it.contract;
        $('c-pip').value = it.pip;
        if (!$('c-price').value || $('c-inst').dataset.touched !== '1') { $('c-price').value = it.price; }
        $('c-inst').dataset.touched = '1';
        $('c-inst-note').textContent = it.note || '';
        runCalc();
      }

      function calcPipVal() {
        const pv = pipValuePerLot();
        if (pv == null) { muted('c-pipval', 'Lengkapi contract size, ukuran pip, dan harga sekarang.'); return; }
        out('c-pipval', [
          ['Per 1.00 lot', fmtCalc(pv)],
          ['Per 0.10 lot', fmtCalc(pv * 0.1)],
          ['Per 0.01 lot', fmtCalc(pv * 0.01, 3)]
        ]);
      }

      function calcLotSize() {
        const bal = parseFloat($('c-bal').value), risk = parseFloat($('c-risk').value);
        const e = parseFloat($('c-ls-entry').value), sl = parseFloat($('c-ls-sl').value);
        const pv = pipValuePerLot();
        if (isNaN(bal) || isNaN(risk) || isNaN(e) || isNaN(sl) || pv == null) {
          muted('c-lotout', 'Isi saldo, risk %, entry, dan stop loss.'); return;
        }
        if (e === sl) { muted('c-lotout', 'Entry dan Stop Loss tidak boleh sama.'); return; }
        if (bal <= 0 || risk <= 0) { muted('c-lotout', 'Saldo dan risk % harus lebih dari 0.'); return; }
        const riskAmt = bal * (risk / 100);
        const pips = pipsBetween(e, sl);
        const lots = riskAmt / (pips * pv);
        out('c-lotout', [
          ['Jarak SL', pips.toFixed(1) + ' pips'],
          ['Nilai Risiko', fmtCalc(riskAmt)],
          ['Lot Disarankan', '<span class="calc-big">' + lots.toFixed(2) + '</span>', 'pos']
        ]);
        $('c-lotout').insertAdjacentHTML('beforeend',
          `<div style="flex-basis:100%;font-size:11.5px;color:var(--gray);margin-top:2px;">
        Lot presisi: <b style="font-family:var(--mono)">${lots.toFixed(4)}</b> — broker biasanya
        membulatkan ke 0,01. Kalau dibulatkan ke bawah jadi
        <b style="font-family:var(--mono)">${(Math.floor(lots * 100) / 100).toFixed(2)}</b>,
        risikonya ${fmtCalc(Math.floor(lots * 100) / 100 * pips * pv)}.
      </div>`);
      }

      function calcPL() {
        const lot = parseFloat($('c-pl-lot').value), e = parseFloat($('c-pl-entry').value),
          x = parseFloat($('c-pl-exit').value), dir = $('c-pl-dir').value;
        const pv = pipValuePerLot();
        if (isNaN(lot) || isNaN(e) || isNaN(x) || pv == null) {
          muted('c-plout', 'Isi volume, entry, dan exit.'); return;
        }
        if (lot <= 0) { muted('c-plout', 'Volume harus lebih dari 0.'); return; }
        const c = calcCfg();
        const signed = (dir === 'buy' ? (x - e) : (e - x)) / c.pip;
        const pl = signed * pv * lot;
        out('c-plout', [
          ['Pergerakan', (signed >= 0 ? '+' : '') + signed.toFixed(1) + ' pips', signed >= 0 ? 'pos' : 'neg'],
          ['Nilai / Pip', fmtCalc(pv * lot, 3)],
          ['Hasil', '<span class="calc-big">' + fmtCalc(pl) + '</span>', pl >= 0 ? 'pos' : 'neg']
        ]);
      }

      function calcRR() {
        const e = parseFloat($('c-rr-entry').value), sl = parseFloat($('c-rr-sl').value),
          tp = parseFloat($('c-rr-tp').value), lot = parseFloat($('c-rr-lot').value);
        const pv = pipValuePerLot();
        if (isNaN(e) || isNaN(sl) || isNaN(tp) || pv == null) {
          muted('c-rrout', 'Isi entry, stop loss, dan take profit.'); return;
        }
        if (e === sl) { muted('c-rrout', 'Entry dan Stop Loss tidak boleh sama.'); return; }
        const slPips = pipsBetween(e, sl), tpPips = pipsBetween(e, tp);
        const rr = tpPips / slPips;
        const items = [
          ['Jarak SL', slPips.toFixed(1) + ' pips'],
          ['Jarak TP', tpPips.toFixed(1) + ' pips'],
          ['R:R', '<span class="calc-big">1 : ' + rr.toFixed(2) + '</span>', rr >= 1 ? 'pos' : 'neg']
        ];
        if (!isNaN(lot) && lot > 0) {
          items.push(['Rugi jika SL', fmtCalc(-slPips * pv * lot), 'neg']);
          items.push(['Untung jika TP', fmtCalc(tpPips * pv * lot), 'pos']);
        }
        out('c-rrout', items);
        const dirOK = (tp > e && sl < e) || (tp < e && sl > e);
        if (!dirOK) {
          $('c-rrout').insertAdjacentHTML('beforeend',
            `<div style="flex-basis:100%;font-size:12px;color:#B91C1C;margin-top:4px;">
          Perhatikan: SL dan TP ada di sisi yang sama dari Entry. Cek lagi arah ordernya.</div>`);
        }
      }

      function runCalc() { calcPipVal(); calcLotSize(); calcPL(); calcRR(); }

      function initCalc() {
        fillInstruments();
        $('c-inst').value = 'XAUUSD';
        applyInstrument();
        $('c-inst').addEventListener('change', () => { $('c-inst').dataset.touched = '0'; applyInstrument(); });
        ['c-contract', 'c-pip', 'c-price', 'c-cur', 'c-bal', 'c-risk', 'c-ls-entry', 'c-ls-sl',
          'c-pl-lot', 'c-pl-dir', 'c-pl-entry', 'c-pl-exit',
          'c-rr-entry', 'c-rr-sl', 'c-rr-tp', 'c-rr-lot'].forEach(id => {
            $(id).addEventListener('input', runCalc);
            $(id).addEventListener('change', runCalc);
          });
      }

      /* Saat pindah ke tab Kalkulator, isi otomatis dari akun yang sedang dipilih */
      function syncCalcWithAccount() {
        const id = currentAccId();
        const a = id ? acctById(id) : (accounts.length === 1 ? accounts[0] : null);
        if (!a) return;
        if (!$('c-bal').value) {
          $('c-bal').value = a.currency === 'USC' ? a.startBalance : balUSD(a).toFixed(2);
        }
        $('c-cur').value = a.currency === 'USC' ? 'USC' : 'USD';
        runCalc();
      }
      /* ---------- BACKUP / RESTORE / CSV ---------- */
      function download(name, content, type) {
        const blob = new Blob([content], { type }); const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = url; a.download = name; a.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
      $('backup-btn').onclick = () => {
        const payload = { app: 'FNC Academy Member Area', version: 1, exportedAt: new Date().toISOString(), accounts, trades, settings };
        download(`backup-jurnal-fnc-${new Date().toISOString().slice(0, 10)}.json`, JSON.stringify(payload, null, 2), 'application/json');
      };
      $('restore-btn').onclick = () => $('restore-file').click();
      $('restore-file').onchange = e => {
        const f = e.target.files[0]; if (!f) return;
        const rd = new FileReader();
        rd.onload = async () => {
          try {
            const d = JSON.parse(rd.result);
            if (!Array.isArray(d.accounts) || !Array.isArray(d.trades)) throw new Error('format');
            if (!confirm(`Restore ${d.accounts.length} akun & ${d.trades.length} trade? Data saat ini akan diganti.`)) return;
            accounts = d.accounts; trades = d.trades; settings = d.settings || settings;
            await persist(); renderAll(); alert('Restore berhasil.');
          } catch (err) { alert('File backup tidak valid.'); }
          e.target.value = '';
        };
        rd.readAsText(f);
      };
      $('export-csv').onclick = () => {
        const list = journalFiltered();
        if (!list.length) { alert('Tidak ada data untuk diexport.'); return; }
        const head = ['Tanggal', 'Akun', 'Market', 'Entry', 'SL', 'TP', 'Volume', 'RiskPct', 'RiskUSD', 'RR', 'Hasil', 'NetPL_USD', 'NetPL_Rp', 'Strategi', 'TF', 'Alasan'];
        const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
        const rows = list.map(t => {
          const a = acctById(t.accountId) || {}, c = compute(t);
          return [t.date, a.name || '', t.market, t.entry, t.sl, t.tp, t.vol == null ? '' : t.vol, t.riskPct,
          c.risk.toFixed(2), c.rr.toFixed(2), t.result, c.usd.toFixed(2), c.rp.toFixed(0),
          t.strategy || '', t.tf || '', t.reason || ''].map(q).join(',');
        });
        download('jurnal-fnc.csv', '\uFEFF' + [head.map(q).join(','), ...rows].join('\r\n'), 'text/csv;charset=utf-8');
      };

      /* ---------- EVENTS ---------- */
      if ($('in-posisi')) $('in-posisi').addEventListener('change', () => { posisiDiubahManual = true; });


      /* ============================================================
         JURNAL — TIGA MODE PENGISIAN
         Cepat  : kolom penting saja
         Tempel : banyak trade sekaligus dari catatan member
         Lengkap: form 15 kolom yang lama
         Ketiganya menyimpan ke tempat yang SAMA, jadi Statistik tetap
         terhitung normal. Risk % wajib ada karena untung-rugi dihitung
         dari situ — kalau kosong, Statistik jadi nol.
         ============================================================ */
      const K_RISK = 'fncjt_risk_terakhir';
      let jmMode = 'cepat';

      function jmRiskBawaan() {
        const v = parseFloat(settings && settings.riskTerakhir);
        return (!isNaN(v) && v > 0) ? v : 1;
      }
      async function jmSimpanRisk(v) {
        const n = parseFloat(v);
        if (isNaN(n) || n <= 0) return;
        settings.riskTerakhir = n;
        try { await persist(); } catch (e) { }
      }
      function jmAkun() {
        return currentAccId() || (accounts.length ? accounts[0].id : '');
      }
      function jmSekarang() {
        const d = new Date();
        return {
          tgl: d.toISOString().slice(0, 10),
          jam: String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0')
        };
      }
      function jmTrade(o) {
        const w = jmSekarang();
        return {
          id: 't_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
          dibuat: new Date().toISOString(),
          accountId: o.accountId, date: o.date || w.tgl, jam: o.jam || w.jam,
          market: o.market, entry: o.entry, sl: o.sl, tp: o.tp,
          vol: null, riskPct: o.riskPct, posisi: o.posisi,
          result: o.result, strategy: '', tf: '', reason: ''
        };
      }
      function jmSetMode(m) {
        jmMode = m;
        document.querySelectorAll('#jm-mode .jm-tab').forEach(b =>
          b.classList.toggle('active', b.dataset.jm === m));
        $('jm-cepat').classList.toggle('on', m === 'cepat');
        $('jm-tempel').classList.toggle('on', m === 'tempel');
        $('trade-form').classList.toggle('open', m === 'lengkap');
        if (m === 'cepat') {
          $('q-risk').value = jmRiskBawaan();
          $('q-market').focus();
        }
      }
      function jmBuka() {
        if (!accounts.length) { alert('Buat akun dulu di tab Akun.'); return; }
        $('jm-mode').hidden = false;
        jmSetMode('cepat');
      }
      function jmTutup() {
        $('jm-mode').hidden = true;
        $('jm-cepat').classList.remove('on');
        $('jm-tempel').classList.remove('on');
        $('trade-form').classList.remove('open');
        ['q-market', 'q-entry', 'q-sl', 'q-tp'].forEach(i => { if ($(i)) $(i).value = ''; });
        if ($('p-teks')) $('p-teks').value = '';
        if ($('p-lapor')) $('p-lapor').hidden = true;
      }

      /* ---------- MODE CEPAT ---------- */
      async function jmSimpanCepat() {
        const market = ($('q-market').value || '').trim().toUpperCase();
        const entry = parseFloat($('q-entry').value), sl = parseFloat($('q-sl').value),
          tp = parseFloat($('q-tp').value), risk = parseFloat($('q-risk').value);
        const akun = jmAkun();
        if (!akun) { alert('Buat akun dulu di tab Akun.'); return; }
        if (!market) { alert('Market belum diisi.'); $('q-market').focus(); return; }
        if (isNaN(entry) || isNaN(sl) || isNaN(tp)) {
          alert('Entry, Stop Loss, dan Take Profit harus diisi angka.'); return;
        }
        if (entry === sl) { alert('Stop Loss tidak boleh sama dengan Entry.'); return; }
        if (isNaN(risk) || risk <= 0) { alert('Risk % harus lebih dari 0.'); $('q-risk').focus(); return; }
        trades.push(jmTrade({
          accountId: akun, market: market, entry: entry, sl: sl, tp: tp,
          riskPct: risk, posisi: $('q-posisi').value, result: $('q-result').value
        }));
        await jmSimpanRisk(risk);
        await persist(); jmTutup(); renderAll();
      }

      /* ---------- MODE TEMPEL ---------- */
      const JM_ARAH = {
        buy: 'Buy', b: 'Buy', long: 'Buy', beli: 'Buy',
        sell: 'Sell', s: 'Sell', short: 'Sell', jual: 'Sell'
      };
      const JM_HASIL = {
        win: 'Win', w: 'Win', profit: 'Win', untung: 'Win', tp: 'Win',
        loss: 'Loss', l: 'Loss', rugi: 'Loss', sl: 'Loss',
        be: 'BE', breakeven: 'BE', impas: 'BE'
      };
      /* Angka boleh ditulis 1.0850 atau 1,0850 — koma dianggap titik desimal. */
      function jmAngka(s) {
        const t = String(s || '').trim().replace(/\s/g, '').replace(',', '.');
        const n = parseFloat(t);
        return isNaN(n) ? null : n;
      }
      function jmBacaBaris(baris, no) {
        const k = baris.split('|').map(x => x.trim());
        if (k.length < 6) return { no: no, salah: 'kurang kolom (butuh 6, ada ' + k.length + ')' };
        const market = k[0].toUpperCase();
        if (!market) return { no: no, salah: 'nama market kosong' };
        const arah = JM_ARAH[k[1].toLowerCase()];
        if (!arah) return { no: no, salah: 'arah "' + k[1] + '" tidak dikenal (pakai buy / sell)' };
        const entry = jmAngka(k[2]), sl = jmAngka(k[3]), tp = jmAngka(k[4]);
        if (entry === null) return { no: no, salah: 'entry "' + k[2] + '" bukan angka' };
        if (sl === null) return { no: no, salah: 'stop loss "' + k[3] + '" bukan angka' };
        if (tp === null) return { no: no, salah: 'take profit "' + k[4] + '" bukan angka' };
        if (entry === sl) return { no: no, salah: 'stop loss sama dengan entry' };
        const hasil = JM_HASIL[k[5].toLowerCase()];
        if (!hasil) return { no: no, salah: 'hasil "' + k[5] + '" tidak dikenal (pakai win / loss / be)' };
        let risk = jmRiskBawaan();
        if (k.length >= 7 && k[6]) {
          const r = jmAngka(k[6]);
          if (r === null || r <= 0) return { no: no, salah: 'risk "' + k[6] + '" bukan angka yang benar' };
          risk = r;
        }
        let tgl = '';
        if (k.length >= 8 && k[7]) {
          if (!/^\d{4}-\d{2}-\d{2}$/.test(k[7]))
            return { no: no, salah: 'tanggal "' + k[7] + '" harus format 2026-08-30' };
          tgl = k[7];
        }
        return {
          no: no, data: {
            market: market, posisi: arah, entry: entry, sl: sl, tp: tp,
            result: hasil, riskPct: risk, date: tgl
          }
        };
      }
      function jmBacaSemua() {
        const teks = ($('p-teks').value || '').split('\n');
        const ok = [], gagal = [];
        teks.forEach((b, i) => {
          if (!b.trim()) return;
          const h = jmBacaBaris(b, i + 1);
          if (h.salah) gagal.push(h); else ok.push(h.data);
        });
        return { ok: ok, gagal: gagal };
      }
      function jmLapor(hasil) {
        const el = $('p-lapor'); el.hidden = false;
        let h = '';
        if (hasil.ok.length) h += '<span class="ok">&#10003; ' + hasil.ok.length + ' trade siap disimpan.</span>';
        if (hasil.gagal.length) {
          if (h) h += '<br>';
          h += '<span class="bad">&#10005; ' + hasil.gagal.length + ' baris belum bisa dibaca:</span><ul>' +
            hasil.gagal.slice(0, 8).map(g => '<li>Baris ' + g.no + ' &mdash; ' + esc(g.salah) + '</li>').join('') +
            '</ul>';
          if (hasil.gagal.length > 8) h += '<p style="margin:5px 0 0;">...dan ' + (hasil.gagal.length - 8) + ' lagi.</p>';
        }
        if (!hasil.ok.length && !hasil.gagal.length) h = '<b>Belum ada yang ditempel.</b>';
        el.innerHTML = h;
      }
      async function jmSimpanTempel() {
        const akun = jmAkun();
        if (!akun) { alert('Buat akun dulu di tab Akun.'); return; }
        const hasil = jmBacaSemua();
        jmLapor(hasil);
        if (!hasil.ok.length) return;
        if (hasil.gagal.length &&
          !confirm(hasil.ok.length + ' trade akan disimpan.\n' +
            hasil.gagal.length + ' baris yang bermasalah dilewati.\n\nLanjutkan?')) return;
        hasil.ok.forEach(d => trades.push(jmTrade(Object.assign({ accountId: akun }, d))));
        await jmSimpanRisk(hasil.ok[hasil.ok.length - 1].riskPct);
        await persist(); jmTutup(); renderAll();
      }

      function jmPasang() {
        if (!$('jm-mode')) return;
        document.querySelectorAll('#jm-mode .jm-tab').forEach(b =>
          b.onclick = () => jmSetMode(b.dataset.jm));
        $('q-simpan').onclick = jmSimpanCepat;
        $('q-batal').onclick = jmTutup;
        $('p-simpan').onclick = jmSimpanTempel;
        $('p-periksa').onclick = () => jmLapor(jmBacaSemua());
        $('p-batal').onclick = jmTutup;
        $('p-salin').onclick = () => {
          const t = $('p-contoh').textContent;
          const beres = () => {
            const b = $('p-salin'), l = b.textContent;
            b.textContent = 'Tersalin'; setTimeout(() => { b.textContent = l; }, 1400);
          };
          try {
            if (navigator.clipboard && navigator.clipboard.writeText)
              navigator.clipboard.writeText(t).then(beres, beres);
            else beres();
          } catch (e) { beres(); }
        };
        ['q-market', 'q-entry', 'q-sl', 'q-tp'].forEach(i => {
          $(i).addEventListener('keydown', e => { if (e.key === 'Enter') jmSimpanCepat(); });
        });
      }

      $('toggle-form').onclick = () => {
        if (!accounts.length) { alert('Buat akun dulu di tab Akun.'); return; }
        /* Kalau panel sudah terbuka, tombol ini menutupnya. */
        if (!$('jm-mode').hidden) { jmTutup(); return; }
        posisiDiubahManual = false; resetForm();
        jmBuka();
      };
      jmPasang();
      $('cancel-form').onclick = () => jmTutup();
      $('save-trade').onclick = async () => {
        const d = readForm();
        if (!d.accountId || !d.market || isNaN(d.entry) || isNaN(d.sl) || isNaN(d.tp) || isNaN(d.riskPct)) {
          alert('Wajib isi: Akun, Market, Entry, SL, TP, dan Risk %.'); return;
        }
        if (d.sl === d.entry) { alert('Stop Loss tidak boleh sama dengan Entry.'); return; }
        if (editTradeId) trades = trades.map(t => t.id === editTradeId ? { ...t, ...d } : t);
        else trades.push({
          id: 't_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
          dibuat: new Date().toISOString(), ...d
        });
        await persist(); jmTutup(); renderAll();
      };

      $('toggle-acct-form').onclick = () => { const f = $('acct-form'); if (!f.classList.contains('open')) resetAcctForm(); f.classList.toggle('open'); };
      $('cancel-acct').onclick = () => $('acct-form').classList.remove('open');
      $('save-acct').onclick = async () => {
        const d = {
          name: $('a-name').value.trim(), broker: $('a-broker').value.trim(), type: $('a-type').value.trim(),
          currency: $('a-currency').value, startBalance: parseFloat($('a-balance').value),
          startDate: $('a-start').value, status: $('a-status').value, notes: $('a-notes').value.trim()
        };
        if (!d.name || isNaN(d.startBalance) || d.startBalance <= 0) { alert('Isi Nama Akun dan Saldo Awal (harus lebih dari 0).'); return; }
        if (editAcctId) accounts = accounts.map(a => a.id === editAcctId ? { ...a, ...d } : a);
        else accounts.push({ id: 'a_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7), ...d });
        await persist(); $('acct-form').classList.remove('open'); renderAll();
      };
      $('save-kurs').onclick = async () => {
        const k = parseFloat($('kurs-input').value);
        if (isNaN(k) || k <= 0) { alert('Kurs tidak valid.'); return; }
        settings.kurs = k; await persist(); renderAll(); alert('Kurs disimpan.');
      };
      $('reset-all').onclick = async () => {
        if (confirm('Hapus SEMUA akun dan trade? Tindakan ini tidak bisa dibatalkan.')) {
          accounts = []; trades = []; await persist(); renderAll();
        }
      };

      /* Putar ulang animasi masuk pada sebuah view (hapus kelas, paksa reflow, pasang lagi) */
      function replayAnim(view) {
        const el = document.getElementById('v-' + view);
        if (!el) return;
        el.classList.remove('anim-in');
        void el.offsetWidth;
        el.classList.add('anim-in');
      }
      function go(view) {
        /* Tab boleh dibuka semua. Pengamannya bukan di sini, melainkan pada
           berkasnya: isi Rekap, Materi, Analisa, dan Berita Eksklusif
           terenkripsi, dan pengguna percobaan tidak punya kuncinya. */
        /* Jurnal & Statistik butuh profil dulu */
        if ((view === 'journal' || view === 'dashboard') && !profil) {
          bukaProfil(view === 'journal'
            ? 'Jurnal butuh profil supaya catatan trade-mu punya identitas.'
            : 'Statistik dihitung dari jurnal — buat profil dulu ya.');
          return;
        }
        document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.view === view));
        document.querySelectorAll('.view').forEach(v => { v.classList.remove('active'); v.classList.remove('anim-in'); });
        $('v-' + view).classList.add('active');
        if (view === 'beranda') renderBeranda();
        if (view === 'beranda') setTimeout(mkSegarkanSaatTampil, 60);
        if (view === 'calc') syncCalcWithAccount();
        if (view === 'news') showNews();
        if (view === 'analisa') checkAnalisaGate();
        if (view === 'rekap') showRekap();
        if (view === 'calendar') showKalender();
        if (view === 'kelas') showKelas();
        if (view === 'challenge') showChallenge();
        if (view === 'konsul') showKonsul();
        if (view === 'info') showInfo();
        if (view === 'help') showHelp();
        if (view === 'journal') setTimeout(() => tawarkanContohData('Jurnal'), 450);
        if (view === 'dashboard') setTimeout(() => tawarkanContohData('Statistik'), 450);
        try { tabsKeAktif(); } catch (e) { }
        if (view === 'materi') showMateri();
        if (view === 'dashboard') renderDashboard();
        replayAnim(view);
      }
      document.querySelectorAll('.tab').forEach(t => t.onclick = () => go(t.dataset.view));
      $('acct-filter').onchange = () => {
        if ($('acct-filter').value === '__new') {
          fillAccountSelects();
          openNewAccount();
          return;
        }
        renderAll();
      };
      ['jf-market', 'jf-result', 'jf-strategy'].forEach(i => $(i).onchange = renderJournal);
      $('jf-search').oninput = renderJournal;
      ['in-account', 'in-entry', 'in-sl', 'in-tp', 'in-riskpct', 'in-result'].forEach(i => {
        $(i).addEventListener('input', updatePreview); $(i).addEventListener('change', updatePreview);
      });

      /* ---------- modal profil ---------- */
      let profilTujuan = null;
      function bukaProfil(alasan) {
        $('profil-why').textContent = alasan || 'Profil dipakai untuk menandai catatan jurnal kamu.';
        $('profil-err').hidden = true; $('profil-nama').value = profil ? profil.nama : '';
        $('profil-overlay').hidden = false;
        setTimeout(() => $('profil-nama').focus(), 120);
      }
      window.__bukaProfil = () => bukaProfil();
      $('profil-save').onclick = async () => {
        const n = $('profil-nama').value.trim();
        if (!n) { $('profil-err').hidden = false; $('profil-nama').focus(); return; }
        await simpanProfil(n);
        $('profil-overlay').hidden = true;
        await store.set(K_SEEN, true);
        go(profilTujuan || 'journal'); profilTujuan = null;
      };
      $('profil-cancel').onclick = () => { $('profil-overlay').hidden = true; profilTujuan = null; go('beranda'); };

      /* Segarkan view yang sedang terbuka. Dipakai setelah tier berubah —
         kalau ada view yang terlewat di sini, isinya akan tetap buram walau
         kode sudah benar (ini penyebab bug yang dilaporkan). */
      async function segarkanAktif() {
        const aktif = (id) => $(id) && $(id).classList.contains('active');
        if (aktif('v-news')) await showNews(true);
        if (aktif('v-analisa')) await checkAnalisaGate();
        if (aktif('v-rekap')) await showRekap(true);
        if (aktif('v-calendar')) { kalCache = null; await showKalender(true); }
        if (aktif('v-kelas')) { prdCache = null; await showKelas(true); }
        if (aktif('v-konsul')) { ksCache = null; await showKonsul(true); }
        if (aktif('v-materi')) await showMateri(true);
        if (aktif('v-beranda')) await renderBeranda();
        if (!aktif('v-analisa')) await checkAnalisaGate();
      }

      /* ---------- modal upgrade eksklusif ---------- */
      function bukaUpgrade() {
        $('upg-err').hidden = true; $('upg-code').value = '';
        $('upgrade-overlay').hidden = false;
        setTimeout(() => $('upg-code').focus(), 120);
      }
      window.__bukaUpgrade = bukaUpgrade;
      $('upg-save').onclick = async () => {
        const v = normCode($('upg-code').value);
        const b = $('upg-save'), lama = b.textContent;
        b.disabled = true; b.textContent = 'Memeriksa...'; $('upg-err').hidden = true;
        let hasil = null;
        try { hasil = v ? await periksaKode(v) : null; } catch (e) { hasil = null; }
        b.disabled = false; b.textContent = lama;
        /* Kode percobaan tidak dianggap peningkatan — tingkatannya tidak naik. */
        if (hasil === 'eks') {
          setTier('eks'); await store.set(K_TIER, 'eks');
          kodeEks = v; await store.set(K_ANGATE, v);
          kodeAkses = v; await store.set(K_KODE, v);
          newsCache = null; newsExCache = null; analisaCache = null;
          rekapCache = null; rekapExCache = null; materiCache = null; materiExCache = null;
          $('upgrade-overlay').hidden = true;
          await segarkanAktif();
        } else if (hasil === 'private' && tier === 'umum') {
          setTier('private'); await store.set(K_TIER, 'private');
          kodeEks = null; await store.set(K_ANGATE, '');
          kodeAkses = v; await store.set(K_KODE, v);
          $('upgrade-overlay').hidden = true;
          await segarkanAktif();
        } else {
          $('upg-err').hidden = false; $('upg-code').value = ''; $('upg-code').focus();
        }
      };
      $('upg-cancel').onclick = () => { $('upgrade-overlay').hidden = true; };
      /* Tombol melayang diarahkan ke pemberitahuan perbaikan, BUKAN ke nomor AI.
         Dibungkus fungsi supaya dicari saat tombol ditekan — sambungan ini dipasang
         lebih dulu daripada pemberitahuannya dibuat.
         Kalau AI Agent sudah pulih, ganti isinya kembali ke bukaAI(). */
      if ($('ai-fab')) $('ai-fab').onclick = () => {
        if (typeof window.__aiKendala === 'function') window.__aiKendala();
      };

      /* ---------- keluar / ganti kode akses ----------
         Hanya menghapus kode & tingkatan akses. Profil, akun, dan jurnal TIDAK dihapus. */
      async function keluarAkses() {
        if (!confirm('Keluar dan masukkan kode akses lagi?\n\n' +
          'Profil, akun, dan catatan jurnal kamu TIDAK akan terhapus.')) return;
        kodeEks = null; kodeAkses = null; setTier('umum');
        await store.set(K_GATE, false);
        await store.set(K_TIER, 'umum');
        await store.set(K_KODE, '');
        await store.set(K_ANGATE, '');
        newsCache = null; newsExCache = null; analisaCache = null;
        rekapCache = null; rekapExCache = null; materiCache = null; materiExCache = null;
        ['news-list', 'analisa-list', 'rk-list', 'mt-list', 'beranda-body'].forEach(id => {
          if ($(id)) $(id).innerHTML = '';
        });
        ['news-stamp', 'an-stamp', 'rk-stamp', 'mt-stamp'].forEach(id => { if ($(id)) $(id).textContent = ''; });
        $('shell').classList.add('locked');
        if ($('ai-fab')) $('ai-fab').hidden = true;
        $('gate-overlay').hidden = false;
        $('gate-err').hidden = true; $('gate-code').value = '';
        setTimeout(() => $('gate-code').focus(), 140);
      }
      window.__keluarAkses = keluarAkses;
      $('upg-code').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); $('upg-save').click(); } });

      /* welcome */
      /* Pop-up sambutan sekarang cuma memperkenalkan website + ajakan gabung grup.
         Tawaran contoh data dipindah ke tab Jurnal/Statistik, supaya orang baru
         tidak diberondong beberapa pop-up sekaligus saat pertama masuk. */
      if ($('w-grup')) $('w-grup').onclick = async () => {
        $('welcome-overlay').hidden = true; await store.set(K_SEEN, true);
        await lanjutMasuk();
        if (window.__bukaGrup) window.__bukaGrup();
      };
      $('w-skip').onclick = async () => {
        $('welcome-overlay').hidden = true; await store.set(K_SEEN, true);
        await lanjutMasuk();
      };

      function renderAll() { fillAccountSelects(); renderDashboard(); renderJournal(); renderAccounts(); terapkanProfil(); }

      /* ---------- BERANDA ---------- */
      function potongTeks(s, n) {
        const t = String(s || '').replace(/[*_~`]/g, '').replace(/\s+/g, ' ').trim();
        return t.length > n ? t.slice(0, n) + '...' : t;
      }
      const IKON = {
        Berita: '&#128240;', Eksklusif: '&#128274;', Analisa: '&#128200;',
        Rekap: '&#127909;', Materi: '&#128218;',
        RekapEks: '&#127909;', MateriEks: '&#128218;'
      };
      const LABEL = { RekapEks: 'Rekap', MateriEks: 'Materi' };
      function kartuUpdate(it, sumber, view, terkunci) {
        const tampil = LABEL[sumber] || sumber;
        const cls = (sumber === 'Analisa' || sumber === 'Materi' || sumber === 'MateriEks') ? 'an'
          : ((sumber === 'Eksklusif' || sumber === 'RekapEks') ? 'eks' : '');
        const gbr = it.thumb || it.image || ((it.images && it.images[0]) || '');
        const isiThumb = gbr
          ? '<img src="' + esc(gbr) + '" alt="" loading="lazy">'
          : '<div class="ph">' + (IKON[sumber] || '&#128196;') + '</div>';
        const gbrKunci = terkunci ? (it.blur || '') : '';
        const isiKunci = gbrKunci
          ? '<img src="' + esc(gbrKunci) + '" alt="" aria-hidden="true">'
          : '<div class="ph">&#128274;</div>';
        const thumb = terkunci
          ? '<div class="hc-thumb blur">' + isiKunci + '<div class="lk-mini">&#128274;</div></div>'
          : '<div class="hc-thumb">' + isiThumb + '</div>';
        const aksi = terkunci
          ? 'window.__bukaUpgrade()'
          : "window.__bukaKiriman('" + view + "','" + String(it.id || '').replace(/'/g, '') + "','" + sumber + "')";
        return '<div class="home-card" onclick="' + aksi + '">' + thumb +
          '<div class="hc-body">' +
          (terkunci ? '<h4 style="color:var(--gray);">Konten Eksklusif</h4>'
            : (it.title ? '<h4>' + esc(it.title) + '</h4>' : '<h4>&mdash;</h4>')) +
          '<div class="hc-top"><span class="hc-src ' + cls + '">' + esc(tampil) + '</span>' +
          (!terkunci && it.pair ? '<span class="hc-src">' + esc(it.pair) + '</span>' : '') +
          '<span class="hc-date">' + stempelWaktu(it) + '</span></div>' +
          (terkunci ? '<div class="hc-lockrow">&#128274; Ketuk untuk buka akses</div>' : '') +
          '</div></div>';
      }
      /* ---------- PENGUMUMAN ----------
         Diambil dari pengumuman.json. Kalau berkasnya tidak ada, kosong, atau
         semua item sudah lewat masa tayang -> bagian ini tidak muncul sama sekali. */
      function kartuAnn(a) {
        const j = String(a.jenis || 'info').toLowerCase();
        const ic = j === 'live' ? '&#128308;' : (j === 'penting' ? '&#9888;&#65039;' : '&#128226;');
        const lbl = j === 'live' ? 'Live Sekarang' : (j === 'penting' ? 'Penting' : 'Info');
        const tombol = a.url
          ? '<div class="ann-btn" onclick="event.stopPropagation();window.__buka(\'' +
          esc(a.url).replace(/'/g, "\\'") + '\')">' + esc(a.cta || 'Buka Link') + '</div>' : '';
        /* Ada gambar -> tampil sebagai kartu besar menonjol di paling atas Beranda. */
        if (a.image) {
          return '<div class="ann-hl">' +
            '<img class="ann-hl-img" src="' + esc(a.image) + '" alt="" loading="lazy">' +
            '<div class="ann-hl-body">' +
            '<span class="ann-hl-pill ' + esc(j) + '">' +
            (j === 'live' ? '<span class="dot-live"></span>' : '') + esc(lbl) + '</span>' +
            (a.title ? '<h4>' + esc(a.title) + '</h4>' : '') +
            (a.body ? '<p>' + waFormat(a.body) + '</p>' : '') +
            tombol +
            (a.pub ? '<span class="ann-time">' + stempelWaktu(a) + '</span>' : '') +
            '</div></div>';
        }
        return '<div class="ann ' + esc(j) + '">' +
          '<div class="ann-ic">' + ic + '</div><div style="flex:1;min-width:0;">' +
          (a.title ? '<b>' + esc(a.title) + '</b>' : '') +
          (a.body ? '<p>' + waFormat(a.body) + '</p>' : '') +
          (a.url ? '<div class="ann-btn" onclick="event.stopPropagation();window.__buka(\'' +
            esc(a.url).replace(/'/g, "\\'") + '\')">' + esc(a.cta || 'Buka Link') + '</div>' : '') +
          (a.pub ? '<span class="ann-time">' + stempelWaktu(a) + '</span>' : '') +
          '</div></div>';
      }
      async function ambilPengumuman() {
        try {
          const d = await fetchJSON(ANN_URL);
          const kini = Date.now();
          return (d.items || [])
            .filter(fncSudahTayang)
            .filter(a => {
              if (!a.exp) return true;
              const t = new Date(a.exp).getTime(); return isNaN(t) ? true : t > kini;
            })
            .sort((a, b) => fncWaktuTerbit(b) - fncWaktuTerbit(a))
            .slice(0, 3);
        } catch (e) { return []; }
      }

      let berandaJatuhTempo = null;   /* kapan Beranda perlu digambar ulang berikutnya */
      async function renderBeranda() {
        const sapa = profil ? ('Halo, ' + esc(profil.nama)) : 'Selamat datang';
        $('hero-title').textContent = profil ? ('Halo, ' + profil.nama) : 'Selamat datang';
        $('hero-sub').textContent = profil
          ? 'Cek update terbaru, lalu lanjut ke jurnal kamu.'
          : 'Learn the market, track your progress.';
        $('hero-cta').innerHTML = profil ? '' :
          '<button class="btn" onclick="window.__bukaProfil()">Buat Profil</button>';

        const body = $('beranda-body');
        body.innerHTML = '<div class="feed-empty">Memuat update...</div>';

        const kumpul = []; const jadwal = [];
        const catat = arr => { const t = tayangBerikut(arr); if (t) jadwal.push(t); };
        /* Semua berkas diambil BERBARENGAN, bukan satu per satu. Tiap berkas
           terenkripsi butuh PBKDF2 200.000 iterasi — kalau berurutan, waktunya
           dijumlahkan. Dijalankan paralel, waktunya tinggal sepanjang berkas
           yang paling lambat. */
        const tugas = [];
        const kerja = f => tugas.push((async () => { try { await f(); } catch (e) { } })());

        kerja(async () => {
          const c = await loadNewsUmum(); catat(c.semua || c.items);
          (c.items || []).slice(0, 4).forEach(x => kumpul.push([x, 'Berita', 'news']));
        });
        if (tier !== 'umum') {
          kerja(async () => {
            const d = await fetchJSON(REKAP_URL); const r = await bukaIsi(d, await ambilKodeAkses());
            catat(r); urutBaru(r).slice(0, 2).forEach(x => kumpul.push([x, 'Rekap', 'rekap']));
          });
          kerja(async () => {
            const d = await fetchJSON(MATERI_URL); const r = await bukaIsi(d, await ambilKodeAkses());
            catat(r); urutBaru(r).slice(0, 2).forEach(x => kumpul.push([x, 'Materi', 'materi']));
          });
        }
        if (tier === 'eks') {
          kerja(async () => {
            const c = await loadNewsEks(); if (c.next) jadwal.push(c.next);
            (c.items || []).slice(0, 3).forEach(x => kumpul.push([x, 'Eksklusif', 'news']));
          });
          kerja(async () => {
            const d = await fetchJSON(ANALISA_URL); const r = await bukaIsi(d, await ambilKode());
            catat(r); urutBaru(r).slice(0, 3).forEach(x => kumpul.push([x, 'Analisa', 'analisa']));
          });
          kerja(async () => {
            const d = await fetchJSON(REKAP_EX_URL); const r = await bukaIsi(d, await ambilKode());
            catat(r); urutBaru(r).slice(0, 2).forEach(x => kumpul.push([x, 'RekapEks', 'rekap']));
          });
          kerja(async () => {
            const d = await fetchJSON(MATERI_EX_URL); const r = await bukaIsi(d, await ambilKode());
            catat(r); urutBaru(r).slice(0, 2).forEach(x => kumpul.push([x, 'MateriEks', 'materi']));
          });
        } else if (tier === 'umum') {
          /* Pengguna percobaan melihat pratinjau buram dari SEMUA yang terkunci —
             hanya bagian teaser yang diambil, isinya tetap terenkripsi. */
          const pratinjau = [[NEWS_EX_URL, 'Eksklusif', 'news'], [ANALISA_URL, 'Analisa', 'analisa'],
          [REKAP_URL, 'Rekap', 'rekap'], [MATERI_URL, 'Materi', 'materi'],
          [REKAP_EX_URL, 'RekapEks', 'rekap'], [MATERI_EX_URL, 'MateriEks', 'materi']];
          pratinjau.forEach(([url, label, view]) => kerja(async () => {
            const d = await fetchJSON(url);
            catat(d.teaser || []);
            (d.teaser || []).filter(fncSudahTayang)
              .sort((a, b) => fncWaktuTerbit(b) - fncWaktuTerbit(a))
              .slice(0, 2).forEach(x => kumpul.push([x, label, view, true]));
          }));
        } else {
          /* Member Private tetap melihat kartunya — tapi hanya dari bagian teaser.
             Isi, link, dan gambar asli tidak pernah diambil. */
          const pratinjau = [[NEWS_EX_URL, 'Eksklusif', 'news'], [ANALISA_URL, 'Analisa', 'analisa'],
          [REKAP_EX_URL, 'Rekap', 'rekap'], [MATERI_EX_URL, 'Materi', 'materi']];
          pratinjau.forEach(([url, label, view]) => kerja(async () => {
            const d = await fetchJSON(url);
            catat(d.teaser || []);
            (d.teaser || []).filter(fncSudahTayang)
              .sort((a, b) => fncWaktuTerbit(b) - fncWaktuTerbit(a))
              .slice(0, 2).forEach(x => kumpul.push([x, label, view, true]));
          }));
        }
        /* pengumuman ikut diambil berbarengan, bukan menunggu giliran */
        let ann = [];
        kerja(async () => { ann = await ambilPengumuman(); });
        await Promise.all(tugas);
        kumpul.sort((a, b) => fncWaktuTerbit(b[0]) - fncWaktuTerbit(a[0]));

        let out = '';
        /* Isi lengkapnya sudah tampil di pop-up saat masuk. Kalau kartunya
           ditampilkan penuh di sini juga, beritanya terdorong jauh ke bawah —
           jadi cukup satu bilah ringkas untuk membukanya kembali. */
        if (ann.length) {
          const j = ann[0];
          out += '<div class="ann-bar" onclick="window.__bukaPengumuman()">' +
            '<div class="ic">&#128226;</div>' +
            '<div style="flex:1;min-width:0;">' +
            '<b>' + ann.length + ' Pengumuman</b>' +
            '<p>' + esc(j.title || 'Dari tim FNC Academy') + '</p>' +
            '</div>' +
            '<span class="go">Baca &rarr;</span>' +
            '</div>';
        }
        /* Sorotan diambil dari kiriman TERBARU yang tidak terkunci.
           Kalau yang teratas kebetulan eksklusif, cari yang berikutnya —
           supaya member Private tetap mendapat sorotan, bukan kosong. */
        let sorotan = null;
        const iSorot = kumpul.findIndex(a => !a[3]);
        if (iSorot >= 0) { sorotan = kumpul.splice(iSorot, 1)[0]; }
        if (sorotan || kumpul.length) {
          let blokSorot = '';
          if (sorotan) {
            const si = sorotan[0], ss = sorotan[1], sv = sorotan[2];
            const aksi = "window.__bukaKiriman('" + sv + "','" +
              String(si.id || '').replace(/'/g, '') + "','" + ss + "')";
            blokSorot = '<div class="kiri">' + kartuSorotan(si, ss, sv, aksi) + '</div>';
          }
          out += '<div class="home-sec"><div class="home-head"><h3>Update Terbaru</h3>' +
            '<a onclick="window.__go(\'news\')">Lihat semua</a></div>' +
            '<div class="sorot-grid">' + blokSorot +
            '<div class="kanan">' +
            kumpul.slice(0, 6).map(a => kartuUpdate(a[0], a[1], a[2], a[3])).join('') +
            '</div>' +
            '</div></div>';
        }
        if (tier !== 'eks') {
          out += '<div class="home-sec"><div class="upsell">' +
            (tier === 'umum'
              ? '<h4>&#128274; Lanjut Jadi Member Private</h4>' +
              '<p>Dapatkan Analisa, Rekap Live, dan Materi lengkap. ' +
              'Sudah punya kode dari admin?</p>'
              : '<h4>&#128274; Buka Akses Eksklusif</h4>' +
              '<p>Analisa, berita mendalam, rekap live, dan materi lanjutan. ' +
              'Sudah dapat kode eksklusif dari admin?</p>') +
            '<button class="btn" onclick="window.__bukaUpgrade()">Masukkan Kode</button></div></div>';
        }
        if (profil && trades.length) {
          const tot = trades.length;
          const win = trades.filter(t => t.result === 'Win').length;
          const wr = tot ? ((win / tot) * 100).toFixed(1) : '0';
          let net = 0; trades.forEach(t => { try { net += compute(t).usd; } catch (e) { } });
          out += '<div class="home-sec"><div class="home-head"><h3>Ringkasan Jurnal</h3>' +
            '<a onclick="window.__go(\'dashboard\')">Statistik lengkap</a></div>' +
            '<div class="mini-grid">' +
            '<div class="mini"><span>Trade</span><b>' + tot + '</b></div>' +
            '<div class="mini"><span>Win Rate</span><b>' + wr + '%</b></div>' +
            '<div class="mini"><span>Net P/L</span><b style="color:' + (net >= 0 ? 'var(--win)' : 'var(--loss)') + '">$' +
            net.toFixed(2) + '</b></div></div></div>';
        }

        /* ---------- pintasan cepat ---------- */
        /* ---------- konsultasi admin ---------- */
        out += '<div class="home-sec"><div class="home-head"><h3>Konsultasi</h3></div>' +
          '<div class="konsul">' +
          ADMIN_LIST.map(a =>
            '<div class="konsul-kartu" onclick="window.__konsul(\'' + a.kunci + '\')">' +
            '<div class="konsul-ic">' + IKON_WA + '</div>' +
            '<b>' + a.label + '</b>' +
            '</div>').join('') +
          '</div></div>';

        /* ---------- Tanya AI Agent ---------- */
        out += '<div class="ai-card" onclick="window.__aiKendala()">' +
          '<div class="ai-ic">&#129302;</div>' +
          '<div style="flex:1;min-width:0;">' +
          '<b>Tanya AI Agent FNC</b>' +
          '<p>Sedang dalam perbaikan. Sementara ini pertanyaanmu dijawab ' +
          'langsung oleh admin.</p>' +
          '<span class="go">&#128172; Mulai Chat</span>' +
          '</div></div>';

        /* ---------- gabung grup publik ----------
           Jaring pengaman untuk yang melewatkan pop-up saat pertama masuk. */
        out += '<div class="grup-cta" onclick="window.__bukaGrup()">' +
          '<div class="ic">' + IKON_WA + '</div>' +
          '<div style="flex:1;min-width:0;">' +
          '<b>Gabung Grup Publik FNC</b>' +
          '<p>Grup WhatsApp gratis: info sesi live, bahasan market, dan tanya-jawab ' +
          'bareng member lain.</p>' +
          '</div>' +
          '<span class="go">Gabung &rarr;</span>' +
          '</div>' +
          '<p class="grup-nb">Tautan grupnya tidak bisa dibuka atau sudah penuh? ' +
          'Chat salah satu <b>Admin</b> di atas, nanti diundang manual.</p>' +
          '<div class="dc-cta" onclick="window.__bukaDiscord()">' +
          '<div class="ic">' + IK_DC + '</div>' +
          '<div style="flex:1;min-width:0;">' +
          '<b>Gabung Server Discord FNC</b>' +
          '<p>Tempat sesi live berlangsung, plus ruang diskusi dan tanya-jawab ' +
          'yang lebih rapi per topik.</p>' +
          '</div>' +
          '<span class="go">Gabung &rarr;</span>' +
          '</div>';

        /* ---------- pintasan ---------- */
        const daftarPintas = [
          ['&#128200;', 'Analisa', 'Pembahasan chart', 'analisa'],
          ['&#128240;', 'Berita', 'Update market', 'news'],
          ['&#128197;', 'Kalender', 'Jadwal rilis ekonomi', 'calendar'],
          ['&#128221;', 'Jurnal', 'Catat trade kamu', 'journal']];
        out += '<div class="home-sec"><div class="home-head"><h3>Pintasan</h3></div>' +
          '<div class="pintas">' +
          daftarPintas.map(a => pintasKartu(a[0], a[1], a[2], a[3])).join('') +
          '</div></div>';


        /* ---------- penutup ---------- */
        out += '<div class="tutup"><div class="garis"></div>' +
          'FNC Academy &mdash; Edukasi Trading<br>' +
          'Semua isi di sini adalah bahan belajar dan alat bantu evaluasi pribadi, ' +
          'bukan sinyal atau rekomendasi investasi.</div>';

        body.innerHTML = out || '<div class="feed-empty">Belum ada update. Cek lagi nanti ya.</div>';

        /* Tentukan waktu terdekat yang membuat tampilan ini berubah:
           kiriman terjadwal yang akan tayang, atau pengumuman yang akan hilang. */
        const kini = Date.now();
        const calon = jadwal.filter(t => t && t > kini);
        ann.forEach(a => {
          if (a.exp) {
            const t = new Date(a.exp).getTime();
            if (!isNaN(t) && t > kini) calon.push(t);
          }
        });
        berandaJatuhTempo = calon.length ? Math.min.apply(null, calon) : null;
      }
      async function loadRekapEksBeranda() {
        const d = await fetchJSON(REKAP_EX_URL);
        return urutBaru(await bukaIsi(d, await ambilKode()));
      }
      async function loadMateriEksBeranda() {
        const d = await fetchJSON(MATERI_EX_URL);
        return urutBaru(await bukaIsi(d, await ambilKode()));
      }
      /* ============================================================
         MODE TERANG / GELAP
         Pilihan disimpan di perangkat. Kalau member belum pernah memilih,
         ikut pengaturan sistem operasinya.
         ============================================================ */
      const K_TEMA = 'fncjt_tema';

      /* ============================================================
         MARKET BERANDA — pita harga, kartu market, chart layar penuh.
         Data & chart dari TradingView (gratis, tanpa kunci rahasia).
         Semua tampil untuk SEMUA tingkatan; hanya tombol "Cek Analisa"
         yang membedakan umum vs berbayar.
         ============================================================ */
      const MK_PASAR = [
        { nama: 'Emas', sym: 'OANDA:XAUUSD', jenis: 'komoditas' },
        { nama: 'Bitcoin', sym: 'BINANCE:BTCUSDT', jenis: 'kripto' },
        { nama: 'Minyak', sym: 'TVC:USOIL', jenis: 'komoditas' },
        { nama: 'Euro', sym: 'OANDA:EURUSD', jenis: 'forex' },
        { nama: 'Yen', sym: 'OANDA:USDJPY', jenis: 'forex' },
        { nama: 'Pound', sym: 'OANDA:GBPUSD', jenis: 'forex' },
        { nama: 'Ethereum', sym: 'BINANCE:ETHUSDT', jenis: 'kripto' }
      ];
      function mkGelap() { return document.documentElement.getAttribute('data-tema') === 'gelap'; }

      function mkRangka() {
        const w = $('mk-wrap'); if (!w) return;
        let k = '';
        MK_PASAR.forEach((p, i) => {
          k += '<div class="mk-kartu">' +
            '<div class="mk-atas" onclick="window.__mkChart(' + i + ')">' +
            '<span class="mk-tag ' + p.jenis + '">' + p.jenis + '</span>' +
            '<div class="mk-harga" id="mk-h' + i + '"></div>' +
            '<div class="mk-buka"><span>Buka chart</span><i>&#8594;</i></div>' +
            '</div>' +
            '<button class="mk-analisa" onclick="window.__mkAnalisa(' + i + ')">Cek Analisa</button>' +
            '</div>';
        });
        w.innerHTML =
          '<div class="mk-sesi">' +
          '<div class="mk-judul"><span class="mk-dot"></span><h3>Harga Berjalan</h3>' +
          '<span class="mk-pill">real-time</span></div>' +
          '<div class="mk-kotak"><div class="mk-pita" id="mk-pita"></div></div>' +
          '</div>' +
          '<div class="mk-sesi">' +
          '<div class="mk-judul"><span class="mk-dot"></span><h3>Cari Pair</h3>' +
          '<span class="mk-pill">forex &middot; kripto &middot; indeks &middot; saham</span></div>' +
          '<div class="mk-kotak">' +
          '<div class="mk-cari-bar">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ' +
          'stroke-linecap="round"><circle cx="11" cy="11" r="7"/>' +
          '<path d="M20 20l-3.5-3.5"/></svg>' +
          '<input id="mk-cari" type="text" autocomplete="off" spellcheck="false" ' +
          'placeholder="Ketik pair, kripto, indeks, atau saham...">' +
          '<button class="mk-cari-x" id="mk-cari-x" type="button">&#10005;</button>' +
          '</div>' +
          '<div class="mk-hasil" id="mk-hasil"></div>' +
          '<div class="mk-ringkas" id="mk-ringkas">' +
          '<div class="mk-rk-atas">' +
          '<div class="mk-rk-judul"><b id="mk-rk-nama">&mdash;</b>' +
          '<span id="mk-rk-desc"></span></div>' +
          '<span class="mk-tag" id="mk-rk-tag"></span>' +
          '</div>' +
          '<div class="mk-rk-harga" id="mk-rk-harga"></div>' +
          '<div class="mk-rk-tbl">' +
          '<button type="button" class="mk-b-tutup" onclick="window.__mkCariTutup()">Tutup</button>' +
          '<button type="button" class="mk-b-chart" onclick="window.__mkCariChart()">Buka Chart</button>' +
          '</div>' +
          '<button type="button" class="mk-analisa" onclick="window.__mkCariAnalisa()">' +
          'Cek Analisa</button>' +
          '</div>' +
          '</div>' +
          '</div>';
        mkPasangCari();
      }

      /* Widget dipasang sebagai bingkai terpisah supaya warnanya
         bisa ikut berganti saat tema diubah. */
      function mkBingkai(alamat, tinggi) {
        const f = document.createElement('iframe');
        f.src = alamat; f.style.height = tinggi; f.setAttribute('scrolling', 'no');
        f.style.background = mkWarnaKartu();   /* jaring pengaman kalau widget telat mengecat */
        return f;
      }
      /* Warna kartu diambil langsung dari tema yang sedang aktif, lalu
         DIKIRIM ke widget supaya dia mengecat latarnya sendiri. Dulu kita
         menyuruhnya tembus pandang; kalau itu gagal, yang muncul putih
         bawaan browser — kelihatan jelek di mode gelap. */
      function mkWarnaVar(nama, cadangan) {
        try {
          const w = getComputedStyle(document.documentElement)
            .getPropertyValue(nama).trim();
          if (w) return w;
        } catch (e) { }
        return cadangan;
      }
      function mkWarnaKartu() {
        return mkWarnaVar('--kartu', mkGelap() ? '#1F1F1F' : '#FFFFFF');
      }
      function mkWarnaHal() {
        return mkWarnaVar('--hal', mkGelap() ? '#141414' : '#F3EFE9');
      }
      let mkWidgetSiap = false;
      function mkIsiWidget() {
        const gelap = mkGelap(), bg = mkWarnaKartu();
        /* Kalau lebarnya masih nol berarti Beranda sedang tersembunyi.
           Widget tetap dipasang, tapi ditandai belum sah supaya dipasang
           ulang saat Beranda benar-benar terlihat. */
        const w0 = $('mk-wrap');
        mkWidgetSiap = !!(w0 && w0.clientWidth > 0);
        const pita = $('mk-pita');
        if (pita) {
          pita.innerHTML = '';
          /* Tembus pandang DIMATIKAN — kalau dinyalakan, latar widget jadi putih.
             Warna gelap bawaan widget ini #1F1F1F, sama persis dengan warna
             kartu kita, jadi menyatu tanpa perlu akal-akalan. */
          const cfg = {
            symbols: MK_PASAR.map(p => ({ proName: p.sym, title: p.nama })),
            showSymbolLogo: true, colorTheme: gelap ? 'dark' : 'light',
            isTransparent: false, backgroundColor: bg,
            displayMode: 'adaptive', locale: 'id'
          };
          pita.appendChild(mkBingkai(
            'https://s.tradingview.com/embed-widget/ticker-tape/?locale=id#' +
            encodeURIComponent(JSON.stringify(cfg)), '90px'));
        }
        /* Kartu 'Pasar Hari Ini' sudah dihapus dari Beranda — digantikan
           Cari Pair. Perulangan ini otomatis tidak melakukan apa-apa karena
           kotaknya tidak ada, jadi aman dibiarkan. */
        MK_PASAR.forEach((p, i) => {
          const kotak = $('mk-h' + i); if (!kotak) return;
          kotak.innerHTML = '';
          const cfg = {
            symbol: p.sym, width: '100%', colorTheme: gelap ? 'dark' : 'light',
            isTransparent: false, backgroundColor: bg, locale: 'id'
          };
          kotak.appendChild(mkBingkai(
            'https://s.tradingview.com/embed-widget/single-quote/?locale=id#' +
            encodeURIComponent(JSON.stringify(cfg)), '104px'));
        });
      }

      function mkAlamatChart(sym) {
        const gelap = mkGelap();
        const p = {
          symbol: sym, interval: '15', timezone: 'Asia/Jakarta',
          theme: gelap ? 'dark' : 'light', style: '1', locale: 'id',
          hide_side_toolbar: '0', hide_top_toolbar: '0', allow_symbol_change: '1',
          save_image: '1', details: '0', calendar: '0', withdateranges: '1', hideideas: '1'
        };
        if (gelap) { p.backgroundColor = mkWarnaHal(); p.gridColor = 'rgba(149,152,161,0.10)'; }
        const q = []; for (const k in p) { q.push(encodeURIComponent(k) + '=' + encodeURIComponent(p[k])); }
        if (gelap) {
          const ov = {
            'mainSeriesProperties.candleStyle.upColor': '#FFFFFF',
            'mainSeriesProperties.candleStyle.downColor': '#F2701D',
            'mainSeriesProperties.candleStyle.borderUpColor': '#FFFFFF',
            'mainSeriesProperties.candleStyle.borderDownColor': '#F2701D',
            'mainSeriesProperties.candleStyle.wickUpColor': '#FFFFFF',
            'mainSeriesProperties.candleStyle.wickDownColor': '#F2701D',
            'paneProperties.background': mkWarnaHal()
          };
          q.push('overrides=' + encodeURIComponent(JSON.stringify(ov)));
        }
        return 'https://s.tradingview.com/widgetembed/?' + q.join('&');
      }

      let mkSymAktif = null;
      window.__mkChart = (i) => {
        const p = MK_PASAR[i]; if (!p) return;
        mkBukaChart(p.sym, p.nama);
      };
      /* Dipakai bersama oleh kartu market dan hasil pencarian pair. */
      function mkBukaChart(sym, judul) {
        mkSymAktif = sym;
        const layar = $('mk-layar'), isi = $('mk-layar-isi');
        $('mk-layar-nama').textContent = judul;
        isi.innerHTML = '<div class="mk-memuat">Memuat chart...</div>';
        const f = document.createElement('iframe');
        f.setAttribute('allowtransparency', 'true');
        f.setAttribute('scrolling', 'no');
        f.setAttribute('allowfullscreen', 'true');
        f.src = mkAlamatChart(sym);
        f.onload = () => { const m = isi.querySelector('.mk-memuat'); if (m) m.remove(); };
        isi.appendChild(f);
        layar.classList.add('on');
        document.body.style.overflow = 'hidden';
      }
      window.__mkTutupChart = () => {
        const layar = $('mk-layar');
        layar.classList.remove('on');
        $('mk-layar-isi').innerHTML = '';   /* coretan analisa ikut terhapus */
        mkSymAktif = null;
        document.body.style.overflow = '';
      };

      /* Member berbayar (private/eksklusif) langsung masuk tab Analisa.
         Pengunjung umum diberi penjelasan lalu diarahkan ke tab Kelas. */
      window.__mkAnalisa = (i) => {
        const p = MK_PASAR[i]; if (!p) return;
        if (tier !== 'umum') { go('analisa'); return; }
        popupInfo({
          ikon: '&#128200;',
          judul: 'Analisa Harian',
          sub: 'Khusus member Private & Eksklusif',
          tombol: 'Lihat Pilihan Kelas',
          batal: 'Nanti Saja',
          aksi: () => { go('kelas'); },
          isi: '<p>Analisa harian <b>' + esc(p.nama) + '</b> dibahas tuntas oleh mentor FNC &mdash; ' +
            'lengkap dengan alasan di balik setiap level yang ditandai.</p>' +
            '<p style="margin-top:10px;">Tersedia untuk member <b>Private</b> dan ' +
            '<b>Eksklusif</b>. Kamu tetap bisa pakai chart dan harga di Beranda ' +
            'kapan saja, gratis.</p>'
        });
      };

      /* ===== CARI PAIR =====
         Daftar pair pilihan kami (73 buah). TradingView tidak menyediakan cara
         resmi mencari ke seluruh database mereka dari website luar, jadi kalau
         yang dicari tidak ada di daftar, member tetap bisa mencoba membukanya
         langsung lewat jalur bebas di bawah hasil pencarian. */
      const MK_CARI = [{ "n": "EUR/USD", "d": "Euro / Dolar AS", "s": "OANDA:EURUSD", "k": "forex" }, { "n": "GBP/USD", "d": "Pound / Dolar AS", "s": "OANDA:GBPUSD", "k": "forex" }, { "n": "USD/JPY", "d": "Dolar AS / Yen", "s": "OANDA:USDJPY", "k": "forex" }, { "n": "AUD/USD", "d": "Aussie / Dolar AS", "s": "OANDA:AUDUSD", "k": "forex" }, { "n": "USD/CAD", "d": "Dolar AS / Dolar Kanada", "s": "OANDA:USDCAD", "k": "forex" }, { "n": "USD/CHF", "d": "Dolar AS / Franc Swiss", "s": "OANDA:USDCHF", "k": "forex" }, { "n": "NZD/USD", "d": "Kiwi / Dolar AS", "s": "OANDA:NZDUSD", "k": "forex" }, { "n": "GBP/JPY", "d": "Pound / Yen", "s": "OANDA:GBPJPY", "k": "forex" }, { "n": "EUR/JPY", "d": "Euro / Yen", "s": "OANDA:EURJPY", "k": "forex" }, { "n": "EUR/GBP", "d": "Euro / Pound", "s": "OANDA:EURGBP", "k": "forex" }, { "n": "AUD/JPY", "d": "Aussie / Yen", "s": "OANDA:AUDJPY", "k": "forex" }, { "n": "CHF/JPY", "d": "Franc / Yen", "s": "OANDA:CHFJPY", "k": "forex" }, { "n": "CAD/JPY", "d": "Dolar Kanada / Yen", "s": "OANDA:CADJPY", "k": "forex" }, { "n": "NZD/JPY", "d": "Kiwi / Yen", "s": "OANDA:NZDJPY", "k": "forex" }, { "n": "EUR/AUD", "d": "Euro / Aussie", "s": "OANDA:EURAUD", "k": "forex" }, { "n": "EUR/CHF", "d": "Euro / Franc", "s": "OANDA:EURCHF", "k": "forex" }, { "n": "GBP/AUD", "d": "Pound / Aussie", "s": "OANDA:GBPAUD", "k": "forex" }, { "n": "GBP/CAD", "d": "Pound / Dolar Kanada", "s": "OANDA:GBPCAD", "k": "forex" }, { "n": "GBP/CHF", "d": "Pound / Franc", "s": "OANDA:GBPCHF", "k": "forex" }, { "n": "AUD/CAD", "d": "Aussie / Dolar Kanada", "s": "OANDA:AUDCAD", "k": "forex" }, { "n": "AUD/NZD", "d": "Aussie / Kiwi", "s": "OANDA:AUDNZD", "k": "forex" }, { "n": "EUR/CAD", "d": "Euro / Dolar Kanada", "s": "OANDA:EURCAD", "k": "forex" }, { "n": "USD/SGD", "d": "Dolar AS / Dolar Singapura", "s": "OANDA:USDSGD", "k": "forex" }, { "n": "USD/IDR", "d": "Dolar AS / Rupiah", "s": "FX_IDC:USDIDR", "k": "forex" }, { "n": "XAU/USD", "d": "Emas", "s": "OANDA:XAUUSD", "k": "komoditas" }, { "n": "XAG/USD", "d": "Perak", "s": "OANDA:XAGUSD", "k": "komoditas" }, { "n": "USOIL", "d": "Minyak Mentah WTI", "s": "TVC:USOIL", "k": "komoditas" }, { "n": "UKOIL", "d": "Minyak Mentah Brent", "s": "TVC:UKOIL", "k": "komoditas" }, { "n": "XPT/USD", "d": "Platinum", "s": "OANDA:XPTUSD", "k": "komoditas" }, { "n": "XPD/USD", "d": "Paladium", "s": "OANDA:XPDUSD", "k": "komoditas" }, { "n": "NATGAS", "d": "Gas Alam", "s": "TVC:NATGAS", "k": "komoditas" }, { "n": "COPPER", "d": "Tembaga", "s": "TVC:COPPER", "k": "komoditas" }, { "n": "BTC/USD", "d": "Bitcoin", "s": "BINANCE:BTCUSDT", "k": "kripto" }, { "n": "ETH/USD", "d": "Ethereum", "s": "BINANCE:ETHUSDT", "k": "kripto" }, { "n": "BNB/USD", "d": "BNB", "s": "BINANCE:BNBUSDT", "k": "kripto" }, { "n": "SOL/USD", "d": "Solana", "s": "BINANCE:SOLUSDT", "k": "kripto" }, { "n": "XRP/USD", "d": "XRP / Ripple", "s": "BINANCE:XRPUSDT", "k": "kripto" }, { "n": "ADA/USD", "d": "Cardano", "s": "BINANCE:ADAUSDT", "k": "kripto" }, { "n": "DOGE/USD", "d": "Dogecoin", "s": "BINANCE:DOGEUSDT", "k": "kripto" }, { "n": "AVAX/USD", "d": "Avalanche", "s": "BINANCE:AVAXUSDT", "k": "kripto" }, { "n": "DOT/USD", "d": "Polkadot", "s": "BINANCE:DOTUSDT", "k": "kripto" }, { "n": "LINK/USD", "d": "Chainlink", "s": "BINANCE:LINKUSDT", "k": "kripto" }, { "n": "LTC/USD", "d": "Litecoin", "s": "BINANCE:LTCUSDT", "k": "kripto" }, { "n": "TRX/USD", "d": "Tron", "s": "BINANCE:TRXUSDT", "k": "kripto" }, { "n": "TON/USD", "d": "Toncoin", "s": "BINANCE:TONUSDT", "k": "kripto" }, { "n": "SHIB/USD", "d": "Shiba Inu", "s": "BINANCE:SHIBUSDT", "k": "kripto" }, { "n": "PEPE/USD", "d": "Pepe", "s": "BINANCE:PEPEUSDT", "k": "kripto" }, { "n": "NEAR/USD", "d": "Near Protocol", "s": "BINANCE:NEARUSDT", "k": "kripto" }, { "n": "ATOM/USD", "d": "Cosmos", "s": "BINANCE:ATOMUSDT", "k": "kripto" }, { "n": "US30", "d": "Dow Jones", "s": "TVC:DJI", "k": "indeks" }, { "n": "NAS100", "d": "Nasdaq 100", "s": "TVC:NDX", "k": "indeks" }, { "n": "SPX500", "d": "S&P 500", "s": "TVC:SPX", "k": "indeks" }, { "n": "GER40", "d": "DAX Jerman", "s": "TVC:DAX", "k": "indeks" }, { "n": "UK100", "d": "FTSE 100 Inggris", "s": "TVC:UKX", "k": "indeks" }, { "n": "JPN225", "d": "Nikkei 225", "s": "TVC:NI225", "k": "indeks" }, { "n": "HK50", "d": "Hang Seng", "s": "TVC:HSI", "k": "indeks" }, { "n": "VIX", "d": "Indeks Volatilitas", "s": "TVC:VIX", "k": "indeks" }, { "n": "DXY", "d": "Indeks Dolar AS", "s": "TVC:DXY", "k": "indeks" }, { "n": "AAPL", "d": "Apple", "s": "NASDAQ:AAPL", "k": "saham" }, { "n": "TSLA", "d": "Tesla", "s": "NASDAQ:TSLA", "k": "saham" }, { "n": "NVDA", "d": "Nvidia", "s": "NASDAQ:NVDA", "k": "saham" }, { "n": "MSFT", "d": "Microsoft", "s": "NASDAQ:MSFT", "k": "saham" }, { "n": "AMZN", "d": "Amazon", "s": "NASDAQ:AMZN", "k": "saham" }, { "n": "GOOGL", "d": "Alphabet / Google", "s": "NASDAQ:GOOGL", "k": "saham" }, { "n": "META", "d": "Meta / Facebook", "s": "NASDAQ:META", "k": "saham" }, { "n": "AMD", "d": "AMD", "s": "NASDAQ:AMD", "k": "saham" }, { "n": "COIN", "d": "Coinbase", "s": "NASDAQ:COIN", "k": "saham" }, { "n": "BBCA", "d": "Bank Central Asia", "s": "IDX:BBCA", "k": "idx" }, { "n": "BBRI", "d": "Bank Rakyat Indonesia", "s": "IDX:BBRI", "k": "idx" }, { "n": "BMRI", "d": "Bank Mandiri", "s": "IDX:BMRI", "k": "idx" }, { "n": "TLKM", "d": "Telkom Indonesia", "s": "IDX:TLKM", "k": "idx" }, { "n": "ASII", "d": "Astra International", "s": "IDX:ASII", "k": "idx" }, { "n": "GOTO", "d": "GoTo Gojek Tokopedia", "s": "IDX:GOTO", "k": "idx" }];
      let mkPilihCari = null;

      function mkNorm(s) { return String(s || '').toLowerCase().replace(/[^a-z0-9]/g, ''); }
      function mkCari(q) {
        const n = mkNorm(q); if (!n) return [];
        const skor = [];
        MK_CARI.forEach(p => {
          const a = mkNorm(p.n), b = mkNorm(p.d), c = mkNorm(p.s);
          let s = -1;
          if (a === n) s = 0; else if (a.indexOf(n) === 0) s = 1;
          else if (c.indexOf(n) >= 0) s = 2; else if (b.indexOf(n) === 0) s = 3;
          else if (a.indexOf(n) >= 0) s = 4; else if (b.indexOf(n) >= 0) s = 5;
          if (s >= 0) skor.push([s, p]);
        });
        skor.sort((x, y) => x[0] - y[0]);
        return skor.slice(0, 8).map(x => x[1]);
      }
      function mkGambarHasil(q) {
        const box = $('mk-hasil'); if (!box) return;
        if (!q.trim()) { box.classList.remove('on'); box.innerHTML = ''; return; }
        const r = mkCari(q);
        if (!r.length) {
          /* Kategori simbol tak dikenal TIDAK ditebak — diberi label netral. */
          box.innerHTML = '<div class="mk-kosong">Tidak ada di daftar pilihan kami.<br>' +
            'Kamu tetap bisa mencoba membukanya langsung di TradingView.' +
            '<br><button type="button" class="mk-coba" id="mk-coba">Coba buka <b>' +
            esc(q.toUpperCase()) + '</b></button></div>';
          box.classList.add('on');
          const b = $('mk-coba');
          if (b) b.onclick = () => mkPilihPair({
            n: q.toUpperCase(),
            d: 'Dicoba langsung dari TradingView',
            s: q.toUpperCase().replace(/\s+/g, ''), k: 'lain'
          });
          return;
        }
        box.innerHTML = r.map(p =>
          '<div class="mk-hs">' +
          '<div class="mk-hs-nama"><b>' + esc(p.n) + '</b><span>' + esc(p.d) + '</span></div>' +
          '<span class="mk-tag ' + p.k + '">' + esc(p.k) + '</span>' +
          '</div>').join('');
        box.classList.add('on');
        Array.prototype.forEach.call(box.querySelectorAll('.mk-hs'), (el, i) => {
          el.onclick = () => mkPilihPair(r[i]);
        });
      }
      function mkPilihPair(p) {
        mkPilihCari = p;
        $('mk-hasil').classList.remove('on');
        $('mk-rk-nama').textContent = p.n;
        $('mk-rk-desc').textContent = p.d;
        const tag = $('mk-rk-tag');
        tag.textContent = p.k === 'lain' ? 'pencarian bebas' : p.k;
        tag.className = 'mk-tag ' + p.k;
        mkIsiHargaCari();
        $('mk-ringkas').classList.add('on');
      }
      function mkIsiHargaCari() {
        if (!mkPilihCari) return;
        const kotak = $('mk-rk-harga'); if (!kotak) return;
        kotak.innerHTML = '';
        const cfg = {
          symbol: mkPilihCari.s, width: '100%',
          colorTheme: mkGelap() ? 'dark' : 'light', isTransparent: false,
          backgroundColor: mkWarnaKartu(), locale: 'id'
        };
        kotak.appendChild(mkBingkai(
          'https://s.tradingview.com/embed-widget/single-quote/?locale=id#' +
          encodeURIComponent(JSON.stringify(cfg)), '104px'));
      }
      window.__mkCariChart = () => {
        if (!mkPilihCari) return;
        mkBukaChart(mkPilihCari.s, mkPilihCari.n + ' \u2014 ' + mkPilihCari.d);
      };
      window.__mkCariAnalisa = () => {
        if (tier !== 'umum') { go('analisa'); return; }
        const nama = (mkPilihCari && mkPilihCari.n) || 'pair ini';
        popupInfo({
          ikon: '&#128200;', judul: 'Analisa Harian',
          sub: 'Khusus member Private & Eksklusif',
          tombol: 'Lihat Pilihan Kelas', batal: 'Nanti Saja',
          aksi: () => { go('kelas'); },
          isi: '<p>Analisa harian <b>' + esc(nama) + '</b> dibahas tuntas oleh mentor FNC ' +
            '&mdash; lengkap dengan alasan di balik setiap level yang ditandai.</p>' +
            '<p style="margin-top:10px;">Tersedia untuk member <b>Private</b> dan ' +
            '<b>Eksklusif</b>. Chart dan harga di Beranda tetap bisa kamu pakai ' +
            'kapan saja, gratis.</p>'
        });
      };
      window.__mkCariTutup = () => {
        $('mk-ringkas').classList.remove('on'); mkPilihCari = null;
      };
      function mkPasangCari() {
        const inp = $('mk-cari'), x = $('mk-cari-x');
        if (!inp) return;
        inp.oninput = () => {
          if (x) x.classList.toggle('on', !!inp.value);
          mkGambarHasil(inp.value);
        };
        if (x) x.onclick = () => {
          inp.value = ''; x.classList.remove('on');
          $('mk-hasil').classList.remove('on');
          $('mk-ringkas').classList.remove('on');
          mkPilihCari = null; inp.focus();
        };
      }

      function mkPasangNav() {

        const geser = $('mk-geser'), kiri = $('mk-kiri'), kanan = $('mk-kanan');
        if (!geser || !kiri || !kanan) return;
        const langkah = () => {
          const k = geser.querySelector('.mk-kartu');
          return k ? (k.offsetWidth + 8) * 2 : 496;
        };
        const segar = () => {
          const maks = geser.scrollWidth - geser.clientWidth - 2;
          kiri.disabled = geser.scrollLeft <= 2; kanan.disabled = geser.scrollLeft >= maks;
        };
        kiri.onclick = () => { geser.scrollBy({ left: -langkah(), behavior: 'smooth' }); setTimeout(segar, 320); };
        kanan.onclick = () => { geser.scrollBy({ left: langkah(), behavior: 'smooth' }); setTimeout(segar, 320); };
        geser.onscroll = segar;
        window.addEventListener('resize', segar);
        setTimeout(segar, 150);
      }

      /* Dipanggil ulang saat tema berganti supaya widget ikut gelap/terang. */
      function mkSegarkanTema() {
        mkIsiWidget();
        mkIsiHargaCari();
        if ($('mk-layar') && $('mk-layar').classList.contains('on') && mkSymAktif) {
          const isi = $('mk-layar-isi'); isi.innerHTML = '';
          const f = document.createElement('iframe');
          f.setAttribute('allowtransparency', 'true');
          f.setAttribute('scrolling', 'no');
          f.setAttribute('allowfullscreen', 'true');
          f.src = mkAlamatChart(mkSymAktif);
          isi.appendChild(f);
        }
      }
      function mkMulai() {
        mkRangka(); mkIsiWidget();
        /* Kalau tema sempat berubah tepat setelah halaman dibuka, widget
           dipasang ulang sekali supaya warnanya pasti ikut. */
        let temaSaatPasang = mkGelap();
        setTimeout(() => { if (mkGelap() !== temaSaatPasang) mkIsiWidget(); }, 400);
      }

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const L = $('mk-layar');
        if (L && L.classList.contains('on')) window.__mkTutupChart();
      });

      /* Kartu sapaan bisa disembunyikan supaya tidak makan ruang di atas.
         Sembunyinya hanya untuk kunjungan ini — kalau website dibuka lagi,
         sapaannya muncul kembali seperti biasa. */
      function pasangTutupHero() {
        const b = $('hero-tutup'), k = $('hero-kartu');
        if (!b || !k) return;
        b.onclick = () => { k.style.display = 'none'; };
      }


      /* Tombol geser baris tab + penanda tepi + tab aktif digeser ke tengah. */
      function tabsPasang() {
        const bar = $('tabs'), bungkus = bar && bar.parentNode,
          kiri = $('tabs-kiri'), kanan = $('tabs-kanan');
        if (!bar || !kiri || !kanan) return;
        const langkah = () => Math.max(120, Math.round(bar.clientWidth * 0.6));
        function segar() {
          const maks = bar.scrollWidth - bar.clientWidth - 2;
          const bisaKiri = bar.scrollLeft > 2, bisaKanan = bar.scrollLeft < maks;
          kiri.disabled = !bisaKiri; kanan.disabled = !bisaKanan;
          bungkus.classList.toggle('ada-kiri', bisaKiri);
          bungkus.classList.toggle('ada-kanan', bisaKanan);
        }
        kiri.onclick = () => { bar.scrollBy({ left: -langkah(), behavior: 'smooth' }); setTimeout(segar, 330); };
        kanan.onclick = () => { bar.scrollBy({ left: langkah(), behavior: 'smooth' }); setTimeout(segar, 330); };
        bar.addEventListener('scroll', segar);
        window.addEventListener('resize', segar);
        setTimeout(segar, 120);
        window.__tabsSegar = segar;
      }
      /* Setelah pindah tab, tab yang aktif digeser supaya kelihatan penuh. */
      function tabsKeAktif() {
        const bar = $('tabs'); if (!bar) return;
        const akt = bar.querySelector('.tab.active'); if (!akt) return;
        const kiriAkt = akt.offsetLeft, lebarAkt = akt.offsetWidth;
        const tujuan = kiriAkt - (bar.clientWidth - lebarAkt) / 2;
        try { bar.scrollTo({ left: Math.max(0, tujuan), behavior: 'smooth' }); }
        catch (e) { bar.scrollLeft = Math.max(0, tujuan); }
        setTimeout(() => { if (window.__tabsSegar) window.__tabsSegar(); }, 340);
      }


      /* Tawaran contoh data muncul saat member pertama kali membuka Jurnal atau
         Statistik dan belum punya data apa pun — bukan lagi ditumpuk di pop-up
         sambutan. Hanya ditawarkan sekali seumur perangkat. */
      async function tawarkanContohData(namaTab) {
        try {
          if (accounts.length || trades.length) return;
          /* Pembacaan penanda dipisah: kalau gagal dibaca, tawaran tetap jalan.
             Sebelumnya kegagalan kecil di sini membatalkan seluruh tawaran diam-diam. */
          let sudah = false;
          try { sudah = !!(await store.get(K_DEMO)); } catch (e) { sudah = false; }
          if (sudah) return;
          try { await store.set(K_DEMO, true); } catch (e) { }
          popupInfo({
            ikon: '&#129513;',
            judul: 'Coba Pakai Contoh Data?',
            sub: 'Biar kelihatan dulu bentuk jadinya',
            isi: '<p>Tab <b>' + esc(namaTab) + '</b> kamu masih kosong karena belum ada ' +
              'trade yang dicatat.</p>' +
              '<p style="margin-top:10px;">Mau kami isikan <b>contoh data</b> dulu? ' +
              'Kamu bisa lihat bentuk jurnal dan statistik yang sudah terisi, ' +
              'jadi lebih gampang paham sebelum mencatat trade sendiri.</p>' +
              '<p style="margin-top:10px;font-size:11.5px;color:var(--gray);line-height:1.6;">' +
              'Contoh ini bisa kamu hapus kapan saja lewat tab Profil.</p>',
            tombol: 'Ya, Isikan Contoh',
            batal: 'Nanti Saja',
            aksi: async () => {
              try {
                const d = demoData(); accounts = [d.acc]; trades = d.tr;
                await persist(); renderAll();
              } catch (e) { }
            }
          });
        } catch (e) { }
      }

      /* Dipanggil tiap kali Beranda ditampilkan. Kalau widget sebelumnya
         tergambar saat tab tersembunyi (lebar nol), dia dipasang ulang di sini. */
      function mkSegarkanSaatTampil() {
        try {
          const w = $('mk-wrap');
          if (!w || !w.clientWidth) return;
          if (mkWidgetSiap) return;
          mkIsiWidget();
        } catch (e) { }
      }

      function pakaiTema(t) {
        document.documentElement.setAttribute('data-tema', t === 'gelap' ? 'gelap' : 'terang');
        const b = $('tema-btn');
        if (b) {
          b.innerHTML = t === 'gelap' ? '&#9788;' : '&#9789;';   /* matahari / bulan */
          b.title = t === 'gelap' ? 'Ganti ke mode terang' : 'Ganti ke mode gelap';
        }
        try { if (typeof mkSegarkanTema === 'function' && $('mk-pita')) mkSegarkanTema(); } catch (e) { }
      }
      async function muatTema() {
        let t = null;
        try { t = await store.get(K_TEMA); } catch (e) { }
        if (t !== 'gelap' && t !== 'terang') {
          /* belum pernah memilih -> ikut pengaturan sistem */
          t = cekMedia('(prefers-color-scheme: dark)') ? 'gelap' : 'terang';
        }
        pakaiTema(t);
      }
      async function gantiTema() {
        const kini = document.documentElement.getAttribute('data-tema');
        const baru = kini === 'gelap' ? 'terang' : 'gelap';
        pakaiTema(baru);
        try { await store.set(K_TEMA, baru); } catch (e) { }
      }

      /* ---------- sorotan mengikuti kursor ----------
         Hanya untuk perangkat berkursor. Posisinya diperbarui lewat
         requestAnimationFrame supaya tidak membebani saat mouse digerakkan cepat. */
      function cekMedia(q) {
        try { return !!(window.matchMedia && window.matchMedia(q).matches); } catch (e) { return false; }
      }
      function pasangSorotKursor() {
        const el = $('sorot-kursor'); if (!el) return;
        if (cekMedia('(pointer: coarse)')) return;
        if (cekMedia('(prefers-reduced-motion: reduce)')) return;
        let x = 0, y = 0, tunggu = false;
        function gambar() {
          el.style.transform = 'translate(' + x + 'px,' + y + 'px) translate(-50%,-50%)';
          tunggu = false;
        }
        window.addEventListener('mousemove', e => {
          x = e.clientX; y = e.clientY;
          if (!el.classList.contains('on')) el.classList.add('on');
          if (!tunggu) { tunggu = true; requestAnimationFrame(gambar); }
        }, { passive: true });
        window.addEventListener('mouseleave', () => el.classList.remove('on'));
      }

      /* ---------- AI Agent FNC Academy (WhatsApp) ----------
         Membuka WhatsApp dengan pesan pembuka yang sudah terisi, jadi member
         tidak perlu mengetik apa-apa untuk memulai. */
      const AI_NOMOR = '6281918688086';
      const AI_SAPAAN = 'Hallo Ai bisakah aku konsultasi seputar trading?';
      function bukaAI() {
        const url = 'https://wa.me/' + AI_NOMOR + '?text=' + encodeURIComponent(AI_SAPAAN);
        try { window.open(url, '_blank', 'noopener'); } catch (e) { location.href = url; }
      }
      window.__bukaAI = bukaAI;

      /* Buka tab lalu gulirkan ke kiriman yang diklik — bukan sekadar pindah tab.
         Segmen (Umum/Eksklusif) ikut disesuaikan supaya kirimannya benar-benar ada. */
      async function bukaKiriman(view, id, sumber) {
        if (view === 'news') {
          const mau = (sumber === 'Eksklusif') ? 'eks' : 'umum';
          if (newsKind !== mau) {
            newsKind = mau;
            document.querySelectorAll('#news-seg .seg-btn').forEach(b =>
              b.classList.toggle('active', b.dataset.nk === mau));
          }
        }
        if (view === 'rekap') {
          const mau = (sumber === 'RekapEks') ? 'eks' : 'umum';
          if (rkKind !== mau) {
            rkKind = mau;
            document.querySelectorAll('#rk-seg .seg-btn').forEach(b =>
              b.classList.toggle('active', b.dataset.rk === mau));
          }
        }
        if (view === 'materi') {
          const mau = (sumber === 'MateriEks') ? 'eks' : 'umum';
          if (mtKind !== mau) {
            mtKind = mau;
            document.querySelectorAll('#mt-seg .seg-btn').forEach(b =>
              b.classList.toggle('active', b.dataset.mt === mau));
          }
        }
        go(view);
        if (!id) return;
        /* Tunggu daftarnya selesai dimuat, baru gulirkan. */
        for (let i = 0; i < 24; i++) {
          await new Promise(r => setTimeout(r, 130));
          /* Kiriman bisa berupa kartu biasa ATAU kartu sorotan — dicari
             berdasarkan penanda id yang sama, supaya tidak salah lompat. */
          const kid = String(id).replace(/"/g, '');
          const el = document.querySelector('#v-' + view + ' .feed-item[data-kid="' + kid + '"], ' +
            '#v-' + view + ' .utama[data-kid="' + kid + '"]');
          if (el) {
            el.classList.add('buka');          /* buka isinya saat dituju dari Beranda */
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.classList.remove('sorot');
            void el.offsetWidth;              /* paksa animasi diulang */
            el.classList.add('sorot');
            setTimeout(() => el.classList.remove('sorot'), 2200);
            return;
          }
        }
      }
      window.__bukaKiriman = (v, i, s) => bukaKiriman(v, i, s);
      /* Sorotan di tab Berita: kartunya ada di daftar yang sama, jadi cukup
         buka lalu gulir ke sana. */
      window.__tutupBukaSorotan = function (el) {
        if (el && el.classList) el.classList.toggle('buka');
      };
      window.__bukaSorotan = function (id) {
        const el = document.querySelector('#news-list .feed-item[data-kid="' +
          String(id).replace(/"/g, '') + '"]');
        if (el) {
          el.classList.add('buka');
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          el.classList.remove('sorot'); void el.offsetWidth; el.classList.add('sorot');
          setTimeout(() => el.classList.remove('sorot'), 2200);
        }
      };
      /* Kartu sorotan untuk kiriman teratas. Kalau isiPenuh diisi, isinya
         bisa dibuka langsung di tempat tanpa berpindah ke kartu lain. */
      function kartuSorotan(it, sumber, view, aksi, isiPenuh) {
        const gbr = it.thumb || it.image || ((it.images || [])[0]) || '';
        const tampilLbl = LABEL[sumber] || sumber;
        const ringkas = potongTeks(it.body, 150);
        return '<div class="utama" data-kid="' + esc(it.id || '') + '" onclick="' + aksi + '">' +
          '<div class="utama-gbr">' +
          (gbr ? '<img src="' + esc(gbr) + '" alt="" loading="lazy">'
            : '<div class="ph">' + (IKON[sumber] || '&#128196;') + '</div>') +
          (it.url ? '<div class="vmark"></div>' : '') +
          '<span class="utama-pita">' + esc(tampilLbl) + '</span>' +
          '</div>' +
          '<div class="utama-isi">' +
          (it.title ? '<h3>' + esc(it.title) + '</h3>' : '<h3>&mdash;</h3>') +
          (ringkas ? '<p>' + esc(ringkas) + '</p>' : '') +
          '<div class="utama-kaki">' +
          '<span class="utama-baca">Baca selengkapnya</span>' +
          '<span class="hc-date">' + stempelWaktu(it) + '</span>' +
          '</div>' +
          (isiPenuh ? '<div class="utama-full"><div class="feed-body">' +
            waFormat(it.body) + '</div></div>' : '') +
          /* Kiriman teratas dipajang sebagai kartu sorotan, bukan kartu biasa,
             jadi tombol bagikannya dipasang di sini juga. */
          (it.id && (view === 'news' || view === 'analisa')
            ? '<div class="fi-bagi"><button type="button" title="Bagikan kiriman ini" ' +
            'onclick="event.stopPropagation();window.__feedBagi(\'' + esc(it.id) + '\',\'' +
            (view === 'analisa' ? 'analisa' : 'berita') + '\',this)">&#128279; Bagikan</button></div>'
            : '') +
          '</div></div>';
      }

      function pintasKartu(ikon, judul, ket, view) {
        return '<a onclick="window.__go(\'' + view + '\')">' +
          '<div class="ik">' + ikon + '</div>' +
          '<div class="tx"><b>' + judul + '</b><span>' + ket + '</span></div></a>';
      }
      window.__go = v => go(v);

      /* ---------- PROFIL MEMBER (lokal) ---------- */
      function buatIdMember() {
        const c = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let s = '';
        for (let i = 0; i < 5; i++)s += c[Math.floor(Math.random() * c.length)];
        return 'FNC-' + s;
      }
      async function simpanProfil(nama) {
        profil = { id: buatIdMember(), nama: String(nama).trim().slice(0, 24), dibuat: new Date().toISOString() };
        await store.set(K_PROFIL, profil);
        terapkanProfil();
        return profil;
      }
      function terapkanProfil() {
        if (!$('v-accounts')) return;
        const box = $('profil-card');
        if (box) {
          box.innerHTML = profil
            ? '<div class="prof-row"><div class="prof-av">' + esc((profil.nama || '?').charAt(0).toUpperCase()) + '</div>' +
            '<div class="prof-meta"><b>' + esc(profil.nama) + '</b><span>ID ' + esc(profil.id) + '</span></div></div>' +
            '<p style="font-size:11.5px;color:var(--gray);line-height:1.6;margin:11px 0 0;">' +
            'Profil &amp; jurnal tersimpan di perangkat ini, bukan di server. ' +
            'Rutin klik <b>Backup</b> di tab Jurnal supaya aman.</p>' +
            '<div style="border-top:1px solid var(--line);margin-top:14px;padding-top:13px;">' +
            '<div style="font-size:11.5px;color:var(--gray);margin-bottom:9px;">Akses saat ini: <b>' +
            (tier === 'eks' ? 'Eksklusif' : 'Private') + '</b></div>' +
            '<div style="display:flex;gap:8px;flex-wrap:wrap;">' +
            (tier === 'eks' ? '' : '<button class="btn sm" onclick="window.__bukaUpgrade()">Punya Kode Eksklusif?</button>') +
            '<button class="btn ghost sm" onclick="window.__keluarAkses()">Keluar / Ganti Kode</button>' +
            '</div></div>'
            : '<p style="font-size:13px;color:var(--slate-2);line-height:1.65;margin:0 0 12px;">' +
            'Belum ada profil. Buat dulu supaya bisa mulai mencatat jurnal.</p>' +
            '<button class="btn" onclick="window.__bukaProfil()">Buat Profil</button>' +
            '<div style="border-top:1px solid var(--line);margin-top:14px;padding-top:13px;' +
            'display:flex;gap:8px;flex-wrap:wrap;">' +
            (tier === 'eks' ? '' : '<button class="btn sm" onclick="window.__bukaUpgrade()">Punya Kode Eksklusif?</button>') +
            '<button class="btn ghost sm" onclick="window.__keluarAkses()">Keluar / Ganti Kode</button></div>';
        }
      }
      /* ---------- TIER ---------- */
      /* Tab yang terbuka penuh untuk pengunjung UMUM (tanpa kode).
         Kalender ikut di sini karena jadwal rilis ekonomi sengaja dibuka
         untuk semua orang sebagai pintu masuk. */
      const TAB_UMUM = ['beranda', 'news', 'kelas', 'challenge', 'calendar', 'journal', 'dashboard', 'calc', 'accounts', 'help', 'info'];

      function setTier(t) {
        tier = t;
        const label = t === 'eks' ? 'Eksklusif' : (t === 'umum' ? 'Umum' : 'Private');
        [['tier-chip'], ['hero-tier']].forEach(([id]) => {
          const el = $(id); if (!el) return;
          el.textContent = label;
          el.className = 'tier-chip ' + (t === 'eks' ? 'eks' : (t === 'umum' ? 'trial' : 'priv'));
        });
        const dot = $('an-lockdot'); if (dot) dot.hidden = (t === 'eks');
        terapkanAkses();
        try { terapkanProfil(); } catch (e) { }
      }

      /* Menyembunyikan tab yang tidak termasuk masa percobaan.
         Ini lapisan tampilan; pengaman sebenarnya ada di go() dan di enkripsi berkas. */
      /* Pengguna percobaan tetap BISA membuka tabnya — isinya yang terkunci,
         sama seperti member private melihat konten eksklusif. Yang tampil
         hanya bagian teaser: gambar mini buram + tanggal, tanpa judul. */
      function terapkanAkses() {
        const trial = tier === 'umum';
        document.querySelectorAll('.tab').forEach(t => {
          const v = t.dataset.view;
          t.hidden = false;
          const kunci = trial && TAB_UMUM.indexOf(v) < 0;
          let dot = t.querySelector('.lockdot');
          if (kunci && !dot && v !== 'analisa') {
            dot = document.createElement('span');
            dot.className = 'lockdot'; dot.innerHTML = '&#128274;';
            t.appendChild(dot);
          } else if (!kunci && dot && v !== 'analisa') {
            dot.remove();
          }
        });
        const dotAn = $('an-lockdot');
        if (dotAn) dotAn.hidden = (tier === 'eks');
        /* segmen Eksklusif tetap terlihat, tapi isinya pratinjau buram */
        const segEks = document.querySelector('#news-seg .seg-btn[data-nk="eks"]');
        if (segEks) segEks.hidden = false;
      }
      /* Uji kode ke berkas terenkripsi. true HANYA kalau dekripsi v2 berhasil. */
      async function kodeEksValid(kode) {
        if (await kodeEksCocok(kode)) return true;
        for (const url of [ANALISA_URL, NEWS_EX_URL, REKAP_EX_URL, MATERI_EX_URL]) {
          try {
            const d = await fetchJSON(url);
            if (d && (d.v === 2 || d.v === 3 || d.v === 4) && d.ct) { await fncDekripsi(kode, d); return true; }
          } catch (e) { }
        }
        return false;
      }
      /* Satu kode, dua tingkat. Kode eksklusif otomatis mencakup akses private. */
      /* ============================================================
         MASA PERCOBAAN (TRIAL)
         Kode percobaan disimpan sebagai sidik SHA-256 di trial.json —
         kode aslinya tidak pernah ada di berkas manapun yang bisa diunduh.
         Setiap kode punya dua batas, dan yang lebih dulu tiba yang berlaku:
           1. tanggal kedaluwarsa mutlak  (tidak bisa direset)
           2. jumlah hari sejak pertama dipakai di perangkat itu
         ============================================================ */
      const K_KODE = 'fncjt_kode';    /* kode akses yang dipakai — untuk membuka berkas private */
      let kodeAkses = null;

      async function periksaKode(v) {
        if (!v) return null;
        try { if (await kodeEksValid(v)) return 'eks'; } catch (e) { }
        try { if ((await fncHash(v)) === ACCESS_CODE_HASH) return 'private'; } catch (e) { }
        return null;
      }

      /* ---------- GATE ---------- */
      function normCode(s) { return String(s || '').toUpperCase().replace(/[^A-Z0-9]/g, ''); }
      async function kodeCocok(v) {
        if (!v) return false;
        try { return (await fncHash(v)) === ACCESS_CODE_HASH; } catch (e) { return false; }
      }
      /* ============================================================
         PENGATURAN SITUS  (pengaturan.json — berkas polos, tanpa enkripsi)
         Isinya hal-hal yang sering berubah dan harus bisa diganti admin
         tanpa menyentuh kode: tautan grup publik, dan nanti nomor admin
         serta info pembayaran.
         ============================================================ */
      const SET_URL = 'pengaturan.json';
      /* Cadangan kalau pengaturan.json belum di-upload — supaya fiturnya
         tetap hidup di hari pertama. Yang di berkas selalu menang. */
      const GRUP_BAWAAN = 'https://chat.whatsapp.com/IoaK3O31T61ABskrHptt6V';
      const K_GRUP = 'fncjt_grup_seen';
      /* Nomor cadangan — dipakai kalau pengaturan.json belum di-upload.
         Yang ada di berkas selalu menang, jadi kalau ada nomor kena ban
         tinggal ganti dari admin tanpa menyentuh kode. */
      const WA_BAWAAN = {
        a1: '0895423372080', a2: '087713361586', a3: '0895378218007',
        ai: '081918688086',
        /* Nomor Radit ada dua: 1586 untuk pengunjung umum, 0081 khusus
           member berbayar. Konsultasi memakai yang kedua. */
        a2priv: '087747550081'
      };
      /* Urutan yang tampil di layar: Admin 1, Admin 2, Admin 3.
         Namanya sengaja tidak ditampilkan — hanya dipakai di template pesan. */
      const ADMIN_LIST = [
        { kunci: 'a1', label: 'Admin 1', peran: 'Materi &amp; cara belajar', sapa: 'Yudhis' },
        { kunci: 'a2', label: 'Admin 2', peran: 'Tanya-tanya umum', sapa: 'Radit' },
        { kunci: 'a3', label: 'Admin 3', peran: 'Pendaftaran &amp; paket', sapa: 'Alief' }
      ];
      const PESAN_ADMIN = {
        a1: 'Saya lihat FNC Academy dari website, mau tanya soal cara mulai belajar dan materinya.',
        a2: 'Saya baru lihat FNC Academy, mau tanya-tanya dulu sebelum gabung.',
        a3: 'Saya mau tanya soal paket kelas dan cara daftarnya di FNC Academy.'
      };
      /* 08xxx -> 628xxx, supaya tautan wa.me selalu benar. */
      function waNormal(no) {
        let t = String(no || '').replace(/[^0-9]/g, '');
        if (!t) return '';
        if (t.indexOf('0') === 0) t = '62' + t.slice(1);
        else if (t.indexOf('62') !== 0) t = '62' + t;
        return t;
      }
      async function nomorAdmin(kunci) {
        const p = await ambilPengaturan();
        const dari = (p && p.wa && typeof p.wa[kunci] === 'string' && p.wa[kunci].trim())
          ? p.wa[kunci] : WA_BAWAAN[kunci];
        return waNormal(dari);
      }
      function pesanKonsul(kunci) {
        const a = ADMIN_LIST.filter(x => x.kunci === kunci)[0];
        const nama = (profil && profil.nama) ? (', saya ' + profil.nama) : '';
        if (kunci === 'ai') return 'Halo FNC, saya mau tanya seputar kelas dan cara mulai belajar trading.';
        return 'Halo Admin ' + (a ? a.sapa : '') + nama + '. ' + (PESAN_ADMIN[kunci] || '');
      }
      /* Membuka tab baru hanya diizinkan browser selama "izin sentuh" dari
         klik masih hidup. Menunggu unduhan berkas lebih dulu akan menghanguskan
         izin itu, dan tab barunya diblokir — itu sebabnya dulu harus diklik dua
         kali. Sekarang: kalau datanya belum siap, halaman ini yang dialihkan
         (tidak pernah diblokir); kalau sudah siap, tab baru seperti biasa. */
      function bukaWA(url, siap) {
        if (siap) { try { window.open(url, '_blank', 'noopener'); return; } catch (e) { } }
        location.href = url;
      }
      function pengaturanSiap() { return !!pengaturan; }
      window.__konsul = async (kunci) => {
        const siap = pengaturanSiap();
        const no = await nomorAdmin(kunci);
        if (!no) { alert('Nomor admin belum diatur. Coba lagi nanti ya.'); return; }
        bukaWA('https://wa.me/' + no + '?text=' + encodeURIComponent(pesanKonsul(kunci)), siap);
      };
      /* AI Agent sedang bermasalah. Daripada mengarahkan ke nomor yang tidak
         membalas — yang bikin orang merasa diabaikan — kendalanya dijelaskan
         dan langsung dialihkan ke admin. */
      window.__aiKendala = () => {
        popupInfo({
          ikon: '&#128295;',
          judul: 'AI Agent Sedang Diperbaiki',
          sub: 'Sementara ini dijawab admin langsung',
          isi: '<p>AI Agent FNC lagi dalam perbaikan, jadi belum bisa membalas ' +
            'pertanyaanmu untuk sementara.</p>' +
            '<p style="margin-top:10px;">Kabar baiknya: pertanyaanmu bisa langsung ' +
            'dijawab <b>Admin Yudhis</b> lewat WhatsApp &mdash; malah lebih enak, ' +
            'karena dijawab orang yang paham betul materinya.</p>' +
            '<p style="margin-top:10px;font-size:11.5px;color:var(--gray);line-height:1.6;">' +
            'Kami kabari lagi kalau AI Agent-nya sudah bisa dipakai.</p>',
          tombol: 'Chat Admin Yudhis',
          batal: 'Nanti Saja',
          aksi: () => { window.__aiKeAdmin(); }
        });
      };
      window.__aiKeAdmin = async () => {
        const siap = pengaturanSiap();
        const no = await nomorAdmin('a1');
        if (!no) { alert('Nomor admin belum diatur. Coba lagi nanti ya.'); return; }
        const nama = (profil && profil.nama) ? (' Saya ' + profil.nama + '.') : '';
        const pesan = 'Halo Kak Yudhis.' + nama + ' Saya mau tanya seputar trading, ' +
          'tapi AI Agent FNC sedang dalam perbaikan. Boleh dibantu lewat chat?';
        bukaWA('https://wa.me/' + no + '?text=' + encodeURIComponent(pesan), siap);
      };
      window.__bukaGrup = async () => {
        const siap = pengaturanSiap();
        const url = await tautanGrup();
        if (!url) return;
        bukaWA(url, siap);
      };
      const IKON_WA_KECIL = '<span style="font-size:15px;vertical-align:-2px;">&#128172;</span>';
      const IKON_WA = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.01-1.04 2.47 0 1.45 1.06 2.86 1.21 3.06.15.2 2.09 3.2 5.08 4.48.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.18 4.22-9.4 9.42-9.4 2.51 0 4.88.98 6.65 2.76a9.34 9.34 0 0 1 2.75 6.65c0 5.19-4.22 9.41-9.41 9.41zM20.52 3.49A11.78 11.78 0 0 0 12.04 0C5.5 0 .18 5.32.18 11.86c0 2.09.55 4.13 1.6 5.93L.08 24l6.35-1.66a11.83 11.83 0 0 0 5.61 1.43h.01c6.53 0 11.85-5.32 11.85-11.86 0-3.17-1.23-6.15-3.38-8.42z"/></svg>';
      let pengaturan = null;

      async function ambilPengaturan() {
        if (pengaturan) return pengaturan;
        let d = null;
        try { d = await fetchJSON(SET_URL); } catch (e) { d = null; }
        pengaturan = (d && typeof d === 'object') ? d : {};
        return pengaturan;
      }
      async function tautanGrup() {
        const p = await ambilPengaturan();
        const v = (p && typeof p.grupWA === 'string') ? p.grupWA.trim() : '';
        return v || GRUP_BAWAAN;
      }

      /* Ditampilkan SEKALI, saat orang pertama kali masuk. Kalau ditutup,
         tidak muncul lagi — tautannya tetap tersedia di tab Bantuan. */
      async function tampilGrupPublik() {
        let sudah = false;
        try { sudah = await store.get(K_GRUP); } catch (e) { }
        if (sudah) return false;
        const url = await tautanGrup();
        if (!url) return false;
        $('grup-join').onclick = async () => {
          try { window.open(url, '_blank', 'noopener'); } catch (e) { location.href = url; }
          await tutupGrup();
        };
        $('grup-skip').onclick = tutupGrup;
        $('grup-overlay').hidden = false;
        return true;
      }
      /* Dipakai di setiap ujung alur masuk. Tautan berbagi bisa dibuka orang
         yang belum pernah membuka situs ini sama sekali — dia harus melewati
         gerbang, ajakan grup, dan layar sambutan dulu. Tanpa ini, tautannya
         hangus di tengah jalan dan dia mendarat di Beranda tanpa tahu kenapa. */
      async function lanjutMasuk() {
        try { if (await kelasDariTautan()) return; } catch (e) { }
        /* Pengumuman ditampilkan setelah tautan berbagi, supaya orang yang
           datang lewat tautan tetap sampai ke tujuannya lebih dulu. */
        try { if (await tampilPengumuman()) return; } catch (e) { }
        go('beranda');
      }
      async function tutupGrup() {
        $('grup-overlay').hidden = true;
        try { await store.set(K_GRUP, true); } catch (e) { }
        const seen = await store.get(K_SEEN);
        if (!seen) { $('welcome-overlay').hidden = false; }
        else { await lanjutMasuk(); }
      }

      async function unlock() {
        $('gate-overlay').hidden = true;
        $('shell').classList.remove('locked');
        if ($('ai-fab')) $('ai-fab').hidden = false;
        await store.set(K_GATE, true);
        /* Ajakan gabung grup publik lebih dulu — komitmennya paling ringan.
           Kalau sudah pernah tampil, langsung lanjut ke alur biasa. */
        /* Ajakan grup sekarang menyatu di pop-up sambutan, jadi pop-up terpisah
           ini dimatikan supaya orang baru tidak diberondong berkali-kali. */
        /* if(await tampilGrupPublik())return; */
        const seen = await store.get(K_SEEN);
        if (!seen) { $('welcome-overlay').hidden = false; }
        else { await lanjutMasuk(); }
      }
      async function trySubmitCode() {
        const val = normCode($('gate-code').value);
        const btn = $('gate-submit'), lama = btn.textContent;
        btn.disabled = true; btn.textContent = 'Memeriksa...'; $('gate-err').hidden = true;
        let t = null;
        try { t = await periksaKode(val); } catch (e) { t = null; }
        btn.disabled = false; btn.textContent = lama;
        if (t) {
          setTier(t);
          await store.set(K_TIER, t);
          if (t === 'eks') { kodeEks = val; await store.set(K_ANGATE, val); }
          else { kodeEks = null; await store.set(K_ANGATE, ''); }   /* buang sisa kode lama */
          kodeAkses = val;
          await store.set(K_KODE, kodeAkses);
          $('gate-err').hidden = true; $('gate-code').value = '';
          await unlock();
        } else {
          $('gate-err').innerHTML = 'Kode tidak dikenali. Cek lagi ya, ' +
            'atau pilih <b>Lihat-lihat dulu</b> untuk masuk tanpa kode.';
          $('gate-err').hidden = false; $('gate-code').value = ''; $('gate-code').focus();
        }
      }
      $('gate-submit').onclick = trySubmitCode;
      /* Masuk sebagai pengunjung UMUM — tanpa kode, tanpa batas waktu. */
      if ($('gate-umum')) $('gate-umum').onclick = async () => {
        setTier('umum');
        await store.set(K_TIER, 'umum');
        kodeEks = null; kodeAkses = null;
        await store.set(K_KODE, ''); await store.set(K_ANGATE, '');
        $('gate-err').hidden = true; $('gate-code').value = '';
        await unlock();
      };
      $('gate-code').addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); trySubmitCode(); }
        else $('gate-err').hidden = true;
      });

      (async function boot() {
        await muatTema();
        if ($('tema-btn')) $('tema-btn').onclick = gantiTema;
        try { mkMulai(); } catch (e) { console.warn('market gagal dimuat', e); }
        try { pasangTutupHero(); } catch (e) { }
        try { hpPasang(); } catch (e) { }
        try { tabsPasang(); } catch (e) { }
        pasangSorotKursor();
        accounts = (await store.get(K_ACC)) || [];
        trades = (await store.get(K_TR)) || [];
        settings = (await store.get(K_SET)) || { kurs: 17000 };
        profil = (await store.get(K_PROFIL)) || null;
        let tSimpan = await store.get(K_TIER);
        /* 'trial' adalah sisa sistem lama — pemakainya dinaikkan jadi UMUM,
           yang aksesnya justru lebih luas (dapat Kalender juga). */

        /* Kode yang tersimpan diperiksa ulang di sini. Tanpa ini, member yang
           kodenya sudah diganti admin tetap terlihat "Eksklusif" di Profil,
           padahal isinya tidak bisa dibuka lagi — bingung, dan tidak ada
           petunjuk apa pun bahwa dia harus memasukkan kode baru. */
        let kodeKadaluarsa = false;
        if (tSimpan === 'eks' || tSimpan === 'private') {
          let simpanan = null;
          try { simpanan = await store.get(K_KODE); } catch (e) { }
          let sah = false;
          if (typeof simpanan === 'string' && simpanan) {
            try {
              const sidik = await fncHash(fncNormKode(simpanan));
              sah = (tSimpan === 'eks') ? (sidik === EKS_CODE_HASH)
                : (sidik === ACCESS_CODE_HASH || sidik === EKS_CODE_HASH);
            } catch (e) { sah = false; }
          }
          if (!sah) {
            kodeKadaluarsa = true;
            tSimpan = 'umum';
            kodeEks = null; kodeAkses = null;
            try {
              await store.set(K_TIER, 'umum');
              await store.set(K_KODE, '');
              await store.set(K_ANGATE, '');
              await store.set(K_GATE, false);
            } catch (e) { }
          }
        }
        setTier(tSimpan === 'eks' ? 'eks' : (tSimpan === 'private' ? 'private' : 'umum'));
        /* Pemulihan gerbang Analisa: kalau tingkatannya eksklusif dan kode
           aksesnya masih tersimpan, kode gerbang dipulihkan otomatis. Member
           eksklusif cukup memasukkan kodenya SEKALI di perangkat ini. */
        if (tier === 'eks') {
          try {
            const gerbang = await store.get(K_ANGATE);
            if (!gerbang) {
              const simpanan = await store.get(K_KODE);
              if (typeof simpanan === 'string' && simpanan) {
                kodeEks = simpanan;
                await store.set(K_ANGATE, simpanan);
              }
            }
          } catch (e) { }
        }
        initCalc();
        initFeeds();
        renderAll();
        updateStorageNotice();
        const unlocked = await store.get(K_GATE);
        if (kodeKadaluarsa) {
          /* Sesinya diakhiri, tapi jangan sampai member merasa dikeluarkan
             tanpa sebab — alasannya dijelaskan langsung di gerbang. */
          /* Kode kedaluwarsa tidak lagi mengunci seluruh website. Member turun
             ke UMUM dan tetap bisa memakai Beranda, Jurnal, dan lainnya, lalu
             memasukkan kode baru lewat tab Profil kapan saja. */
          setTier('umum');
          try { await store.set(K_TIER, 'umum'); } catch (e) { }
          kodeAkses = null; kodeEks = null;
          await unlock();
          setTimeout(() => {
            try {
              popupInfo({
                ikon: '&#128273;', judul: 'Kode Akses Sudah Diperbarui',
                sub: 'Kamu masuk sebagai pengunjung umum',
                isi: '<p>Kode lamamu sudah tidak berlaku. Kamu tetap bisa memakai ' +
                  'Beranda, Berita, Jurnal, Statistik, dan Kalkulator seperti biasa.</p>' +
                  '<p style="margin-top:10px;">Punya kode baru dari admin? Masukkan lewat ' +
                  'tab <b>Profil</b> untuk membuka kembali isi khusus member.</p>',
                tombol: 'Ke Tab Profil', batal: 'Nanti Saja',
                aksi: () => { go('info'); }
              });
            } catch (e) { }
          }, 700);
        } else if (unlocked === true) {
          $('shell').classList.remove('locked');
          if ($('ai-fab')) $('ai-fab').hidden = false;
          const seen = await store.get(K_SEEN);
          if (!seen) $('welcome-overlay').hidden = false;
          else if (!(await kelasDariTautan())) {
            if (!(await tampilPengumuman())) { renderBeranda(); replayAnim('beranda'); }
          }
        } else {
          /* Pengunjung baru TIDAK lagi dihadang gerbang kode. Dia langsung masuk
             sebagai UMUM dan bisa menjelajah. Kode akses dimasukkan lewat tab
             Profil kalau memang punya. Ini menghapus pop-up pertama yang paling
             sering dikeluhkan. Member yang sudah membuka kode sebelumnya tetap
             terbuka aksesnya — tidak perlu memasukkan kode lagi tiap kunjungan. */
          setTier('umum');
          try { await store.set(K_TIER, 'umum'); } catch (e) { }
          await unlock();
        }
      })();
    })();
  </script>
  <div class="mk-layar" id="mk-layar">
    <div class="mk-layar-atas">
      <b id="mk-layar-nama">Chart</b>
      <button class="mk-tutup" onclick="window.__mkTutupChart()">&#10005; Tutup</button>
    </div>
    <div class="mk-layar-isi" id="mk-layar-isi"></div>
    <div class="mk-layar-kaki">
      Chart oleh TradingView &middot; coretan analisamu <b>bersifat sementara</b> &mdash;
      hilang begitu chart ditutup. Pakai ikon kamera di chart untuk menyimpannya jadi gambar.
    </div>
  </div>
</body>

</html>